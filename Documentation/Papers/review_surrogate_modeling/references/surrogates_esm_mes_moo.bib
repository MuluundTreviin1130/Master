@ARTICLE{Wu2026,
	author = {Wu, Yidi and Feng, Bo and Zhang, Yangrui and Li, Mengyu and Jia, Yongliang and Wang, Jingmiao},
	title = {Ultra short term prediction of distributed photovoltaic power generation based on mixed kernel SVM},
	year = {2026},
	journal = {Measurement: Journal of the International Measurement Confederation},
	volume = {257},
	pages = {},
	doi = {10.1016/j.measurement.2025.118683},
	url = {https://www.scopus.com/pages/publications/105013464551?origin=resultslist},
	abstract = {This study proposes an ultra-short-term prediction method for distributed photovoltaic (PV) power generation based on a hybrid kernel function-based support vector machine (SVM) to improve the operational efficiency of distributed PV systems, optimize grid scheduling strategies, minimize energy losses, and enhance the overall stability of the power system. The proposed methodology includes: (1) analyzing the factors influencing power generation to select key indicators (e.g., solar irradiance) for dataset construction, while employing the Isolation Forest algorithm to eliminate outliers through its ensemble learning-based anomaly detection capability, thereby ensuring data reliability; (2) applying the Pearson correlation coefficient to extract five critical eigenvalues (including the irradiance-temperature ratio) from the processed data to improve power variation modeling accuracy; (3) developing a hybrid kernel SVM model that combines a radial basis function (RBF) and a polynomial kernel function to integrate both local and global kernel characteristics, while utilizing the firefly algorithm to optimize hybrid kernel parameters and enhance model performance; (4) training the model using sample data with mean square error (MSE) as the loss function for minimization, and generating predictions through feature vector input to facilitate PV system operation management. Experimental results demonstrate precise ultra-short-term PV power prediction, with F1-scores approaching 1 under both sunny and rainy conditions, while root mean square error (RMSE), mean absolute error (MAE), and relative error are all reduced, confirming superior prediction accuracy, model performance, and environmental adaptability. Implementation results indicate a significant reduction in power curtailment rates and improved energy utilization efficiency. © 2025},
	author_keywords = {Distributed photovoltaic power generation; Eigenvalue; Mixed kernel function; Power prediction; Support vector machine; Ultra short term},

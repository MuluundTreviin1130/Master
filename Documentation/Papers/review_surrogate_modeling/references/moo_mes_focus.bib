}

@inproceedings{gu_low-carbon-emission-based_2023,
	title = {Low-carbon-emission-based Economic Optimization Scheme for a Smart Building with Multiple Energy Flows},
	isbn = {979-8-3503-2762-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85178515031&doi=10.1109%2fCPESE59653.2023.10303021&partnerID=40&md5=37b4c4e7325823f9fb101d2528545ff6},
	doi = {10.1109/CPESE59653.2023.10303021},
	abstract = {This paper proposes a novel economic optimization scheme that prioritizes low carbon emissions for smart buildings integrating multiple energy flows. The scheme addresses the inherent challenges faced by buildings as complex integrated energy systems, characterized by high carbon emissions and diverse optimization objectives of multiple energy flows. Firstly, we establish an incentive-based carbon emission trading mechanism. Subsequently, a multi-objective scheduling model for smart buildings is formulated, taking into account the carbon trading market and the intricate coupling of multiple energy flows. This model aims to minimize both operational costs and carbon emissions. To solve the formulated model, the Multi-objective Salp Swarm Algorithm ({MSSA}) is employed. Finally, the feasibility and effectiveness of the proposed approach are assessed through the simulation of various scheduling scenarios. © 2023 {IEEE}.},

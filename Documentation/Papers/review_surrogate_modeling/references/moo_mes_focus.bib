	author = {Hosseini, K. and Araghi, S. and Ahmadian, M. B. and Asadian, V.},
	date = {2017},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission networks, Genetic algorithms, Multi-objective optimization, Particle swarm optimization ({PSO}), Decision making, Microgrid, Optimizers, Solar panels, Fuel cells, Micro-Grid, Operating costs, Pareto principle, Multi objective, Virtual power plants, Screening, Energy resources, Smart power grids, Fuzzy decision making, Multi-objective ant lion optimizer, Fuzzy techniques, {MOALO}, Pareto Strategy, Virtual power, Virtual power player, Virtual Power Players ({VPP})},

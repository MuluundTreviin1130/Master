	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Wind power, Multi-objective optimization, Microgrid, optimization, Stochastic systems, Power generation, alternative energy, Cooling systems, energy resource, Electric energy storage, Stochastic models, Scheduling, energy storage, Energy storage system, Storage systems, Energy, Energy storage systems, Potable water, Demand-side management, Power markets, Stochastic programming, energy market, demand analysis, Energy conversion, stochasticity, Multi energy, hydroelectric power plant, Two-stage stochastic programming, multi-energy microgrid, Cooling water, power line, Energy-water nexus, Heating power},

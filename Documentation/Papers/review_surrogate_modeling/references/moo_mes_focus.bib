}

@article{lv_interactive_2016,
	title = {Interactive energy management of networked microgrids-based active distribution system considering large-scale integration of renewable energy resources},
	volume = {163},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84947901084&doi=10.1016%2fj.apenergy.2015.10.179&partnerID=40&md5=f19c8c56165b663d693814e822d60c79},
	doi = {10.1016/j.apenergy.2015.10.179},
	abstract = {Recently, large-scale renewable energy resources have been widely integrated into power systems. To optimize large-scale integration of these resources and improve the operation performance of the distribution system, this paper proposes a novel dynamic energy management strategy with the cooperative interaction of an energy system: a multi-grid connected microgrids ({MGs})-based active distribution system ({ADS}). A bi-level multi-objective optimization problem of the strategy is formulated with the active distribution network ({ADN}) in the upper level and {MGs} in the lower level. The interaction can be classified into two categories: the one between {MGs} and the {ADN} and the other one among {MGs}. The former is described by bi-level programming; the latter is innovatively explained by an interactive energy game matrix ({IEGM}) defined in this paper. The concept of the expanded energy storage system is defined and applied to the {IEGM} for the optimal operation of {ADSs}. The optimal operation includes improved technical performances in terms of power quality, energy utilization, adaptability and autonomy. The optimization problem is solved with a hybrid algorithm of Rough Set Theory-Hierarchical Genetic Algorithm-{NSGA}-{II}. Case studies of an {ADS} with different {MGs} and a real system would validate the efficiency of the proposed methodology. Results show that the proposed {EM} strategy can accurately quantify and guide the energy interaction among {MGs} and that between {MGs} and the {ADN}. Moreover, those technical performances of the {ADS} are improved. © 2015 Elsevier Ltd.},
	pages = {408--422},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Lv, T. and Ai, Q.},
	date = {2016},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power distribution, Energy management systems, Genetic algorithms, Energy utilization, genetic algorithm, Micro grid, Microgrids, Multi-objective optimization problem, optimization, distribution system, Energy management, Power generation, Energy conservation, energy resource, renewable resource, Energy storage systems, Energy resources, performance assessment, Resource management, Active distribution systems, technical efficiency, Active distribution network ({ADN}), Bi-level multi-objective optimization, Rough set theory, Active distribution system, Cooperative interactions, Dynamic energy managements, Game matrix, Hierarchical genetic algorithm},
}

@article{lv_bi-level_2016,
	title = {A bi-level multi-objective optimal operation of grid-connected microgrids},
	volume = {131},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84946124037&doi=10.1016%2fj.epsr.2015.09.018&partnerID=40&md5=f3b99716b3c4f1b73d2ef3ebe8ea0f04},
	doi = {10.1016/j.epsr.2015.09.018},
	abstract = {To obtain operation benefits of both distribution network ({DN}) and microgrids ({MGs}), a multi-objective bi-level optimal operation model for {DN} with grid-connected {MGs} is explained. Starting from forecast of load and generation in {MGs}, upper-level ({DN} level) model determines the optimal dispatch of {DN} to achieve its power loss reduction and voltage profile improvement. Lower-level ({MG} level) model accepts the dispatch requirements from upper-level and determines the optimal operation strategy of distributed generators in {MGs}. Their energy utilization is increased with the consideration of wind curtailment, solar curtailment and other factors such as environmental benefits. With the mutual influence and constraints between upper-level and lower-level model, {MGs} could accommodate the optimal dispatch of {DN}. To solve the bi-level model, a combination method based on self-adaptive genetic algorithm and non-linear programming is put forward. {IEEE} 33 {DN} with Europe typical {MGs} and a real system are presented to perform several simulations, and results show the over-all optimal operation schemes of both {DN} and {MGs} compared with traditional dispatch approach, thereby validating the efficiency of the proposed model. © 2015 Elsevier B.V. All rights reserved.},
	pages = {60--70},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Lv, T. and Ai, Q. and Zhao, Y.},
	date = {2016},
	keywords = {Multiobjective optimization, Electric power distribution, Genetic algorithms, Multi-objective optimization, Energy utilization, genetic algorithm, Micro grid, optimization, Distributed generators, Power loss reduction, Bi-level optimization, Nonlinear programming, Environmental benefits, Grid-connected microgrid, Optimal operation strategy, Voltage profile improvement, Self adaptive genetic algorithm},
}

@inproceedings{lv_optimal_2024,
	title = {Optimal Scheduling of Integrated Energy Microgrids Considering Demand Response and Hybrid Game Theory},
	isbn = {979-8-3503-4176-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207911955&doi=10.1109%2fEEE59956.2024.10709761&partnerID=40&md5=f0cd9ca148b91b5cb50519eb177a03b7},
	doi = {10.1109/EEE59956.2024.10709761},
	abstract = {This paper proposes a multi-objective optimization hybrid game model considering demand response and shared energy storage. Firstly, the Iterative Selforganizing Data Analysis Techniques Algorithm clustering method is used to cluster wind and solar scenarios. At this stage, the distribution network acts as the leader, and a leader-follower game model is constructed with comprehensive scheduling cost, net load variance, and integrated vulnerability as the objective functions. Secondly, considering the demand response of multiple microgrids and shared energy storage as followers, a cooperative game model is formed under optimized electricity pricing, with operational cost and environmental protection cost as the objective functions. To address the model characteristics, an improved Quantum Particle Swarm Optimization algorithm is used to solve the leader model, while the follower model is solved using the {CPLEX} solver. The results demonstrate that the proposed model can effectively stabilize alliance relationships and reduce the operational costs of microgrids and distribution networks, the validity of the proposed method has been demonstrated through empirical validation. © 2024 {IEEE}.},
	eventtitle = {Proceedings of 2024 International Conference on Energy and Electrical Engineering, {EEE} 2024},

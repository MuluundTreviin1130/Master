@inproceedings{mao_multi-objective_2010,
	title = {Multi-objective economic dispatch model for a microgrid considering reliability},
	isbn = {978-1-4244-5670-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-77956503408&doi=10.1109%2fPEDG.2010.5545765&partnerID=40&md5=1bb54c3bb81bb77c671e07304e80ced4},

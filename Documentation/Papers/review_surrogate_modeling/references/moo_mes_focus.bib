@article{li_multi-objective_2020-1,
	title = {Multi-objective Union Optimal Configuration Strategy for Multi-microgrid Integrated Energy System Considering Bargaining Games},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092651596&doi=10.13335%2fj.1000-3673.pst.2020.0289&partnerID=40&md5=e9288650a22db38ab42dfe6526a9af81},
	doi = {10.13335/j.1000-3673.pst.2020.0289},
	abstract = {A multi-microgrid integrated energy system ({MMGIES}) is formed by multiple microgrids ({MGs}) connected to the same power distribution system. When there is power interaction between the multiple {MGs}, challenges about planning and dispatching of the {MMGIES} come up with the intricate beneficial interactions among the multiple {MGs}. A multi-objective union optimized configuration strategy based on bargaining games is proposed for the {MMGIES} with power interactions. Grounded on the different typical scenes of {MMGIES}, a linearized bargaining game is first introduced to model the beneficial interactions between the multiple {MGs}. For the expected annualized total costs and the exergic efficiency of {MMGIES}, using Tchebycheff method to find the Pareto optimal front, the final optimized configuration plan is obtained by subjective and objective comprehensive weighting method which mixes the entropy coefficient method with the fuzzy analytical hierarchy process. The necessity and reasonability of introducing bargaining games into the analysis of the beneficial interactions of {MMGIES} with power interaction are finally proved as shown by the case study. Aiming at economy and exergic efficiency, the multi-objective optimized configuration plan takes the economic performance and high efficiency of energy cascade utilization as consideration, which performs better than those single-objective configuration plans. © 2020, Power System Technology Press. All right reserved.},
	pages = {3680--3688},
	number = {10},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Li, P. and Wu, D. and Li, Y. and Yin, Y. and Fang, Q. and Chen, B.},
	date = {2020},
	keywords = {Multiobjective optimization, Microgrids, Pareto principle, Multi-microgrid, game theory, Optimized configuration, Integrated energy systems, Integrated energy system, Economic performance, Pareto-optimal front, Power distribution system, Bargaining game, Entropy coefficients, Exergic efficiency, Fuzzy analytical hierarchy process, Muiti-agent, Multi-objective optimal configuration},
}

@inproceedings{li_optimal_2014-2,
	title = {Optimal operation of microgrid based on improved binary particle swarm optimization algorithm with double-structure coding},
	isbn = {978-1-4799-5032-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84925233437&doi=10.1109%2fPOWERCON.2014.6993632&partnerID=40&md5=dd59525785fa0615eff0e63526a6af8c},
	doi = {10.1109/POWERCON.2014.6993632},
	abstract = {Due to energy crisis and environmental concern, distributed generations including renewable energy sources have become popular in the electric energy industry. Microgrid is an effective technical means of the integration and access of distributed generations. On the basic of the generating characteristics of various microsources, this paper establishes a multi-objective optimal operation model with multiple constraints, aiming at minimizing the generation cost, pollutant emission cost, compensation cost of load shedding and network loss of microgrid. Different weights are assigned to the four sub-objective functions to transform the multi-objective optimization problem into a single objective optimization problem. Binary particle swarm optimization ({BPSO}) algorithm is improved with double-structure coding. Its performance is tested by two test functions and comparison with the traditional {BPSO} algorithm is made. The improved algorithm is applied to a microgrid simulation example which is in the island mode. Simulation results demonstrate the correctness of the proposed optimization model and the effectiveness of the improved algorithm. © 2014 {IEEE}.},
	pages = {3141--3146},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Li, P. and Xu, D.},
	date = {2014},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Particle swarm optimization ({PSO}), Micro grid, Microgrid, Microgrids, Multi-objective optimization problem, Distributed power generation, Energy policy, optimal operation, Environmental concerns, Single objective optimization problems, Electric load shedding, Binary particle swarm optimization, Double-structure coding, Improved binary particle swarm optimization algorithm},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 13},
}

@article{li_stochastic_2016,
	title = {Stochastic optimal operation of microgrid based on chaotic binary particle swarm optimization},
	volume = {7},
	issn = {19493053},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84960332900&doi=10.1109%2fTSG.2015.2431072&partnerID=40&md5=530bcee5c096113f2f5be8bbcfaecd58},
	doi = {10.1109/TSG.2015.2431072},
	abstract = {Based on fuzzy mathematics theory, this paper proposes a fuzzy multi-objective optimization model with related constraints to minimize the total economic cost and network loss of microgrid. Uncontrollable microsources are considered as negative load, and stochastic net load scenarios are generated for taking the uncertainty of their output power and load into account. Cooperating with storage devices of the optimal capacity controllable microsources are treated as variables in the optimization process with the consideration of their start and stop strategy. Chaos optimization algorithm is introduced into binary particle swarm optimization ({BPSO}) to propose chaotic {BPSO} ({CBPSO}). Search capability of {BPSO} is improved via the chaotic search approach of chaos optimization algorithm. Tests of four benchmark functions show that the proposed {CBPSO} has better convergence performance than {BPSO}. Simulation results validate the correctness of the proposed model and the effectiveness of {CBPSO}. © 2015 {IEEE}.},
	pages = {66--73},
	number = {1},

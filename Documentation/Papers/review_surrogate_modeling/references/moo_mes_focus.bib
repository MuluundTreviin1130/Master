	keywords = {Multiobjective optimization, Energy management systems, Energy efficiency, Energy utilization, optimization, Energy management, Costs, Scheduling, Electricity, {ECONOMICS}, energy market, game theory, Energy services, Service provider, operations technology, Operation strategy, Integrated energy systems, Integrated energy system, dynamic pricing, Energy efficiency improvement, Energy efficiency improvements, Game strategies, Source-load interactive, Stackelberg game, Stackelberg Games, Two-stage energy management},
}

@article{huang_capacity_2024,
	title = {Capacity Optimization Configuration for a Park-Level Hybrid Energy Storage System Based on an Improved Cuckoo Algorithm},
	volume = {12},
	issn = {2227-9717},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191408029&doi=10.3390%2fpr12040718&partnerID=40&md5=98c60126f608473b69764bac57759bc6},
	doi = {10.3390/pr12040718},
	abstract = {To promote the development of green industries in the industrial park, a microgrid system consisting of wind power, photovoltaic, and hybrid energy storage ({WT}-{PV}-{HES}) was constructed. It effectively promotes the local consumption of wind and solar energy while reducing the burden on the grid infrastructure. In this study, the analytic hierarchy process ({AHP}) was used to decompose the multi-objective function into a single-objective function. The economic and environmental benefits of the system were taken as the objective function. Furthermore, the cuckoo search algorithm ({CS}) was used to solve the specific capacity of each distributed power source. Different scenarios were applied to study the specific capacity of microgrid systems. The results show that the equivalent annual cost of the {WT}-{PV}-{HES} microgrid system is reduced by 7.3 percent and 62.23 percent, respectively. The carbon disposal cost is reduced by 1.71 and 2.38 times, respectively. The carbon treatment cost is more sensitive to load changes. The solution iteration of the cuckoo algorithm is 18 times. Meanwhile, the system requires four updates of capacity allocation results for 20 years of operation. This result validates the effectiveness of the proposed model and methodology. It also provides a reference for the research and construction of capacity allocation of microgrid systems at the park level. © 2024 by the authors.},
	number = {4},
	journaltitle = {Process.},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Huang, Z. and Bei, L. and Wang, B. and Xu, L.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Wind power, Multi-objective optimization, Objective functions, Carbon, energy storage, Microgrid systems, Solar energy, Iterative methods, Parks, Cost reduction, Industrial parks, Hybrid energy storage systems, Capacity allocation, Analytic hierarchy process, Hybrid energy storage, Capacity optimization, cuckoo algorithm, Specific capacities},
}

@article{huang_modeling_2019,

	journaltitle = {J. Mod. Power Syst. Clean Energy},
	publisher = {State Grid Electric Power Research Institute Nanjing Branch},
	author = {Sun, B. and Jing, R. and Ge, L. and Zeng, Y. and Dong, S. and Hou, L.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Multi-objective optimization, Microgrid, Distributed power generation, Electric energy storage, Hosting capacity, Electric power utilization, Distribution networks planning, Optimal dispatching, Smart distribution networks, Flexible resources, Distributed dispatching, distributed optimal dispatching, flexible resource, Smart distribution network, Smart distribution network ({SDN})},
}


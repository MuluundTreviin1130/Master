	date = {2010},
	keywords = {Multiobjective optimization, Renewable energy resources, Battery storage, Particle swarm optimization ({PSO}), Renewable energy, optimization, Hydrogen storage, Renewable energies, renewable resource, photovoltaic system, Photovoltaic, Photovoltaic effects, Demand-side management, Electric utilities, Particle swarm, Hydrogen, power plant, Particle swarm optimization, consumption behavior, Electric load forecasting, electrification, France, Lead, Remote consumer, Remote consumers},
}

@inproceedings{awan_economic_2017,
	title = {Economic dispatch in microgrids using compromise solution method},
	isbn = {978-1-5090-4237-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85034789667&doi=10.1109%2fPTC.2017.7981250&partnerID=40&md5=4d92d5a65dbd11d1de8396f108fdfbec},
	doi = {10.1109/PTC.2017.7981250},
	abstract = {In this paper, we evaluate a multi-objective-moving-horizon-optimization ({MO}-{MHO}) approach as an instrument for improvement of economic dispatch in microgrids. In particular, we investigate the effect of adaptation of the multi-objective optimization strategy used in the moving horizon framework on the end result of the economic dispatch. Power dispatch in microgrids is inherently a high-dimensional problem often cast as a mixed-integer stochastic program with conflicting objectives. Implied is the fact that exhaustive exploration of the whole Pareto front in a related multi-objective approach is not a computationally tractable decision tool. It is thus argued that it is preferable to represent the problem as a bi-objective optimization problem with the two costs grouping the least conflicting components. The solution method for the optimization problem over a window 'looking into the future' can then be selected or adjusted in real time by employing an independent set of assessment functions evaluated along the trajectories of optimal multi-objective solutions already implemented over a window in the past. The proposed strategy is applied to a case study of a remote microgrid. Its performance is evaluated based on simulation results that suggest that choosing the compromise solution of the {MO}-{MHO} problem may be superior to the usual scalarization methods. © 2017 {IEEE}.},
	eventtitle = {2017 {IEEE} Manchester {PowerTech}, Powertech 2017},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Awan, F. and Michalska, H. and Joos, G.},
	date = {2017},
	keywords = {Multiobjective optimization, Electric load dispatching, Micro grid, Microgrids, optimization, Optimization problems, Distributed power generation, Stochastic systems, distributed generation, Scheduling, Integer programming, Conflicting objectives, Bi-objective optimization, Economic dispatch, High-dimensional problems, Moving horizon optimization, Scalarization method},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 4},
}

@article{azamian_developing_2025,
	title = {Developing an optimal energy system model for a sustainable urban transportation framework planning in the long term through different climatic zones},
	volume = {3},
	issn = {29497361},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209885642&doi=10.1016%2fj.grets.2024.100151&partnerID=40&md5=4f92ae30c6e577ed4b6b2d68f66dcef0},
	doi = {10.1016/j.grets.2024.100151},
	abstract = {The modern lifestyle highlights the demand for an improved urban transportation infrastructure and a shift to renewable, efficient technologies. This evolution is essential for both developed and developing countries. The transportation system in a developing country such as Iran faces significant challenges, including low energy efficiency and high emissions. This situation makes the development of a sustainable transportation plan increasingly critical. Furthermore, there is considerable potential for renewable energy across various climatic zones in the country that should be utilized. This study presents a sustainable development model for the transportation system that incorporates zero-emission vehicles and renewable energy supply technologies in competition with traditional ones. The model is designed for long-term application and includes five case studies from various climatic zones in Iran, each featuring different renewable potentials and system scales. Determining the optimal structure of the system in each case study requires solving a linear, dynamic, and multi-criteria optimization problem. The objective function focuses on minimizing total costs, which include technological, energy, and social. All case studies indicate that developing a sustainable transportation system is optimal. However, larger case studies tend to produce more favorable optimization outcomes. According to the results, the scale of the case study is the most important factor in this research. © 2024 The Authors},
	number = {2},
	journaltitle = {Green. Technol. Sustain.},
	publisher = {{KeAi} Communications Co},
	author = {Azamian, S.},
	date = {2025},
	keywords = {Multi-criteria optimization, Electric vehicle, transportation, Fuel cell vehicle, Sustainable energy development, Zero-emission system},
}

@article{azaza_multi_2017,
	title = {Multi objective particle swarm optimization of hybrid micro-grid system: A case study in Sweden},
	volume = {123},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85011948998&doi=10.1016%2fj.energy.2017.01.149&partnerID=40&md5=b0af9486554e9e44d5251e3df80516b4},
	doi = {10.1016/j.energy.2017.01.149},
	abstract = {Distributed energy resources {DERs} are small scale energy system which could provide local supply when placed at customers' premises. They aggregate multiple local and diffuse production installations, consumer facilities, storage facilities and monitoring tools and demand management. The main challenges when assessing the performance of an off-grid hybrid micro-grid system {HMGS} are the reliability of the system, the cost of electricity production and the operation environmental impact. Hence the tradeoff between three conflicting objectives makes the design of an optimal {HMGS} seen as a multi-objective optimization task. In this paper, we consider the optimization and the assessment of a {HMGS} in different Swedish cities to point out the potential of each location for {HMGS} investment. The {HMGS} consists of photovoltaic panels, wind turbines, diesel generator and battery storage. The {HMGS} model was simulated under one-year weather conditions data. A multi objective particle swarm optimization is used to find the optimal system configuration and the optimal component size for each location. An energy management system is applied to manage the operation of the different component of the system when feeding the load. The techno economics analysis shows the potential of {HMGS} in the Swedish rural development. © 2017 Elsevier Ltd},
	pages = {108--118},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Azaza, M. and Wallin, F.},
	date = {2017},
	keywords = {Multiobjective optimization, Energy management systems, Multi-objective optimization, Particle swarm optimization ({PSO}), Renewable energy, Environmental impact, Micro grid, optimization, Sensitivity analysis, Economic analysis, Renewable energies, energy resource, renewable resource, Photovoltaic cells, Wind turbines, algorithm, cost analysis, Digital storage, Investments, photovoltaic system, Energy resources, performance assessment, Multi objective particle swarm optimization, Conflicting objectives, distributed energy resources, {ECONOMICS}, wind turbine, installation, Particle swarm optimization, urban area, Cost of electricity productions, {DERs}, Equipment, Hybrid micro-grid, Optimal system configuration, Regional planning, rural development, Sweden},
}

@inproceedings{azeim_soliman_optimized_2018,
	title = {Optimized hybrid microgrid of gas generators-wind farm using crow search algorithm},
	isbn = {978-1-5386-1876-9},

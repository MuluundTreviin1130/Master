}

@article{huang_achieving_2024,
	title = {Achieving energy independence in urban microgrids: Strategies for domestic resource utilization and environmental sustainability},
	volume = {101},
	issn = {2210-6707},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182905871&doi=10.1016%2fj.scs.2023.105158&partnerID=40&md5=dea6cd26714403e0d60c90c50448be63},
	doi = {10.1016/j.scs.2023.105158},
	abstract = {The quest for energy independence within urban microgrids ({MGs}) has become increasingly crucial for ensuring domestic resource utilization and environmental sustainability. One of the pivotal challenges lies in the clustering of {MGs}, a complex task aimed at enhancing their robustness and economic performance during events. However, limited research has been conducted on this intricate clustering problem. This study addresses this gap by proposing an artificial intelligence-based method tailored for {MG} clustering. In this paper, we introduce a novel multi-objective optimization approach to determine the optimal clustering of standalone {MGs}. Our methodology considers a range of critical parameters, including distributed generation ({DG}) droop settings, {DG} locations and capacities, renewable energy resources from solar units and wind turbines, capacitors, and power transmission lines. By minimizing power losses and enhancing voltage stability, we identify a virtual cut-set line, often referred to as the "virtual line," characterized by minimal power exchange between clustered {MGs}. To achieve optimal and cost-effective performance, we develop an enhanced differential genetic evolution algorithm designed to address multi-objective problems within stringent constraints. Additionally, we employ Bayesian theory within artificial intelligence to estimate the optimal output power of renewable energy sources, specifically wind turbines and solar panels. To validate the effectiveness of our approach, we apply it to a 69-bus {MG} across various scenarios. Our findings demonstrate the proficiency of our method in achieving energy independence, domestic resource utilization, and environmental sustainability within urban microgrids. © 2023},
	journaltitle = {Sustainable Cities Soc.},
	publisher = {Elsevier Ltd},
	author = {Huang, H. and Wei, L. and Liu, D. and Feng, B. and Deng, M. and Liu, W. and Xie, X.},
	date = {2024},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission, Renewable energy, genetic algorithm, Microgrid, Cost effectiveness, Sustainable development, Solar panels, alternative energy, Renewable energies, Wind turbines, Sustainability, Environmental sustainability, energy use, Clusterings, Artificial intelligence, urban area, Urban energy, Energy independence, prediction, Microgrid cluster, Domestic resources, power line, Resources utilizations, Virtual modeling, Virtual models},
}

@article{huang_economic_2024,
	title = {Economic Optimization Scheduling Strategy for Offshore Fishing Raft Microgrid Clusters},
	volume = {12},
	issn = {21693536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192994110&doi=10.1109%2fACCESS.2024.3398808&partnerID=40&md5=9e763dd6134adf92ef25d2dbb30a54df},
	doi = {10.1109/ACCESS.2024.3398808},
	abstract = {As a renewable energy solution for remote marine environments, marine raft microgrid clusters differ from terrestrial multi-microgrid systems and traditional single-island microgrids. In the absence of large-scale grid support, these marine raft microgrids must maintain the stability and economic efficiency of power supply within a collaborative multi-microgrid context. To address this, a multi-objective optimization approach for energy scheduling is proposed. This study initially constructs a microgrid cluster system model and introduces two economic objective functions. These functions consider both inter-microgrid power scheduling and the economic benefits of power procurement. By applying the Non-dominated Sorting Genetic Algorithm {II} ({NSGA}-{II}) and the Constraint-based Multi-objective Evolutionary Algorithm based on Decomposition ({CMOEA}/D) to solve the objective functions, the results indicate that the {CMOEA}/D algorithm demonstrates high efficiency and accuracy in pursuing economically optimal solutions. Compared to the {NSGA}-{II} algorithm, {CMOEA}/D outperforms in terms of the quality of optimal solutions and iteration time, thereby enhancing the economic benefits of the microgrid cluster and validating the effectiveness of the proposed model. This research provides significant theoretical and practical guidance for energy management in remote marine environments, showcasing its profound theoretical significance and application value.  © 2013 {IEEE}.},
	pages = {76986--76994},
	journaltitle = {{IEEE} Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Huang, J. and Guo, H. and Luo, H.},
	date = {2024},

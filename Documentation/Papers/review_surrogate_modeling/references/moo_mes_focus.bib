	editor = {Wang, M. and He, F. and Liu, H. and Chen, P. and Tang, Y. and Yu, H.},
	date = {2019},
	keywords = {Renewable energy resources, Multi-objective optimization, Stochastic programming, {MINLP}, building integrated energy system},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}


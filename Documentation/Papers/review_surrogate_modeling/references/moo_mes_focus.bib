@article{brahman_optimal_2015,
	title = {Optimal electrical and thermal energy management of a residential energy hub, integrating demand response and energy storage system},
	volume = {90},
	issn = {0378-7788},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84921518001&doi=10.1016%2fj.enbuild.2014.12.039&partnerID=40&md5=6f5d8664031effe100a8444f8710494d},
	doi = {10.1016/j.enbuild.2014.12.039},
	abstract = {Energy crisis along with environmental concerns are some principal motivations for introducing "energy hubs" by integrating energy production, conversion and storage technologies such as combined cooling, heating and power systems ({CCHPs}), renewable energy resources ({RESs}), batteries and thermal energy storages ({TESs}). In this paper, a residential energy hub model is proposed which receives electricity, natural gas and solar radiation at its input port to supply required electrical, heating and cooling demands at the output port. Augmenting the operational flexibility of the proposed hub in supplying the required demands, an inclusive demand response ({DR}) program including load shifting, load curtailing and flexible thermal load modeling is employed. A thermal and electrical energy management is developed to optimally schedule major household appliances, production and storage components (i.e. {CCHP} unit, {PHEV} and {TES}). For this purpose, an optimization problem has been formulated and solved for three different case studies with objective function of minimizing total energy cost while considering customer preferences in terms of desired hot water and air temperature. Additionally, a multi-objective optimization is conducted to consider consumer's contribution to {CO}2, {NOx} and {SOx} emissions. The results indicate the impact of incorporating {DR} program, smart {PHEV} management and {TES} on energy cost reduction of proposed energy hub model. © 2014 Elsevier B.V. All rights reserved.},
	pages = {65--75},
	journaltitle = {Energy Build.},
	publisher = {Elsevier Ltd},
	author = {Brahman, F. and Honarmand, M. and Jadid, S.},
	date = {2015},
	keywords = {Multiobjective optimization, Renewable energy resources, optimization, Energy management, Carbon dioxide, Cooling systems, Housing, Electric energy storage, Energy hub, Energy hubs, Energy policy, Heat storage, Demand response programs, energy storage, Energy storage systems, Energy resources, Hybrid vehicles, Thermal energy, Thermal energy storage, heating, Cost reduction, Demand response, Cooling, Storage management, Combined cooling heating and power, Domestic appliances, Demand response ({DR}), Combined cooling heating and power ({CCHP}), Electrical energy management, Environmental concerns, Environmental technology, Operational flexibility, Plugged in hybrid electric vehicle, Sun},
}

@inproceedings{bremer_hybridizing_2019,
	title = {Hybridizing S-Metric Selection and Support Vector Decoder for Constrained Multi-objective Energy Management},
	isbn = {21945357},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064880934&doi=10.1007%2f978-3-030-14347-3_24&partnerID=40&md5=aa3cbdd0f9cf14114e9c36e6498f7adc},

@inproceedings{ramsami_multi-objective_2020,
	title = {Multi-Objective Optimisation of Photovoltaic Systems and Unified Power Quality Conditioners with Simultaneous Distribution Network Reconfiguration},
	isbn = {978-1-7281-5707-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099566726&doi=10.1109%2fELECOM49001.2020.9297033&partnerID=40&md5=ddbf88528a5e3dc519debd1d448ab7ec},
	doi = {10.1109/ELECOM49001.2020.9297033},
	abstract = {Nowadays, renewable energy sources are being increasingly integrated to power systems. This research analyses various cases of distribution network reconfiguration ({DNR}) as well as the placement and sizing of photovoltaic ({PV}) systems and unified power quality conditioners ({UPQC}). Non-dominated Sorting Genetic Algorithm-{II} ({NSGA}-{II}), Strength Pareto Evolutionary Algorithm-2 ({SPEA}2) and Multi-objective Evolutionary Algorithm based on Decomposition ({MOEA}/D) were applied to minimise the active power loss, voltage deviation and total cost subject to constraints. The efficacy of the three algorithms was analysed according to their simulation time and performance metrics. The simulation results revealed that the integration of {PV} systems and {UPQC} with the simultaneous reconfiguration of the network produces acceptable compromises among the objective functions. {NSGA}-{II} outperformed the other algorithms in terms of simulation time at the expense of a minor deterioration in the quality of the solutions in some cases. With equal importance of each objective, smaller {PV} systems are required to achieve the optimal solution when {UPQCs} are present in the distribution system. The integration of {UPQC} with simultaneous {DNR} further reduces the size of {PV} systems required. © 2020 {IEEE}.},
	eventtitle = {2020 3rd International Conference on Emerging Trends in Electrical, Electronic and Communications Engineering, {ELECOM} 2020 - Proceedings},
	pages = {191--197},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Ramsami, P. and Ah King, R.T.F.},
	editor = {{Pudaruth S.} and {Mungur A.} and {Ah King R.T.F.} and {Fowdur T.P.} and {Bojkovic Z.} and {Milovanovic D.} and {Hurbungs V.}},
	date = {2020},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Genetic algorithms, Power quality, Distribution systems, distribution network reconfiguration, Non dominated sorting genetic algorithm ii ({NSGA} {II}), Multi-objective optimisation, Photovoltaic cells, Photovoltaic systems, Multi objective evolutionary algorithms, Distributed generation units, Strength pareto evolutionary algorithm, Unified power quality conditioners, Deterioration, Custom power devices},

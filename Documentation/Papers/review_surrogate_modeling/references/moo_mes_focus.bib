	keywords = {Multiobjective optimization, Renewable energy resources, Genetic algorithms, Design, Hybrid renewable energy systems, Intelligent systems, Monte Carlo methods, Multi-objective optimisation, Wind, Photovoltaic cells, Wind turbines, Hybrid Renewable Energy System ({HRES}), Non dominated sorting genetic algorithm ({NSGA} {II}), {NSGA}-{II}, Reliability, Constrained optimization, Multi-objective problem, Decision support systems, Computer programming, Hybrid wind, Chance Constrained Programming, Chance-constrained programming, Design under uncertainties, Design under uncertainty, Standalone hybrid wind-{PV}-battery},
}


}

@inproceedings{pudaruth_s_nature-inspired_2020,
	title = {Nature-inspired search method for cost optimization of hybrid renewable energy generation at the edge},
	isbn = {978-1-7281-6770-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092018841&doi=10.1109%2ficABCD49160.2020.9183811&partnerID=40&md5=c265f17723e1afff2d3439da9dc0b0cf},
	doi = {10.1109/icABCD49160.2020.9183811},
	abstract = {The global deficient in energy generation has called for innovative ways of energy generation. Currently, renewable energy is one of such innovation which is based of producing energy from wind and/or solar. However, generating and harvesting renewable energy is challenged in terms of the economic cost of energy generation to meet demand of users. In this study, we consider the problem of renewable energy generating as a multi-objective optimization problem which is subject to constraints such as cost. The study attempts to solve this problem by proposing a novel nature-inspired Social Spider-Prey ({SSP}) hunting technique to optimize the economic cost of hybrid renewable energy generation systems. The experimental results show a reduction cost of approximately 0.05 {US} Dollars in renewable energy generation. © 2020 {IEEE}.},

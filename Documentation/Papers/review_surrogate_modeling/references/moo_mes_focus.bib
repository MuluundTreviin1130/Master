@article{cheng_dynamic_2017,
	title = {Dynamic dispatch optimization of microgrid based on a {QS}-{PSO} algorithm},
	volume = {9},
	issn = {19417012},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85027340774&doi=10.1063%2f1.4995646&partnerID=40&md5=72afb2b5107c73cea519014cb8e0aacc},
	doi = {10.1063/1.4995646},
	abstract = {A microgrid ({MG}) has been regarded as an efficient way for integrating distributed generation sources ({DGSs}) into distribution systems, and the corresponding effective energy management is crucial to realize the benefits associated with {MG}. In general, most of the researches ignored the inherent coupling among the dispatch intervals. This study aims to establish a dynamic dispatch optimization model for reasonably scheduling the {DGSs} in the {MG} and to identify the optimal solution based on a swarm intelligence algorithm. With the introduction of the dynamic system theory, a dynamic multi-objective optimization model is established for minimizing the operation and maintenance cost of the {MG}, decreasing the pollutant emissions, and reducing the deprivation cost of the {DGSs}. In order to deal with this complex optimization problem with high-dimension variables and multiple constraints, an enhanced quorum sensing based particle swarm optimization ({QS}-{PSO}) algorithm, whose competitiveness has been verified, is successively applied for determining the optimal dispatch solution of the whole period, instead of dividing the entire dispatch period into a number of small time intervals via a static optimization approach. The results based on a series of numerical simulations validate the effectiveness of the proposed dispatching model and {QS}-{PSO} application and demonstrate the superiority of dynamic operation optimization over the static optimization. © 2017 Author(s).},
	number = {4},
	journaltitle = {J. Renewable Sustainable Energy},
	publisher = {American Institute of Physics Inc},
	author = {Cheng, S. and Su, G. C. and Zhao, L. L. and Huang, T. L.},
	date = {2017},
	keywords = {Multiobjective optimization, Evolutionary algorithms, Particle swarm optimization ({PSO}), optimization, Distribution systems, Optimization modeling, Operation and maintenance, Complex optimization problems, Distributed generation source, Dynamic multiobjective optimization, Static optimization, Swarm intelligence algorithms},
}

@article{cheng_bi-level_2022,
	title = {Bi-level multi-objective optimization of a new energy microgrid with electric vehicles},
	volume = {50},
	issn = {16743415},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136510844&doi=10.19783%2fj.cnki.pspc.211149&partnerID=40&md5=669bce2b82e897c3f7d0beaf7c0d9312},
	doi = {10.19783/j.cnki.pspc.211149},
	abstract = {Electric vehicles ({EVs}) and the New Energy Microgrid ({NEMG}) belong to different stakeholders. There can be economic operational problems after {EVs} are connected to an {NEMG}. A mathematical model of {NEMG} multi-objective hierarchical scheduling considering {EV} orderly charge and discharge behavior and owner’ comprehensive satisfaction is established, and calculation method for analysis is proposed. The {EV} layer aims to maximize the comprehensive satisfaction of the vehicle owner. The {EV} charge and discharge plan is established by {CPLEX} software and transmitted to the {NEMG} layer. The {NEMG} layer adjusts the output of controllable distributed generation in the microgrid based on the {EV} charge and discharge plan to minimize the comprehensive cost of system and interactive power fluctuation. To analyze the high-dimensional, nonlinear and multi-objective model, a multi-objective particle swarm optimization algorithm of a three-black-hole-system capture based on reliability is presented. The simulation results show that the layered architecture of the microgrid with {EV} can achieve mutual benefit and win-win of {EV} and {NEMG} compared with a non-layered architecture. This verifies the validity and effectiveness of the proposed method. © 2022 Power System Protection and Control Press. All rights reserved.},
	pages = {63--71},
	number = {12},
	journaltitle = {Dianli Xitong Baohu yu Kongzhi},
	publisher = {Power System Protection and Control Press},
	author = {Cheng, S. and Wang, Y. and Liao, W. and Zuo, X. and Dai, J.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Particle swarm optimization ({PSO}), Microgrid, Microgrids, Electric discharges, Electric vehicles, Electric vehicle, Multi objective particle swarm optimization, Operational problems, Multi-objective particle swarm optimization, Charge and discharge, Layered architecture, layered optimization, New energies, new energy microgrid, satisfaction},
}


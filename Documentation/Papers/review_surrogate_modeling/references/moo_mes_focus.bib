	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: F. Boutros; Saint-Joseph University of Beirut, {ESEO}, {IREENA} Lab {UR} 4642, Angers, 10 Bd Jeanneteau, 49100, France; email: fouad.boutros@eseo.fr},
}


	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Multi-objective optimization models, Carbon dioxide, Power generation, System Integration, Cogeneration plants, {CCHP}, {CHP}, Household applications, Integration levels, {MATHEMATICAL} {MODELS}, Thermal solar, Thermal solar plants},

	date = {2019},
	keywords = {Resilience, optimal dispatch, multi-objective weighted fuzzy programming, district integrated energy system},
}

@inproceedings{qi_improvement_2017,
	title = {An improvement of the optimal capacity and economic analysis of micro-grid on island},
	isbn = {978-0-692-94690-9},

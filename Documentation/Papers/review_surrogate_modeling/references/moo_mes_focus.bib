	isbn = {978-1-7281-5572-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100153671&doi=10.1109%2fIREC48820.2020.9310451&partnerID=40&md5=2e2e9fc6992cdabb4104fce8eee1a1a5},

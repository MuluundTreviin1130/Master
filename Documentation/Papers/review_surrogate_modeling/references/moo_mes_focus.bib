}

@inproceedings{luo_chaos-adaptive_2020,
	title = {{CHAOS}-{ADAPTIVE} {MULTI}-{OBJECTIVE} {PSO} {ALGORITHM} {FOR} {MICROGRID} {OPTIMIZATION} {SCHEDULING}},
	isbn = {27324494},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216862313&doi=10.1049%2ficp.2024.2307&partnerID=40&md5=d4e7acdd6e51985819ddc14be3e2d6ef},
	doi = {10.1049/icp.2024.2307},
	abstract = {To enhance the economic and environmental benefits of daily microgrid operations and address the optimization accuracy challenges in particle swarm optimization ({PSO}) algorithms, a chaotic adaptive multi-objective particle swarm algorithm is proposed. Firstly, the Logistical chaotic mapping is introduced to generate the initial population, enhancing population diversity. Secondly, based on chaotic theory, the control factor y adaptively adjusts the chaotic search range, and the algorithm's adaptability is further improved through the adaptive adjustment of the inertia weight parameter ω and acceleration coefficients c1, c2. The proposed algorithm is simulated using six typical test functions, demonstrating superior performance in terms of optimization accuracy, solution stability, and convergence speed compared to heuristic algorithms such as the grey wolf algorithm. Finally, the enhanced {PSO} algorithm is applied to solve multi-objective optimization and scheduling problems in microgrid integration. Simulation results indicate that the algorithm effectively enhances the overall benefits of daily microgrid operations. © The Institution of Engineering \& Technology 2024.},

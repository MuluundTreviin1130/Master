}

@inproceedings{li_multi-objective_2017,
	title = {Multi-objective optimal operation of combined cooling, heating and power microgrid},
	isbn = {978-1-5386-1427-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85047241751&doi=10.1109%2fEI2.2017.8245310&partnerID=40&md5=bf77e69269614c9a4a33a728ebfb9438},
	doi = {10.1109/EI2.2017.8245310},
	abstract = {In order to improve the energy utilization rate and ensure the economic operation of the microgrid, it is necessary to optimize the configuration of the micro-power supply under the conditions of the safety, stability and reliable operation of microgrid. Firstly, take the the daily operation cost, the daily environment cost and the primary energy rate as the goals. An multi-objective optimization model is established for microgrid operation, considering the constraints of energy balances and devices output power. Then, based on the principle of maximum membership, the fuzzy optimization method is used to transform the multi-objective optimization problem into a nonlinear single objective optimization problem. What's more, a new hybrid particle swarm optimization algorithm is proposed to solve the model. Finally, taking a typical summer day of a district as an example, solve the nonlinear programming model by the algorithm. The optimal outputs of each micro-source in a day are obtained, providing guidances for microgrid economic scheduling. The rationality and practicability of the model and algorithm are verified via analyzing the optimization results. © 2017 {IEEE}.},
	pages = {1--6},

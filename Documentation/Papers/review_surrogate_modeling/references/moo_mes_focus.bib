	keywords = {Renewable energy, optimization, Optimisations, alternative energy, Renewable energies, Sustainability, performance assessment, Combined heat and power, Energy-based, Rankine cycle, thermodynamics, power plant, Performance optimizations, Geothermal, Geothermal energy, Rankine, Geothermal system, Heating capacity, Net power outputs, Transcritical {CO}, Transcritical {CO}2},
}

@article{leone_multi-objective_2022,
	title = {Multi-Objective Optimization of {PV} and Energy Storage Systems for Ultra-Fast Charging Stations},
	volume = {10},
	issn = {21693536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124083235&doi=10.1109%2fACCESS.2022.3147672&partnerID=40&md5=f85bf736a5b461f10abee281a6b5db4c},
	doi = {10.1109/ACCESS.2022.3147672},
	abstract = {The installation of ultra-fast charging stations ({UFCSs}) is essential to push the adoption of electric vehicles ({EVs}). Given the high amount of power required by this charging technology, the integration of renewable energy sources ({RESs}) and energy storage systems ({ESSs}) in the design of the station represents a valuable option to decrease its impact on the grid and the environment. Therefore, this paper proposes a multi-objective optimization problem for the optimal sizing of photovoltaic ({PV}) system and battery {ESS} ({BESS}) in a {UFCS} of {EVs}. The proposed multi-objective function aims to minimize, on one side, the annualized cost of the station, and on the other side, the produced pollutant emissions. The decision variables are the number of {PV} panels and the capacity of the {ESS} to be installed. The optimization problem is reduced to a single-objective problem by applying the linear scalarization method. Then the equivalent single-objective function is optimized through a genetic algorithm ({GA}). The proposed optimization framework is applied to a study case and the results prove that {PV} and {ESS} could lead to a significant reduction of both the annualized cost and the pollutant emissions. Finally, a sensitivity analysis is also presented to validate the effectiveness of the proposed solution. © 2013 {IEEE}.},
	pages = {14208--14224},
	journaltitle = {{IEEE} Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Leone, C. and Longo, M. and Fernandez-Ramirez, L. M. and Garcia-Trivino, P.},
	date = {2022},
	keywords = {Multiobjective optimization, Renewable energy resources, Genetic algorithms, Pollution, Sensitivity analysis, Electric vehicles, Charging (batteries), energy storage, Storage systems, Charging station, Load demand, Bi-objective optimization, Solar cells, Fast charging, Charging loads, Extreme fast charging, fast-charging load demand, integrated charging station},
}


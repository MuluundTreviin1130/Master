	author = {Makhdoomi, S. and Askarzadeh, A.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric batteries, Multi-objective optimization, Cost effectiveness, Photovoltaics, Hybrid energy system, Levelized costs, Pumped storage power plants, Pollutants emissions, Pumped hydro storage, Cost of energies, Solar tracker, Economic feasibility assessment, techno-enviro-economic feasibility assessment},
}


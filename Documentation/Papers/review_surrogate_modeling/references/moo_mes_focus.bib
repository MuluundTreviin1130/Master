}

@article{guo_capacity_2024,
	title = {The capacity optimization and techno-economic analysis of stand-alone hybrid renewable energy systems based on a two-stage nested optimization approach},
	volume = {85},
	issn = {2352152X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186519098&doi=10.1016%2fj.est.2024.111143&partnerID=40&md5=9cbef500ea7ce6b9d0334a482e4a0990},
	doi = {10.1016/j.est.2024.111143},
	abstract = {For a stand-alone renewable energy system, the configuration with an appropriate energy storage system can effectively cope with the power output volatility of renewable sources such as solar and wind energy, and ultimately improve the power supply reliability. In this paper, in order to optimize the capacity of stand-alone hybrid renewable energy systems ({HRESs}) respectively coupled with battery ({BAT}), hydrogen energy storage system ({HESS}) and thermal energy storage system ({TESS}), a two-stage nested optimization approach is proposed by combining multi-objective optimizer and single-objective optimizer. In the first stage, the multi-objective optimizer is employed for the capacity optimization of {HRESs} with different topologies by considering the economic cost and power supply reliability (i.e., the levelized cost of energy ({LCOE}) and loss of load supply probability ({LPSP})) simultaneously, and the optimal results are obtained by using Multiple Criteria Decision-making method. In the second stage, while taking {LCOE} as the only objective function and {LPSP} in the best optimal results obtained in the first stage as the constraint condition, the single-objective optimizer is employed to further optimize the capacity of various {HRESs}. The case study shows that when the {HRESs} are used to supply the annual load demand of 86.27 {MWh}, the optimal capacity configurations obtained by the proposed two-stage nested optimization approach are 76 {kW} {PV}, 162.87 {kWh} {BAT} with {LPSP}=0.0984 and {LCOE}=0.3228 \$/{kWh} for the {PV}/{WT}/{BAT} hybrid system; 159.2 {kW} {PV}, 58 {kW} {EL}, 23 {kW} {FC}, 788 {kWh} {HST} with {LPSP}=0.053 and {LCOE}=0.7675 \$/{kWh} for the {PV}/{WT}/{HESS} hybrid system; 177.6 {kW} {PV}, 73 {kW} {EH}, 52 {kW} {PB}, 806 {kWh} {TEST} with {LPSP}=0.0161 and {LCOE}=0.5594 \$/{kWh} for the {PV}/{WT}/{TESS} hybrid system, respectively. Meanwhile, compared to the results obtained by using multi-objective optimization alone, the {LCOE} decreases by 0.0001 \$/{kWh}, 0.0031 \$/{kWh}, and 0.0417 \$/{kWh}, respectively, without depressing the reliability. Furthermore, identical conclusions can be obtained from the sensitivity analysis for different solar irradiance, load profiles and equipment prices, which demonstrates the effectiveness and superiority of the proposed approach. © 2024 Elsevier Ltd},
	journaltitle = {J. Energy Storage},
	publisher = {Elsevier Ltd},
	author = {Guo, Y. and Niu, Y.},
	date = {2024},
	keywords = {Multiobjective optimization, Wind power, Renewable energy, Decision making, Economic analysis, Hybrid systems, Hydrogen storage, Costs, Renewable energies, Heat storage, Energy storage system, Storage systems, Energy systems, Levelized costs, Capacity optimization, Multiple criteria decision making, Cost of energies, Decision-making method, Multiple criteria decision-making method},
}

@article{guo_multi-objective_2024,
	title = {Multi-objective optimization of multi-energy complementary system based on cascade utilization of heat storage},
	volume = {299},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85176316068&doi=10.1016%2fj.enconman.2023.117864&partnerID=40&md5=0d4b9f554c230fc12a432040df0e9bde},
	doi = {10.1016/j.enconman.2023.117864},
	abstract = {A multi-energy complementary system driven by solar energy and central grid is proposed to supply electricity and cooling/heating, in which a dual-tank thermal storage system is integrated to achieve cascaded solar heat energy utilization. The system integrates parabolic trough solar collectors, high-temperature and low-temperature thermal storage tanks, and an organic Rankine cycle to form an operational loop. The low-temperature thermal storage tank drives an absorption heat pump independently. Excess photovoltaic power drives the ground source heat pump for heating/cooling. Three indicators are defined and compared to show the renewable energy penetration rate in the complementary system. A multi-objective optimization model considering economic performance and renewable energy rate is constructed to optimize the system configurations. Three sets of objective functions are compared through the optimization Pareto frontiers. Then, the {TOPSIS} method is employed to select the optimum configuration through setting different weights of optimization objectives. Compared with the reference system, the proposed multi-energy complementary system improves the energy, economic and environmental benefits by 59.21\%, 24.27\% and 11.31\%, respectively. Through a variety of equipment ({PV}, {ORC}, {AHP}, {TES}), solar energy supplies 86.2\% and 72.2\% of total electricity and heat loads, respectively. © 2023 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Guo, Z. and Wang, J. and Dong, F. and Xu, H.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy supplies, Multi-objective optimization, Energy utilization, Renewable energies, Heat storage, Electric loads, Solar energy, Temperature, Rankine cycle, Solar heating, Thermal storage, Geothermal energy, Complementary systems, Multi-energy complementary system, Tanks (containers), Geothermal heat pumps, Multi energy, Dual-tank thermal storage, Renewable energy supply rate, Supply rate},
}

@article{gupta_novel_2024,
	title = {A Novel Multi-Objective Protection Coordination Scheme for a Microgrid with Optimal Deployment of Dual-Setting {ROCOV} Based Relays},
	volume = {9},
	issn = {23672617},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198039068&doi=10.23919%2fPCMP.2023.000425&partnerID=40&md5=74bea1a2d76093b39aeb4db4f6a1ac43},
	doi = {10.23919/PCMP.2023.000425},
	abstract = {Relay coordination is crucial in electrical power systems to protect against malfunctions and damage caused by unexpected events like short circuits. To address the challenge associated with the reverse direction of fault current, dual-setting ({DS}) directional over-current relays have evolved but failed to provide proper coordination during changes of load, generation, and network. In the meantime, with the increasing number of {DS} relays, the total relay operating time tends to saturate. Therefore, this paper proposes a protection scheme based on the optimal deployment of conventional and dual-setting rate of change of voltage ({DS}-{ROCOV}) relays in distribution systems. This holds true for varying network topologies and is unaffected by variations in load and generation. The objective of the proposed scheme is to ensure reliable and efficient protection against faults in distribution systems by minimizing the overall operating time with the optimal number of {DS}-{ROCOV} relays. The proposed protection scheme's performance is evaluated for different coordination time interval values as well as in different microgrid scenarios. This paper outlines the design and implementation of the proposed protection scheme which is validated on the modified {IEEE} 14-bus system using simulations in Matlab/Simulink. © 2019 Power System Protection and Control Press.},
	pages = {23--38},
	number = {4},
	journaltitle = {Prot. Cont. Mod. Power Sys.},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Gupta, P. K. and Niranjan, P. and Choudhary, N. K. and Singh, N. and Singh, R. K.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power distribution, Multi-objective optimization, Microgrid, Electric loads, Electric power system protection, Protection coordination, Relay protection, Coordination time interval, {DS}-{ROCOV} relay, Dual-setting, Dual-setting-{ROCOV} relay, Operating time, optimal deployment, optimal-deployment, Protection schemes, Simulink, Time interval},
}

@inproceedings{gusain_optimal_2024,
	title = {Optimal Configuration of Off-Grid Hybrid Renewable Energy System: A Multi-Criteria Analysis},
	isbn = {979-8-3503-8719-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208484391&doi=10.1109%2fICPEICES62430.2024.10719369&partnerID=40&md5=51785b48ebf7116f6e41728a53ffd275},
	doi = {10.1109/ICPEICES62430.2024.10719369},
	abstract = {With conventional power systems depleting, the demand for reliable and eco-friendly alternative energy sources has surged. Nonetheless, renewable energy sources encounter challenges such as uncertainty, intermittency, and high costs. One promising solution is the integration of multiple {RESs} into a hybrid renewable energy system. In this study, we propose an integrated solar, wind, and battery-based {HRES} and employ the ancient-inspired meta-heuristic methodology Giza pyramids construction algorithm for optimal system configuration determination. The approach involves a multi-criteria bi-objective optimization model aiming to balance cost and reliability by reducing the annualized system cost while ensuring high reliability, indicated by minimizing the loss of power supply probability. By implemented this methodology using hourly solar irradiation, temperature, and wind speed data collected over a year in the northern region of Uttarakhand, India. Results demonstrate the effectiveness of the {GPC} optimization method in sizing {HRES} components structured to specific locations. Furthermore, findings reveal a strong correlation between the cost of the optimal configuration and {LPSP}. © 2024 {IEEE}.},
	pages = {1002--1006},

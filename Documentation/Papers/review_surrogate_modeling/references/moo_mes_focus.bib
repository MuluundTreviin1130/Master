	editor = {Wang, J. and Zheng, X. and Tai, N. and Yang, Z. and Wei, W. and Li, L.},
	date = {2019},
	keywords = {Multiobjective optimization, Micro grid, Microgrids, optimal operation, Energy resources, Uncertainty, Distributed energy resource, Simulated annealing, Geothermal heat pumps, Combined cooling, Groundsource heat pump ({GSHP}), heating and power ({CCHP}), Improved simulated annealing algorithm, Mec Microgrid, Resiliency-Oriented, Robust Optimal Operation},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: X. Zheng; School of Electronic Information and Electrical Engineering, Shanghai Jiao Tong University, Shanghai, China; email: xiaodongzheng@sjtu.edu.cn},
}

@article{wang_multi-energy_2024,
	title = {Multi-energy complementary integrated energy system optimization with electric vehicle participation considering uncertainties},
	volume = {309},
	issn = {0360-5442},
	url = {https://www.sciencedirect.com/science/article/pii/S0360544224028846},
	doi = {10.1016/j.energy.2024.133109},
	abstract = {Multi-energy complementary integrated energy system ({MCIES}) can promote the utilization of renewable energy and facilitate the transition to a low-carbon society. With the popularization of electric vehicles ({EVs}), the charging load is a non-negligible load demand and brings unknown impacts on the {MCIES}. Moreover, the uncertain nature of renewable energy and {EVs} charging load may hinder the desired performance of {MCIES}. This study optimized the capacities of {MCIES} considering the {EVs} charging load and source-load uncertainties. An integrated solution method was used to deal with the multi-objective optimization problem, i.e., minimizing the annual total cost ({ATC}), annual total {CO}2 emissions ({ATE}) and power grid load volatility (F). In addition, the complementarity between the {EVs} charging load and power grid load for {MCIES} was investigated, as well as the impacts of the {EVs} charging strategy. An actual swimming pool building with {MCIES} was used as a case study to illustrate the procedure. The results show that the capacity configuration for {MCIES} considering {EVs} participation and uncertainties has better comprehensive performance. Moreover, the {EVs} charging strategy can further affect the load volatility of {MCIES} and its volatility is reduced by 61.3 \% under an orderly charging strategy.},
	pages = {133109},
	journaltitle = {Energy},
	author = {Wang, Jiaqiang and Cui, Yanping and Liu, Zhiqiang and Zeng, Liping and Yue, Chang and Agbodjan, Yawovi Souley},
	urldate = {2024-11-15},
	date = {2024},
}

@article{wang_short-term_2020,
	title = {Short-term Coordinated Scheduling of Wind-pumped-hydro-thermal Power System With Multi-energy Complementarities},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092638312&doi=10.13335%2fj.1000-3673.pst.2020.0476&partnerID=40&md5=bcaebe2d4020ae96b6cb5d8ec52c9612},
	doi = {10.13335/j.1000-3673.pst.2020.0476},
	abstract = {The coordinative optimization of different energy sources in power system is an effective means to deal with the randomness of wind power and promote the utilization of large scale renewable energy. For the multi-energy complementary system with wind, pumped storage, hydro and thermal power, a coordinated scheduling model and its solving method are proposed to fully exploit the complementary benefits of multi-energy and improve the accommodation capacity of renewable energy. Firstly, a multi-objective short-term coordinated scheduling model is proposed considering the economic and stable operation of the thermal power units, the utilization of renewable energy and the fluctuation of the load deducting wind power. Secondly, to take full advantage of the regulation ability of the pumped storage, a mean value deviation based method is designed to predetermine the operating state of the pumped storage. The number of thermal units to start up is determined in advance based on the load and spinning reserve requirement in the peak and valley period. Thus the integer variables in the model are solved independently, which can effectively avoid the problem of "dimension disaster" in multivariable coupling solution space. Finally, according to the flexibility, cleanliness and complementarities of different energy sources, a multi-objective optimization solution with "piecewise-sequence-feedback" strategy is established based on dispatching requirements, to realize the segmented and coordinated optimization of dispatching output of each power. Simulations of test systems with different typical days and different pumped storage capacities are carried out, and the results indicate that the proposed model can comprehensively optimize the operation characteristics of wind, pumped storage, hydro and thermal power units and maximize the comprehensive benefits of the multi-energy system. The proposed model and method have good applicability to multi-energy coordinative optimization problem. © 2020, Power System Technology Press. All right reserved.},
	pages = {3631--3640},
	number = {10},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Wang, K. and Luo, X. and Jia, R. and Zhou, C.},
	date = {2020},
	keywords = {Multiobjective optimization, Wind power, Multi-objective optimization, Scheduling, Fossil fuel power plants, Pumped storage power plants, Renewable energy accommodation, Complementary systems, Coordinated scheduling, Wind power generation, Multi-energy complementary, Coordinative optimization, Coordinated optimization, Different energy sources, Thermal power system, Comprehensive benefit, Operation characteristic, Disaster prevention, Pumped-storage},
}

@article{wang_multi-objective_2018,
	title = {Multi-objective operation optimization for integrated electricity and gas systems considering the accommodation capability of wind power},
	volume = {39},
	issn = {10007229},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85051957858&doi=10.3969%2fj.issn.1000-7229.2018.06.014&partnerID=40&md5=6f81a2d4fa32c9457ab353d26dc762ac},
	doi = {10.3969/j.issn.1000-7229.2018.06.014},
	abstract = {An integrated electric power and natural gas system, as a special example of an integrated energy system, is of great potential for promoting the accommodating capability of intermittent renewable energy generation through flexible operation of various energy carriers. However, the overall operation cost and energy transmission loss may suffer from significant changes depending on the penetration level of renewable energy sources. It is necessary to study the multi-objective optimal operation strategy for integrated electric power and gas systems considering the accommodation of wind power generation. First, a multi-objective operation optimization model is established by minimizing the operation cost, wind power curtailment and energy loss of the integrated electric power and gas system. Then, the nonlinear constraints are simplified by piecewise linearization, and the original mixed integer nonlinear planning model is then transformed into a mixed integer linear planning one. Moreover, the multi-objective optimization technique based on the augmented e-constraint method is employed to solve the model, and the fuzzy comprehensive evaluation is employed to find the compromised optimal solution from the attained Pareto optimal solutions. Finally, an integrated and revised version of the {IEEE} 39-bus power system and the Belgium 20-bus natural gas system is served to demonstrate the feasibility and efficiency of the proposed method.},
	pages = {105--116},
	number = {6},
	journaltitle = {Dianli Jianshe},
	publisher = {State Power Economic Research Institute},
	author = {Wang, K. and Wang, P. and Xu, Y. and Liu, W. and Wen, F. and Lin, Z.},
	date = {2018},
	keywords = {Multi-objective optimization, Coordinated operation, Accommodating capability of wind power, Integrated electric power and gas system, Power to gas ({PtG}) technology},
}

@inproceedings{wang_min-max_2017,
	title = {Min-max multi-objective optimization scheduling of microgrids with renewable energy},
	isbn = {978-1-5386-3524-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050362151&doi=10.1109%2fCAC.2017.8243488&partnerID=40&md5=53f8381a96ecb5806ef0c6c21a05d38e},
	doi = {10.1109/CAC.2017.8243488},
	abstract = {The operation scheduling is a crucial factor that can affect the economic and environmental benefits and operation reliability of the microgrids ({MGs}). However, widely used scheduling methods are lacking in the comprehensive consideration for the multi-objective ({MO}) property and robustness of the system operation. Also, the generated solutions might not diminish the disturbance of uncertainty under the condition of {MO}. Therefore, a novel min-max multi-objective ({MMMO}) scheduling method is proposed to derive the operation scheduling that minimizes the operation cost and emission of the system by attenuating the disturbance of all possible realizations of the uncertainty. A mixed integer linear programming ({MILP}) model is established based on min-max criterion. Moreover, we develop a two-layer solving strategy to solve the model. The inner layer is multi-objective cross entropy ({MOCE}) algorithm, and the outer layer is composed of binary additive ϵ+ indicator and cross entropy ({CE}) algorithm. Simulation results demonstrate that trade-off solutions can be achieved in the case of uncertainty perturbation. And compared to the deterministic {MO} optimization, the economic and environmental benefits are obviously improved. © 2017 {IEEE}.},
	pages = {4044--4049},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Wang, L. and Li, Q. and Cheng, X.},
	date = {2017},
	keywords = {Multiobjective optimization, Economic and social effects, Micro grid, Microgrid, optimization, Scheduling, Integer programming, Multi objective, multi-objective, Economic and environmental benefits, Mixed integer linear programming model, Entropy, Operation scheduling, Scheduling methods, min-max, Operation reliability},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: L. Wang; School of Electrical Engineering, University of Jinan, Jinan, 250022, China; email: wlhbeyond@gmail.com},
}

@article{wang_integrated_2017,
	title = {Integrated scheduling of energy supply and demand in microgrids under uncertainty: A robust multi-objective optimization approach},
	volume = {130},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85018268428&doi=10.1016%2fj.energy.2017.04.115&partnerID=40&md5=0cc3fe6efc663e977355e9e651b9d717},
	doi = {10.1016/j.energy.2017.04.115},
	abstract = {As a Demand Response ({DR}) based working mode, the integrated scheduling of energy supply and demand provides an effective approach to improve economic and environmental benefits for Microgrids ({MGs}). However, it is still a challenging issue to cover uncertainties caused by intermittent renewable energy and random loads while optimizing multiple objectives in economy and environment. To tackle this issue, an integrated scheduling approach for {MGs} is proposed based on robust multi-objective optimization. Firstly, load shifting in a finite time is introduced to express an acceptable {DR} program for industrial customers. A minimax multi-objective optimization model is formulated to seek the minimum operation costs and emissions under the worst-case realization of uncertainties, which are captured by the robust sets with budgets of uncertainty. Secondly, a strong duality based model transformation method is implemented to cope with the strong coupling and nonlinearity in the proposed formulation. Also, Multi-Objective Cross Entropy ({MOCE}) algorithm is adopted to solve the reconstructed model for simultaneously optimizing all the objectives. Finally, detailed comparative experiments are conducted in problem level, model level and algorithm level. The simulation results show that the proposed scheduling approach can effectively attenuate the disturbances of uncertainties as well as achieve optimal economic and environmental benefits, compared with single-objective robust optimization scheduling approaches and deterministic multi-objective optimization scheduling approaches. Meanwhile, the validity and effectiveness of the robust multi-objective optimization approach for the {MG} integrated scheduling problem under uncertainty are confirmed. © 2017},
	pages = {1--14},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Wang, L. and Li, Q. and Ding, R. and Sun, M. and Wang, G.},
	date = {2017},
	keywords = {Multiobjective optimization, Multi-objective optimization, Economic and social effects, Micro grid, Microgrid, optimization, Budget control, Multi-objective optimization models, uncertainty analysis, renewable resource, Scheduling, Smart grid, algorithm, Energy resources, Demand-side management, Uncertainty, {ECONOMICS}, nonlinearity, integrated approach, Robust optimization, Economic and environmental benefits, multicriteria analysis, Robust multi-objective optimizations, Comparative experiments, Demand scheduling, Model transformation methods},
}

@article{wang_robust_2017,
	title = {Robust Multi-Objective Optimization Scheduling of Micro-Grids with Renewable Energy},
	volume = {32},
	issn = {10006753},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85018443011&partnerID=40&md5=0660ba6810596dfe3b9a1240c63b3cd4},
	abstract = {In view of the problem that multi-objective demand and parameter uncertainties in micro-grids operation, a robust multi-objective optimization scheduling method is proposed to derive scheduling schemes that attenuate the disturbance of uncertainties under the multi-objective framework. Also, a robust economic environmental optimization scheduling model is formulated, whose robustness measure is introduced to capture the characteristic of uncertainties so as to alleviate conservatism in the derived model. Here, the robust transformation theory is employed to transform this model into its robust counterpart. Based on duality principle, the changed model is recast as a deterministic multi-objective optimization problem, which is efficiently solved by the multi-objective evolutionary algorithm. Simulation results demonstrate that the Pareto front achieved in this model can attenuate the disturbance of uncertainties and satisfy both requirements of economics and environment. As a result, the validity and feasibility of the proposed optimization model and method are clarified. © 2017, The editorial office of Transaction of China Electrotechnical Society. All right reserved.},
	pages = {184--192},
	number = {5},
	journaltitle = {Diangong Jishu Xuebao},
	publisher = {Chinese Machine Press},
	author = {Wang, L. and Li, Q. and Ding, R. and Wang, R.},
	date = {2017},
	keywords = {Multiobjective optimization, Evolutionary algorithms, Renewable energy, Micro grid, Multi-objective optimization problem, optimization, Renewable energies, Scheduling, Multi objective, Micro-grids, multi-objective, Robust optimization, Multi objective evolutionary algorithms, Optimization scheduling, Robust multi-objective optimizations},
}

@article{wang_robust_2019,
	title = {Robust multi-objective optimization for energy production scheduling in microgrids},
	volume = {51},
	issn = {0305215X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85045673157&doi=10.1080%2f0305215X.2018.1457655&partnerID=40&md5=b04d045a2e1ad4ff6837db5d7f461f50},
	doi = {10.1080/0305215X.2018.1457655},
	abstract = {In order to achieve better economic and environmental benefits of microgrids ({MGs}) under multiple uncertainties in renewable energy resources and loads, a novel energy production scheduling method is proposed based on robust multi-objective optimization with minimax criterion. Firstly, a mixed integer minimax multi-objective formulation is developed to capture uncertainties as well as minimize economic and environmental objectives. Secondly, the primal problem is decomposed into a bi-level optimization problem, which attempts to seek robust scheduling scheme set under the worst-case realization of uncertainties in a multi-objective framework. Finally, a hierarchical meta-heuristic solution strategy, including multi-objective cross entropy algorithm and δ+ indicator, is designed to solve the reconstructed problem. Numerical results demonstrate that the proposed scheduling method can effectively attenuate the disturbance of uncertainties as well as reduce energy costs and emissions, as compared with single-objective robust optimization and multi-objective optimization scheduling approaches. This study could offer useful insights which help decision-makers balance robustness and comprehensive benefits in the operation of {MGs}. © 2018, © 2018 Informa {UK} Limited, trading as Taylor \& Francis Group.},
	pages = {332--351},
	number = {2},
	journaltitle = {Eng Optim},
	publisher = {Taylor and Francis Ltd},
	author = {Wang, L. and Li, Q. and Zhang, B. and Ding, R. and Sun, M.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Decision making, Micro grid, Microgrid, Scheduling, Numerical methods, Multi-objective formulation, Uncertainty, Economic and environmental benefits, Environmental objectives, Problem solving, Robust multi-objective optimizations, robust multi-objective optimization, Comprehensive benefit, Production control, Bi-level optimization problems},
}

@inproceedings{wang_multi-objective_2023-1,
	title = {Multi-Objective Optimization Scheduling of Microgrids Considering Demand Response},
	isbn = {979-8-3503-0375-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189287110&doi=10.1109%2fCAC59555.2023.10451373&partnerID=40&md5=f8658461f7ae885ee7ad57d2e998a474},
	doi = {10.1109/CAC59555.2023.10451373},
	abstract = {Currently, uncertainty, demand side response, and multi-objective optimization issues of renewable energy have become important research topics in microgrid optimization. An optimization strategy considering economic indicators, security indicators, and demand response is proposed to address these issues. The optimization scheduling uses a complementary power generation method combining diesel engines and energy storage systems to address the uncertainty of large-scale renewable energy grid connection. With the aim of reducing the overall operating costs of microgrids and the power fluctuations between micro grids and the main grid interconnection lines, a coordinated operation model for distributed power generation and demand side load optimization management is established in the context of time-of-use electricity prices. The design problem is solved using the enhanced multi-objective Particle Swarm Optimization method and Pareto optimum solution theory, and the best solution is found using the fuzzy membership function. According to the calculation results, demand response reduces the microgrid's total operating costs by 12.46\% when compared to when it is not used, and it also lessens line power fluctuation by 11.11 \%, which has positive effects on both the economy and public safety.  © 2023 {IEEE}.},

	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Multi-objective optimization, Particle swarm optimization ({PSO}), Microgrid, Distributed power generation, Optimal systems, Smart grid, Smart power grids, {MATLAB}, Cost reduction, Particle swarm, Swarm optimization, Operations cost, Electric network analysis, Quanta particle swarm optimizations, Quantum particle swarm optimization algorithm, Grid-based, Power grid planning, quantum particle swarm optimization},
}

@inproceedings{lopez_approach_2011,
	title = {An approach to hybrid power systems integration considering different renewable energy technologies},
	isbn = {18770509},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84856408757&doi=10.1016%2fj.procs.2011.08.086&partnerID=40&md5=e80f401c94962ba4c70f202bdb2579e5},

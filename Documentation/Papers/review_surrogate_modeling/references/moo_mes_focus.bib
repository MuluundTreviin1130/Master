@article{lin_energy_2022,
	title = {Energy recycling perspective analysis of district heating and cooling system planning: Modeling and case study},
	volume = {52},
	issn = {23527102},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128480581&doi=10.1016%2fj.jobe.2022.104499&partnerID=40&md5=11cb4577d2130b404688e76eed716523},
	doi = {10.1016/j.jobe.2022.104499},
	abstract = {District heating and cooling ({DHC}) systems could make use of available regional resources to meet users' various demands. With the rapid development of urbanization, {DHC} is also used in a new scenario where industrial and residential systems are interconnected. Under such a scenario, the simultaneous utilization of local waste heat and renewable energy becomes a new challenge for system design and requires a new perspective of analysis. This study proposes energy recycling analysis of {DHC} and carries out an investigation in a biomedical town with industrial and residential demand. Considering the instability of waste heat, a quantified index of energy recycling rate consisting of renewable energy and energy cascade utilization is formulated to handle the worst case of waste heat utilization. Based on that, this study proposes a multi-objective planning scheme of {DHC} system considering economy and environmental impact, and carries out the evaluation of energy recycling rate for the energy supply configurations of the biomedical town. In this case, the energy recycling rate of the system ranges from 23\% to 58\% under all Pareto solutions, and is positively correlated to the planning cost of the {DHC} system. Furthermore, single-objective and tri-objective planning schemes are carried out to make comparisons with the scheme proposed above. The results of planning and comparison of different planning schemes show that the proposed energy recycling rate can assist to select an economy-environment-balanced energy supply configuration with acceptable computation time. © 2022 Elsevier Ltd},
	journaltitle = {J. Build. Eng.},
	publisher = {Elsevier Ltd},
	author = {Lin, X. and Mao, Y. and Kong, F. and Zhong, W. and Lu, S.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy supplies, Multi-objective optimization, Cooling systems, Housing, Renewable energies, Energy planning, District heating, Energy resources, Cooling, Waste heat, District heating and cooling, Recycling, Planning scheme, District heating and cooling systems, Energy recycling, Recycling energy, Recycling rate},
}

@article{lin_optimal_2021,
	title = {Optimal planning for economy and reliability of integrated energy system based on improved co-evolution algorithm},
	volume = {41},
	issn = {10066047},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114672790&doi=10.16081%2fj.epae.202109033&partnerID=40&md5=2c0c5f8d507c245953f054dc4876ec4f},
	doi = {10.16081/j.epae.202109033},
	abstract = {With the deepening of the coupling degree of multi-energy flow and the diversification of energy utilization demand, {IES}(Integrated Energy System) puts forward higher requirements for the economy and reliability of the planning scheme. However, the complex relationship between economy and reliability is mutually restricted, which makes it difficult for them to realize coordinated optimization. Therefore, an optimal planning method for economy and reliability of {IES} based on improved co-evolution algorithm is proposed. Based on the multi-scenario economic evaluation model and the reliability evaluation model of energy supply based on Markov chain Monte Carlo method, a multi-objective optimization planning model of {IES} is established. Then, the influence factors of decision variables on system economy and reliability are calculated based on the orthogonal experiment method, and the economy and reliability evolution subpopulations are established, furthermore a model optimization method based on improved co-evolution algorithm is proposed. The simulation analysis of a case study based on the actual data in a certain area is carried out, and the simulative results show that the proposed model can realize the coordinated improvement for economy and reliability of the planning scheme of {IES}. © 2021, Electric Power Automation Equipment Press. All right reserved.},
	pages = {173--181},

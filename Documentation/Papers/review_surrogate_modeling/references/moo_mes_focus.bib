	number = {5},
	journaltitle = {Clean Technol. Environ. Policy},
	publisher = {Springer Science and Business Media Deutschland {GmbH}},
	author = {Farajollahi, A. and Rostami, M. and Feili, M. and Ghaebi, H.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Sensitivity analysis, Economic analysis, Power, Exergy, Hydrogen, Economic optimization, Waste heat, Desalination, Fresh Water, Geothermal energy, Waste heat utilization, Water, Stand -alone, Economics evaluations, Waste-heat recovery, freshwater, Geothermal power plants, Multi-heat, Multi-heat recovery, Thermodynamic evaluation},
}

@article{farhoodnea_optimum_2014,

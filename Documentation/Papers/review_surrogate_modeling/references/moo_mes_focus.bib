	keywords = {Multiobjective optimization, Renewable energy resources, Electric power distribution, Electric power transmission networks, Micro grid, Microgrid, Carbon dioxide, Emission control, Renewable energy generation, Operating costs, Photovoltaic cells, Wind turbines, Algorithms, Smart power grids, Mathematical model, Photoelectrochemical cells, {MATHEMATICAL} {MODELS}, Economic and environmental benefits, Economic operations, Improved particle swarm algorithm, Particle swarm algorithm, Economic operation, Sulfur dioxide, Large-scale applications, Microsources, Multi-objective optimization operation, Nonlinear constrained optimization problems},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}


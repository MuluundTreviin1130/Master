	volume = {43},
	issn = {10001026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067610741&doi=10.7500%2fAEPS20190102007&partnerID=40&md5=a020f82bbca909aa9805bf8852ebddca},
	doi = {10.7500/AEPS20190102007},
	abstract = {The contruction of the distributed system with multi-energy complementarity has gradually become the development trend of electric power industry. Four kinds of energy sources including cooling, heating, power and gas are connected by power generation equipment, electric equipment, cooling heating and power system. Then a strong coupling energy network is constructed. Based on the interval theory, the uncertainty of combined cooling heating and power load, distributed energy output and the operation efficiency is expressed. The transfer matrix is used to describe the coupling relationship between energy input and output, and the coupling modeling of multi-energy complementary system is realized. Considering the factors of energy, environment and economy, multi-objective optimization of the system is realized. The model is solved by using interval linear programming based on affine operation and the problem of the interval linear operation being too conservative is effectively solved. The multi-energy complementary system and the individual generation system, the proposed algorithm and the traditional algorithm are compared and the results show that the model and method are reasonable and effective. © 2019 Automation of Electric Power Systems Press.},

	volume = {8},
	issn = {20763417},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85058153887&doi=10.3390%2fapp8122560&partnerID=40&md5=79bf43ec08d5084df43f1cd10a4b1407},
	doi = {10.3390/app8122560},
	abstract = {This paper investigates the stochastic optimal operation of microgrid considering the influence of energy storage system ({ESS}). The uncertain factors related to renewable energies are also fully considered. Monte Carlo simulation ({MCS}) and scenario reduction technique are used to capture the randomness of renewable energy output. The objective is to minimize the operation cost and pollutant treatment cost of the microgrid system. Then, the multi-objective optimization problem is transformed to a single-objective problem by a line weighted sum method. A nonlinear programming tool-General Algebraic Modeling System ({GAMS})-is adopted to solve the single-objective problem. Simulation results indicate that the total cost of the microgrid system can be reduced effectively when considering the effect of {ESS} and verify the correctness of the proposed strategy. © 2018 by the authors.},

	date = {2016},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric batteries, Evolutionary algorithms, Multi-objective optimization, Hybrid renewable energy systems, Optimal systems, Pareto principle, Pareto optimal solutions, Diesel engines, Multi objective evolutionary algorithms, Multiple-objectives, {HRES}, Combinatorial modeling, {PV}-wind-diesel-battery, Wind diesel, Wind-diesel-battery systems},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 10},
}


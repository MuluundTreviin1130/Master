	doi = {10.1016/j.ijepes.2015.07.007},
	abstract = {The optimum design of Hybrid Renewable Energy Systems ({HRES}) depends on different economical, environmental and performance related criteria which are often conflicting objectives. The Non-dominated Sorting Genetic Algorithm ({NSGA}-{II}) provides a decision support mechanism in solving multi-objective problems and providing a set of non-dominated solutions where finding an absolute optimum solution is not possible. The present study uses {NSGA}-{II} algorithm in the design of a standalone {HRES} comprising wind turbine, {PV} panel and battery bank with the (economic) objective of minimum system total cost and (performance) objective of maximum reliability. To address the uncertainties in renewable resources (wind speed and solar irradiance), an innovative method is proposed which is based on Chance Constrained Programming ({CCP}). A case study is used to validate the proposed method, where the results obtained are compared with the conventional method of incorporating uncertainties using Monte Carlo simulation. © 2015 Elsevier Ltd. All rights reserved.},

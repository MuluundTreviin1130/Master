	volume = {57},
	issn = {10011390},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115342157&doi=10.19753%2fj.issn1001-1390.2020.10.013&partnerID=40&md5=236feaec2bccf687311234963b32ee3c},
	doi = {10.19753/j.issn1001-1390.2020.10.013},
	abstract = {Reactive power reserve ({RPR}) optimization method is classified into static and transient {RPR} dispatch, which corresponds to static and transient voltage stability problems. Under the condition of new energy grid connection, an optimization model of power system network line loss considering both static and transient reactive power reserve is proposed in this paper. According to the characteristics of the model, a weighted minimum-module ideal-point method was proposed to simplify the multi-objective planning problem through adopting multi-objective {RPR} dispatch method. This method can a-void the complex Pareto front-end surface, solve the problem of multi-objective programming and simplify the complexity of problem. Finally, the simulation analysis on {IEEE}-39 bus system demonstrates the validity of the proposed method. © 2020 Harbin Jinhe Electrical Measurement \& Instrumentation Magazine Publishing Co., Ltd.. All rights reserved.},

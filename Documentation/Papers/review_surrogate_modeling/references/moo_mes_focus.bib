	keywords = {Multiobjective optimization, Multi-objective optimization, Renewable energy, Energy utilization, Multi-objective optimization problem, Linear programming, Hybrid energy system, renewable resource, Sustainability, Profitability, Electricity demands, goal programming, {GOAL} {PROGRAMMING} {MODEL}, Grid connected systems, Operational decisions, Sustainable energy supply},
}


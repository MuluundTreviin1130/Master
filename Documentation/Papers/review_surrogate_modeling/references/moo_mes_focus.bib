	author = {Ashfaq, S. and Zhang, D. and Dong, Z. Y.},
	date = {2017},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission networks, Multi-objective optimization, Microgrid, Voltage stability index, Distributed power generation, distributed generation, Optimization algorithms, Optimal sizing, {MATLAB}, Optimal allocation, distributed generation ({DG}), Autonomous Micro grid, Grid operation, Losses minimizations, Optimal allocation and Sizing, Software testing, Voltage-stability index},

	author = {Ma, H. and Tian, H. and Zhang, K. and Liu, Y.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Wind power, Multi-objective optimization, Renewable energy, Optimal systems, Hydrogen production, Hydrogen storage, Renewable energies, Pareto principle, Pareto optimal solutions, hydrogen energy storage, Hydrogen energy storages, Global optimization, Optimization models, Renewable energy power, Cogeneration systems, Optimal scheduling strategies, Application-oriented, co-generation system, Global optimisation},

	author = {Hajiamoosha, P. and Rastgou, A. and Bahramara, S. and Bagher Sadati, S. M.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy source, Renewable energy sources, Decision making, Microgrids, Greenhouse gases, Monte Carlo methods, multi-objective programming, Stochastic systems, Energy management, Renewable energies, electricity generation, Global warming, Demand response programs, Electrical power, Electromagnetic wave emission, Fuzzy decision making, Virtual storage, Pollution emission, Electricity prices, Tidal power, Tidal energy, Augmented ε-constraint method, Software environments, Tidal power plants},
}

@article{hajizadeh_optimal_2022,
	title = {Optimal Eco-Emission Scheduling of Demand and Supply Side of Microgrids Using Multi-Objective Ant Lion Optimization and Fuzzy Decision-Making},
	volume = {50},
	issn = {15325008},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141015222&doi=10.1080%2f15325008.2022.2135642&partnerID=40&md5=cf91eb158b7035755fda3e2bb74c4dc1},
	doi = {10.1080/15325008.2022.2135642},
	abstract = {One of the important approaches in demand-side management is shifting energy usage from on-peak time to the other periods considering the financial conditions, which is known as a demand response program. To reduce the environmental concerns, energy policymakers have proposed to use renewable energy resources as clean energy and alternative source to fossil fuels. The wind turbine and photovoltaic panel are used as renewable sources of the microgrid ({MG}). Demand response programs, including the time of use and critical peak price, are employed by the {MG}. The profit of the operator of {MG} from selling the electricity and the produced pollutant gasses of all energy sources are the considered objective functions of the demand-side management problem. The multi-objective ant lion optimizer is used to optimize the indices of the {MG} and create the optimal Pareto-front. After applying the multi-objective optimization algorithm, the Fuzzy method is used to select the best particle equal to the optimal operational schedule of energy sources and the load pattern of the {MG}. Ultimately, the proposed method is applied to optimize a sample {MG}. Results show that the proposed method improves the grid efficiency by optimizing the renewable units and battery. © 2022 Taylor \& Francis Group, {LLC}.},
	pages = {52--63},
	number = {1},
	journaltitle = {Electr. Power Comp. Syst.},
	publisher = {Taylor and Francis Ltd},
	author = {Hajizadeh, M. and Gharehpetian, G. B. and Ghassemzadeh, S. and Askari, M. T.},
	date = {2022},
	keywords = {Multiobjective optimization, Renewable energy resources, Decision making, Microgrid, Demand side management, Optimizers, Electric energy storage, Demand response programs, Scheduling, Wind turbines, Multi objective, Energy storage system, Storage systems, Demand-side management, Fossil fuels, Demand response, Electric utilities, Photovoltaic panels, Energy source, wind turbine, Photovoltaic panel, Multi-objective ant lion optimizer},
}


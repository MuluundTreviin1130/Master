	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Design, Microgrid, Microgrids, Multi-objective optimization problem, droop control, Controllers, distributed control, Distributed control strategy, Distributed parameter control systems, Load sharing, Droop controllers, Distributed-control, Load voltages, Voltage balance},
}

@article{lu_distributed_2017,

	title = {Multi-Stage Multi-Objective Energy Management System for Seaport {DC} Microgrids},
	isbn = {978-89-5708-350-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85170643452&doi=10.23919%2fICPE2023-ECCEAsia54778.2023.10213784&partnerID=40&md5=6a56cece3a5429c8b3537d19c24246dc},
	doi = {10.23919/ICPE2023-ECCEAsia54778.2023.10213784},
	abstract = {In this paper, a multi-stage optimal economic dispatch algorithm has been proposed for the seaport {DC} microgrid to support the main grid while feeding the local loads. Based on the real-time grid tariff, the optimized charging and discharging decisions for the {ESSs} have been initiated. The optimization algorithm has been split into two parts to solve the optimization problems: a rule-based algorithm and the Genetic Algorithm ({GA}). The results have shown that the proposed {EMS} can effectively schedule the {ESS} devices while considering the economic benefits of the system. The work has been performed on the {MATLAB} platform using the {GA} optimization tool. © 2023 The Korean Institute of Power Electronics.},

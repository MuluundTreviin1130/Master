	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Particle swarm optimization ({PSO}), Micro grid, Microgrid, Microgrids, Optimization problems, Fuel cells, Hydrogen storage, Photovoltaic cells, Reliability, Multi objective particle swarm optimization, Particle swarm optimization, Customer satisfaction, Cost functions, Operation and maintenance, Solar cells, hybrid {PV}/wind system, Photovoltaic arrays, Fuel cell/Battery {ESS}, Intermittent behaviors},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 14},

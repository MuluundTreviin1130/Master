	date = {2023},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Natural resources, Genetic algorithms, Particle swarm optimization ({PSO}), Micro grid, Microgrid, Cost effectiveness, Distributed power generation, Stochastic systems, distributed generation, Operating costs, Power, Demand response, Energy demands, Demand reduction, Constraint theory, Demand side reserve, multi-objective differential evolution, Multi-objective differential evolutions, Reduction function, Stochastic management},
}

@inproceedings{dixit_s_hybrid_2024,
	title = {Hybrid Renewable Energy System Design using Multi-Objective Optimization},
	volume = {581},
	isbn = {25550403},

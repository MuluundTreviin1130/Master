	keywords = {Multiobjective optimization, Renewable energy resources, Genetic algorithms, Life cycle, Computer simulation, Design, Dynamic simulation, Electric demand, Electric power systems, Environmental aspects, genetic algorithm, Hybrid power system, Hybrid power systems, Hybrid renewable energy systems, Life cycle costs ({LCC}), Loss of power supply probability, Multi-objective design optimization, Residential house},
}


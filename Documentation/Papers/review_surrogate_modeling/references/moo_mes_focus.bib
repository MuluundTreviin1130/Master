}

@article{ming_multi-objective_2017,
	title = {Multi-objective optimization of hybrid renewable energy system using an enhanced multi-objective evolutionary algorithm},
	volume = {10},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85035125889&doi=10.3390%2fen10050674&partnerID=40&md5=e4f33f637e76053b884378a53663ec94},
	doi = {10.3390/en10050674},
	abstract = {Due to the scarcity of conventional energy resources and the greenhouse effect, renewable energies have gained more attention. This paper proposes methods for multi-objective optimal design of hybrid renewable energy system ({HRES}) in both isolated-island and grid-connected modes. In each mode, the optimal design aims to find suitable configurations of photovoltaic ({PV}) panels, wind turbines, batteries and diesel generators in {HRES} such that the system cost and the fuel emission are minimized, and the system reliability/renewable ability (corresponding to different modes) is maximized. To effectively solve this multi-objective problem ({MOP}), the multi-objective evolutionary algorithm based on decomposition ({MOEA}/D) using localized penalty-based boundary intersection ({LPBI}) method is proposed. The algorithm denoted as {MOEA}/D-{LPBI} is demonstrated to outperform its competitors on the {HRES} model as well as a set of benchmarks. Moreover, it effectively obtains a good approximation of Pareto optimal {HRES} configurations. By further considering a decision maker's preference, the most satisfied configuration of the {HRES} can be identified. © 2017 by the authors.},
	number = {5},
	journaltitle = {Energies},
	publisher = {{MDPI} {AG}},
	author = {Ming, M. and Wang, R. and Zha, Y. and Zhang, T.},
	date = {2017},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Evolutionary algorithms, Multi-objective optimization, Decision making, Hybrid renewable energy systems, Optimal systems, Pareto principle, Wind turbines, Hybrid Renewable Energy System ({HRES}), Power grids, Multi objective evolutionary algorithms, Multi-objective problem, Grid-connected modes, power grid, Greenhouse effect, Boundary intersection method, Decision maker's preferences, Multi-objective evolutionary algorithm ({MOEA}), Penalty-based boundary intersection method},
}

@inproceedings{ming_multi-objective_2017-1,
	title = {Multi-Objective Optimization of Hybrid Renewable Energy System with Load Forecasting},
	isbn = {978-1-5090-5759-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85020234640&doi=10.1109%2fICEI.2017.27&partnerID=40&md5=0a96482166c57489a2090f0be10802c5},
	doi = {10.1109/ICEI.2017.27},
	abstract = {Load forecasting is crucial to schedule energy in advance with meeting the load demand of users. This study proposes a hybrid model in which the multiple linear regression ({MLR}) and the autoregressive integrated moving average ({ARIMA}) method are used to perform load forecasting. The proposed method enhances the forecasting accuracy by emphasizing more on the previous forecasting results that have smaller deviations. In addition, Kalman filter is used to estimate parameters of the hybrid model. By taking the forecasted load as input, the paper further considers multi-objective optimal design of a hybrid renewable energy system ({HRES}). The {HRES} consists of photovoltaic ({PV}) panels, wind turbines, batteries and diesel generators. The design is to minimize the {HRES} cost, pollutant emission, as well as to satisfy the load demand as much as possible. The problem is solved by a multi-objective evolutionary algorithm ({MOEA}) by which a set of approximated Pareto optimal (trade-off) solutions are found. By further integrating the preference of a decision maker, the best configuration of the {HRES} is identified. © 2017 {IEEE}.},

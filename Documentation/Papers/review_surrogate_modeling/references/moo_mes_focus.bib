	keywords = {genetic algorithm, energy resource, algorithm, Algorithms, Article, cost, software, process optimization, Diesel generator, Hydrogen, Models, Theoretical, theoretical model, controlled study, hydrogen energy storage, Distributed energy resource, Isolated microgrid, Energy-Generating Resources, flow measurement, flower, Fuel cost, hybrid gene, mathematical analysis, non dominated sorting genetic algorithm {II}, nonhuman, photovoltaic array, pollination, power flow analysis, summer, wind turbine generator, winter},
}

@article{bharti_planning_2020,
	title = {Planning Framework for Optimal Resource Utilization Strategy in Microgrid},
	volume = {45},
	issn = {2193567X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077443696&doi=10.1007%2fs13369-019-04310-x&partnerID=40&md5=edba40670e524f2ab2beb13d12944be3},
	doi = {10.1007/s13369-019-04310-x},
	abstract = {The incorporation of distributed energy resources and technical innovations has restructured the electrical power system network from conventional grid to microgrid. Consequently, significant impacts on both distribution and utilization of power have been observed triggered by diverse operating condition and enhanced power demand. In planning of microgrid, energy management is a critical issue which is related to efficient utilization of available resources at minimum operating cost. Distributed and intermittent nature of generations in microgrid demands efficient and optimal allocation of existing resources. An allocation technique is necessary to attain optimal utilization of assets and to accomplish decision making for optimal power flow route through shortest path. This paper proposes a multi-objective optimization-based resource allocation technique to efficiently control available generation at any load condition to achieve minimum operating cost while maintaining all system constraints. In proposed framework, line flows are maximized to its load-carrying capability and by controlling power flow through shortest possible path. Proposed methodology suggests proper controller position to sustain desired power flow through the shortest path between each generator and load pair. An interconnected microgrid network topology is considered to demonstrate the proposed methodology. © 2020, King Fahd University of Petroleum \& Minerals.},
	pages = {1927--1947},
	number = {3},
	journaltitle = {Arab. J. Sci. Eng.},
	publisher = {Springer},
	author = {Bharti, D. and De, M.},
	date = {2020},
	keywords = {Multi-objective optimization, Microgrid, Resource allocation, Genetic algorithm ({GA}), Power flow constraints, Shortest path},
}

@inproceedings{bharti_multi-objective_2019,
	title = {Multi-Objective optimization Based Resource Utilization with Loss Minimization in Microgrid},

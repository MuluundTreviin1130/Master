	author = {Wang, L. and Singh, C.},
	date = {2007},
	keywords = {Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Electric power systems, Cost effectiveness, Distributed power generation, Energy management, Algorithms, Reliability, Particle swarm optimization, Renewable sources of energy, Reliability theory, Remote regions, Hybrid generating system, Alternative energy technologies, Autonomous power generating system, Optimum resource management},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 37; Correspondence Address: L. Wang; Department of Electrical and Computer Engineering, Texas A and M University, College Station, {TX} 77843-3128, United States; email: l.f.wang@ieee.org},
}


	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 8; Correspondence Address: A.C. Rueda-Medina; Universidade Estadual Paulista ({UNESP} - Ilha Solteira), São Paulo, Brazil; email: aucerume@gmail.com},

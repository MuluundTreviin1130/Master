	keywords = {Multiobjective optimization, Renewable energy resources, Data storage equipment, Greenhouse gases, Sensitivity analysis, Costs, Renewable energy generation, Electric energy storage, Energy storage systems, Cost benefit analysis, Natural gas, Conflicting objectives, Distributed energy systems, Design and operations, Storage technology, Electricity tariff, Generic frameworks},

	keywords = {Multiobjective optimization, Renewable energy, Life cycle, Renewable energies, Wind turbines, Distributed energies, Planning, Desalination, Water, Combined cooling, Multi-objective planning, heating and power ({CCHP}), Desalination units, Micro energy, {CCHP} system, Micro energy network, Fresh water resources},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 6; Correspondence Address: D. Wang; Key Laboratory of Smart Grid of Ministry of Education, Tianjin University, Tianjin, Nankai District, 300072, China; email: wangdantjuee@tju.edu.cn},

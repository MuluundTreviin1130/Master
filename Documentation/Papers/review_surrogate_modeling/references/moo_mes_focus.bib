@article{ruhani_hydrogen_2024,
	title = {Hydrogen production via renewable-based energy system: Thermoeconomic assessment and Long Short-Term Memory ({LSTM}) optimization approach},
	volume = {52},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166629910&doi=10.1016%2fj.ijhydene.2023.03.456&partnerID=40&md5=8abdd51b97fb7b71a43dc71b1ef17bc7},
	doi = {10.1016/j.ijhydene.2023.03.456},
	abstract = {A clean and carbon-free energy market can be more sustainable and safer that can be approaches by investing on hydrogen energy. Further, a renewable energy-driven energy production cycle coupled with an energy storage option is of major significance. In the present article, a hybrid process based on geothermal and solar energies is conceptually designed and simulated. The process is comprised of a solar-organic Rankine cycle ({ORC}) unit, a geothermal cycle, an electrolysis unit (based on alkaline electrolyzer stack, {AES}), and a nanomaterial-based unit (i.e., alkaline fuel cell stack, {AFC}) to store hydrogen. Combining nickel nanoparticles thermally enclosed in multiwalled carbon nanotubes ({MWCNTs}) with a composite thermoset anion-exchange membrane enables alkaline water splitting. When the grid demands are less than generated electricity rate, additional electricity is fed into an {AES} to generate hydrogen fuel. Further, when the grid demands are more than generated electricity rate, stored hydrogen and oxygen are fed into an {AFC} to back convert the chemical energy in the fuel into electrical energy. The thermodynamic and thermo-economic evaluations of the considered hybrid process are comprehensively presented. Furthermore, multi-objective optimization of the introduced process has been developed in accordance with the genetic optimization technique to maximize the rate of electricity and minimize the cost rate. Additionally, the Long Short-Term Memory ({LSTM}) -based optimization technique is established and discussed. The outcomes indicated that under the {LSTM}-based genetic optimization technique the output electricity and electricity and hydrogen costs of the considered hybrid process can be improved by 34.55\% and reduced by 40.3\% and 26.8\%, respectively. It was also found that the estimations obtained from the {LSTM} technique are very reliable, and can be relied on with acceptable accuracy. The estimation based on {LSTM} has an accuracy level of more than 98.1\%. © 2023 Hydrogen Energy Publications {LLC}},
	pages = {505--519},
	journaltitle = {Int J Hydrogen Energy},
	publisher = {Elsevier Ltd},
	author = {Ruhani, B. and Moghaddas, S. A. and Kheradmand, A.},
	date = {2024},
	keywords = {Multiobjective optimization, Renewable energy, optimization, Optimisations, Electrolyzers, Power generation, Hydrogen production, Solar power generation, Renewable energies, Electric energy storage, Thermal energy, Rankine cycle, Optimization techniques, Genetic optimization, Thermoeconomic, Fuel cell stack, Brain, Free energy, Alkaline fuel cells, Alkalines, Alkalinity, Hybrid process, Ion exchange membranes, Nanomaterial-based electrolyze, Nanomaterial-based electrolyzer},
}

@article{ruiming_multi-objective_2019,
	title = {Multi-objective optimized operation of integrated energy system with hydrogen storage},
	volume = {44},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85062809995&doi=10.1016%2fj.ijhydene.2019.02.168&partnerID=40&md5=5ced9dff8e3e73a8ec18c775eb6d2afd},
	doi = {10.1016/j.ijhydene.2019.02.168},
	abstract = {In this paper, an integrated energy system ({IES}) consisting of wind turbine unit, photovoltaic cell unit, electrolytic hydrogen unit, fuel cell unit, and hydrogen storage unit is proposed, and the construction of multi objectives for day-ahead power dispatching of the {IES} considering both operation and environment cost is discussed. By adopting piecewise linearization method, the optimization variables are divided into 24 periods, and the day-ahead power dispatching optimization problem is transformed into a 24-h piecewise optimization problem. On the basis, a complete non-linear mixed integer dynamic scheduling optimization model is established. An improved non-dominated sorting genetic algorithm ({NSGA}-{II}) is applied to solving the model. In optimization process, an interactive strategy is adopted to solve the coordination between discretization of variables and restriction of switching times of electrolyzer. Optimization results show that, compared with the single objective of minimizing operating costs, the multi-objective optimization scheme can reduce carbon emissions by 3.5\% with 2.8\% increase of operating cost. Compared with the single objective of minimizing environmental, the multi-objective optimization scheme can reduce operating cost carbon by 5.12\% with 2.6\% increase of environmental cost. © 2019 Hydrogen Energy Publications {LLC}},
	pages = {29409--29417},
	number = {56},
	journaltitle = {Int J Hydrogen Energy},
	publisher = {Elsevier Ltd},
	author = {Ruiming, F.},
	date = {2019},
	keywords = {Multiobjective optimization, Electric load dispatching, Genetic algorithms, Multi-objective optimization, Energy management, Carbon, Fuel cells, Hydrogen storage, Operating costs, Integer programming, Photovoltaic cells, Wind turbines, Non dominated sorting genetic algorithm ({NSGA} {II}), {NSGA}-{II} algorithm, Cost reduction, Photoelectrochemical cells, Integrated energy systems, Integrated energy system, Multi energy, Multi-objective optimization scheme, Optimization variables, Electrolytic hydrogen, Multi-energy complement, Piecewise linearization},
}

@inproceedings{ruzive_optimising_2024,
	title = {Optimising Hybrid Energy Solutions for Hydrogen Production in South Africa},
	isbn = {979-8-3503-9118-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216019843&doi=10.1109%2fICECCME62383.2024.10796753&partnerID=40&md5=be61175f285f4bb3845307596c7e8644},
	doi = {10.1109/ICECCME62383.2024.10796753},
	abstract = {South Africa's heavy reliance on coal for electricity generation contributes adversely to global warming. This has led to a national initiative to transition to variable renewable energy sources for electricity and green hydrogen production. However, the variability and intermittency of the renewable energy sources raises reliability and efficiency concerns. To help improve the reliability and efficiency of the variable renewable energy systems, this paper proposes a Hybrid Hydrogen Energy System optimisation model, which uses wind and solar energy to power a Proton Exchange Membrane electrolyser for green hydrogen production. The Non-dominated Sorting Genetic Algorithm {II} is used to implement the optimisation. The optimisation objectives considered for the study are minimisation of total system cost and maximisation of system efficiency at high system reliability. Results demonstrate that total system cost and system efficiency are successfully optimised. This highlights {NSGA}-{II}'s potential for optimising larger hybrid hydrogen energy systems in South Africa, which can contribute to an increase in the reliability and efficiency of variable renewable energy systems. © 2024 {IEEE}.},
	eventtitle = {International Conference on Electrical, Computer, Communications and Mechatronics Engineering, {ICECCME} 2024},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Ruzive, G. and Garner, K. S.},

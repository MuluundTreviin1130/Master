}

@inproceedings{liu_study_2024,
	title = {A Study on the Economic Optimal Control Strategy of {AC}-{DC} Hybrid Microgrid Based on Consistency Theory},
	isbn = {979-8-3315-0455-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000252215&doi=10.1109%2fNPSIF64134.2024.10883417&partnerID=40&md5=4ff55e19345ecf35001fdcc81f045c50},
	doi = {10.1109/NPSIF64134.2024.10883417},
	abstract = {In recent years, renewable energy has been developing rapidly, accompanied by the wide application of distributed generation. {AC}-{DC} hybrid microgrid, as a flexible and efficient energy system, is an important and key part of the construction of a new power system. This paper conducts an in-depth study on the economic optimization control strategy of {AC}-{DC} hybrid microgrid, aiming at improving the overall operation efficiency and economy performance of the new power system. Firstly, the control mathematical model of {AC}-{DC} hybrid microgrid is established, and the output characteristics and load characteristics of different power sources are considered. Secondly, this study proposes an active power control strategy based on equal incremental rate consistency algorithm and an economic scheduling control model considering frequency recovery for microgrid networks, thus realizing the construction of power regulation and control model of microgrid system. Through the improved artificial bee colony algorithm based on Gaussian variation and chaos perturbation, the economic optimization scheduling model is solved and run, and the effectiveness and feasibility of the control strategy is verified by simulation cases. The research results show its capability to significantly reduce the operating cost and improve the utilization rate of renewable energy on the premise of ensuring the stable operation of the system, and provide theoretical basis and technical support for the practical application of {AC}-{DC} hybrid microgrid. © 2024 {IEEE}.},

	author = {Huang, Z. and Xie, Z. and Zhang, C. and Chan, S. H. and Milewski, J. and Xie, Y. and Yang, Y. and Hu, X.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Evolutionary algorithms, Multi-objective optimization, Electric power systems, Hybrid energy system, Power management strategies, Electric vehicle batteries, Potential energy, {NSGA}-{II}, Multi objective evolutionary algorithms, {MOEA}/D, Hydrogen economy, {EV} battery, Lithium batteries, Comparison of performance, Molecular physics, Retired {EV} battery},
}


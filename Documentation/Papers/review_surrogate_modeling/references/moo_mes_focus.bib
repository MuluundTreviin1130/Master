	isbn = {978-87-7475-698-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195783948&partnerID=40&md5=b56aa4e55f01819f90608e9532ee466a},
	abstract = {Increased shares of variable renewable energy ({VRE}) necessitate various approaches to match supply and demand patterns at different spatial and temporal scales. Within electricity distribution networks, which may experience grid constraints, energy communities could play an important role in enabling higher shares of solar photovoltaic ({PV}) integration, while reducing the overall costs and carbon footprint of the building sector. This can be achieved by adapting {PV} generation to better match demand patterns-and therefore improve the community's self-consumption and self-sufficiency-through different combinations of installation sizing, tilt, and azimuth angles. To assess the aggregation effects of demand from multiple prosumers with varied demand patterns and {PV} system configurations, we simulate a group of residential buildings (three singlefamily and two multi-family houses) and carry out a bi-objective (cost and carbon minimization) optimizations to investigate the optimal placement of {PV} systems on building rooftops and facades. The Pareto frontiers show the tradeoff between normalized costs and {GHG} emissions and indicate higher normalized costs for buildings with lower electricity demand as {PV} systems are scaled to the available rooftop and facade areas. When the placement of solar panels is optimized for the aggregated case, we observe an average gain of 16.7\% in self-consumption and 4.0\% in self-sufficiency, a reduction of 44\% in cost, and 1.9\% in greenhouse gas ({GHG}) emissions compared to when {PV} placement is optimized for each building individually. The study highlights the comparative advantage of group optimization that considers the aggregation effects in both demand and {PV} generation. © Proceedings of {ECOS} 2022 - 35th International Conference on Efficiency, Cost, Optimization, Simulation and Environmental Impact of Energy Systems.},
	pages = {1419--1430},
	publisher = {{DTU} Construct},
	author = {Li, Q. and Vulic, N. and Orehounig, K.},

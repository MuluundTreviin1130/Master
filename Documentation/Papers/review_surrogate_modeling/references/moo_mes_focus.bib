	publisher = {Elsevier Ltd},
	author = {Liu, X. and Hou, G. and Yang, L.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Energy, Power, Energy source, Energy-consumption, Windmill, Multi energy, datacenter, Energy interactions, Data center, Multi-energy interaction, {NSGA}-Ⅲ algorithm},
}

@article{liu_hierarchical_2022,
	title = {Hierarchical multi-objective design of regional integrated energy system under heterogeneous low-carbon policies},
	volume = {32},
	issn = {2352-5509},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85129946750&doi=10.1016%2fj.spc.2022.04.027&partnerID=40&md5=1ffb9dd797ceaaa66e74bbb2fd417acb},
	doi = {10.1016/j.spc.2022.04.027},
	abstract = {Fossil-to-renewable energy system transition is an inevitable future trend considering carbon dioxide emissions mitigation burdens. However, huge investment costs and insufficient policy support are still the two main barriers to further expand renewable energy penetration. To transcend these barriers, from the perspective of both policy makers and energy suppliers, this study simultaneously integrates low-carbon policy formulations and regional integrated energy system ({IES}) reshaping to achieve an affordable decarbonization pathways. Mixed Integer Quadratically-Constrained Programs ({MIQCP}) models are constructed, and hierarchical multi-objective optimization is applied to quantify local government's decision-making costs and energy suppliers' system transition costs. A new rural community in Dalian (China) is taken as a case study to capture the relationship among energy structure adjustment, energy system reshaping, and renewable subsidy and carbon tax adjustment under different {CO}2 emission reduction regulations. The result shows that under the same {CO}2 emission reduction rate, portfolio policies can benefit both the policy maker and the energy supplier by balancing the local government revenue and expenditure, and reducing the annual total costs of {IES}. In addition, via {IESs} optimization, a higher renewable energy penetration rate could be obtained and the energy supplier could achieve a competitive cost within 40\% {CO}2 emission reduction targets. © 2022},
	pages = {357--377},
	journaltitle = {Sustain. Prod. Consum.},
	publisher = {Elsevier B.V},
	author = {Liu, X. and Liu, F. and Li, N. and Mu, H. and Li, L.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Decision making, Carbon dioxide, Renewable energies, Emission control, Global warming, Integer programming, Energy systems, Investments, Carbon tax, {ECONOMICS}, Cost reduction, Constrained optimization, Carbon taxes, Integrated energy systems, Integrated energy system, Hierarchical systems, Integrated energy systems ({IES}), Hierarchical multi-objective optimization, Energy subsidies, Energy system transition, Mixed integer quadratically constrained programs, Mixed integer quadratically-constrained program, Mixed Integer Quadratically-Constrained Programs ({MIQCP}), Renewable energy subsidy, System transitions},
}

@inproceedings{liu_multi-objective_2021,
	title = {Multi-Objective Non-Cooperative Game Optimization for Microgrid Clusters Based on {NSGA}-{II} Coordinated Interior-Point Method},
	volume = {2021-July},
	isbn = {19449925},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124158885&doi=10.1109%2fPESGM46819.2021.9638127&partnerID=40&md5=3657365dd47b30279b3eddf59ba76987},
	doi = {10.1109/PESGM46819.2021.9638127},
	abstract = {An energy interaction mechanism is presented for multi-microgrid clusters with high penetration of renewable energies. By properly managing 'generalized reserve capacities' within the multi-microgrid cluster, flexible energy resources such as extra amount of renewable generations and energy storage capacities can be traded among the energy prosumers. The {NSGA}-{II} coordinated interior-point method based multi-microgrid multi-objective optimization is developed, taking both economy and comfort as the goal. First, the {NSGA}-{II} coordinated interior-point method is used to dispatch the demand side of microgrids to determine the electricity consumption behavior and the demand of electric energy transaction. Secondly, a game optimization model is built to guide the demand side response of the microgrid through the release of internal electricity price, and finally the scheme is determined. Finally, an example of five microgrids is given to demonstrate the effectiveness of the proposed method. © 2021 {IEEE}.},

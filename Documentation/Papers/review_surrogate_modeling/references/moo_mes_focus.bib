	author = {Chen, J. and Yang, X. and Zhu, L. and Zhang, M.},
	date = {2014},
	keywords = {Multiobjective optimization, Electric power distribution, Electric power transmission networks, Multi-objective optimization problem, Power generation, Combined heat and power, Reactive power, Active and Reactive Power, Electric power supplies to apparatus, Optimization modeling, {MATHEMATICAL} {MODELS}, Site selection, Multi-objective modeling, Environmental benefits, Electrical engineering, Electronics engineering, Fuzzy optimization theory, Mathematical transformations, Satisfaction degrees},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 3; Correspondence Address: J. Chen; Electric Power Engineering, Shanghai University of Electric Power, Shanghai, China; email: chenjie\_boys@163.com},
}


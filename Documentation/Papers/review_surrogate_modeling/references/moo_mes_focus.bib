	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy, Plug-in Electric Vehicles, Vehicle-to-grid, Electric loads, {NSGA}-{II}, {NSGA}-{II} algorithm, Fossil fuel power plants, Photovoltaic thermals, unit commitment, Optimization scheduling, Unit-based, Thermal power units, Levy flight strategy, Levy flights, Multi - objective optimization, {PEVs}},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: Z. Yang; Shenzhen Institute of Advanced Technology, Chinese Academy of Sciences, Shenzhen, China; email: zl.yang@siat.ac.cn},

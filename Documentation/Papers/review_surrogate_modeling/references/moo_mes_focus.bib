	isbn = {978-1-032-42003-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85145556254&doi=10.1201%2f9781003360773-87&partnerID=40&md5=f4a70a043667431174a4e3f51119b167},

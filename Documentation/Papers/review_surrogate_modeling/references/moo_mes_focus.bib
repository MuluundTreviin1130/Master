	editor = {Tremont-Brito, R. J. and Darbali-Zamora, R. and Broderick, R. and Aponte-Bezares, E. E. and O'Neill-Carrillo, E. and Lave, M. S.},
	date = {2023},
	keywords = {Multiobjective optimization, Economic and social effects, Microgrid, Microgrids, Solar power generation, Rural community, Cost benefit analysis, Trade off, Diesel engines, Cost optimization, Costs Optimization, Microgrid sizing, rural microgrid, Design basis threat, design basis threats, Puerto Rico, Trade-offs analyse, trade-offs analysis},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 8; {CODEN}: {CRCND}},

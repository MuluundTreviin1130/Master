	date = {2020},
	keywords = {Multiobjective optimization, Wind power, Microgrids, Multi-objective optimization problem, {NSGA}-{II} algorithm, Cost reduction, Electric power system interconnection, Environmental protection, Cluster analysis, Power out put, Energy interactions, Cluster systems, Load transfer, Time of use prices ({TOU}), Transaction mode},

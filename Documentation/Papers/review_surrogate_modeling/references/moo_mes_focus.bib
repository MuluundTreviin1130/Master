	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Power quality, Smart grid, Smart power grids, Renewable energy integration, Renewable energy integrations, {MATLAB}, Controllers, Electric power system control, Constrained optimization, Plug-in hybrid vehicles, Harmonic distortion, Topology, Bang-Bang control, Bessel filter, Bessel filter sallen key topology, Optimal pseudospectral bang bang control, Plug-In Hybrid Electric Vehicle, Pseudospectral, Quality control, Total harmonic distortion, Total harmonic distortions},

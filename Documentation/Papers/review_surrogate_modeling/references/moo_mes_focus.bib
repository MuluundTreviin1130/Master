	keywords = {Multiobjective optimization, Multi-objective optimization, Economic and social effects, Water conservation, energy storage, Social impact, Water supply, Water energy, Rural areas, Off-grid system, Off-grid systems, Sustainable dimensions, technological change, Water-Energy storage},
}

@article{furlan_robust_2024,
	title = {Robust design of hybrid solar power systems: Sustainable integration of concentrated solar power and photovoltaic technologies},
	volume = {13},
	issn = {26667924},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184802582&doi=10.1016%2fj.adapen.2024.100164&partnerID=40&md5=03417c607fbc2908ff08b70b6431761f},
	doi = {10.1016/j.adapen.2024.100164},
	abstract = {The global energy sector is now transitioning its structure towards carbon neutrality aided by renewable resource use. Despite its immense potential, solar energy contributes minimally to the global energy mix due to its intermittent nature and challenges with power demand fluctuations. Increased use of distributed solar sources alters market dynamics, necessitating conventional power plants to ramp up output during lower renewable energy production times and manage oversupply risks. Concentrated solar power ({CSP}) can contribute to grid decarbonization, but its high levelized cost of electricity ({LCOE}) impedes widespread adoption. This study proposes hybridizing {CSP} and photovoltaic ({PV}) technologies, aiming to leverage their synergy to maximize economic benefits. We develop a comprehensive process design framework that utilizes a robust multi-objective optimization ({MOO}) approach, which factors in techno-economic and environmental objectives while accounting for model uncertainty from resource prices and life cycle assessment indicators. Optimization results reveal that in Ivanpah, California, hybrid {CSP} + {PV} can reduce 41 \% of {LCOE} and limit environmental impacts compared to standalone {CSP} plants. This robust framework also identifies design trends, such as a constant dependence on the {PV} field, and a trade-off between the installed area of the solar concentrators and the backup boiler operation. The optimal unit sizes, less susceptible to future market fluctuations and potential changes in the global warming potential ({GWP}) of technologies, contribute significantly to robust and sustainable energy planning decisions. © 2024 The Author(s)},
	journaltitle = {Adv. Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Furlan, G. and You, F.},
	date = {2024},
	keywords = {optimization, Photovoltaic ({PV}), Concentrated solar power ({CSP}), Decision-making under uncertainty, Techno-enviro-economic optimization},
}

@inproceedings{fusco_smart_2016,
	title = {Smart {AMI} based demand-response management in a micro-grid environment},
	isbn = {978-1-5090-0687-8},
	abstract = {Reliable operation of the electrical grid requires balancing between generation and energy demand at any time instant. Increasing penetration of intermittent sources of alternative generation compromises reliability and introduces significant price volatility. As a solution, demand response strategies have been studied to provide the necessary demand-side flexibility for utility to absorb some volatility. In this paper, a demand-response management ({DRM}) system is proposed, where a service provider finds a mutual optimal solution for the utility and the customers in a microgrid setting. This could be used by a service provider interacting with the respective customers and utility under the existence of some {DRM} agreements. In this study, a micro-grid consisting of a smart neighbourhood of twelve customers is taken as experimental case study and an advanced metering infrastructure ({AMI}) is implemented. Based on the formulation of an optimization problem which exploits price-responsive demand flexibility and the {AMI} infrastructure, a win-win-win strategy is presented. By shaping load patterns according to market pricing, the proposed method led to higher cost savings for the flexible customers and the utility, with consistent profit margins achieved by the service provider. Results for a range of typical scenarios are presented to demonstrate the effectiveness of the proposed demand-response management framework. © 2016 {IEEE}.},
	eventtitle = {Clemson University Power Systems Conference, {PSC} 2016},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Fusco, V. and Venayagamoorthy, G. K. and Squartini, S. and Piazza, F.},
	date = {2016},
	keywords = {Multiobjective optimization, Electric power transmission networks, Multi-objective optimization, optimization, Optimization problems, Costs, Smart grid, Sales, Demand response, Reliable operation, Demand response ({DR}), Advanced metering infrastructures, Advanced metering infrastructure ({AMI}), Alternative generation, dynamic pricing, Price responsive demand, Remote management, remote management system},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 9},
}

@article{gabbar_risk-based_2012,
	title = {Risk-based performance analysis of microgrid topology with distributed energy generation},

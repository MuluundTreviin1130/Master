@article{ba-alawi_reliable_2023,
	title = {Reliable operation of an optimal self-scheduling multicarrier system with two alternatives: Multiple renewable utilities or hydrogen facilities},
	volume = {420},
	issn = {0959-6526},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168011168&doi=10.1016%2fj.jclepro.2023.138463&partnerID=40&md5=bc3908e9f822a797bd047acfe99d9bb9},
	doi = {10.1016/j.jclepro.2023.138463},
	abstract = {Multicarrier systems ({MCSs}) have been retrofitted with storage facilities to enhance their resilience to meet the fluctuating demands. Considering the complexity of the systems and the interactions among various carriers, optimal resource allocation is a serious challenge in the sustainable management of energy systems. This study proposes a new self-scheduling {MCS} to supply power, heating, cooling, and freshwater, without external cooling and nonrenewable heating facilities. Modeled based on circular integration principle, the {MCS} consists of various subsystems and storage facilities to treat the effluent and digest excess sludge of a wastewater treatment facility. The {MCS} is optimally designed and scheduled in a two-stage multi-objective optimization to satisfy the demand loads of a small community in two configurations: one with a material conversion unit ({MCS}-{MC}) to store and utilize hydrogen, and the other with weather-driven renewable energy units ({MCS}-{RE}) for a reliable operation. Accordingly, total annual cost ({TAC}), total exergy dissipation ({nTED}), and the mismatch between supply and demand ({MSD}) are minimized in a multi-objective optimization problem to obtain the optimal capacity of the equipment and the short-term storage facilities are scheduled in the first and second stages, respectively. The results show that the optimal {MCS}-{MC} and {MCS}-{RE} configurations reduced the {TAC}, {nTED}, and {MSD} by 30.2\% and 12.4\%, 32.9\% and 23.4\%, and 55.4\% and 48.5\%, respectively, compared to the base system. The new utility-free hydrogen-assisted multi-carrier systems are anticipated to substitute present systems with multiple renewable resources. © 2023 Elsevier Ltd},
	journaltitle = {J. Clean. Prod.},
	publisher = {Elsevier Ltd},
	author = {Ba-Alawi, A. H. and Ifaei, P. and Yoo, C.},
	date = {2023},
	keywords = {Multiobjective optimization, Energy management systems, Energy management, Hydrogen storage, Multi carrier systems, {ECONOMICS}, Biogas-fueled multicarrier system, Circular integration, Effluent treatment, Hydrogen facilities, Hydrogen facility, Multicarrier systems, Optimal self-scheduling storage, Renewable utilities allocation, Renewable utility allocation, Self-scheduling, Storage facilities, Sustainable energy management, Wastewater treatment},
}

@article{ba-alawi_techno-economic_2024,
	title = {Techno-economic risk-constrained optimization for sustainable green hydrogen energy storage in solar/wind-powered reverse osmosis systems},
	volume = {90},
	issn = {2352152X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192244922&doi=10.1016%2fj.est.2024.111849&partnerID=40&md5=b31f3050dba104a987ef21a803cbae45},
	doi = {10.1016/j.est.2024.111849},
	abstract = {Hydrogen energy storage systems ({HESSs}) are vital for enhancing the resilience of energy systems and coping with the intermittency of renewable energy sources. However, their implementation presents significant risks and costs. This study proposes a novel safety-oriented multi-criteria optimization approach for designing sustainable {HESSs} tailored to meet the demands of a hybrid solar-wind powered reverse osmosis system. Firstly, a hybrid deep-learning model was developed to enhance the precision of weather and demand data forecasting. Subsequently, a comprehensive qualitative–quantitative risk assessment was conducted to explore the impact of {HESS} design parameters, including storage size, pressure, flow rate, and temperature. Then, multi-objective optimization was performed considering the total environmental cost, total life cycle cost ({TLCC}), and risk cost index ({RCI}). The design of three green {HESSs}, gas hydrogen storage ({GH}2), liquid hydrogen storage ({LH}2), and material-based hydrogen storage ({MH}2), were compared. The results reveal that {GH}2 has the largest {TLCC} (568,164.60 {USD}/year), followed by {MH}2 (460,674.18 {USD}/year) and {LH}2 (383,895.25 {USD}/year) The {RCI} identifies {LH}2 (0.21) as the highest risk, primarily because of the potential explosion hazards. Although {MH}2 integration may offer cost and safety advantages, temperature control during hydrogen release poses challenges to its practical application. Thus, this study offers a balanced approach integrating safety and economic considerations for designing green {HESSs}, aiding decision-makers toward sustainable energy solutions. © 2024 Elsevier Ltd},
	journaltitle = {J. Energy Storage},
	publisher = {Elsevier Ltd},
	author = {Ba-Alawi, A. H. and Nguyen, H.-T. and Aamer, H. and Yoo, C.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Decision making, Life cycle, Hydrogen storage, Solar power generation, Costs, Electric energy storage, Deep Learning, Storage systems, Weather forecasting, Constrained optimization, Hydrogen energy storages, Cost indexes, Hydrogen storage system, Multi-criteria assessment, Reverse osmosis systems, Risk assessment, Risk costs, Safety risk assessments, Safety-risk assessment, Total life cycle costs},
}

@article{ba-alawi_sustainable_2023,
	title = {Sustainable design of a solar/wind-powered reverse osmosis system with cooperative demand-side water management: A coordinated sizing approach with a fuzzy decision-making model},
	volume = {295},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171647995&doi=10.1016%2fj.enconman.2023.117624&partnerID=40&md5=171a05f2d80a2e66786a19d1f8f8064b},
	doi = {10.1016/j.enconman.2023.117624},
	abstract = {A reverse osmosis ({RO}) desalination plant powered by solar and wind energy resources is a promising sustainable solution to meet the increasing freshwater demand. However, the high energy consumption and complex management of systems present significant design and operational challenges. This study proposes a new coordinated sizing approach that integrates demand-side water management ({DSWM}) to optimize the sizing of a renewable energy ({RE}) powered {RO} ({RE}-{RO}) desalination system by considering total annual cost ({TAC}), total environmental cost ({TEC}), scheduling profit ({SP}), and potential loss of power supply probability ({PLPSP}). First, a scheduling based {DSWM} was applied to effectively reduce peak water usage for a community of 61 commercial buildings, serving as a case study. Subsequently, a freshwater energy-storage cascade table was used to determine the initial ranges of the battery, hydrogen, and water storage capacities. Consequently, a multi-objective genetic optimization algorithm in a leader–follower structure was developed to determine the optimal sizes of {RE}-{RO} system components, including the number of photovoltaic panels ({PVs}), wind turbines ({WTs}), {RO} parameters, and storage capacities. Then, multi-criteria decision-making based on a hybrid fuzzy approach was employed to select the optimal sizes of system components. The results showed that the {DSWM} case required fewer {PVs} (i.e., 30 {PVs} and 18 {WTs}) than the case without {DSWM} (i.e., 44 {PVs} and 18 {WTs}). Additionally, the {DSWM} case required a lower powering capacity ({PRRO}) of 45.41 {kW} and inlet feedwater (Qin) of 9.537 m3/h, whereas the case without {DSWM} required a {PRRO} of 56.29 kw and Qin of 13.185 m3/h. The implementation of {DSWM} improved {TAC}, {TEC}, {SP}, and {PLPSP} by 5.37\%, 32.4438\%, 57.9311\%, and 23.7822\%, respectively, compared to the case without {DSWM}. Overall, the developed coordinated sizing approach assisted by {DSWM} could help to optimize the sizing of the {RE}-{RO} system, resulting in significant cost reduction and a flexible demand satisfaction with lower emissions and higher sustainability. © 2023 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Ba-Alawi, A. H. and Nguyen, H.-T. and Yoo, C.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Wind power, Multi-objective optimization, Decision making, Energy utilization, Sustainable development, Hydrogen storage, Structural optimization, Ecodesign, Fuzzy decision making, Office buildings, Demand-side, Desalination, Decision-making modeling, Demand side water management, Fuzzy decision-making model, Osmosis desalination system, Reverse osmose desalination system, Reverse osmosis, Reverse osmosis desalination, Reverse osmosis desalination system, Solar wind energy, Solar/wind energy resource, Solar/wind energy resources, Structural design, Water management, Waters managements, Wind energy resources},
}

@article{babaei_cooperative_2024,
	title = {Cooperative energy scheduling of interconnected microgrid system considering renewable energy resources and electric vehicles},
	volume = {229},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182904495&doi=10.1016%2fj.epsr.2024.110167&partnerID=40&md5=862ee0d74606db608566368c505444d8},
	doi = {10.1016/j.epsr.2024.110167},
	abstract = {Microgrids are known as a local energy system that changes the central power plants toward distributed and renewable energy resources. The microgrids provide low-cost, more efficient, and clean energy for the energy systems. Therefore, this paper presents a techno-sustainable-economic framework for the operation scheduling of multi-microgrid systems that are integrated with renewable energy sources, dispatchable resources, and energy storage systems. The proposed model presents a multi-objective optimization model that attempts to simultaneously minimize the total cost, power losses, and carbon emissions by cooperation of each microgrid with other neighboring energy systems. In the cooperative framework, the microgrids form a big coalition to reduce the operation costs by their local energy system and energy trading with neighbor microgrids. Also, microgrids try to minimize the power losses by local energy trading. The Genetic algorithm is used to model the multi-objective cooperative scheduling of microgrids and presents a fair cost allocation to consider the impact of each microgrid in the coalition. The proposed model is tested on the {IEEE} 33-bus test system and simulation results demonstrate that the proposed model reduces the power losses and carbon emissions by 68.67 \% and 19.65 \% compared to the decentralized framework because of local energy sharing between microgrids. © 2024 Elsevier B.V.},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Babaei, M. A. and Hasanzadeh, S. and Karimi, H.},
	date = {2024},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric load dispatching, Genetic algorithms, Microgrid, Microgrids, Energy management, Carbon, Costs, Energy systems, Microgrid systems, Carbon emissions, Energy trading, Power markets, Pollution emissions, Powerloss, Cooperative microgrid, Cooperative microgrids, Decentralized scheduling, Electric power system interconnection, Local energy systems, Pollution emission},
}

@article{babu_multi-objective_2023,
	title = {Multi-objective genetic algorithm based energy management system considering optimal utilization of grid and degradation of battery storage in microgrid},
	volume = {9},
	issn = {2352-4847},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162745195&doi=10.1016%2fj.egyr.2023.05.067&partnerID=40&md5=c6d8e54465b00e6c472d28298590282f},
	doi = {10.1016/j.egyr.2023.05.067},
	abstract = {This paper develops intelligent energy management in Microgrid using forecasting-based multi-objective optimization using genetic algorithm framework. In this work, the energy storage system is included in Microgrid network, which is essential for effective energy management and smooth power transfer. The developed model incorporates the forecasted values of solar {PV} and wind generation obtained using time series long short-term memory network for the next 24 h and provides the optimal values of battery and grid powers to meet the deficit of power to meet the demand in the Microgrid. The proposed model incorporates grid power consumption cost and battery degradation cost as the objectives with battery status and renewables utilization as the constraints of the optimization model. The fuzzy decision-making strategy obtains the compromise solution in the Pareto optimal front from multiple solutions. The proposed model is investigated with fixed and variable grid tariff conditions achieving efficient performance in energy management with optimal utilization of renewables, grid and battery in the system for 24 hours-time horizons. The system parameters in the Microgrid network are also investigated in the time horizon with the optimal values of proposed model. The proposed intelligent energy management system model is tested in 2.5 {MW} {PV}/wind/energy storage Microgrid system in {MATLAB} 2020 simulation platform and experimental setup of 1 {kW} grid connected Microgrid with solar {PV} and battery. © 2023 The Authors},
	pages = {5992--6005},
	journaltitle = {Energy Rep.},
	publisher = {Elsevier Ltd},
	author = {Babu, V. V. and Preetha Roselyn, J. and Sundaravadivel, P.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Battery storage, Electric batteries, Energy management systems, Renewables, Genetic algorithms, Multi-objective optimization, Decision making, Energy transfer, Microgrid, Energy management, Optimal systems, Pareto principle, {MATLAB}, battery degradation, Grid consumption, Grid power, Optimal utilization, Optimal values, Simulation platform, Solar {PVs}, Time horizons},
}

@article{baghaee_multi-objective_2017,
	title = {Multi-objective optimal power management and sizing of a reliable wind/{PV} microgrid with hydrogen energy storage using {MOPSO}},
	volume = {32},
	issn = {10641246},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85014295829&doi=10.3233%2fJIFS-152372&partnerID=40&md5=6ec60996a86263ba5846eacc1bfc615b},
	doi = {10.3233/JIFS-152372},
	abstract = {In this paper, a multi-objective algorithm is presented for optimal power management and design of a hybrid Wind/Photovoltaic/ generation system with hydrogen energy storage system including electrolyzer, fuel cell and hydrogen tank to supply power demand in a microgrid system. The generation units are intrinsically non-dispatchable and moreover, the major components of the system i.e. wind turbine generators, photovoltaic arrays and {DC}/{AC} converter may be subjected to failure. Also, solar radiation, wind speed and load data are assumed to be entirely deterministic. The goal of this design is to use a novel multi-objective optimization algorithm to minimize the objective functions i.e. annualized cost of the system, loss of load expected and loss of energy expected and provide optimal energy management in the microgrid. The system costs involve investment, replacement and operation and maintenance costs. Prices are all empirical and components are commercially available. The simulation results for different cases reveal the impact of components outage on the reliability and cost of the system. So, they are directly depends on component's reliabilities, i.e. outages lead to need for a larger and more expensive generation system to supply the load with the acceptable level of reliability. In addition, an approximate method for reliability evaluation of hybrid system is presented which lead to reduce computation time. Simulation results show the effectiveness of proposed multi-objective algorithm to solve optimal sizing problem in contrast with traditional single objective methods. © 2017 {IOS} Press and the authors. All rights reserved.},
	pages = {1753--1773},
	number = {3},
	journaltitle = {J. Intelligent Fuzzy Syst.},
	publisher = {{IOS} Press},
	author = {Baghaee, H. R. and Mirsalim, M. and Gharehpetian, G. B.},
	date = {2017},
	keywords = {Multiobjective optimization, Energy management systems, Wind power, Particle swarm optimization ({PSO}), Micro grid, Microgrid, optimization, Energy management, fuel cell, Fuel cells, Hybrid systems, Hydrogen storage, Costs, Wind, Photovoltaic cells, Power management, Wind turbines, energy storage, Digital storage, Investments, Wind energy, Photovoltaic, Reliability, Multi objective particle swarm optimization, Storage management, Hydrogen energy storages, Outages, Fuel storage, Fuel tanks, Multi objective algorithm, Multi-objective particle swarm optimization, Operation and maintenance, Optimal power management and sizing, Reliability evaluation, Turbogenerators},
}

@article{baghaee_reliabilitycost-based_2016,
	title = {Reliability/cost-based multi-objective Pareto optimal design of stand-alone wind/{PV}/{FC} generation microgrid system},
	volume = {115},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84991058653&doi=10.1016%2fj.energy.2016.09.007&partnerID=40&md5=4fdad160c003840f4ab5fe6321ac2f32},
	doi = {10.1016/j.energy.2016.09.007},
	abstract = {The main goal for designing hybrid wind–solar generating microgrid systems is reliable supply of load, under varying weather conditions, with the minimum cost and maximum reliability. In this paper, a hybrid wind-solar generation microgrid system with hydrogen energy storage is designed for a 20-year period of operation using novel multi-objective optimization algorithm to minimize the three objective functions namely annualized cost of the system, loss of load expected and loss of energy expected. System costs involve investment, replacement and operation and maintenance costs and the major components of system may be subjected to failure. The simulation results based on multi-objective particle swarm optimization for different cases reveal the impact of components outage on reliability and cost of the system. In addition, an approximate method for reliability evaluation of hybrid system is presented which lead to reduce computation time. Simulation results show effectiveness of proposed multi-objective algorithm to solve optimal sizing problem in contrast with traditional single objective methods. © 2016 Elsevier Ltd},
	pages = {1022--1041},

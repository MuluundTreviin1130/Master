}

@inproceedings{chen_multi-objective_2023-4,
	title = {A Multi-objective Optimal Scheduling Model of a Virtual Power Plant Considering Uncertainties},
	isbn = {979-8-3503-4552-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162708324&doi=10.1109%2fACPEE56931.2023.10135644&partnerID=40&md5=63447674dc5175b0a1fa57bd8a3d4bb3},
	doi = {10.1109/ACPEE56931.2023.10135644},
	abstract = {Virtual power plants aggregate various types of distributed generation resources to participate in the power market as a whole. When optimizing day-ahead dispatch, virtual power plants must take into account the volatility of renewable energy to lower the risk of benefit loss and must balance the interests of many partners to produce sustained economic gains. In this research, we provide an optimum multi-objective model of a virtual power plant taking uncertainties into account. Based on minimizing the risk brought on by the unpredictability of renewable energy output, the virtual power plant develops a day-ahead dispatch plan that takes into consideration both its own interests and those of its customers to obtain the best overall results. © 2023 {IEEE}.},

}

@inproceedings{sharaf_hybrid_2010,
	title = {A hybrid {PSO}-self regulating {VSC}-{SMC} controller for {PV}-{FC}-diesel-battery renewable energy scheme for buildings electricity utilization},
	isbn = {978-0-7695-4062-7},

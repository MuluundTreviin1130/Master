	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Decision making, Scheduling, Multi objective, Integrated energy systems, Neural network models, Integrated energy system, Constraint theory, Recurrent neural networks, Optimized scheduling, Integrated energy systems ({IES}), Distributed multi-objective optimization, neural dynamics, Neurodynamic optimizations, non-convex, Recurrent neural network, recurrent neural networks ({RNNs})},
}

@article{huang_multi-objective_2020,

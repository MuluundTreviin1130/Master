	keywords = {Multiobjective optimization, Energy management systems, Multi-objective optimization, Particle swarm optimization ({PSO}), Energy efficiency, Micro grid, Microgrid, Microgrids, Energy management, Secondary batteries, energy storage, Energy storage systems, Multi-objective particle swarm optimization algorithms, Hybrid energy storage system, Storage management, Particle swarm optimization, Hybrid energy storage systems, Fuzzy control, Complementary characteristics, Renewable energy storages, Economical efficiency, Environmental friendliness},

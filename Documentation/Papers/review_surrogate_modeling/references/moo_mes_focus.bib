@article{li_research_2023-2,
	title = {Research on Optimal Configuration of Landscape Storage in Public Buildings Based on Improved {NSGA}-{II}},
	volume = {15},
	issn = {2071-1050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165110196&doi=10.3390%2fsu15021460&partnerID=40&md5=49a16654913a8f4db92398abedfc20c8},
	doi = {10.3390/su15021460},
	abstract = {The transition to clean and low-carbon energy in public buildings is crucial to energy saving and green social development. This paper focus on the sustainable development of public buildings and the construction of complementary power generation systems in existing public buildings. In the study, it was found that the constraints of the energy storage system could not be satisfied, which would result in the failure of the energy storage system for the purpose of peak regulation and stable operation of the microgrid. In order to satisfy the constraint conditions of the energy storage system, a spatial transformation method was proposed that improves the Non-dominated Sorting Genetic Algorithm-{II} ({NSGA}-{II}). The simulation results show that the spatial transformation Non-dominated Sorting Genetic Algorithm-{II} ({STNSGA}-{II}) has advantages in dealing with the strong constraints of the energy storage system. The introduction of the complementary power generation system with energy storage system in public buildings can save 23.74\% to 31.17\% from the perspective of optimal cost, and can reduce of {CO}2 emissions by at least 2478 kg from the perspective of carbon emission reduction. This study presents a case for transforming public buildings from simple consumers of energy systems to active contributors supporting large-scale wind and {PV} access. © 2023 by the authors.},
	number = {2},
	journaltitle = {Sustainability},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Li, S. and Zhou, H. and Xu, G.},
	date = {2023},
	keywords = {Wind power, Renewable energy, genetic algorithm, optimization, Carbon dioxide, Power generation, alternative energy, energy storage, photovoltaic system, carbon emission, energy use, {CO}2 emissions, {PV} system, Multi objective optimization, wind generation},
}

@inproceedings{li_multi-objective_2024-8,
	title = {Multi-Objective Planning for Hydrogen Production Considering Complementary Hydrogen Production Technologies in Source-Grid-Load-Storage System},

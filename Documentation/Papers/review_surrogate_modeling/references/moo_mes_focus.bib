	journaltitle = {Sustainability},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Ukoba, Michael O. and Diemuodeke, Ogheneruona E. and Alghassab, Mohammed and Njoku, Henry I. and Imran, Muhammad and Khan, Zafar A.},
	urldate = {2020-07-16},
	date = {2020},
	langid = {english},
	keywords = {{TOPSIS}, hybrid energy, {AHP}, {HOMER}},

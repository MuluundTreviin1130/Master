	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission, Multi-objective optimization, Economic and social effects, Carbon, Emission control, Integer programming, Electric loads, Energy, Agriculture, Integer Linear Programming, Mixed integer linear, Greenhouses, Mixed integer linear programming, Multi energy, multi-energy complementarity, Co-generation, co-generation of electricity, cooling and heating, greenhouse integrated energy},

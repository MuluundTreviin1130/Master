@article{wang_differential_2021,
	title = {Differential evolution algorithm based on {PCA} to determine the objective function to optimize the configuration of microgrid},
	volume = {2003},
	issn = {17426588},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114995754&doi=10.1088%2f1742-6596%2f2003%2f1%2f012015&partnerID=40&md5=2c4bd6871951cac344c66f19b740c830},
	doi = {10.1088/1742-6596/2003/1/012015},

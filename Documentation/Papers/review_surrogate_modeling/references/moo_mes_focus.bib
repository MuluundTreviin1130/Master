	isbn = {978-1-5386-0451-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050566568&doi=10.1109%2fSusTech.2017.8333521&partnerID=40&md5=3c262c943916c06b59c2d0e016b19da9},

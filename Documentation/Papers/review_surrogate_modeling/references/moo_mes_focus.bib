	isbn = {979-8-3503-5905-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185000124&doi=10.1109%2fICPEA59834.2023.10398618&partnerID=40&md5=0c02ad4c513410d5bd89f2d4cf596c2c},
	doi = {10.1109/ICPEA59834.2023.10398618},
	abstract = {Multi-type energy storage is essential for managing fluctuations in renewable energy power and increasing the consumption rate of renewable energy. In this paper, an optimal scheduling strategy for the co-generation system comprising wind power, photovoltaic power, electrical energy storage, and hydrogen energy storage is proposed. The strategy consists of a global optimization model and an application-oriented Pareto optimal solution screening methodology. The global optimization model establishes a multi-objective optimization model based on meteorological prediction information that considers the intended output power completion of the co-generation system, the remaining equivalent power of the energy storage plant, and the equivalent production of hydrogen. The {NSGA}-{II} is utilized to solve the global optimization model and obtains multiple Pareto optimal solutions. The optimal solutions are screened by applying the application-oriented Pareto optimal solution screening methodology. Finally, a co-generation plant in Shandong Province is presented to validate the effectiveness of the proposed approach in mitigating wind variability and encouraging the adoption of renewable energy sources.  © 2023 {IEEE}.},

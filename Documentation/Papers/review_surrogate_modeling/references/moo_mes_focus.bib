@article{sun_passivity-based_2024,
	title = {Passivity-Based Stability Analysis of {DC} Microgrids Using Physically Decoupled Model},
	volume = {39},
	issn = {08858950},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179806564&doi=10.1109%2fTPWRS.2023.3339815&partnerID=40&md5=b78e6e9ea15f605eb9b9780634ebba20},
	doi = {10.1109/TPWRS.2023.3339815},
	abstract = {Due to the low inertia and weak damping of the dc microgrid, its stability becomes even more serious and has attracted many investigations. However, as its scale and complexity continue to grow, the effectiveness, reliability, and comprehensiveness of the stability analysis cannot be guaranteed simultaneously. Therefore, this paper proposes a passivity-based stability analysis approach by developing a physically decoupled model. Specifically, for the first time presenting the concept of virtual capacitance in modeling, the dc microgrid is physically decoupled into several low-dimensional subsystems. These subsystems have feedback structures, constituting the physically decoupled model, and the physical meanings of parameters are retained explicitly and completely. Subsequently, a sufficient condition for the stability of the physically decoupled model is derived based on strict passivity and {LaSalle}'s Theorem. Then, by combining optimization theory, the stability domain calculation of multiple subsystems is transformed into a multi-objective optimization problem. The stability impacts of internal circuit and power parameters are evaluated, and the stability boundaries are identified to determine parameter limitations. Finally, numerical and time-domain simulations are carried out to validate the effectiveness and accuracy of the theoretical analysis and the superiority of the proposed method than Lyapunov direct method and {TS} fuzzy model method. © 1969-2012 {IEEE}.},
	pages = {5645--5658},
	number = {4},
	journaltitle = {{IEEE} Trans Power Syst},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Sun, S. and Tang, C. and Xie, D. and Hailati, G. and Gu, C. and Zhang, Y. and Wang, X.},
	date = {2024},
	keywords = {Multiobjective optimization, Microgrid, Numerical methods, Reliability analysis, Time domain analysis, Stability criteria, Stability analysis, Load modeling, Site selection, {DC} microgrid, Timing circuits, {DC} microgrids, Power systems stability, Stability criterions, Circuit simulation, Circuit stability, decoupling, Decouplings, domain of attraction, Integrated circuit modeling, Passivity, Stability analyze},
}

@article{sun_multi-objective_2022,
	title = {Multi-objective optimization dispatching of a micro-grid considering uncertainty in wind power forecasting},
	volume = {8},
	issn = {2352-4847},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124567813&doi=10.1016%2fj.egyr.2022.01.175&partnerID=40&md5=01a30e29726e9f1c36412546685c815c},
	doi = {10.1016/j.egyr.2022.01.175},
	abstract = {This paper presents a new multi-objective optimization dispatching method to optimize the output power of distributed generators of a micro-grid considering uncertainty in wind power forecasting with the aims of minimizing the operational cost and pollutant emission. To deal with uncertainty in wind power forecasting, an adaptive concept of confidence interval ({ACCI}) is proposed and probabilistic wind power interval forecasting model based on deterministic wind power forecasting and {ACCI} is developed to address this problem. Then, a comprehensive formulation with different operational constraints is applied to construct the multi-objective optimization dispatching model of a micro-grid considering uncertainty in wind power forecasting, and two-step solution methodology based on chaos and sinusoidal mapping multi-objective optimization bat algorithm ({CSMOBA}) and fuzzy theory set is employed to solve the multi-objective optimization dispatching problem. Eventually, simulation results demonstrate the proposed {ACCI} method can work well and obtain appropriate confidence level at each dispatching hour, and the proposed {CSMOBA} algorithm outperforms multi-objective optimization bat algorithm and well-known non-dominated sorting genetic algorithm {II} when applied in multi-objective optimization dispatching of micro-grid. © 2022 The Author(s)},
	pages = {2859--2874},
	journaltitle = {Energy Rep.},
	publisher = {Elsevier Ltd},
	author = {Sun, S. and Wang, C. and Wang, Y. and Zhu, X. and Lu, H.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Electric power transmission networks, Wind power, Genetic algorithms, Microgrid, Multi objective, Micro-grids, Weather forecasting, Chaos theory, Bat algorithms, Support vector machines, confidence interval, Multi-objective bat algorithm, Interval forecasting, Least square support vector machine, Least square support vector machines, Optimization dispatching, Wind power interval forecasting},
}

@inproceedings{sun_optimal_2023,
	title = {An Optimal Dispatch Strategy for A Distributed Microgrid Using Snake Optimizer},
	isbn = {978-1-6654-5215-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166389835&doi=10.1109%2fICCSIE55183.2023.10175294&partnerID=40&md5=760656fbf5957323a64f4b3f8866d10b},
	doi = {10.1109/ICCSIE55183.2023.10175294},
	abstract = {In this paper, we propose an optimal scheduling strategy, which is to reduce the operating costs of microgrids while using as much clean energy as possible. Therefore, this paper uses a new metaheuristics algorithm, Snake Optimizer({SO}), solves a multi-objective optimization model for microgrids. The algorithm simulates the behavior and patterns of snake foraging and reproduction, and allocates the population into two groups of males and females according to certain rules. In turn, population renewal strategies are generated based on the specific mating behavior of snakes. Based on the comparison of the two search results, it is proved that the algorithm has strong global search capability and good robustness of convergence results. In addition, the proposed optimization strategy is applicable to all operating modes of the microgrid. {SO} improves the ability of microgrids to operate independently while reducing the cost of microgrid generation. In the process of finding the optimal dispatching strategy in microgrid operation, for the multi-objective optimization problem of microgrid, the traditional intelligent optimization algorithm is easy to fall into the local optimal solution, which makes it difficult to find the global optimal solution. © 2023 {IEEE}.},
	eventtitle = {2022 1st International Conference on Cyber-Energy Systems and Intelligent Energy, {ICCSIE} 2022},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Sun, Z. and Yang, J. and Su, H.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Energy management systems, Microgrid, Multi-objective optimization models, Optimizers, Optimal systems, Operating costs, Meta-heuristics algorithms, Clean energy, Cost reduction, Dispatch strategy, Energy management system, optimal dispatch, Snake Optimizer, Optimal scheduling strategies, Optimal scheduling strategy, Cell proliferation},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: Z. Sun; Northeastern University, College of Information Science and Engineering, Shenyang, China; email: wordsnor@163.com},
}

@article{sutar_multi-criteria_2019,
	title = {Multi-criteria optimization of a hybrid renewable energy for standalone electrification},
	volume = {28},
	issn = {20054238},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081188169&partnerID=40&md5=56dec920d11f1f4949f8b5ed9dbbae19},
	abstract = {In developing countries, designing a sustainable electrification system for remote places is very complex. Recently published research papers in the hybrid renewable field have not considered various factors such as technical, economic, environmental, and social ({TEES}), without which achievement of the goal of the sustainable energy system for rural places is not feasible. In the presented paper, a methodological framework based on decision analysis is designed with locally available renewable energy sources considering various {TEES} factors. Initially, suitable energy alternatives selected by considering different criteria with multiple scenarios for decision analysis. Further optimal combination of energy sources evaluated for different possibilities. The case study with real metrological data of a remote place in Himanchal Pradesh carried out, and the result shows that new methodology gave an optimized real-time system with multiple system combinations and configuration with the use of multitasking decisions algorithm and found very impactful on its {TEES} factor for the considered location. © 2019 {SERSC}.},

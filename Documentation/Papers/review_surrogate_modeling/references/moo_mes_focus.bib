	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Life cycle, Economic analysis, Costs, Optimization algorithms, Storage systems, Cost benefit analysis, Lead acid batteries, Lithium-ion batteries, absorption, lithium-ion, Teaching-learning-based optimizations, Renewable sources, Lithium ions, Economic models, Absorbent glass mat, Absorbent glass mats, Economic modeling, Glass, Repair, Teaching-learning-based optimization algorithm, {TLBO} algorithm, Valve regulated acid lead, Valve-regulated},
}

@article{kharatovi_multi-objective_2024,
	title = {A Multi-Objective Optimization Framework for Peer-to-Peer Energy Trading in South Korea’s Tiered Pricing System},
	volume = {14},
	issn = {20763417},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212446890&doi=10.3390%2fapp142311071&partnerID=40&md5=141eb309202baa8279f74c95f7f339c9},
	doi = {10.3390/app142311071},
	abstract = {This study proposes a multi-objective optimization framework for peer-to-peer (P2P) energy trading in South Korea’s tiered electricity pricing system. The framework employs the Multi-Objective Evolutionary Algorithm based on Decomposition ({MOEA}/D) to optimize three conflicting objectives: minimizing consumer costs, maximizing prosumer benefits, and enhancing energy utilization. Using real microgrid data from a South Korean community, the framework’s performance is validated through simulations. The results highlight that {MOEA}/D achieved an optimal cost of {KRW} 32,205.0, a benefit of {KRW} 32,205.0, and an energy utilization rate of 57.46\%, outperforming the widely used {NSGA}-{II} algorithm. Pareto front analysis demonstrates {MOEA}/D’s ability to generate diverse and balanced solutions, making it well suited for regulated energy markets. These findings underline the framework’s potential to improve energy efficiency, lower costs, and foster sustainable energy trading practices. This research offers valuable insights for advancing decentralized energy systems in South Korea and similar environments. © 2024 by the authors.},
	number = {23},
	journaltitle = {Appl. Sci.},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Kharatovi, L. and Gantassi, R. and Masood, Z. and Choi, Y.},
	date = {2024},
	keywords = {Multi-objectives optimization, Microgrid, optimization, Optimisations, Optimization algorithms, Clean energy, Energy, Energy trading, multi-objective evolutionary algorithm, South Korea, Optimization framework, P2P, tiered pricing},
}


@article{cai_optimal_2025,
	title = {Optimal sizing and cost-benefit assessment of stand-alone microgrids with different energy storage considering dynamic avoided {GHG} emissions},
	volume = {109},
	issn = {2352152X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213046791&doi=10.1016%2fj.est.2024.115128&partnerID=40&md5=aa24537bd59e401ffff08f53ffbc27af},
	doi = {10.1016/j.est.2024.115128},
	abstract = {This study proposes an innovative microgrid capacity planning framework aimed at optimizing the configuration of standalone microgrid systems in suburban Beijing. The framework comprehensively considers economic benefits and environmental impacts, introducing dynamic avoided {GHG} emissions ({AGE}) and a cost-benefit index ({CBI}) as evaluation metrics. Based on local meteorological data and load demands, the study employs an improved multi-objective optimization algorithm, {MORIME}, for system optimization, comparing it with other advanced algorithms. Results indicate that {PV}/{WT}/{FC} and {PV}/{WT}/Bat configurations perform best under different evaluation criteria. The {PV}/{WT}/{FC} configuration achieves the highest {AGE} within a higher total net present cost ({TNPC}) range, while the {PV}/{WT}/Bat configuration maintains high {AGE} levels within a lower {TNPC} range. Sensitivity analysis reveals the impact of key techno-economic parameters on system performance. The study integrates Markov Chain Monte Carlo ({MCMC}) methods with the {MORIME} algorithm, effectively addressing uncertainties in renewable energy output and load demand. The research findings provide a comprehensive and reliable decision support framework for microgrid planning in suburban Beijing and similar regions, offering important references for promoting cleaner, more efficient, and more reliable regional energy systems. © 2024 Elsevier Ltd},
	journaltitle = {J. Energy Storage},
	publisher = {Elsevier Ltd},
	author = {Cai, C. and Zhang, L. and Lai, G. and Zhou, J. and Zhou, L. and Qin, Y. and Tang, Z.},
	date = {2025},
	keywords = {Renewables, Microgrid systems, Optimal sizing, Greenhouse gas emissions, Low emission, {GHG} emission, {GHGs} emissions, Stand -alone, Dynamic avoided {GHG} emission, Dynamic avoided {GHG} emissions, Kyoto Protocol, Markov chain Monte Carlo method, {MCMC} method, {MORIME} algorithm, Optimal sizing design, Stand-alone renewable microgrid system},
}

@inproceedings{cai_design_2023,
	title = {Design, Control and Simulation of a Geothermal and Solar Generation System Integrated with Hydrogen Storage and {PEM}-{FC}},
	isbn = {21624704},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179513282&doi=10.1109%2fIECON51785.2023.10312164&partnerID=40&md5=ff5471a94df576a1e4e66da8cc0a15bd},
	doi = {10.1109/IECON51785.2023.10312164},
	abstract = {Geothermal and solar energy have become two of important renewable energy sources for power generation in the context of carbon reduction and carbon peaking. In order to improve the power supply stability and peak shaving ability of the system, a geothermal and solar-powered renewable generation system integrated with a proton exchange membrane fuel cell ({PEMFC}) is designed and analyzed. The system includes both hydrogen production, storage, and generation processes to overcome the intermitted shortcoming of renewable energy sources. The design parameters of the system are analyzed and optimized. A multi-objective optimization ({MOO}) is conducted, considering both energy efficiency and economic competitiveness. The result shows that the system can better meet the electricity demand of a community. The unmet demand for electricity falls from 8.1\% to 4 \% and the system generates additional 0.12 {MWh}/day. © 2023 {IEEE}.},

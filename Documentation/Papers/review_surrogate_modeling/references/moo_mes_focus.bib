	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Particle swarm optimization ({PSO}), Renewable energy, Microgrid, Distributed power generation, Energy balance, Renewable energies, Learning algorithms, Electric load management, Optimal energy, Inertia weight, Teaching-learning-based optimizations, Adaptive inertia, Adaptive teaching–learning-based optimization, Islanding mode, Islanding modes, Optimal load control},
}

@inproceedings{joshi_power_2021,
	title = {Power Grid Resilience against Natural Disasters via Line Reinforcement and Microgrid Formation},
	isbn = {21665478},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166237481&doi=10.1109%2fGreenTech56823.2023.10173846&partnerID=40&md5=7fc1c5cc132f822b9186120bb3e10854},
	doi = {10.1109/GreenTech56823.2023.10173846},
	abstract = {Natural disasters can devastate the critical infrastructure of the affected regions, including the power and energy systems. Power grid resilience can be achieved during operation, by adopting risk-based dispatch strategies, or through proactive grid reinforcement and hardening strategies. A solution is proposed in this paper for optimal line reinforcement in order to enable microgrid formation during the course of a natural disaster event. The problem is formulated as a mixed-integer nonlinear multi-objective optimization model to minimize the reinforcement cost and maximize the amount of load served. The problem is solved subject to power flow and network topology constraints. A case study is presented to illustrate that through a selective and targeted line reinforcement, multiple microgrids can be formed in order to continue the local supply of the loads until damaged components are repaired or replaced, and service is restored to the main grid.  © 2023 {IEEE}.},
	pages = {209--213},
	publisher = {{IEEE} Computer Society},
	author = {Joshi, G. and Mohagheghi, S.},
	date = {2021},
	keywords = {Multiobjective optimization, Electric load dispatching, Microgrid, Microgrids, Distributed power generation, Integer programming, Energy resources, distributed energy resources, Power grids, Electric load flow, Disasters, Islanding, Reinforcement, Grid reinforcement, infrastructural resilience, microgrid islanding, Natural disasters, power grid reinforcement, Power grid resilience},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: G. Joshi; Colorado School of Mines, Electrical Engineering Department, Golden, 80401, United States; email: gjoshi@mines.edu},
}

@article{joshi_improved_2019,
	title = {An improved {TLBO} based economic dispatch of power generation through distributed energy resources considering environmental constraints},
	volume = {18},
	issn = {23524677},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063081722&doi=10.1016%2fj.segan.2019.100207&partnerID=40&md5=2012ce250f76a9daa5632c0defb046df},
	doi = {10.1016/j.segan.2019.100207},
	abstract = {In today's era, to attain sustainable energy on the increasing environmental apprehension and diminution in the fuel expenditure, the endeavor on the integration of distributed energy resources (such as wind, solar etc.) along with conventional energy sources are gaining the highest consideration. Development of such hybrid model presents an interesting challenge of solving complex multi-objective optimization problem without getting trapped in local optima. In the present work, various optimization techniques such as Particle Swarm Optimization ({PSO}), Teaching Learning Based Optimization ({TLBO}), and Improved {TLBO} ({TLBO}–{PSO}) are presented to optimize the total operating cost of the system. This system consists of multiple solar {PV} modules, wind turbines, and thermal generators. Main objective of this work is “to check the strength of improved {TLBO} ({TLBO}–{PSO}) on complex multi-objective optimization problem” “to analyze the effect of renewable resources on the total operating cost of emission constrained economic dispatch system” and “to evaluate the effect of emission constraint on economic dispatch problem considering renewable energy resources using different optimization algorithms.” Results have also been compared with the classical optimization technique {QCP} and other metaheuristic technique such as {GA} and one of the recently developed techniques, namely comprehensive {TLBO} ({CTLBO}), which indicates that the computational strength and quality of solution obtained from improved {TLBO} ({TLBO}–{PSO}) is superior to other four algorithms under consideration. © 2019},
	journaltitle = {Sustain. Energy Grids Netw.},
	publisher = {Elsevier Ltd},
	author = {Joshi, P. M. and Verma, H. K.},
	date = {2019},
	keywords = {Particle swarm optimization ({PSO}), distributed energy resources, Genetic algorithm ({GA}), Comprehensive {TLBO} ({CTLBO}), Economic load dispatch, Improved {TLBO} ({TLBO}–{PSO}), Quadratic constraint programming, Teaching learning based optimization ({TLBO}), Wind Energy Conversion System ({WECS})},
}

@article{ju_robust_2023,
	title = {Robust Multi-objective optimal dispatching model for a novel island micro energy grid incorporating biomass waste energy conversion system, desalination and power-to-hydrogen devices},
	volume = {343},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85158059086&doi=10.1016%2fj.apenergy.2023.121176&partnerID=40&md5=b241f92bcafec632aba7ac89499579b7},
	doi = {10.1016/j.apenergy.2023.121176},
	abstract = {To realize renewable and self-sustainable energy supply in island region, based on geographical characteristics with abundant renewable resources, an optimal model for island micro energy grid ({MEG}) is designed incorporating biomass waste energy conversion system ({ECS}), desalination, and power-to-hydrogen ({BSP}-{MEG}) Firstly, the mathematical model is designed, including models of power generators, {ECS}, desalination and power-to-hydrogen (P2H) devices, etc. Next, the multi-objective scheduling optimization model is designed, containing conventional scheduling model (Scheduling optimization objectives and constraints established with minimum operation and environment costs) and stochastic scheduling model (Minimum Conditional Value-at-Risk objective specific to volatility and uncertainty of renewable generations based on robust stochastic optimization method). Then, to solve the multi-objective optimization problem ({MOP}), a hybrid differential evolution algorithm is proposed based on local optimal and external archiving strategies. Finally, the {MEG} of {YongXing} Island is selected as an example. The results show (1) {BSP}-{MEG} effectively realized multi-energy cooperative optimization, and promote intra-day peak shaving. (2) {BSP}-{MEG} reduced operating costs, environmental costs and Conditional Value-at-Risk ({CVaR}) by 78.2\%, 61.8\% and 77.9\% respectively, while curtailment rate by 25.6 to 0.9\%. (3) Whether in general scenario or worst, {BSP}-{MEG} can realize self-production and self-sale of energy and material, of which risk resistance ability is better. (4) By designing local optimal and external archiving strategies, hybrid differential evolution algorithm performs better in solving complex {MOP}. In general, the optimization model proposed in this paper can improve the utilization of renewable resources, alleviate the shortage of fresh water, and help realize renewable and sustainable energy supply. © 2023 Elsevier Ltd},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Ju, L. and Liu, L. and Han, Y. and Yang, S. and Li, G. and Lu, X. and Liu, Y. and Qiao, H.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Evolutionary algorithms, Wind power, Multi-objective optimization, optimization, Sustainable development, Stochastic systems, Energy conservation, renewable resource, Stochastic models, Operating costs, algorithm, Power, numerical model, Value engineering, Biomass, Sustainable energy supply, Robust optimization, Energy conversion, Desalination, Waste energy, Bioenergy, Risk perception, Energy conversion systems, Biomass waste energy conversion, Biomass wastes, Micro energy grid, Micro energy grids, P2H},
}

@article{ju_multi-objective_2016,
	title = {Multi-objective operation optimization and evaluation model for {CCHP} and renewable energy based hybrid energy system driven by distributed energy resources in China},
	volume = {111},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84973100814&doi=10.1016%2fj.energy.2016.05.085&partnerID=40&md5=a9fa5ccb6bb52ba786f55f592c51aad1},
	doi = {10.1016/j.energy.2016.05.085},
	abstract = {This paper construct a {CCHP} and renewable energy based hybrid energy system driven by distributed energy resources ({DERs} {CCHP}). Then, the paper constructs performance indexes from energy, economic and environment. Thirdly, the paper proposes a multi-objective optimization model for {DERs} {CCHP} system under four optimization of energy rate ({ER}), total operation cost ({TOC}), carbon dioxide emission reductions ({CER}) and joint optimization. Finally, Guangzhou Higher Education Mega Center ({GHEMC}) in China is taken as the object for comparatively analyzing the operation performance of {DERs} {CCHP} system and {CCHP} system driven by natural gas ({NG} {CCHP} system). Results show: Joint optimization mode could balance the results of different optimization modes. {DERs} {CCHP} system shows better operation performance. {ER} of {ER} optimization, {CER} optimization and joint optimization are higher than that of {NG} {CCHP} system. {NPV} of all optimization modes is positive, {IRR} are bigger than the expected yield rate. {DERs} {CCHP} system could reduce {CO}2 emission by utilizing wind energy and solar energy to replace {NG}. The sensitivity analysis indicates the performance of the {DERs} {CCHP} system will become better with the increase of chiller {COP}, decrease of {NG} price and wind-photovoltaic equipment cost. © 2016 Elsevier Ltd.},
	pages = {322--340},
	journaltitle = {Energy},

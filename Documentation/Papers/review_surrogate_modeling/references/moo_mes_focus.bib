@inproceedings{li_energy_2015,
	title = {Energy Management of Microgrid Considering Different Battery {SOC}},
	isbn = {19341768},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140455215&doi=10.23919%2fCCC55666.2022.9902613&partnerID=40&md5=0d55017e8b02083bd5cde7c0b0792da4},
	doi = {10.23919/CCC55666.2022.9902613},
	abstract = {With wind and solar energy are integrated into power grid especially in microgrid ({MG}), the randomness nature of renewable energy power generation and load demand bring great difficulties to optimize scheduling of {MG}. In this work, a hybrid prediction method is put forward to address this problem. Firstly, to improve forecasting accuracy, variational mode decomposition ({VMD}) is adopted to analyze the input power time-series data. Secondly, each decomposed mode is sent to self-adaptive evolutionary extreme learning machine ({SaE}-{ELM}) separately. The final prediction result is obtained by rebuilding the result of every mode. In order to reduce the volatility of renewable energy generate electricity and load, an energy management strategy is proposed. Different from traditional energy management method, the battery {SOC} is considered when calculating the energy storage cost. Finally, a non-dominated sorting genetic algorithm {II} ({NSGA}-{II}) is applied to solve the multi-objective optimization problem. The simulation results reveal that the proposed energy management strategy is superior to other reported methods in terms of economic and environmental benefits.  © 2022 Technical Committee on Control Theory, Chinese Association of Automation.},
	pages = {5306--5312},
	publisher = {{IEEE} Computer Society},
	author = {Li, F. and Dou, C. and Zheng, Y.},
	editor = {{Zhao Q.} and {Liu S.}},
	date = {2015},
	keywords = {Multiobjective optimization, Electric power transmission networks, Energy management systems, Genetic algorithms, Microgrid, Multi-objective optimization problem, Energy management, Secondary batteries, Digital storage, Machine learning, Solar energy, Management strategies, Forecasting, Energy management strategy, Learning machines, Microgrid ({MG}), Battery {SOC}, Knowledge acquisition, multi-objective optimization problem ({MOP}), Self-adaptive evolutionary extreme learning machine, self-adaptive evolutionary extreme learning machine ({SaE}-{ELM}), variational mode decomposition, variational mode decomposition ({VMD})},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@inproceedings{li_new_2023,
	title = {New Technology and Integrated Optimization of Distributed Energy Storage Power Generation},
	isbn = {979-8-3503-1385-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173828821&doi=10.1109%2fEEPS58791.2023.10256696&partnerID=40&md5=b1995eddca1a12be131d76092e513a14},
	doi = {10.1109/EEPS58791.2023.10256696},
	abstract = {Distributed energy storage ({DES}) systems have become a promising technology that can address challenges related to intermittent renewable energy, grid stability, and demand fluctuations. This article first describes different forms of distributed energy storage and generation systems, and compares and analyzes them in terms of scale, layout, configuration, and application. Due to the significant differences in the implementation methods of distributed energy storage power generation based on different principles, the above factors should be fully considered when applying. The designed {DES} system needs to be integrated with the distribution network, so this paper introduces the committed steps of the integration of the {DES} system and the distribution network, then sorts out the commonly used optimization goals of {DES} integration, such as cost minimization, peak shaving, emission reduction and multi-objective optimization, and finally gives the mainstream algorithm of the basic optimization of the {DES} system. The {DES} system can enhance grid flexibility, improve renewable energy utilization, and help establish more sustainable and resilient energy infrastructure. © 2023 {IEEE}.},

@article{humfrey_dynamic_2019,
	title = {Dynamic charging of electric vehicles integrating renewable energy: A multiobjectiveoptimisation problem},
	volume = {2},
	issn = {25152947},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073340420&doi=10.1049%2fiet-stg.2018.0066&partnerID=40&md5=efad7414d9ca4dbe98a29ed2e1a230d0},
	doi = {10.1049/iet-stg.2018.0066},
	abstract = {Dynamically charging electric vehicles ({EVs}) have the potential to significantly reduce range anxiety and decrease the size of battery required for acceptable range. However, with the main driver for progressing {EV} technology being the reduction of carbon emissions, consideration of how a dynamic charging system would impact these emissions is required. This study presents a demand-side management method for allocating resources to charge {EVs} dynamically considering the integration of local renewable generation. A multi-objective optimisation problem is formulated to consider individual users, an energy retailer and a regulator as players with conflicting interests. A 19\% reduction in the energy drawn from the power grid is observed over the course of a 24 h period when compared with a first-come-first-served allocation method. This results in a greater reduction in {CO}2 emissions of 22\% by considering the power grid's make-up at each time interval. Furthermore, a 42\% reduction in {CO}2 emissions is achieved compared to a system without local renewable energy integration. By varying the weights assigned to the players' goals, the method can reduce overall demand at peak times and produce a smoother demand profile. System fairness is shown to improve with an average Gini coefficient reduction of 4.32\%. © 2019 Institution of Engineering and Technology. All rights reserved.},
	pages = {250--259},
	number = {2},
	journaltitle = {{IET} Smart Grid},
	publisher = {Institution of Engineering and Technology},
	author = {Humfrey, H. and Sun, H. and Jiang, J.},
	date = {2019},
	keywords = {Multiobjective optimization, Electric power transmission networks, Carbon dioxide, Renewable energies, Charging (batteries), Carbon emissions, Electric utilities, Electric Vehicles ({EVs}), Allocation methods, Electric automobiles, Charging systems, Energy retailers, First come first served, Gini coefficients},
}

@inproceedings{huo_simulation_2024,
	title = {Simulation and Optimization of Power System Operation for Renewable Energy and Advanced Energy Storage Technology Based on Comprehensive Data of New Energy Storage},
	isbn = {979-8-3315-2766-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216069883&doi=10.1109%2fCIPAE64326.2024.00057&partnerID=40&md5=2845124b089066cb09c1f043e7fb8cdd},
	doi = {10.1109/CIPAE64326.2024.00057},
	abstract = {This paper presents a comprehensive approach to simulating and optimizing power system operations with a focus on large-scale integration of renewable energy sources, such as wind and photovoltaic power, alongside advanced energy storage technologies. Amid stringent global carbon emission restrictions and dwindling mineral resources, accurately modeling renewable energy outputs is critical for assessing peak load regulation and absorption capacities. The study explores current trends and future directions in energy storage within the Jiangsu power grid, projecting an installed capacity of 5 million kilowatts by 2027. It highlights various storage technologies, including electrochemical, compressed air, gravity, flywheel, superconducting, supercapacitor, and hydrogen storage. Emphasis is placed on new energy storage integrated real-time data and digital twin technologies for real-time monitoring, fault detection, and optimization, enhancing storage system efficiency and safety. The proposed simulation model optimizes coordination between conventional and renewable energy sources, validated through empirical research on the Jiangsu power grid. The findings underscore the necessity of robust models to manage the variability and uncertainty of renewable energy, paving the way for future research in multi-objective optimization and adaptive modeling for improved grid management strategies. This study plays a vital role in the planning and assessment of large-scale renewable energy deployment and utilization. © 2024 {IEEE}.},
	pages = {288--292},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Huo, X. and Du, Y. and Dai, Q. and Pan, S. and Zhang, Y. and Guan, G. and Mei, X.},
	date = {2024},
	keywords = {Renewable energy source, Renewable energies, Renewable energy integration, Renewable energy integrations, Power grids, Large-scales, Power system operations, New energies, Energy storage technologies, Power system optimization, Digital Twin Technologies, Digital twin technology, Power systems optimizations},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@inproceedings{huo_two-step_2020,
	title = {A two-step multi-objective optimization frame-work for microgrid scheduling problem based on cloud-edge computing},
	isbn = {978-1-7281-9606-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101639091&doi=10.1109%2fEI250167.2020.9347092&partnerID=40&md5=358bbdca29a010794b9c252f3d2d31e3},
	doi = {10.1109/EI250167.2020.9347092},
	abstract = {The application of smart metering terminals ({SMTs}) can collect online data of electricity customers, which would help microgrid system to obtain more accurate information of electricity load demand by edge-computing. Hence reasonable dispatch schemes can be made. In this paper, a two-step multi-objective optimization framework for microgrid scheduling problem is proposed based on cloud-edge computing. A typical microgrid structure with smart metering terminals ({SMTs}) is introduced and the cloud-edge computing framework is designed, in which the central energy management system ({CEMS}) is utilized to compute the day-ahead microgrid economical/environmental scheduling problem on the cloud side by forecast data, and the edge-computing servers are applied to re-compute the local optimum schemes on the edge-side during the operation process. Thereafter, the two-step multi-objective optimization strategy is proposed taking advantages of the global computing in cloud-side and the distributed computing in edge-side. The day-ahead global optimization model and the online local optimization model are employed to meet different goals by the two steps. Experimental results show that the proposed strategy is efficient in dealing with the microgrid scheduling problem to reduce cost and emission and can take account of the forecast data errors as well as the global optimum information. © 2020 {IEEE}.},
	pages = {2764--2768},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Huo, Z.-H. and Wang, P. and Zhang, S.-J. and Wang, D. and Kong, Z.},
	date = {2020},
	keywords = {Multiobjective optimization, Energy management systems, Microgrid, Microgrids, Scheduling, Micro-grid systems, Global optimization, Scheduling problem, Information management, Electric power measurement, Cloud-edge computing, Computing frameworks, Dispatch scheme, Edge computing, Electric measuring instruments, Electricity customers, Global computing, Local optimizations, Microgrid structures, Multi-objective optimization strategy, Operation process, Smart metering terminal},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 5},
}

@inproceedings{husain_comparative_2020,
	title = {A Comparative Analysis of Multi-objective Optimization Algorithms for Stand-Alone Hybrid Renewable Energy System},
	isbn = {978-1-7281-4167-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084529345&doi=10.1109%2fICIMIA48430.2020.9074903&partnerID=40&md5=9bbf94bce0d4e325f467ca26dcd0326c},
	doi = {10.1109/ICIMIA48430.2020.9074903},
	abstract = {Energy scarcity is one of the greatest challenges faced by the developing countries like India. Researches are now heading towards developing non-conventional energy sources that are both economical and available naturally in large quantities. In this regard, an urgent requirement has been posed to reduce our dependency on fossil fuels for generating sustainable energy. Standalone systems plays a crucial role in promoting rural electrification. Previous studies have focused single objective optimization or weighted sum approach for multi-objective optimization. We have introduced multi-objective optimization approach in this paper which provides a range of solutions for different objectives. The paper proposes a standalone system consisting of renewable energy sources, namely {PV} and wind combined with battery and diesel generator to fulfill the demand of housing loads in a village of Gujarat. Component sizing have been done by three multi-objective optimization algorithms namely {NSGA} {II}, {NSGA} {III} and {MOPSO} to minimize {LPSP}, {COE} and maximize {RF}. Also we have performed some studies to compare the results of multi-objective optimizations. © 2020 {IEEE}.},

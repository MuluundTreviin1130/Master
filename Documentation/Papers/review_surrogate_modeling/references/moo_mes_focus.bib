@article{li_multi-time_2025,
	title = {{MULTI}-{TIME} {SCALE} {OPTIMAL} {SCHEDULING} {OF} {REGIONAL} {INTEGRATED} {ENERGY} {SYSTEM} {CONSIDERING} {POWER} {ADJUSTABLE} {MARGIN}},

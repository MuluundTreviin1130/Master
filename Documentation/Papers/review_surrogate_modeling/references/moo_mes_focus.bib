	date = {2021},
	keywords = {Multiobjective optimization, Economic and social effects, Energy utilization, Environmental impact, Sustainable development, Stochastic systems, uncertainty analysis, Optimal design, Optimal systems, Carbon, Integer programming, Energy, Uncertainty, Stochastic programming, Systems engineering, Urban energy systems, Based modelling, Energy system design, Energy systems engineering, Energy systems engineerings, Energy-carbon-water nexus, Integrated urban energy system, Superstructure-based modeling},
}

@article{chen_framework_2019,

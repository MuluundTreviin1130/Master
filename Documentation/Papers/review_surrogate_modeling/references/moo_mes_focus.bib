	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission networks, Multi-objective optimization, Particle swarm optimization ({PSO}), Microgrid, Sensitivity analysis, Secondary batteries, optimal operation, Power management, Multi objective, Microgrid systems, Power, Diesel engines, Diesel generators, Multi micro-grids, Electricity grids, multi-microgrid systems, Multi-microgrid system},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2},
}

@article{javidtash_novel_2017,
	title = {A novel mixture of non-dominated sorting genetic algorithm and fuzzy method to multi-objective placement of distributed generations in Microgrids},
	volume = {33},
	issn = {10641246},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85029904778&doi=10.3233%2fJIFS-15934&partnerID=40&md5=0c346a503bf255cb01c6e45344a6e8d9},
	doi = {10.3233/JIFS-15934},
	abstract = {Unlike conventional electrical networks, Microgrids are modern and flexible networks with specific parameters that can work in two modes, connected to general network and island mode. Distributed generations are one of the most important parts of Microgrids, so optimal placement of them requires special analysis because of the impact of placement in different electrical indexes, on the other hand on multi objective optimization a collection of answers will get that is called Pareto front and system operator couldn't choose one of them. This paper presents a novel mixture of non-dominated sorting genetic algorithm and fuzzy method to minimize four objective functions such as cost, emission, power losses, and voltage deviation on a typical 34-bus test Microgrid to sizing six distributed generations and system operator can choose the best point between all of the points on Pareto front based on different conditions of operation of the system. © 2017 - {IOS} Press and the authors. All rights reserved.},
	pages = {2577--2584},
	number = {4},
	journaltitle = {J. Intelligent Fuzzy Syst.},

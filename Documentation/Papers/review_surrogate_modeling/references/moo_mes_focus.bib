@inproceedings{ma_cooperative_2019,
	title = {Cooperative scheduling strategy of distributed energy storage system in regional grid with high proportion of renewable energy},
	volume = {2019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081637925&doi=10.1049%2fcp.2019.0521&partnerID=40&md5=5d2cb714686de33e8b782e4bd3c00979},
	doi = {10.1049/cp.2019.0521},
	abstract = {In recent years, the application of large-scale energy storage system({ESS}) in power grid has shown explosive growth. China has successfully built a number of grid-side {ESS} projects. The {ESS} has a variety of application scenarios in grid-side connection, which can give full play to its advantages of quick response and high operating efficiency. In this paper, a collaborative scheduling strategy of distributed {ESSs} are proposed for regional grid with high proportion of renewable energy including photovoltaic({PV}) and wind power. Based on the day-ahead load and the renewable energy power prediction curve, the {ESSs} adopt the multi-point distributed access method, and make the system operating cost and the voltage deviation minimum as the objective function. The large M method is used to linearize the nonlinear variables multiplied by integer variables and continuous variables respectively, and to transform the multiobjective optimization problem of nonlinear multi-decision variables into a mixed-integer linear programming ({MILP}) problem. Finally, the effectiveness is verified by simulation based on {IEEE} 9 node system. The results show that the access of distributed {ESS} in regional grid can effectively promote the consumption of renewable energy and improve the system voltage level. © 2019 Institution of Engineering and Technology. All rights reserved.},

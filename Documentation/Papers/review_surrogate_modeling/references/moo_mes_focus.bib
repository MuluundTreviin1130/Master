	author = {Ma, T. and Chen, J. and Ma, X. and Yang, Y.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multi-objective optimization, Renewable energy systems, Hybrid power, Hydrogen energy systems, Renewable energies, Clean energy, Energy systems, Non-dominated sorting genetic algorithms, Renewable energy system, Configuration optimization, Systems Configuration, Improved non-dominated sorting genetic algorithm {III}, Improved {NSGA}-{III}, System configuration optimization},
}


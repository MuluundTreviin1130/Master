}

@CONFERENCE{Mamun2025,
	author = {Mamun, Abdullah Al and Leo Jiang, Yazhou},
	title = {Optimal Placement of EV Charging Stations through Integrated Analysis of Transportation Flow and Grid Electrification Hosting Capacity},
	year = {2025},
	journal = {2025 57th North American Power Symposium, NAPS 2025},
	pages = {},
	doi = {10.1109/NAPS66256.2025.11272356},
	url = {https://www.scopus.com/pages/publications/105030488563?origin=resultslist},
	abstract = {The rapid growth in electric vehicle (EV) adoption has created an urgent need for optimally sited charging infrastructure that ensures both user accessibility and compatibility with power grid limitations. This paper proposes a novel data-driven geospatial optimization framework for EV charging station placement that integrates transportation demand, captured through interpolated Average Annual Daily Traffic (AADT), with power grid electrification hosting capacity. The methodology employs Ordinary Kriging for traffic flow interpolation and K-Means clustering to identify candidate locations with high vehicular density. A composite scoring system jointly evaluates traffic intensity and available feeder or substation headroom, ensuring that selected sites are both technically viable and demand responsive. Spatial exclusion constraints based on shortest path distances are imposed to promote geographic diversity and prevent station clustering. A comprehensive case study across seven major interstate highways in New York State demonstrates the framework's effectiveness in producing spatially distributed, grid feasible, and high utility charging station locations.  © 2025 IEEE.},
	author_keywords = {Electric Vehicle (EV); Electrification; EV Charging Infrastructure; Hosting Capacity Map; Transportation-Energy Integration},

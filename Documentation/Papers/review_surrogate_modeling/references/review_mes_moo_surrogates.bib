@article{wang_interval_2023,
	title = {{AN} {INTERVAL} {MULTI}-{OBJECTIVE} {OPTIMIZATION} {STRATEGY} {OF} {ISLAND} {INTEGRATED} {ENERGY} {SYSTEM} {CONSIDERING} {MULTIPLE} {UNCERTAINTIES}},

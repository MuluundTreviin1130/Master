	isbn = {978-1-4799-8313-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84983200851&doi=10.1109%2fSGC.2014.7090870&partnerID=40&md5=76fa06e2b31c10a1d623d04c01bb78fb},
	doi = {10.1109/SGC.2014.7090870},
	abstract = {This paper proposes a multi-objective model for optimal energy management of {CHP} based {MG} (microgrid) with the goal of cost and emission minimization. In order to serve the power and heat demands of the {MG} with minimum cost and emission, demand response ({DR}) program has been implemented. Demand response programs encourage consumers to respond to short-term variations in market electricity prices to reduce their demand during peak load hours. The {MG} considered in this paper consists of power only units, heat only units, {CHP} (combined heat and power) units and energy storage system. Proposed {MG} is capable to sell/buy electrical energy to/from the grid. This paper studies two cases in order to confirm the performance of the proposed method.},

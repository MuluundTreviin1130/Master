@article{humfrey_dynamic_2019,
	title = {Dynamic charging of electric vehicles integrating renewable energy: A multiobjectiveoptimisation problem},
	volume = {2},
	issn = {25152947},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073340420&doi=10.1049%2fiet-stg.2018.0066&partnerID=40&md5=efad7414d9ca4dbe98a29ed2e1a230d0},
	doi = {10.1049/iet-stg.2018.0066},
	abstract = {Dynamically charging electric vehicles ({EVs}) have the potential to significantly reduce range anxiety and decrease the size of battery required for acceptable range. However, with the main driver for progressing {EV} technology being the reduction of carbon emissions, consideration of how a dynamic charging system would impact these emissions is required. This study presents a demand-side management method for allocating resources to charge {EVs} dynamically considering the integration of local renewable generation. A multi-objective optimisation problem is formulated to consider individual users, an energy retailer and a regulator as players with conflicting interests. A 19\% reduction in the energy drawn from the power grid is observed over the course of a 24 h period when compared with a first-come-first-served allocation method. This results in a greater reduction in {CO}2 emissions of 22\% by considering the power grid's make-up at each time interval. Furthermore, a 42\% reduction in {CO}2 emissions is achieved compared to a system without local renewable energy integration. By varying the weights assigned to the players' goals, the method can reduce overall demand at peak times and produce a smoother demand profile. System fairness is shown to improve with an average Gini coefficient reduction of 4.32\%. © 2019 Institution of Engineering and Technology. All rights reserved.},
	pages = {250--259},
	number = {2},
	journaltitle = {{IET} Smart Grid},
	publisher = {Institution of Engineering and Technology},
	author = {Humfrey, H. and Sun, H. and Jiang, J.},
	date = {2019},
	keywords = {Multiobjective optimization, Electric power transmission networks, Carbon dioxide, Renewable energies, Charging (batteries), Carbon emissions, Electric utilities, Electric Vehicles ({EVs}), Allocation methods, Electric automobiles, Charging systems, Energy retailers, First come first served, Gini coefficients},
}

@inproceedings{huo_simulation_2024,
	title = {Simulation and Optimization of Power System Operation for Renewable Energy and Advanced Energy Storage Technology Based on Comprehensive Data of New Energy Storage},
	isbn = {979-8-3315-2766-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216069883&doi=10.1109%2fCIPAE64326.2024.00057&partnerID=40&md5=2845124b089066cb09c1f043e7fb8cdd},
	doi = {10.1109/CIPAE64326.2024.00057},
	abstract = {This paper presents a comprehensive approach to simulating and optimizing power system operations with a focus on large-scale integration of renewable energy sources, such as wind and photovoltaic power, alongside advanced energy storage technologies. Amid stringent global carbon emission restrictions and dwindling mineral resources, accurately modeling renewable energy outputs is critical for assessing peak load regulation and absorption capacities. The study explores current trends and future directions in energy storage within the Jiangsu power grid, projecting an installed capacity of 5 million kilowatts by 2027. It highlights various storage technologies, including electrochemical, compressed air, gravity, flywheel, superconducting, supercapacitor, and hydrogen storage. Emphasis is placed on new energy storage integrated real-time data and digital twin technologies for real-time monitoring, fault detection, and optimization, enhancing storage system efficiency and safety. The proposed simulation model optimizes coordination between conventional and renewable energy sources, validated through empirical research on the Jiangsu power grid. The findings underscore the necessity of robust models to manage the variability and uncertainty of renewable energy, paving the way for future research in multi-objective optimization and adaptive modeling for improved grid management strategies. This study plays a vital role in the planning and assessment of large-scale renewable energy deployment and utilization. © 2024 {IEEE}.},
	pages = {288--292},

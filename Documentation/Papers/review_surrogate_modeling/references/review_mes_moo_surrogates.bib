	isbn = {978-1-4799-2705-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84906689745&doi=10.1109%2fIPEC.2014.6869738&partnerID=40&md5=7b1aaaa40081e660321b6cc544650755},

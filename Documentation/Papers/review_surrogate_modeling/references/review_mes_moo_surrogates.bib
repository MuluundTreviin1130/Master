	keywords = {Multi-objectives optimization, Multiobjective optimization, Economic and social effects, Energy efficiency, Microgrid, Carbon, Renewable energies, Optimization algorithms, Carbon neutralities, {ECONOMICS}, 5G mobile communication systems, Base stations, Multi objective optimization, Peak-shaving, 5g base station, carbon peak shaving and carbon neutrality, Carbon peaks, whale optimization algorithm},
}

@article{guo_power_2021,
	title = {Power Transaction Method of Microgrid Group Based on Blockchain},
	volume = {47},
	issn = {10036520},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85120908995&doi=10.13336%2fj.1003-6520.hve.20210373&partnerID=40&md5=1b29f9993fecd3b7ca5e400c8e8948e1},
	doi = {10.13336/j.1003-6520.hve.20210373},
	abstract = {Aimed at the problems of low security, low transaction efficiency and unbalanced economic benefits in the current microgrid ({MG}) group transaction model, an {MG} group power transaction model based on blockchain is constructed. In the data layer, the asymmetric encryption algorithm {SM}2 and hash algorithm {SM}3 independently developed by the state are used to authenticate the participants of the transaction, and the roles of the buyer and the seller are determined by the net load value. In the consensus layer, the delegated proof of stake ({DPOS}) consensus mechanism based on credit value is used to prevent the transaction participants from cheating and malicious attacks. In the incentive layer, the price adjustment and contract matching mechanism based on credit value incentive are designed to encourage all participants to actively participate in the transaction and improve the transaction efficiency. In the contract layer, the multi-objective optimization based on particle swarm optimization is integrated into the intelligent contract to select the optimal power purchase scheme of {MG} swarm optimization to maximize the interests of both parties. Based on Python simulation environment, the proposed method is verified by experiments, the experimental results show that the incentive mechanism and consensus mechanism of the proposed method are effective, and the longest consensus time is only 1.11 ms. Although the proposed method increases part of the transaction delay, it achieves higher security and economic benefits. © 2021, High Voltage Engineering Editorial Department of {CEPRI}. All right reserved.},
	pages = {3810--3818},

@inproceedings{mavromatidis_multi-objective_2014,
	title = {Multi-objective optimization to simultaneously address energy hub layout, sizing and scheduling using a linear formulation},
	isbn = {978-1-138-02725-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84941992264&doi=10.1201%2fb17488-108&partnerID=40&md5=5c87b02e7223f565b374df55fcdc34e9},
	doi = {10.1201/b17488-108},
	abstract = {Multi-energy systems are expected to play an important role in balancing future energy demands and supplies. Effective design and operation of such systems is crucial for the realization of the benefits they promise. The ‘energy hub’ modelling framework can be used to optimize the interaction between multiple energy sources, conversion and storage devices. This paper details an optimization process dealing with the simultaneous element selection and sizing of an energy hub (taking into account the operational characteristics of each element) aswell as calculating the optimal operation schedule. Thiswas performed for multiple objectives (using the ε-constraint method), and a linear model (mixed-integer linear programming).Acase study is presented for an energy hub consisting of conventional and renewable generation technologies as well as thermal storage technologies, to be installed in a commercial building to meet its thermal and electrical energy requirements. © 2015 Taylor \& Francis Group, London.},

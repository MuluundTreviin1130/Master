@ARTICLE{Bian202224179,
	author = {Bian, Feiyu and You, Shi and Zhao, Haoran and Chen, Changnian and Yu, Zeting and Lai, Yanhua},
	title = {Energy, exergy, economy analysis, and multi-objective optimization of a novel integrated energy system by combining artificial neural network and whale optimization algorithm},

	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Environmental management, Carbon dioxide, Hybrid systems, Emission control, Solar energy, Temperature, Solar fuels, {CO} 2 emission, {CCHP}, Fuel storage, Operation strategy, Multi energy, Chemical stability, {CCHP} system, Thermochemicals, multi-energy hybrid, solar thermochemical},
}

@article{liu_multi-objective_2015-1,

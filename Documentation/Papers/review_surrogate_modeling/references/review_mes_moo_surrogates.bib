	publisher = {Taylor and Francis Ltd},
	author = {Jin, T. and Yu, Y. and Elsayed, E.},
	date = {2015},
	keywords = {Power quality, optimization, Distributed power generation, Multi-criteria optimization, Multicriteria optimization, Loss of load probability, Energy resources, Solar energy, onsite generation, distributed energy resources, Distributed generation system, Quality control, Reliability and power qualities, Distributed generation planning, Statistical quality control, variation propagation},
}

@article{jing_gridconnected_2022,
	title = {A Grid‐Connected Microgrid Model and Optimal Scheduling Strategy Based on Hybrid Energy Storage System and Demand‐Side Response},
	volume = {15},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124010142&doi=10.3390%2fen15031060&partnerID=40&md5=55df0f148bf7a14625bfd03ba3e2f1b0},
	doi = {10.3390/en15031060},
	abstract = {The power gap between supply and demand in the microgrid caused by the uncertainty of wind and solar output and users’ electricity consumption needs to be absorbed by the hybrid energy storage devices and the demand‐side electricity price response. To maximize the service life of the lithium battery pack, this paper optimizes a reasonable ratio of the supercapacitor pack’s daily charge and discharge times to the daily cycle times of the lithium battery pack. The model construction includes two parts: power prediction and multi‐objective optimization modeling. In the case study, a microgrid district under the Guizhou Power Grid is analyzed and discussed. Based on the predicted wind output, solar output, and load demand on a certain day, the optimal scheduling results have been obtained. On the one hand, a reasonable ratio regarding the daily charge and discharge times of hybrid energy storage devices has been obtained under the optimized parameter k in the model. Correspondingly, the daily operation and maintenance of the lithium battery pack is minimum. On the other hand, when the hybrid energy storage devices and demand‐side electricity price response are included and not, the changes on the supply and demand sides (a) and of three evaluation indicators (b) are compared, respectively. Thus, the effectiveness of the model in this paper is verified. © 2022 by the authors. Licensee {MDPI}, Basel, Switzerland.},
	number = {3},
	journaltitle = {Energies},
	publisher = {{MDPI}},
	author = {Jing, Y. and Wang, H. and Hu, Y. and Li, C.},
	date = {2022},
	keywords = {Electric power transmission networks, Microgrid, Electric energy storage, Scheduling, {ECONOMICS}, Demand-side, Electricity prices, Battery Pack, Charge and discharge, Lithium batteries, Microgrid modeling, Optimal scheduling strategies, Optimal scheduling strategy, Demand‐side electricity price response, Hybrid energy storage devices, Microgrid model, Price response},
}

@inproceedings{jinyuan_optimization_2024,
	title = {The optimization model of wind-optical co-storage configuration for campus microgrid based on improved particle swarm optimization algorithm},
	isbn = {979-8-3503-6820-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000621543&doi=10.1109%2fICEACE63551.2024.10898908&partnerID=40&md5=362b7d09b3849d99ebae89235781a2e6},
	doi = {10.1109/ICEACE63551.2024.10898908},
	abstract = {As the world gradually faces problems such as fossil energy exhaustion and environmental pollution, the demand for new energy has been greatly spawned. In this paper, the energy storage configuration optimization problem of a park microgrid under the combined power supply mode of solar power generation and main grid is studied. Through the combination of multi-objective optimization and algorithm, the energy storage configuration is optimized, and the optimal wind and solar storage coordination optimization configuration scheme is given. In this paper, the energy storage configuration scheme independently operated by each park is developed according to the requirements and the economy is analyzed. The average wind, optical power and load power per hour are obtained by using the Simpson method to integrate the data. After data analysis, a power purchase scheme was developed to reduce the amount of abandoned power, and the four economic index values h of the three parks were calculated based on the power purchase scheme. The sensitivity analysis of the factors affecting the four indexes is carried out to find the key factors affecting the economic indexes in each park. Then the optimization model based on particle swarm optimization algorithm is established. Then the energy storage configuration scheme of the joint park is developed and its economy is analyzed. First, the load power and wind and solar power of the joint park are combined as joint Park D, and the problem 1.2 model is introduced to solve the relevant economic indicators without energy storage. Then, the advantages of the joint park are analyzed, and it is found that the wind-light power generation consortium of the joint park is conducive to the complementary power generation, the load consortium is conducive to the full use of wind-light power generation, and the use of batteries is conducive to the spatio-temporal transfer of wind-light resources. Finally, the future landscape storage coordination configuration plan of the park is formulated and its economy is analyzed. An optimization model aiming at the total cost of power purchase in the park within 5 years is established. A set of investment plan with considerable return is obtained by solving it, and an economic analysis and demonstration report of the plan is given according to its economic indicators. © 2024 {IEEE}.},
	pages = {615--618},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Jinyuan, Z.},
	date = {2024},
	keywords = {Particle swarm optimization ({PSO}), Microgrid, Microgrids, Linear programming, Sensitivity analysis, Power- generations, Solar power generation, energy storage, Energy, Power, Static Var compensators, Particle swarm, Optimization models, Optimization model, Sensitivity analyzes, Overhead lines, Interpolation, Ferroelectric {RAM}, Cubic spline interpolation, Cubic-spline interpolation, Fiber optic sensors, Industrial wastes, particle swarm improvement, Picture archiving and communication systems, Simpson numerical integration, Splines},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: Z. Jinyuan; Southwest Jiaotong University, Chengdu, China; email: zh\_1625610138@qq.com},
}

@article{jirdehi_multi_2017,
	title = {Multi objective stochastic microgrid scheduling incorporating dynamic voltage restorer},
	volume = {93},
	issn = {01420615},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85020803284&doi=10.1016%2fj.ijepes.2017.06.010&partnerID=40&md5=9ec20ff27189b87fce46be7e44ecbc97},
	doi = {10.1016/j.ijepes.2017.06.010},
	abstract = {This paper focus on optimal scheduling of microgrid including thermal and electrical loads, renewable energy sources (solar and wind), combined heat and power ({CHP}), conventional energy sources (boiler and micro turbine), energy storage systems (thermal and electrical storages), and series flexible alternating current transmission system ({FACTS}) devices. Dynamic Voltage Restorer ({DVR}) is included in the line between the main network and the microgrid in order to achieve a higher power transfer to the upstream grid. In the proposed method, wind speed, solar radiation, and loads are modelled as uncertain parameters based on a stochastic approach. The problem is modelled as a linear, mixed integer, constrained, and multi objective optimization one aiming at minimizing cost and pollution at the same time. Also, a sensitivity analysis is proposed for studying the sensitive parameters in microgrid management. The proposed multi objective and stochastic problem is solved by using the augmented Epsilon-constraint method. All results and calculations are obtained by using {GAMS}24.1.3/{CPLEX}12.5.1. Finally, in order to confirm the results of the proposed method, final results are compared to the genetic algorithm method. Simulation results demonstrate the viability and effectiveness of the proposed scheduling method for microgrid. © 2017 Elsevier Ltd},

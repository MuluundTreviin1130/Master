@inproceedings{li_optimization_2020,
	title = {{OPTIMIZATION} {MODEL} {OF} {DISTRIBUTED} {ENERGY} {SUPPLY} {SYSTEM} {BASED} {ON} {MULTI}-{ENERGY} {COMPLEMENTARITY}},

}

@inproceedings{wang_multi-objective_2024-4,
	title = {Multi-objective Optimization Strategy for Virtual Power Plant with Flexible Data Center},
	isbn = {979-8-3503-7579-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199795249&doi=10.1109%2fCEEPE62022.2024.10586281&partnerID=40&md5=9adc9f9df96b4c2ff507f4b7fe0d75f8},
	doi = {10.1109/CEEPE62022.2024.10586281},
	abstract = {As an emerging load category, data centers are developing rapidly in recent years. Data centers are characterized by high energy consumption, which brings great challenges to the flexibility of power systems. Virtual power plant ({VPP}) could improve energy utilization efficiency and increase power reliability, which is an effective choice to solve the problem of high energy consumption in data centers. In the existing literature, the operation strategies are mostly single-objective optimal, neglecting the optimization for the flexibility indicators. In view of the above knowledge gaps, a multi-objective optimization strategy for virtual power plant ({VPP}) incorporating data center is proposed in this paper. Firstly, a multi-objective operation optimization model is established, where flexibility indicators are incorporated. Then, a multi-objective hybrid optimization algorithm is investigated to solve the proposed multi-objective operation optimization model. Finally, case studies based on actual data verifies that the proposed strategy could effectively improve the flexibility of {VPP} and renewable energy accommodation while decreasing carbon emissions.  © 2024 {IEEE}.},
	pages = {1265--1269},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Wang, X. and Liu, Z. and An, Q. and Li, G.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Energy utilization, Multi objective, Virtual power plants, Power, Virtual power plant, Optimization models, Operations optimization, Optimization strategy, datacenter, Data center, Power system flexibilities, power system flexibility, High energy consumption},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: Q. An; North China Electric Powery University, State Key Laboratory Of Alternate Electrical Power System With Renewable Energy Sources, Beijing, China; email: anqi-ncepu@foxmail.com},
}


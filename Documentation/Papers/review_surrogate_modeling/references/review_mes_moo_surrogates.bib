	date = {2015},
	keywords = {Multiobjective optimization, Battery management systems, Electric batteries, Electric power transmission networks, Energy utilization, Electric power systems, Solar power generation, Energy conservation, Renewable energies, Secondary batteries, Photovoltaic cells, Houses, Optimal capacity, Smart power grids, heating, Water supply, Optimal number, Controllable loads, Hot-water supply, Operational methods, {PV} generators, Without shortage},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},

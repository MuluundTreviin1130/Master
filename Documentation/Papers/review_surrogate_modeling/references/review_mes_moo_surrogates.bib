	isbn = {18766102},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063863523&doi=10.1016%2fj.egypro.2019.01.808&partnerID=40&md5=aa060688cdc2d1df0cd06c3fb8dc4042},
	doi = {10.1016/j.egypro.2019.01.808},
	abstract = {In this work, a model is built to test the optimal design and performance of a multi-energy systems at five different levels of decentralization, ranging from 225 individual buildings systems to a single district system supplying all building's energy demands. A multi-objective analysis, minimizing both costs and emissions with the epsilon-constraint method, was used to select five Pareto optimal solutions for each level. The considered technologies include gas boilers, oil boilers, photovoltaics, solar thermal panels, ground source heat pumps, air source heat pumps, fuel cells, electrolysers, batteries, thermal storage, and hydrogen storage. It was found that the lowest levels of decentralization (i.e., building or neighbourhood level) were able to achieve the highest level of reduction in carbon emissions and self-sustainability. This is due to the potential for heat pump technologies to be installed on the building level that was not an option on the higher levels of decentralization due to borehole availability and capacity restrictions. On the building level, the combination of {PV} panels, a heat pump, and a thermal storage tank was found to be the most cost effective and carbon neutral option. © 2019 The Authors. Published by Elsevier Ltd. This is an open access article under the {CC} {BY}-{NC}-{ND} license (http://creativecommons.org/licenses/by-nc-nd/4.0/) Peer-review under responsibility of the scientific committee of {ICAE}2018 - The 10th International Conference on Applied Energy.},
	pages = {4204--4209},
	publisher = {Elsevier Ltd},
	author = {Murray, P. and Orehounig, K. and Carmeliet, J.},
	date = {2014},
	keywords = {Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Buildings, Cost effectiveness, Optimal systems, Carbon, Fuel cells, Hydrogen storage, Solar power generation, Heat storage, Pareto principle, Photovoltaic cells, Pumps, Cost benefit analysis, Multi-energy systems, Pareto optimal solutions, Renewable energy integration, Renewable energy integrations, Boilers, Epsilon-constraint method, Structural design, Air source heat pumps, Geothermal heat pumps, Multi-objective analysis, Decentralized energy system, Capacity restriction, Decentralized energy systems, Scale effects, Scale effects of decentralization},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 14; Correspondence Address: P. Murray; {ETH} Zürich, Department of Building Physics, Zürich, Stefano-Francini-Platz 5, {CH}-8093, Switzerland; email: murrayp@ethz.ch},
}


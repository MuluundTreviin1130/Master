@ARTICLE{Ruan2023,
	author = {Ruan, Jiaqi and Yang, Chao and Wang, Qihan and Wang, Shuyi and Liang, Gaoqi and Zhao, Junhua and Qiu, Jing},
	title = {Assessment of spatiotemporally coordinated cyberattacks on renewable energy forecasting in smart energy system},
	year = {2023},
	journal = {Applied Energy},
	volume = {347},

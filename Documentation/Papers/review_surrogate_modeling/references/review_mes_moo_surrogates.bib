@article{ouyang_research_2019,
	title = {Research on multi-time scale optimization strategy of cold-thermal-electric integrated energy system considering feasible interval of system load rate},
	volume = {12},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071269942&doi=10.3390%2fen12173233&partnerID=40&md5=3ec7462422b464cbe4ce477481ea8c95},
	doi = {10.3390/en12173233},
	abstract = {The integrated energy system coupling multi-type energy production terminal to realize multi-energy complementarity and energy ladder utilization is of great significance to alleviate the existing energy production crisis and reduce environmental pollution. In this paper, the topology of the cold-thermal-electricity integrated energy system is built, and the decoupling method is adopted to analyze the feasible interval of load rate under the strong coupling condition, so as to ensure the “source-load” power balance of the system. Establishing a multi-objective optimization function with the lowest system economic operation and pollution gas emission, considering the attribute differences and energy scheduling characteristics of different energy sources of cold, heat and electricity, and adopting different time scales to optimize the operation of the three energy sources of cold, heat and electricity, wherein the operation periods of electric energy, heat energy and cold energy are respectively 15 min, 30 min and 1 h; The multi-objective problem is solved by standard linear weighting method. Finally, the mixed integer nonlinear programming model is calculated by {LINGO} solver. In the numerical simulation, the hotel summer front load parameters of Zhangjiakou, China are selected for simulation and compared with a single time scale system. The simulation results show that the multi-time scale system reduces the economic operation cost by 15.6\% and the pollution gas emission by 22.3\% compared with the single time scale system, it also has a wider feasible range of load rate, flexible time allocation, and complementary energy selection. © 2019 by the authors.},
	number = {17},
	journaltitle = {Energies},
	publisher = {{MDPI} {AG}},
	author = {Ouyang, B. and Yuan, Z. and Lu, C. and Qu, L. and Li, D.},
	date = {2019},
	keywords = {Multiobjective optimization, Gas emissions, Pollution, Integer programming, Multi objective, multi-objective, Nonlinear programming, Integrated energy systems, Multi-time scale, Complementation, Multi-energy complementation, Cold-thermal-electricity integrated energy system, Feasible interval of load rate, Load rate, Multi time scales, Optimize operation, Scales (weighing instruments), Time measurement},
}

@inproceedings{pan_analysis_2023,
	title = {Analysis of demand response potential of industrial consumer based on multi-energy complementation},
	isbn = {979-8-4007-0951-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190361435&doi=10.1145%2f3644523.3644649&partnerID=40&md5=e719559e45c0dabeba3bd18925f8bb4d},
	doi = {10.1145/3644523.3644649},
	abstract = {With the continuous development of the social economy and the promotion of the carbon peaking and carbon neutrality goals, the new power system is connected to a high proportion of new energy, and the social electricity consumption is showing a continuous increasing trend. The peak valley difference of power grid load has become increasingly prominent, bringing greater challenges to the peak shaving of the power system. This article analyzes the potential of coal-fired self-owned power plant enterprises to participate in the optimization of source-grid-load operation. By analyzing the costs and benefits of reducing the various systems of plant power, it proposes a multi-objective optimization method for coal-fired self-owned power plants to consider minimizing economic costs, load fluctuations and risk fluctuations. The optimization method for plant power load participation in source-grid-load collaborative operation is proposed. Through example analysis, it has been proven that the participation of auxiliary power loads in the collaborative scheduling of source-grid-load can reduce peak load and fill valley load, effectively improve the utilization efficiency of unit auxiliary equipment, and reduce enterprise electricity costs.  © 2023 {ACM}.},

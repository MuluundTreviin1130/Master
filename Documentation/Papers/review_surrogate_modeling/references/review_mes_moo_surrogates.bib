@ARTICLE{Li2025248,
	author = {Li, Sichen and Hu, Weihao and Cao, Di and Hu, Jiaxiang and Chen, Zhe and Blaabjerg, Frede},
	title = {Coordinated Operation of Multiple Microgrids With Heat-Electricity Energy Based on Graph Surrogate Model-Enabled Robust Multiagent Deep Reinforcement Learning},

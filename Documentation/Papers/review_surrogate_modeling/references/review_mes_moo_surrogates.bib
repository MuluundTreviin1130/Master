	keywords = {Multiobjective optimization, Renewable energy source, Renewable energy sources, Renewable energy, Energy utilization, Multi-objective optimization problem, Linear programming, Integer programming, Electric vehicles, Vehicle-to-grid, Clean energy, Energy, Power, Charging station, Geophysical prospecting, Surface waters, Wind power integration, Integer Linear Programming, Mixed-integer linear programming, Charge storage, {DG} unit, Mixed integer linear, Phosphate deposits, Sailing vessels, Sizing and siting, Vehicle to grids},

	date = {2020},
	keywords = {Multiobjective optimization, Electric load dispatching, Genetic algorithms, Microgrids, droop control, Scheduling, Economic dispatch, {DC} microgrid, Elitist non-dominated sorting genetic algorithms, Capacity matching, Controllable ranges, elitist non-dominated sorting genetic algorithm ({NSGA}-Π), Operation point, Signal analysis, Simulation model, Small signal, Small-signal analysis, Stability conclusion},
}


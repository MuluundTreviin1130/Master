@article{liu_multi-objective_2024-2,
	title = {Multi-objective optimization of power networks integrating electric vehicles and wind energy},
	volume = {24},
	issn = {26673053},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208172720&doi=10.1016%2fj.iswa.2024.200452&partnerID=40&md5=9014fe1d56ea166806dfe303e6bcf6a7},
	doi = {10.1016/j.iswa.2024.200452},
	abstract = {In the ever-evolving landscape of power networks, the integration of diverse sources, including electric vehicles ({EVs}) and renewable energies like wind power, has gained prominence. With the rapid proliferation of plug-in electric vehicles ({PEVs}), their optimal utilization hinges on reconciling conflicting and adaptable targets, including facilitating vehicle-to-grid (V2 G) connectivity or harmonizing with the broader energy ecosystem. Simultaneously, the inexorable integration of wind resources into power networks underscores the critical need for multi-purpose planning to optimize production and reduce costs. This study tackles this multifaceted challenge, incorporating the presence of {EVs} and a probabilistic wind resource model. Addressing the complexity of the issue, we devise a multi-purpose method grounded in collective competition, effectively reducing computational complexity and creatively enhancing the model's performance with a Pareto front optimality point. To discern the ideal response, fuzzy theory is employed. The suggested pattern is rigorously tested on two well-established {IEEE} power networks (30- and 118-bus) in diverse scenarios featuring windmills and {PEV} producers, with outcomes showcasing the remarkable excellence of our multi-purpose framework in addressing this intricate issue while accommodating uncertainty. © 2024},
	journaltitle = {Intell. Syst. Applications.},
	publisher = {Elsevier B.V},
	author = {Liu, P. and Guo, J. and Zhang, F. and Zou, Y. and Tang, J.},
	date = {2024},
	keywords = {renewable resource, Electric vehicle, Energy, Wind power integration, Plug-ins, Electric Vehicles ({EVs}), Windmill, Power networks, Renewable resources, Optimality, Collective competition framework, Multi-purpose, Multi-purpose optimality, Pareto enhancement},
}

@article{liu_administration_2023,
	title = {Administration strategy of energy management in smart grid: system view and optimization path},
	volume = {11},
	issn = {2296598X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164574008&doi=10.3389%2ffenrg.2023.1202904&partnerID=40&md5=c6091f83951041d088a3c68e31ba7e7f},
	doi = {10.3389/fenrg.2023.1202904},
	abstract = {Power generation and transmission infrastructure is vulnerable to the interaction of various Distributed Generations ({DG}), which leads to the imbalance of power system operation, frequent voltage drops or spikes, and even power outages. This phenomenon not only wastes energy, but also affects grid security. The main reason is a delayed feedback of circuit failure and load changes, and the optimization of energy management system and path is an effective way to solve the above problems. In this paper, a method of multi-objective optimization based on {ANFIS} algorithm is proposed which can help to improve the demand response, energy storage and management of smart power grid, reduce the volatility of {DGs}, reducing electricity costs and improving energy efficiency. Firstly, based on the {ANFIS} algorithm, the distributed power generation control mode, inverter control, real-time electricity price calculation method, energy transfer and storage scheme are improved, and the optimization path of the energy management system is defined. Secondly, the advantages of {ANFIS} algorithm in response speed and running stability are verified by comparing with other algorithms. Finally, a distributed energy microgrid is constructed for simulation verification. The results show that :(1) {ANFIS} optimization algorithm has good adaptability in smart grid, and has advantages in large amount of data processing and information transmission; (2) The verification model based on {ANFIS} has strong elasticity and efficient response speed. The research results will help solve various problems in the smart grid, including establishing a clear energy management system path, maintaining the stable operation of the power system, providing users with more reasonable power plans and the lowest cost of electricity. Copyright © 2023 Liu, Wang and Wei.},
	journaltitle = {Front. Energy Res.},
	publisher = {Frontiers Media {SA}},
	author = {Liu, P. and Wang, S. and Wei, Y.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission, Energy management systems, Multi-objective optimization, Power quality, Energy efficiency, Energy transfer, Distributed power generation, Energy management, Costs, Electric energy storage, Smart grid, Electric loads, Digital storage, Power, Smart power grids, Demand response, Data handling, Electric power system control, Outages, System optimizations, {ANFIS}, Response speed, Smart grid systems, system view, Systems view},
}

@article{liu_multi-criteria_2024,
	title = {Multi-criteria optimization next to a comparative analysis of a polygeneration layout based on a double-stage gas turbine cycle fueled by biomass and hydrogen},
	volume = {237},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207599824&doi=10.1016%2fj.renene.2024.121669&partnerID=40&md5=c8dc2e719272ee1224a7ca2493274b63},
	doi = {10.1016/j.renene.2024.121669},
	abstract = {The significance and advantages of utilizing renewable energy sources are widely recognized. Upon examining past studies, it was revealed that there has been a lack of research on harnessing the waste energy from double-stage gas turbines powered by biomass-hydrogen hybrid fuel for polygeneration applications. Thus, a new configuration is proposed in the study for the multi-production of electricity, cooling, heating, and potable water. In the current research, a high-pressure turbine is driven by a combustion chamber fed by a biomass gasifier. Meanwhile, a low-pressure turbine is driven by a post-combustion chamber fed by hydrogen as fuel. The heat loss of the topping gas turbine cycle is recuperated by a supercritical Brayton cycle ({SBC}), a steam Rankine cycle ({SRC}), and a water heater. The waste heat of the supercritical Brayton cycle and steam Rankine cycle is recovered through an absorption refrigeration cycle and a thermoelectric generator, respectively. Thus, the heat loss of the topping system is completely recovered. The net power output of the gas turbine cycle is considered the electricity production of the system while the output power of the {SBC} and {SRC} is utilized in a reverse osmosis desalination system to produce potable water. The investigations conducted on the system are thermodynamic and exergy-economic assessments and three-objective optimization utilizing 5 gases (i.e., {CO}2, {CO}, Nitrogen, Air, and Helium) in the {SBC}. The final results reveal the superiority of Helium as the supercritical gas, bringing about an exergy efficiency (ηex) of 32.11 \%, a total cost rate (C˙tot) of 103 \$h−1, a payback period ({PP}) of 0.159 years, and a specific cost of polygeneration (cpoly) of 22.03 \${GJ}−1 for the system. Although the levelized cost of products of the configuration is high due to the freshwater production, ηex of the proposed system is higher than the previous systems based on a double-stage gas turbine cycle driven by biomass and hydrogen. © 2024},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Liu, S. and Huang, X. and Zhang, J. and Gao, C. and Wan, Q. and Feng, D.},
	date = {2024},
	keywords = {optimization, alternative energy, electricity generation, Exergy, Biomass, Hydrogen, Waste incineration, Firedamp, Liquefied gases, Synthesis gas, Desalination, Water filtration, Aquifers, turbine, multicriteria analysis, comparative study, Reverse osmosis, Waste heat utilization, Brayton cycle, recovery method, Waste heat recovery, Waste-heat recovery, Brayton, Poly-generation, Supercritical fluid extraction, Rankine, Gas turbine cycles, Polygeneration, Descaling, Double stage, Double-stage gas turbine cycle, High pressure turbomachinery, Hydrogen fuel, Regain, Reverse combustion, Supercritical, Supercritical brayton cycle, Working fluid selection, Working fluid selections},
}

@inproceedings{liu_multi-objective_2015,
	title = {Multi-objective optimization dispatch of {PV}-{MG} considering demand response actions},
	isbn = {19341768},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84987896874&doi=10.1109%2fChiCC.2016.7553777&partnerID=40&md5=f5f2a1a64f7e5b923e49527390d73bd2},
	doi = {10.1109/ChiCC.2016.7553777},
	abstract = {On the background of constructing the smart energy city, solar photovoltaic based microgrid ({PV}-{MG}) will play an important role. In this paper, a typical structure of {PV}-{MG}, which is consisted of {PV} power generation system, battery energy storage system ({BESS}), fixed loads ({FLs}), and transferable loads ({TLs}), is constructed firstly. Then in order to improve the economy of {PV}-{MG}'s operation, the influence of the demand response ({DR}) is studied during dealing with the optimization dispatch problem of {PV}-{MG}, and a multi-objective optimization model with various equality and inequality constraints, which objectives are minimization of the total cost of {PV}-{MG}'s operation and energy circulation of {BESS}, is proposed. Focusing on the characteristics of the optimization model, such as multi-objective, multi-constraint, and nonlinearity, a solving strategy based on non-dominated sorting genetic algorithm-{II} ({NSGA}-{II}) is presented also. Finally, case study is performed in {MATLAB}, and several Pareto solution sets are obtained. By analyzing the typical dispatch schemes, the rationality and effectiveness of the established optimization model are verified. © 2016 {TCCT}.},
	pages = {2728--2733},
	publisher = {{IEEE} Computer Society},

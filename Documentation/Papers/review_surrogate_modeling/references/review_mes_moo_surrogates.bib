	author = {An, S. and Chen, M. and Wei, Z. and Qiu, F.},
	date = {2020},
	keywords = {Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Microgrid, Microgrids, Distributed generators, Distributed power generation, Photovoltaic cells, energy storage, Investments, Reliability analysis, Electric power supplies to apparatus, {CCHP}, Chaos, Chaos theory, Combined cooling heating and power, Comprehensive utilizations, Hybrid {PV}/Wind, Multi-objective genetic algorithm, Optimized configuration, Performance indices, Power supply reliability, Reliability of power supply},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 4},
}

@inproceedings{anatone_integration_2013,
	title = {Integration of {CCHP} and solar plants for household applications a multiobjective optimization model},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84899125607&doi=10.1109%2fICRERA.2013.6749806&partnerID=40&md5=a8eb1c5496e1bec92f00bf11f84cea05},
	doi = {10.1109/ICRERA.2013.6749806},
	abstract = {In the last years the household sector has become the main energy consumer. Among the actions for a more rational and more sustainable primary energy exploitation, cogeneration and trigeneration, eventually integrated with technologies based on renewable energy sources, are assuming a great role in the sector. The optimization of the system components and the overall plant reflects the choice of costs or {CO}2 emissions minimization leading to several solutions in a multiobjective context. This work, through a mathematical model, shows that different integration levels among the components play a crucial role on the efficiency of the system as a whole, even if the single component does not operate in its own best conditions. © 2013 {IEEE}.},

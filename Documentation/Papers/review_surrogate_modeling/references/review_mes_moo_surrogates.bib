	keywords = {Multi-objectives optimization, Multiobjective optimization, Microgrid, Microgrids, Optimisations, Energy management, Distribution network, Energy, Optimisation, Power markets, Energy markets, Integer Linear Programming, Local energy, Local energy market, local energy markets, microgrid network, Mixed-integer linear programming, Residential communities, Reverse Power flows},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: H. Ali; Victoria University of Wellington, Engineering and Computer Science, Wellington, New Zealand; email: haesum.ali@vuw.ac.nz},

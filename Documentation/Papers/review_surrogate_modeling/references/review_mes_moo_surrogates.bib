	author = {Han, X. and Liang, D. and Wang, H.},
	date = {2020},
	keywords = {Multiobjective optimization, Electric power transmission networks, Genetic algorithms, Particle swarm optimization ({PSO}), Multi-objective optimization models, Photovoltaic cells, Vehicle-to-grid, energy storage, Digital storage, Solar energy, Hybrid energy storage system, Office buildings, Hybrid energy storage systems, Electric power system planning, photovoltaic power generation, Renewable energy consumption, Energy storage technologies, Adaptive control systems, ensemble empirical mode decomposition, Optimal control methods, Back propagation neural networks, Backpropagation, electric vehicle virtual storage, Principal component analysis, Principle component analysis, tracking planned output, Vehicle locating systems},
}


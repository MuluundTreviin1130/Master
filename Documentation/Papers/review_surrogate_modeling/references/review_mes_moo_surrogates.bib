@inproceedings{lin_optimal_2012,
	title = {Optimal load distribution of microgrid including vanadium redox flow battery},
	isbn = {21574847},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84870552837&doi=10.1109%2fAPPEEC.2012.6307235&partnerID=40&md5=da40d9d16af161b7b2b6096fcf7be165},

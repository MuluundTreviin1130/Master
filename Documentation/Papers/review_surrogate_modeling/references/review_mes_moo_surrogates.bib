	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy supplies, Multi-objective optimization, Cooling systems, Housing, Renewable energies, Energy planning, District heating, Energy resources, Cooling, Waste heat, District heating and cooling, Recycling, Planning scheme, District heating and cooling systems, Energy recycling, Recycling energy, Recycling rate},
}


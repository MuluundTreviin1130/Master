@ARTICLE{Wenzel2025332,
	author = {Wenzel, Moritz and De Din, Edoardo and Zimmer, Marcel and Benigni, Andrea},
	title = {Gaussian Process Supported Stochastic MPC for Distribution Grids},
	year = {2025},
	journal = {IEEE Open Journal of Control Systems},

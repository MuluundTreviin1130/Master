	keywords = {Multiobjective optimization, Cooling systems, District heating, Heating equipment, Multi-energy systems, Energy system optimizations, Cooling, Optimization models, Heating and cooling, District heating networks, Cold district heating network, Cold District Heating Networks, Cold districts, Decentral multi-energy system, {DECENTRAL} {MULTI}-{ENERGY} {SYSTEMS}, Energy System Optimization, Renewable heating, System temperature},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2},

	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Microgrid, Pollution, Optimizers, Operating costs, Pareto principle, Multi objective, Weighted sum method, Multi-verse optimizer, Cost reduction, Fuzzy set theory, Computation theory, Pollutants emissions, Emission level, multi-objective optimization dispatch, Price penalty factor},
}

@article{lagouir_multi-objective_2022,
	title = {Multi-Objective Optimal Dispatching and Operation Control of a Grid Connected Microgrid Considering Power Loss of Conversion Devices},
	volume = {10},
	issn = {18489257},

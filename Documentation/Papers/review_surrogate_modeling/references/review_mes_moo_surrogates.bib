	author = {Chammam, A. and Kumar Tripathi, A. and Nuñez Alvarez, J. R. and O. Alsaab, H. and Romero-Parra, R. M. and Mohammad Mayet, A. and Abdullaev, S. S.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Evolutionary algorithm, Genetic algorithms, Multi-objective optimization, Renewable energy, Energy efficiency, Environmental impact, genetic algorithm, optimization, Optimal design, Optimal systems, Pem fuel cell, Proton exchange membrane fuel cells ({PEMFC}), fuel cell, Exergy, Generation systems, Multi generations, performance assessment, Article, Electricity, heating, Hydrogen, Temperature, controlled study, Cooling, thermodynamics, Desalination, Reverse osmosis, Reverse osmosis desalination, Fresh Water, Multi-generation system, Refrigeration, Bioenergy, Environmental impacts, Antigen, atmospheric pressure, Bioelectric Energy Sources, calculation, chemical reaction, cold, Cold Temperature, critical temperature, current density, Ejector refrigeration, Ejector refrigeration cycle, Ejectors (pumps), energy recovery, evaporation, flammability, genetic recombination, Global warming potential, lymphocyte antigen receptor, microbial fuel cell, natural selection, norflurane, osmotic pressure, ozone depletion, partial pressure, proton exchange membrane fuel cell, Receptors, Refrigerants, Refrigeration cycles, sea water, T-Cell, water vapor},

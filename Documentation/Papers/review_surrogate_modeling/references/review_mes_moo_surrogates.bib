	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85178366412&doi=10.1016%2fj.apenergy.2023.122380&partnerID=40&md5=9d534f02cd9f5beb3609d00064fd1a78},
	doi = {10.1016/j.apenergy.2023.122380},
	abstract = {Recent trends in the increasing penetration of renewable energy generation and the increasingly massive integration of electric vehicles ({EVs}) into multiple-microgrid ({MMG}) systems pose tremendous challenges to the effective energy management of these systems. However, the solutions of current energy management methods have the disadvantage of excessively limited robustness against uncertain fluctuations in renewable energy generation, and existing hierarchical {EV} scheduling methods are solved via an iterative process that is prohibitively time-consuming for real-time practical applications. This work addresses the abovementioned issues by constructing an improved data-driven polyhedral uncertainty set based on modified self-organizing feature map neural networks that perform data clustering. In addition, an iteration-free hierarchical framework is proposed for conducting the tri-layer energy management of {MMGs} with the massive integration of {EVs}. Specifically, the global positive power factor of {EV} aggregation is proposed to formulate a set of constraints into the upper-layer model of the tri-layer framework, which can guarantee the feasibility of the middle-and-lower layer models. The value of this factor is determined using a multi-objective optimization algorithm that makes a trade-off between the feasible range of the output of {EV} aggregators and the degree to which the trip demands of {EVs} are violated. The superiority and effectiveness of the proposed iteration-free robust hierarchical energy management method for {MMGs} are verified via simulations involving a practical {MMG} under high penetrations of renewable energy generation and massive integration of {EVs}. © 2023 Elsevier Ltd},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Tan, B. and Chen, S. and Liang, Z. and Zheng, X. and Zhu, Y. and Chen, H.},
	date = {2024},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Energy management systems, Decision making, Economic and social effects, optimization, Energy management, electricity generation, Renewable energy generation, Electric vehicles, Smart grid, algorithm, Electric vehicle, Microgrid systems, Integration, Iterative methods, Multi micro-grids, Multi-microgrids, Vehicle to grids, Clustering algorithms, Vehicle to grid, Hierarchical systems, Management method, Conformal mapping, Self organizing maps, Hierarchical energy management, Hierarchical method, Layer model, Trilayers},
}


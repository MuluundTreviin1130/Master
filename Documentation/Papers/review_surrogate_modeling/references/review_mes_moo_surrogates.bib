	title = {Probabilistic risk assessment of distribution networks based on topological reconfiguration and PCE surrogate model; [基于拓扑重构及 PCE 代理模型的配电网概率风险评估]},
	year = {2026},
	journal = {Dianli Xitong Baohu yu Kongzhi/Power System Protection and Control},
	volume = {53},
	number = {16},
	pages = {74 - 85},
	doi = {10.19783/j.cnki.pspc.246171},
	url = {https://www.scopus.com/pages/publications/105027858369?origin=resultslist},
	abstract = {Extreme events pose a significant threat to the operational security of distribution networks, making accurate and efficient probabilistic risk assessment crucial. To address the low efficiency of traditional Monte Carlo simulation (MCS) and the insufficiency accuracy of existing surrogate models in low-probability regions, this paper proposes a risk assessment method that balances computational efficiency and accuracy. First, a non-parametric probabilistic model of distributed generation output is built using kernel density estimation (KDE), while dynamic probability modeling of equipment states is performed using exponential distributions and weather factors. Next, the input samples are divided into branch fault and non-fault categories. For non-fault samples, a polynomial chaos expansion (PCE) surrogate model is used for rapid probabilistic power flow calculation. For fault samples, a topology reconfiguration model is employed to calculate optimal power flow and capture risks under topology changes. Based on this, three risk indicators of node voltage over-limit, branch power flow overload, and load loss are constructed. The weights of these indicators are determined by the subjective and objective combination weighting method of game theory, and the comprehensive risk evaluation value is obtained. Simulation results on the IEEE33 and IEEE118 node distribution systems show that the proposed method effectively handles topology uncertainties caused by extreme events, improving both the efficiency and accuracy in risk assessment. © 2026, Power System Protection and Control Press. All rights reserved.},
	author_keywords = {distribution network reconfiguration; extreme events; polynomial chaos expansion; probabilistic risk assessment; uncertainty; 不确定性; 多项式混沌展开; 极端事件; 概率风险评估; 配电网重构},
	keywords = {Additives; Chaos theory; Computation theory; Efficiency; Electric power distribution; Expansion; Game theory; Network security; Network topology; Optimization; Polynomials; Probability distributions; Chaos expansions; Distribution network reconfiguration; Extreme events; Polynomial chaos; Polynomial chaos expansion; Probabilistic Risk Assessment; Uncertainty; 不确定性; 多项式混沌展开; 极端事件; 概率风险评估; 配电网重构; Risk assessment},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Hui2025170723,
	author = {Hui, Huaiyu and Jiang, Xiaomo and Chen, Huize and Zhang, Kexin},
	title = {B2MTGP: A Double Bayesian Multi-Task Gaussian Process Method for Wind Turbine Power Forecasting Under Data Uncertainty},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {170723 - 170734},
	doi = {10.1109/ACCESS.2025.3614474},
	url = {https://www.scopus.com/pages/publications/105017610882?origin=resultslist},
	abstract = {Wind power forecasting plays an increasingly important role on the safety, reliability, and stability of the power grid. Due to the fluctuating and intermittent nature of wind resources, it is very challenging to accurately forecast wind power under varying scenarios. This paper proposes a novel Double Bayesian Multi-Task Gaussian Process (B2MTGP) model tailored for wind turbine power forecasting with scarce data. The model leverages both wind speed and limited power data, employing a two-stage Bayesian inference framework: the first stage integrates discrete wavelet packet decomposition to denoise raw signals, enhancing prediction accuracy; the second stage optimizes the multi-task Gaussian process model structure and parameters to account for data uncertainty. A generalized procedure is developed to facilitate automatic implementation of the proposed method for small-sample forecasting scenarios. Comparative experiments using real-world wind turbine datasets demonstrate that B2MTGP significantly outperforms traditional Gaussian process regression and multi-task models, achieving up to 91% improvement in point prediction accuracy. These results highlight the potential of the proposed approach for robust and reliable wind power forecasting under data uncertainty. © 2013 IEEE.},
	author_keywords = {Bayesian optimization; discrete wavelet packet transform; multi-task Gaussian process regression; Wind power forecasting; wind turbine},
	keywords = {Bayesian networks; Data accuracy; Discrete wavelet transforms; Forecasting; Gaussian distribution; Gaussian noise (electronic); Inference engines; Uncertainty analysis; Wavelet analysis; Wind effects; Wind forecasting; Wind power; Bayesian; Bayesian optimization; Data uncertainty; Discrete wavelet packet transforms; Gaussian process regression; Gaussian Processes; Multi tasks; Multi-task gaussian process regression; Wind power forecasting; Wind turbine power; Wind turbines},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Zhang2025__3,
	author = {Zhang, Jinliang and Hu, Zeping},
	title = {Optimization study of county multi-level power grid co-dispatch based on hybrid game considering multivariate source-load interaction},
	year = {2025},
	journal = {Expert Systems with Applications},
	volume = {275},
	pages = {},
	doi = {10.1016/j.eswa.2025.126981},
	url = {https://www.scopus.com/pages/publications/86000146947?origin=resultslist},
	abstract = {The county distribution grid is evolving into a platform for the effective allocation of source, grid, load, and storage resources in the wake of access to distributed energy sources, data centers, and other enormous distributed resources. Digital grid cooperative control and multilayer grid cooperative scheduling are essential methods for achieving energy conservation, reducing consumption in data centers, and enhancing the flexibility of distribution grids. To this end, this paper constructs a county multi-level power grid co-dispatch model based on a hybrid game considering multivariate source-load interaction. Firstly, the active distribution grid system with a data center and the rural microgrid system with biomass waste are constructed. And analyze the coordinated scheduling mechanism of the county main grid, distribution grid and microgrid. Secondly, the analysis of the data center's flexible regulation potential will be carried out, and the demand response model will be constructed. Finally, the county multi-level grid coordinated scheduling optimization model will be built based on a hybrid game under multivariate source-load interaction. The Kriging meta-model is used to solve the master–slave game, and the PR-ADMM algorithm is used to solve the cooperative game. Compared with the traditional solution method, the convergence speed of the hybrid game model is increased by 93.84 %. The results of the example show that after demand response, the load peak-to-valley difference and cost of the distribution network decreased by 22.71 % and 3.02 %, respectively. After the hybrid game, the power transaction cost of MG3 is reduced by 9.91 %, and the carbon trading income is increased by 1.39 %. Therefore, the hybrid game model can improve the coordination, flexibility and low carbon of the county multi-level power grid co-dispatch. © 2025 Elsevier Ltd},
	author_keywords = {Data center; Demand response; Hybrid game; Integrated rural energy system; Multi-level power grid},
	keywords = {Datacenter; Demand response; Distribution grid; Energy systems; Hybrid game; Integrated rural energy system; Multi-level power grid; Multilevels; Power grids; Rural energy; Demand response},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}


@article{lu_multi-objective_2018,
	title = {Multi-objective optimal load dispatch of microgrid with stochastic access of electric vehicles},
	volume = {195},
	issn = {0959-6526},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85048192629&doi=10.1016%2fj.jclepro.2018.05.190&partnerID=40&md5=d4c154d3346dfb9a88eb85c65e472fef},
	doi = {10.1016/j.jclepro.2018.05.190},
	abstract = {Large-scale uncoordinated charging of electric vehicles ({EVs}) will become a reality in the near future, which will have a great impact on the stability and security of power system operation. In this regard, this paper proposes a multi-objective optimal load dispatch model of microgrid with the stochastic access of {EVs}. The uncertainties of {EVs} are modeled by using the Monte Carlo simulation. The objective function of the model includes the operating cost, pollutant treatment cost and load variance. Distributed generations ({DGs}) are considered in the model, including photovoltaic ({PV}) array, wind turbine ({WT}), diesel engine ({DE}) and micro turbine ({MT}). In order to solve the proposed model effectively, an improved particle swarm optimization ({PSO}) algorithm is proposed. Then we discuss the dispatch results under three different scheduling scenarios, i.e., uncoordinated charging scenario, coordinated charging scenario with and without {DGs}. The simulation results show that charging loads will be shifted form high-priced periods to low-priced periods under the coordinated charging mode of {EVs}, which can reduce daily costs by 3.09\% and effectively improve the stability of power system operation. Meanwhile, the penetration of {DGs} can further reduce 6.43\% of total cost by managing output of {DGs}. Further, the influence of cost weight factor on dispatch results is discussed. It illustrates that the cost weight factor is a trade-off between the total cost and the load variance. The experimental results demonstrate the effectiveness of the model under different charging situations. © 2018 Elsevier Ltd},
	pages = {187--199},
	journaltitle = {J. Clean. Prod.},
	publisher = {Elsevier Ltd},
	author = {Lu, X. and Zhou, K. and Yang, S. and Liu, H.},
	date = {2018},
	keywords = {Multiobjective optimization, Electric load dispatching, Multi-objective optimization, Particle swarm optimization ({PSO}), Economic and social effects, Micro grid, Microgrid, Distributed power generation, Intelligent systems, Monte Carlo methods, Stochastic systems, Stochastic models, Photovoltaic cells, Wind turbines, Electric vehicles, Diesel engines, Cost reduction, Distributed generations ({DGs}), Electric Vehicles ({EVs}), System stability, Power system operations, Electric power plant loads, Load dispatch, Distributed generations, Coordinated charging, Electric automobiles, Optimal load dispatch, Stability of power system, Improved particle swarms},
}

@article{lu_energy_2021,

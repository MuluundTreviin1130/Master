	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@inproceedings{karandeh_multi-application_2021,
	title = {A Multi-Application Energy Management of Behind-the-Meter Battery Energy Storage System},
	isbn = {978-1-7281-8192-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112367489&doi=10.1109%2fNAPS50074.2021.9449803&partnerID=40&md5=6fa8fd7325e6c9b0d209273db513631a},
	doi = {10.1109/NAPS50074.2021.9449803},
	abstract = {Over the past few years, there has been a dramatic growth in penetration of the behind-the-meter ({BTM}) distributed energy resources ({DERs}), including small-scale renewable energy sources ({RES}), interfaced with battery energy storage systems ({BESS}) deployed at the customer premises and behind the customers' meters. The {BESS} is yet costly and a single-application usage of them may not cover the storage installation costs, whereas a combination of {BESS} applications is more likely to justify the expenses. This paper presents a multi-objective optimization approach to schedule the charging and discharging power of the {BTM} {BESS} aiming at minimizing the prosumer's daily operation costs based on time-of-use ({TOU}) energy price and on-peak demand charges. A linear model of the prosumer's optimization problem is presented and solved through mixed-integer linear programming ({MILP}). The proposed approach is applied to a case study defined in the {IEEE} 123-bus distribution network. The results show a promising reduction in prosumer's daily operation costs. Application synergy of the proposed approach and several grid services is also investigated through measuring the peak reduction and energy time-shift for the entire network. © 2021 {IEEE}.},
	eventtitle = {2020 52nd North American Power Symposium, {NAPS} 2020},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Karandeh, R. and Lawanson, T. and Cecchi, V.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Battery storage, Optimization problems, Costs, Battery energy storage, Secondary batteries, Operating costs, Integer programming, Battery energy storage systems, distributed energy resources, Mixed-integer linear programming, Prosumer, time of use, application synergy, behind the meter, Customer premise, demand charge management, energy cost management, Installation costs, Multi-application, multiple applications},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 8},
}

@article{kargarian_multi-microgrid_2015,
	title = {Multi-microgrid energy systems operation incorporating distribution-interline power flow controller},
	volume = {129},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84940469546&doi=10.1016%2fj.epsr.2015.08.015&partnerID=40&md5=ee8f4ac2ad03858a8605d0fb96acd0d6},
	doi = {10.1016/j.epsr.2015.08.015},
	abstract = {Innovative power electronic devices such as distribution-interline power flow controller (D-{IPFC}) can be utilized to improve the operating performance of power distribution systems. In this paper, a power injection model is presented to formulate the D-{IPFC} operation in distribution grids. The proposed power injection model keeps original symmetry of the impedance matrix as well as system equations which facilitates power flow calculations. Then, a centralized multi-objective optimization algorithm is formulated to optimally coordinate multi-microgrids ({MMGs}) through D-{IPFC}. The final optimal operating point of {MMG} is a trade-off between minimization of operating cost, voltage profile deviation, and feeder congestion. To guarantee voltage stability of the system, a voltage security constraint is considered in the optimization problem. The proposed algorithm improves flexibility of the active distribution grids which is essential for resilient smart power grids. A typical {MMG} and a spider diagram are applied to show the effectiveness of the proposed algorithm. © 2015 Published by Elsevier B.V.},
	pages = {208--216},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Kargarian, A. and Rahmani, M.},
	date = {2015},
	keywords = {Multiobjective optimization, Electric power distribution, Electric power transmission networks, Economic and social effects, Electric power systems, Micro grid, Microgrid, optimization, Algorithms, Smart power grids, Electric load flow, Controllers, Nonlinear programming, Electric power system control, System stability, Optimal operating point, Flow control, Electric control equipment, Power electronic devices, Distribution-interline power flow controller, Interline power flow controllers, Multi-objective nonlinear optimization, Non-linear optimization, Power distribution system, Power injection modeling, Smart power grids resiliency, System security},
}

@article{karimi_dynamic_2021,
	title = {Dynamic transactive energy in multi-microgrid systems considering independence performance index: A multi-objective optimization framework},
	volume = {126},
	issn = {01420615},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092745579&doi=10.1016%2fj.ijepes.2020.106563&partnerID=40&md5=ee9490f278880970e675d16347ec2e06},
	doi = {10.1016/j.ijepes.2020.106563},
	abstract = {This paper proposes a leader multi-follower optimization for energy transactions in the multi-microgrid systems. The transactions of microgrids with the distribution network operator can be provided by energy internet. The distribution network operator can buy/sell energy from/to the microgrids. The upper-level of the optimization is modeled as a multi-objective optimization in which the profit of distribution network operator, independence performance, and energy not supplied of the system have been optimized using the lexicography approach. In the lexicography approach, two-steps for objectives are defined. In the first step, the profit of the distribution network operator is maximized, while the independence performance index and energy not supplied of system have been optimized in the second step. In the lower-level, microgrids are considered as followers to minimize their costs. The uncertainty of renewable generation and market prices are applied to the model using scenario-generation and scenario-reduction technique. The proposed non-linear bi-level model is transformed to the linear single-level optimization using the Karush-Kuhn-Tucker optimality conditions and strong duality theorem. The proposed model is tested on the standard case study and the results show the efficiency of the proposed model in terms of independence index, energy not supplied, and greenhouse gas emissions. © 2020 Elsevier Ltd},
	journaltitle = {Int J Electr Power Energy Syst},
	publisher = {Elsevier Ltd},
	author = {Karimi, H. and Bahmani, R. and Jadid, S. and Makui, A.},
	date = {2021},
	keywords = {Multiobjective optimization, Microgrids, Gas emissions, Greenhouse gases, Profitability, Renewable generation, Performance indices, Energy internet, Scenario generation, Linguistics, Multi-microgrid system, Distribution network operators, Energy not supplied, Independence performance index, Karush Kuhn Tucker optimality condition, Multi-follower bi-level optimization, Scenario reduction techniques, Strong duality theorems, Transactive energy},
}

@article{karimi_optimal_2023,
	title = {Optimal energy management of grid-connected multi-microgrid systems considering demand-side flexibility: A two-stage multi-objective approach},
	volume = {214},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140315660&doi=10.1016%2fj.epsr.2022.108902&partnerID=40&md5=6ae52d9c0f61fc56d10aaa3d3b4cbb33},
	doi = {10.1016/j.epsr.2022.108902},
	abstract = {This paper proposes multi-objective optimization framework to enhance the performance of demand response programs in distribution networks. The demand response programs are one of the main resources to enhance the flexibility of the energy systems to manage the uncertain behavior of renewable generation and demand loads. But, the uncoordinated response of customers creates a new peak in the load profile when the market prices are low. Therefore, we present a two-stage multi-objective framework that simultaneously reduces the operating costs and enhances the efficiency of demand response programs in the grid-connected microgrid systems. The first stage focuses on the optimal energy management of the grid-connected microgrid systems from the economic perspective. The second stage focuses on the demand-side flexibility to uniform the load profile. Also, we introduce the Average Power Flexibility during Peak Period Index ({APFDPPI}) to evaluate the energy flexibility of the demand response programs. The proposed model has been tested on a standard grid-connected microgrid, and the simulation results show that the proposed model improves the amount of energy not served by 22.12\%. Also, the peak load and the load factor have been improved by 12.96\% and 15.17\%, respectively compared to uncoordinated demand response programs. © 2022},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Karimi, H. and Gharehpetian, G. B. and Ahmadiahangar, R. and Rosin, A.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy management systems, Multi-objective optimization, Microgrid, Microgrids, Energy management, Demand response programs, Operating costs, Multi objective, Microgrid systems, Renewable generation, System flexibility, Grid-connected, Optimal energy, Demand-side},
}

@inproceedings{karimi_multi_2019,
	title = {Multi Objective Optimization for Multi-Microgrid Energy Management: A Lexicography Approach},
	isbn = {978-1-7281-5273-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85085030421&doi=10.1109%2fPSC49016.2019.9081460&partnerID=40&md5=1bccb47d8f2357ea8147f4ff79e521fe},
	doi = {10.1109/PSC49016.2019.9081460},
	abstract = {Microgrids ({MGs}) are known as the optimal solution for using distributed generations in smart grids. With increasing number and capacity of {MGs}, the Multi-Microgrids ({MMG}) concept is introduced. This paper presents multi-objective energy management for {MMGs}. The {MMG} has various local energy resources such as Photovoltaic ({PV}) panels, Wind Turbines ({WT}), Diesel Generators ({DG}), Fuel Cells ({FC}), Micro Turbines ({MT}), and Battery Energy Storages ({BES}). The {MMG} operator tries to minimize daily cost for {MGs} and {MMG} can participate in Demand Response ({DR}) programs. {DR} programs help to cost minimization, and reliability improvement for {MMG} but a non-coordinated {DR} creates a new peak in the distribution systems. In this paper, a multi-objective optimization is presented that it minimizes {MMG} cost and Deviation from Mean ({DFM}) load simultaneously. A lexicography approach is used and at first, the {MMG} cost is minimized. After that {DFM} is minimized in the second level of optimization. The proposed model will not increase the {MMG} cost but it improves load curve characteristics. This model is tested on a standard case study and it solved by {GAMS} software. The results show the efficiency proposed model. © 2019 {IEEE}.},
	pages = {679--686},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Karimi, H. and Jadid, S.},
	date = {2019},
	keywords = {Multiobjective optimization, Microgrids, Distribution systems, Energy management, Fuel cells, Demand response programs, Energy resources, Photovoltaic panels, Multi micro-grids, Multi-microgrids, Multi objective optimization, Software testing, Optimal solutions, Demand response program, Cost minimization, Linguistics, Battery energy storages ({BES}), Lexicography approach, Reliability improvement},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2},
}

@article{karimi_optimal_2020,
	title = {Optimal energy management for multi-microgrid considering demand response programs: A stochastic multi-objective framework},
	volume = {195},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078278663&doi=10.1016%2fj.energy.2020.116992&partnerID=40&md5=8a3066844cff4cede906f42561f0c147},
	doi = {10.1016/j.energy.2020.116992},
	abstract = {This paper presents a cooperative multi-objective optimization for the networked microgrids energy management. We introduce the Independence Performance Index ({IPI}) for the {MGs} to reduce energy exchange with the main grid. The system losses, voltage drop, and greenhouse gas emissions are improved when the independence of {MMG} is increased. Besides, the {MMG} operator seeks to reduce its total daily costs. For this reason, {MGs} can participate in Demand Response Programs ({DRPs}). {MGs} have two types of loads, namely flexible and inflexible loads. The flexible loads can response to price signals and participate in the {DR} Programs. The uncertainty of renewable generation is modeled as a stochastic optimization that a scenario generation and reduction decision-making method is employed. This stochastic multi-objective optimization is solved by Compromised Program ({CP}) method that is used to combine non-homogeneous objective functions. This technique converts the original multi-objective problem into a single-objective problem. The proposed model is tested on a standard case study for two different conditions. The simulation results show the proposed model improves {CO}2 emission about 13.4 and 9.2\% in the case studies. Besides, the proposed model brings 17 and 11.7\% improvements for the independence of {MMG} in the case studies. © 2020 Elsevier Ltd},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Karimi, H. and Jadid, S.},
	date = {2020},

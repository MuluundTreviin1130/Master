@CONFERENCE{Zhang2025__4,
	author = {Zhang, Jifan and Zhang, Hengxu and Li, Wei},
	title = {An Accelerated Approach to Time-Sequential Production Simulation for Integrated Generation-Grid-Storage Systems Combining Benders Decomposition and Data-Driven Methods},
	year = {2025},
	journal = {2025 IEEE International Conference on Smart Power and Energy Technologies, IEEE SPET 2025},

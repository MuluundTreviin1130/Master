	author = {Jin, J. and Yang, L. and Wang, X.},
	date = {2024},
	keywords = {Multiobjective optimization, Energy supplies, Genetic algorithms, Life cycle, Carbon, Heat storage, Electric loads, Digital storage, Solar energy, carbon emission, Carbon emissions, Optimization method, Capacity allocation, Integrated energy systems, Allocation optimization, Cogeneration integrated energy system, Islanded mode, Radar chart, radar chart evaluation solution},
}


	title = {Optimal integration of solar distributed generations in distribution network using {SPEA}2},
	isbn = {978-1-5090-3407-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85025145192&doi=10.1109%2fSTA.2016.7952079&partnerID=40&md5=7257bf0890fbd5b0fc5485151761e4fb},

@article{han_optimization_2023,
	title = {{OPTIMIZATION} {OF} {SOLAR}-{GAS} {ENERGY} {SYSTEM} {CONSIDERING} {GRID} {RENEWABLE} {ENERGY} {POWER} {PENETRATION} {RATES}},

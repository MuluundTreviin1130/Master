	date = {2015},
	keywords = {Multiobjective optimization, Micro grid, Microgrid, Microgrids, Multi-objective optimization problem, Distributed power generation, Distribution systems, distributed generation, Investments, Optimal allocation, Multi-objective planning, Optimal allocation method, Wind generator systems, Computational results, {PV}-Wind-{ES}, Typical grouping modes},
}

@article{sheng_optimal_2015,
	title = {Optimal allocation between distributed generations and microgrid based on {NSGA}-{II} algorithm},
	volume = {35},

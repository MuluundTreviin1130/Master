	keywords = {Heuristic methods, Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Power quality, Carbon dioxide, Electric energy storage, Storage systems, Power-distribution system, Optimization techniques, Nitrogen oxides, Quality control, Renewable energy storages, Sulfur dioxide, Power system networks, Core saturation, Electricity quality, Electronic gadgets, Power-quality analysis},
}


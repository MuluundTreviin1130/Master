	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Weighting methods, Integrated energy systems, Optimization strategy, Research object, hesitant evaluation, Objective evaluation, objective weighting method, regional integrated energy system, regional integrated energy systems, subjective},
}


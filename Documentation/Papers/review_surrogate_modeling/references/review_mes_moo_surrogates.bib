	isbn = {978-1-6654-4280-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136412576&doi=10.1109%2fMELECON53508.2022.9843003&partnerID=40&md5=47a173deab7120f21e39db83185075d0},

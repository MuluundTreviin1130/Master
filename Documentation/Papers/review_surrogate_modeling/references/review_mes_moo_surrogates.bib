@ARTICLE{Rizqi2023,
	author = {Rizqi, Zakka Ugih and Chou, Shuo-Yan and Yu, Tiffany Hui-Kuang},
	title = {Green energy mix modeling under supply uncertainty: Hybrid system dynamics and adaptive PSO approach},
	year = {2023},
	journal = {Applied Energy},

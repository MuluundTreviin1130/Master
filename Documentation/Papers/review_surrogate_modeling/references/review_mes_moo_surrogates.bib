	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: K. Vemalaiah; Indian Institute of Technology Roorkee, Electrical Engineering Department, Roorkee, India; email: kasi\_v@ee.iitr.ac.in},
}


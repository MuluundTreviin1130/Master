}

@inproceedings{shen_multi-objective_2022-1,
	title = {Multi-objective Optimization Method for Low-Carbon Development of Wind-Light-Biogas-Storage Integrated Energy Microgrids in Remote Areas},
	isbn = {979-8-3503-4715-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85160205002&doi=10.1109%2fEI256261.2022.10117046&partnerID=40&md5=4b6f95dbf2f904e56f1eb83ef7ea316a},
	doi = {10.1109/EI256261.2022.10117046},
	abstract = {Remote areas are rich in renewable energy resources, but the comprehensive utilization rate is not high; and due to restrictions of bitty terrain, the reliability of power supply is relatively low. To realize safe, clean and reliable energy supply in remote areas, integrating clean energy such as wind-lightbiogas resources and constructing integrated energy microgrids ({IEM}) with renewable energy as the main body is one of the important ways to promote low-carbon, safe and efficient development of power systems in remote areas. Therefore, this paper presents a multi-objective programming method for {IEM} planning considering the coordinated operation of wind-light-biogas-storage. Firstly, based on the in-depth analysis of operation and correlation characteristics of various energy conversion equipment in {IEM}, equipment models in wind-light-biogas-storage {IEMs} are established. Then, with the minimum system cost and the maximum utilization of clean energy as the objectives, the multi-objective planning method of {IEMs} is proposed, while planning and operation constraints. Finally, {NSGA}-{II} algorithm is used to solve the programming problem, and the simulation results verify the effectiveness of the proposed model. © 2022 {IEEE}.},
	pages = {327--332},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Shen, Z. and Song, Z. and Zhao, H. and Wang, C. and Chunhui, L. and Hu, E. and Wu, Z. and Zhi, Z.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Microgrid, Microgrids, Carbon, Clean energy, Energy, {NSGA}-{II} algorithm, Optimization method, Biogas, Comprehensive utilizations, Low-carbon development, Remote areas, Renewable Energy Resource, Integrated energy microgrid},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: Z. Shen; State Grid Shanxi Economic Research Institute, Taiyuan, China; email: szy33519@163.com},
}

@article{shen_multi-objective_2023,
	title = {{MULTI}-{OBJECTIVE} {OPTIMIZATION} {METHOD} {FOR} {LOW}-{CARBON} {DEVELOPMENT} {OF} {WIND}-{SOLAR}-{BIOGAS}-{STORAGE} {INTEGRATED} {ENERGY} {MICROGRIDS} {IN} {REMOTE} {REGIONS}},

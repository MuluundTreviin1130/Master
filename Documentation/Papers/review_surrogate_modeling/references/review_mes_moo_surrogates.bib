@CONFERENCE{Fraisse2018,
	author = {Fraisse, G. and Souyri, B. and Wurtz, F. and Brunotte, X. and Enciu, P. and Peuportier, B. and Robillart, M. and El-mankibi, M. and Stathopoulos, N. and Truchet, S. and François, E. and Shyam},
	title = {Towards holistic building optimization using a computing environment that enables interoperability between numerical tools},

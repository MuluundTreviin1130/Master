	publisher = {Italian Association of Chemical Engineering - {AIDIC}},
	author = {Siy, J. and Uy, L. and Uy, P. and Sy, C. and {Varbanov P.S.} and {Yong J.-Y.} and {Klemes J.J.} and {Liew P.-Y.} and {Lam H.L.}},
	date = {2016},

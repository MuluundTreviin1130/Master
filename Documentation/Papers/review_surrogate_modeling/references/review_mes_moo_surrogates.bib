	isbn = {979-8-3315-1661-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000553806&doi=10.1109%2fIFEEA64237.2024.10878726&partnerID=40&md5=3e1eb79d9c234b1df4b16b2423e29123},

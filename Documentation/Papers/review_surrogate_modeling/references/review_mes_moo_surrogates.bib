	keywords = {Fossil fuels; Learning systems; Wave energy conversion; Control actions; Control strategies; Data-driven control; Energy systems; Learning strategy; Optimal controls; Random forests; Regression trees; Sustainable energy; Wave energy; artificial neural network; cost analysis; fossil fuel; regression analysis; sustainable development; wave energy; Deep neural networks},

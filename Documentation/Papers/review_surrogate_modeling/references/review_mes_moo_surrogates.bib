	publisher = {Taylor and Francis Inc},
	author = {Manas, M.},
	date = {2018},
	keywords = {Multi-objective optimization, Renewable energy, Wind energy, Particle swarm optimization, biogas based {IC} engine and photovoltaic, direct current micro-grid},
}


	keywords = {Wind power, optimization, Power generation, alternative energy, Solar power, Sustainability, photovoltaic system, China, Pareto set, Complementary mechanism, Hubei, load fluctuation, wind–photovoltaic–hydro system},
}

@article{shen_energy_2022,

	isbn = {978-1-7281-3520-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074949370&doi=10.1109%2fISGT-Asia.2019.8881318&partnerID=40&md5=ed680e38b6126e9bd1fe515e31ccdde6},

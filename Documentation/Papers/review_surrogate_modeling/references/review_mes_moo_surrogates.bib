}

@article{gupta_novel_2024,
	title = {A Novel Multi-Objective Protection Coordination Scheme for a Microgrid with Optimal Deployment of Dual-Setting {ROCOV} Based Relays},
	volume = {9},
	issn = {23672617},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198039068&doi=10.23919%2fPCMP.2023.000425&partnerID=40&md5=74bea1a2d76093b39aeb4db4f6a1ac43},
	doi = {10.23919/PCMP.2023.000425},
	abstract = {Relay coordination is crucial in electrical power systems to protect against malfunctions and damage caused by unexpected events like short circuits. To address the challenge associated with the reverse direction of fault current, dual-setting ({DS}) directional over-current relays have evolved but failed to provide proper coordination during changes of load, generation, and network. In the meantime, with the increasing number of {DS} relays, the total relay operating time tends to saturate. Therefore, this paper proposes a protection scheme based on the optimal deployment of conventional and dual-setting rate of change of voltage ({DS}-{ROCOV}) relays in distribution systems. This holds true for varying network topologies and is unaffected by variations in load and generation. The objective of the proposed scheme is to ensure reliable and efficient protection against faults in distribution systems by minimizing the overall operating time with the optimal number of {DS}-{ROCOV} relays. The proposed protection scheme's performance is evaluated for different coordination time interval values as well as in different microgrid scenarios. This paper outlines the design and implementation of the proposed protection scheme which is validated on the modified {IEEE} 14-bus system using simulations in Matlab/Simulink. © 2019 Power System Protection and Control Press.},
	pages = {23--38},
	number = {4},
	journaltitle = {Prot. Cont. Mod. Power Sys.},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Gupta, P. K. and Niranjan, P. and Choudhary, N. K. and Singh, N. and Singh, R. K.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power distribution, Multi-objective optimization, Microgrid, Electric loads, Electric power system protection, Protection coordination, Relay protection, Coordination time interval, {DS}-{ROCOV} relay, Dual-setting, Dual-setting-{ROCOV} relay, Operating time, optimal deployment, optimal-deployment, Protection schemes, Simulink, Time interval},
}

@inproceedings{gusain_optimal_2024,
	title = {Optimal Configuration of Off-Grid Hybrid Renewable Energy System: A Multi-Criteria Analysis},
	isbn = {979-8-3503-8719-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208484391&doi=10.1109%2fICPEICES62430.2024.10719369&partnerID=40&md5=51785b48ebf7116f6e41728a53ffd275},
	doi = {10.1109/ICPEICES62430.2024.10719369},
	abstract = {With conventional power systems depleting, the demand for reliable and eco-friendly alternative energy sources has surged. Nonetheless, renewable energy sources encounter challenges such as uncertainty, intermittency, and high costs. One promising solution is the integration of multiple {RESs} into a hybrid renewable energy system. In this study, we propose an integrated solar, wind, and battery-based {HRES} and employ the ancient-inspired meta-heuristic methodology Giza pyramids construction algorithm for optimal system configuration determination. The approach involves a multi-criteria bi-objective optimization model aiming to balance cost and reliability by reducing the annualized system cost while ensuring high reliability, indicated by minimizing the loss of power supply probability. By implemented this methodology using hourly solar irradiation, temperature, and wind speed data collected over a year in the northern region of Uttarakhand, India. Results demonstrate the effectiveness of the {GPC} optimization method in sizing {HRES} components structured to specific locations. Furthermore, findings reveal a strong correlation between the cost of the optimal configuration and {LPSP}. © 2024 {IEEE}.},

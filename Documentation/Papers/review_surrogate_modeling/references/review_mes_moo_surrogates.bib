	date = {2024},
	keywords = {Multiobjective optimization, Particle swarm optimization ({PSO}), Renewable energy, Energy utilization, Microgrid, Optimisations, uncertainty analysis, Renewable energies, Operating costs, Microgrid systems, Uncertainty, Multi micro-grids, K-means clustering, Renewable energy consumption, Collaborative optimization, Cluster analysis, Feature analysis, Multi microgrid system, Multi microgrid systems},

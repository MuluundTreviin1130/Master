	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173848919&doi=10.1109%2fEEPS58791.2023.10257153&partnerID=40&md5=f4f6bc781e17a6583e549f0edc2c1b90},
	doi = {10.1109/EEPS58791.2023.10257153},
	abstract = {Considering the power balance, charge-discharge control of battery and output limit of micro-source as the system constraints, this paper proposes a multi-objective optimal scheduling model for stand-alone microgrid. The model contains multiple distributed power sources. The model ensures the consumption of new energy sources such as wind power and photovoltaic, as well as the reliable power supply to the loads. Then the improved Differential Evolution ({DE}) algorithm, to which a daptive variational factor is introduced, is used to solve the above model. The results show that the improved {DE} has better global search capability. The microgrid optimization model based on the improved {DE} algorithm reduces the total cost by 9.8\% compared to the classical {DE} algorithm. © 2023 {IEEE}.},

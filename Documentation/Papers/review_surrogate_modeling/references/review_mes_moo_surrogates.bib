@article{ren_multi-objective_2019,
	title = {Multi-objective optimal analysis on the distributed energy system with solar driven metal oxide redox cycle based fuel production},
	volume = {233},
	issn = {0959-6526},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85068063859&doi=10.1016%2fj.jclepro.2019.06.028&partnerID=40&md5=0ea6b960d501e1adffa7de51c3f9d317},
	doi = {10.1016/j.jclepro.2019.06.028},
	abstract = {Solar energy driven cerium dioxide ({CeO}2) thermochemical cycle based fuel production is considered to be a promising technology that can integrate with a combined cooling, heating and power ({CCHP}) system owing to the pollution free property and favorable chemical reaction kinetics characteristics. In this study a combined cooling, heating, power and fuel ({CCHPF}) distributed energy system is devised to improve the energy utilization efficiency and reduce the dependence on conventional fossil fuels. To realize the efficient and cost-effectively operations of the system, a constrained multi-objective optimization problem with aims of maximizing primary energy saving ratio ({PESR}) and minimizing {CO}2 emission and energy cost is proposed to search for the optimal operation strategy and schedule. A potent optimization method that capitalizes on the advantages of the non-dominated sorting genetic algorithm-{II} ({NSGA}-{II}) and the random walk with directional exploitation ({RWDE}) algorithm is developed to solve the proposed optimization problem more effectively. The fuzzy decision making method is tailored to determine the final operation strategies of the {CCHPF} system from the obtained Pareto front according to the decision maker preferences. Numerical results show that the proposed system realizes the supply-demand balance, the optimal dispatch of the energy and the efficient economic operation. In comparison with existing {CCHP} systems, the energy utilization efficiency of the developed {CCHPF} system increases by 0.60\% and 17.65\%, {CO}2 emission decreases by 13.79\% and 3.77\%, as well as economic cost reduces 0.29\% and 6.33\% on a typical winter and summer days, respectively. The research findings provide new insights for improving the coordinated operation of distributed renewable energy system and alleviating energy crisis and environmental pollution. © 2019 Elsevier Ltd},
	pages = {765--781},
	journaltitle = {J. Clean. Prod.},
	publisher = {Elsevier Ltd},
	author = {Ren, T. and Li, X. and Chang, C. and Chang, Z. and Wang, L. and Dai, S.},
	date = {2019},
	keywords = {Multiobjective optimization, Genetic algorithms, Decision making, Energy efficiency, Energy utilization, Optimization problems, Pollution, Carbon dioxide, Energy policy, Solar energy, Fossil fuels, Distributed energy systems, Constrained optimization, Operation strategy, Distributed energy system, Fuel production, Metals, Cerium oxide, Optimization problem, Reaction kinetics, Redox reactions, Solar thermochemistry},
}

@article{ren_life-cycle-based_2024,
	title = {Life-cycle-based multi-objective optimal design and analysis of distributed multi-energy systems for data centers},
	volume = {288},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179666500&doi=10.1016%2fj.energy.2023.129679&partnerID=40&md5=dee32b325a371cbc4471be3723b987e3},
	doi = {10.1016/j.energy.2023.129679},
	abstract = {The widespread deployment of data centers has contributed to a dramatic increase in energy consumption and carbon emissions. To solve this problem, this study proposes a distributed multi-energy system ({DMES}) driven by solar, wind, geothermal and natural gas and its life-cycle-based multi-objective optimization model considered energy, economy, and environment. Moreover, a novel operation strategy based on load characteristics is presented for energy flow allocation and a multi-objective grasshopper optimization algorithm is improved for model solving. Case studies are conducted on a practical data center in Qinghai, China. Based on the {DMES} capacity configuration and scheduling results, the cooling, heating and power supply can satisfy the demand of the data center while generating over 30\% of the power from renewable sources. In addition, carbon tax is considered in the optimization model, which accounts for 4\% of the life-cycle cost. Furthermore, the sensitivity of carbon tax, equipment lifespan and predicted mean vote is analyzed, obtaining that these factors have some influence on the performance of the system. Finally, the uncertainty impact on system planning is studied, concluding that the designed system exhibits high robustness levels when renewable energy forecast error is less than 20\% or load forecast error is less than 10\%. © 2023 Elsevier Ltd},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Ren, X. and Han, Z. and Ma, J. and Xue, K. and Chong, D. and Wang, J. and Yan, J.},
	date = {2024},
	keywords = {Multiobjective optimization, Energy utilization, Life cycle, Design, optimization, Optimal design, Optimal systems, Carbon, Costs, Life cycle analysis, Optimization algorithms, algorithm, Multi objective, Multi-energy systems, Natural gas, pollution tax, heating, Forecasting, Carbon taxes, Optimal analysis, Equipment, Geothermal energy, China, Energy flow, datacenter, Distributed multi-energy system, Qinghai, Data centers, Forecast errors, Multi-objective grasshopper optimization algorithm},
}

@inproceedings{ren_multi-objective_2024,
	title = {{MULTI}-{OBJECTIVE} {OPTIMIZATION} {DESIGN} {FOR} {NUCLEAR}-{COUPLED} {DISTRIBUTED} {MULTI}-{ENERGY} {SYSTEM} {IN} {ALPINE} {REGION}},
	volume = {4},
	isbn = {978-0-7918-8824-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209388338&doi=10.1115%2fICONE31-135307&partnerID=40&md5=3d1536476653bcc0096612d47374d03d},
	doi = {10.1115/ICONE31-135307},
	abstract = {The alpine regions are characterized by its remote location, cold climate and limited conventional energy, which presents considerable challenges in ensuring reliable electricity and heating supply. To this end, a nuclear-coupled distributed multi-energy system (N-{DMES}) is proposed. To attain the optimal configuration and operation of N-{DMES}, a multi-objective optimization model is developed with net present cost, shortage of electricity and renewable energy power generation as objective functions. Meanwhile, the improved multi-objective grasshopper optimization algorithm is utilized for the model solving. Besides, this system is compared with a diesel-coupled distributed multi-energy system (D-{DMES}). This paper takes a market town in an alpine region as a case study to assess the effectiveness and feasibility of the proposed N-{DMES}. Simulation results indicate that the designed N-{DMES} can satisfy the users’ electricity demands. N-{DMES} exhibits slightly lower economic performance and renewable energy consumption compared to D-{DMES}. However, N-{DMES} surpasses D-{DMES} in terms of environmental friendliness and reliability. The minimum load factor of {MMR} and renewable energy capacity have a certain impact on the system performance. Copyright © 2024 by {ASME}.},

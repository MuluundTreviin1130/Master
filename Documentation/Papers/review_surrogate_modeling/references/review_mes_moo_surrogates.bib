@inproceedings{wang_resilience-oriented_2019,
	title = {Resilience-oriented multi-energy complementary microgrid robust optimal operation strategy considering the uncertainty},
	volume = {2019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081595643&doi=10.1049%2fcp.2019.0434&partnerID=40&md5=b78547428cd7460e84023de637f1c274},
	doi = {10.1049/cp.2019.0434},
	abstract = {This paper proposes a novel resilience-oriented optimal operation strategy for multi-energy complementary ({MEC}) microgrid. The objectives in the proposed optimal strategy consist of the resilience, the operation cost and the total pollutant emissions. Since distributed energy resources ({DER}) exist in the {MEC} microgrid, the problem formulated is a multi-objective optimization considering the uncertainty wherein the resilience is maximized while the cost is minimized. Thus, it can be solved as a min-max dual robust optimization problem. Benders decomposition ({BD}) is employed to decouple it, then improved simulated annealing algorithm ({SAA}) is deployed to search the min/max value. Compared with other robust optimal model, the proposed strategy can be applied in the {MEC} microgrid as well as consider the resiliency. The case with photovoltaic ({PV}) panels, wind turbines ({WT}), combined cooling, heating and power ({CCHP}) system, ground source heat pump ({GSHP}) and different loads demonstrates the effectiveness of the proposed optimal operation strategy. © 2019 Institution of Engineering and Technology. All rights reserved.},

@article{tang_short-term_2025,
	title = {Short-term optimal scheduling and comprehensive assessment of hydro-photovoltaic-wind systems augmented with hybrid pumped storage hydropower plants and diversified energy storage configurations},
	volume = {389},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001010188&doi=10.1016%2fj.apenergy.2025.125787&partnerID=40&md5=c977609d78935ca48ecb1d33be41b16e},
	doi = {10.1016/j.apenergy.2025.125787},
	abstract = {The increasing utilization of photovoltaic and wind power within the grid, coupled with evolving energy policies, poses significant challenges to the structural integrity and operational performance of existing hybrid energy systems ({HES}). Combining hydropower plants with pumped hydro storage to build hybrid pumped storage hydropower plants ({HPSHP}) effectively capitalizes on the benefits of both technologies, thereby improving economic viability and operational flexibility. However, the integration of {HPSHP} with photovoltaic and wind power remains inadequately investigated. Moreover, the operational constraints of pumped storage systems necessitate the exploration of innovative hybrid energy storage coupling strategies. To address this, a multi-objective optimization model for the {HPSHP}-photovoltaic-wind-battery system ({HPSHP}-{PWB}) is proposed. Subsequently, an optimal operation scheduling strategy is developed, tailored to the constraints of hybrid energy storage systems, along with a profitability model that incorporates peak-valley electricity pricing mechanisms and green power subsidies. The objectively-assigned superior-inferior solution distance method is employed to identify the optimal solution, while a comprehensive multi-criteria analysis framework is established for in-depth evaluations under various scenarios. Finally, analysis based on practical applications in Guizhou Province indicates that the proposed {HPSHP}-{PWB} enhances multi-performance metrics, demonstrating remarkable capabilities in economic viability and scheduling robustness. These findings provide valuable insights for the future development of {HES}. © 2025 Elsevier Ltd},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Tang, H. and Li, R. and Song, T. and Ju, S.},
	date = {2025},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Battery storage, Multi-objective optimization, optimization, Hybrid power, Photovoltaics, Battery energy storage, Battery, energy storage, Energy, photovoltaic system, performance assessment, Hybrid energy storage system, small scale hydropower, assessment method, Pumped storage power plants, Hybrid energy storage systems, Windmill, Multi energy, Pumped storage hydropower plants, Pumped hydro storage, Multi-energy complementary, Cascade hydropower plants, pump},
}

@inproceedings{tang_design_2023,
	title = {Design Hydro-Solar-Wind Multi-energy Complementary System via Multi-Objective Optimization},
	isbn = {979-8-3503-3881-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191730441&doi=10.1109%2fICEPT59018.2023.10492265&partnerID=40&md5=35c7ff955a900434968a76201fc8880b},
	doi = {10.1109/ICEPT59018.2023.10492265},
	abstract = {The global energy crisis and environmental degradation have become an urgent issue, and it is imperative to develop renewable energy system to promote the transformation of the energy structure. As a highly adjustable renewable energy source, the hydroelectric energy is often integrated into photovoltaic and wind systems to improve the system performance. However, the hydropower is limited by hydrological conditions, resulting in insufficient regulation and generation capacity during the dry water period. In this work, we investigate the hydro-solar-wind multi-energy complementary system via the multi-objective optimization considering the dry, flat and rich water periods. The non-dominated sorting genetic algorithm {II} is adopted to realize the multi-objective optimization including minimizing the system output volatility, the difference between system output and load, and maximizing the total system power generation, aiming to obtain the optimal configuration of the energy system under different typical weather conditions. During the dry water period, the hydro-solar-wind multi-energy complementary system shows huge power deficit. The hydrological conditions affect the economy and reliability of system, which will be reduced during dry water period when the hydropower supply is insufficient. The results of this study indicate that the performance of hydro-solar-wind multi-energy complementary systems is poor during the dry water period and other energy sources need to be incorporated to improve the reliability of the system. © 2023 {IEEE}.},
	eventtitle = {2023 24th International Conference on Electronic Packaging Technology, {ICEPT} 2023},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Tang, H. and Song, T. and Tao, G. and Qin, L. and Ju, S.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Multi-objective optimization, genetic algorithm, Energy policy, Energy systems, Reliability, Hydroelectric power, Hydroelectric power plants, Complementary systems, Multi energy, Economy and reliabilities, Multi-energy complementary, Solar/wind, Dry waters, economy and reliability, Hydrological condition, System output},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: S. Ju; Shanghai Jiao Tong University, China-{UK} Low Carbon College, Shanghai, China; email: shenghong.ju@sjtu.edu.cn},
}

@inproceedings{tang_thermo-economic_2021,
	title = {Thermo-economic analysis and multi-objective optimization of a novel {CCHP} system driven by geothermal energy},
	volume = {24},
	isbn = {20042965},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190787283&doi=10.46855%2fenergy-proceedings-9846&partnerID=40&md5=6811ab1be555fb174802c280bae22825},
	doi = {10.46855/energy-proceedings-9846},
	abstract = {Both effective utilization of renewable energy and multi-generation system are promising ways to reduce greenhouse gas emissions. This paper proposed a combined cooling, heating and power ({CCHP}) system, which is based on a basic system and consists of a transcritical {CO}2 cycle, an ejector refrigeration cycle, a domestic water heater and a thermoelectric generator. The parametric and comparative analyses are performed to show the system performance enhancement of the modification system. The multi-objective optimization is also conducted for the involved {CCHP} systems. Results show that compared to basic system, the novel system owns a higher exergy efficiency (30.75 {VS} 27.42\%) and a lower total product unit cost (27.39 {VS} 32.28 \$/{GJ}), confirming the obvious performance improvement. © 2021 {ICAE}.},

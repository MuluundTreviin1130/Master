@article{kong_real-time_2023,
	title = {Real-time pricing method for {VPP} demand response based on {PER}-{DDPG} algorithm},
	volume = {271},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149301695&doi=10.1016%2fj.energy.2023.127036&partnerID=40&md5=55554868ee4ff62f22ac05347bdf5d79},
	doi = {10.1016/j.energy.2023.127036},
	abstract = {Through ad vanced information communication and management system, virtual power plant ({VPP}) can realize the aggregation and coordination optimization of distributed energy, energy storage system, controllable load and other distributed energy resources. However, when making real-time price decisions according to users' demand response ({DR}) characteristics, the optimization effect of {VPP} is still limited by the evaluation accuracy of users’ {DR} potential and the computational burden of continuous decisions. By combining gate recurrent unit ({GRU}) and attention mechanism ({AM}), Neural Turing Machine ({NTM}) can extract users' response features in different environments and improve the accuracy of evaluating {DR} potential. Subsequently, based on the evaluation results, a deep deterministic policy gradient ({DDPG}) algorithm relying on prioritized experience replay ({PER}) is used to formulate a real-time electricity price plan. Ultimately, {VPP} achieves multi-objective optimization through {DR} management, which helps to increase the consumption amount of renewable energy resources, smooth its power fluctuation, and reduce users' electricity cost. Case study results show that the proposed method can improve the accuracy of the {DR} potential evaluation, reduce the response deviation to about 3\%, and enhance the real-time decision calculation efficiency by 17\%, which helps to optimize the smooth consumption of renewable energy. © 2023 Elsevier Ltd},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Kong, X. and Lu, W. and Wu, J. and Wang, C. and Zhao, X. and Hu, W. and Shen, Y.},
	date = {2023},
	keywords = {Multiobjective optimization, Renewable energy resources, Energy utilization, alternative energy, Costs, Electric energy storage, algorithm, Electric loads, energy storage, Virtual power plants, Deterministics, Demand-side management, Demand response, fuel consumption, power plant, Artificial neural network, Real time pricing, Information management, Renewable energy consumption, Policy gradient, Real time, accuracy assessment, Experience replay, Gradient algorithm, Neural turing machine, User demands, {VPP}},
}

@article{kong_multi-objective_2020,
	title = {Multi-objective power supply capacity evaluation method for active distribution network in power market environment},
	volume = {115},
	issn = {01420615},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85070395562&doi=10.1016%2fj.ijepes.2019.105467&partnerID=40&md5=6cfb25097d6eba76b23545912d4d8c9a},
	doi = {10.1016/j.ijepes.2019.105467},
	abstract = {Aiming at the power supply capability evaluation under the background of controllable source-network-load in power system, a multi-objective power supply capability evaluation method for active distribution network considering the active control cost is proposed. Firstly, uncertain factors such as renewable distributed generations’ output and demand response are modeled. Then, the maximization of regional power supply capacity and the minimization of active control costs are taken as the optimization objective from the perspective of both the planning and operation. Considering the constraints of distributed generations output ability, the network topology, load controllable levels, and so on, a multi-objective optimization uncertainty model for the active distribution network is constructed. In addition, the crossover operator and the selection strategy of {NSGA}-{II} are improved based on the non-uniform arithmetic crossover and phase-out strategy, which is used to solve the proposed optimization model. The Pareto optimal solution set obtained by the multi-objective optimization algorithm has a large scale and contains a wealth of information, and a method based on entropy-{TOPSIS} is also provided to select one eclectic solution set by the operator. Finally, the effectiveness of the proposed evaluation method and the performance of the improved algorithm are verified by the improved {IEEE} 33-bus distribution system and one of China's actual power grid. © 2019 Elsevier Ltd},
	journaltitle = {Int J Electr Power Energy Syst},
	publisher = {Elsevier Ltd},
	author = {Kong, X. and Yong, C. and Wang, C. and Li, P. and Yu, L. and Chen, Y.},
	date = {2020},
	keywords = {Multiobjective optimization, Electric power transmission networks, Distributed power generation, Renewable energies, Pareto principle, Power markets, Demand response, Electric power system control, Active distribution network, Active distribution networks, Network reconfiguration, Topology, Network re-configuration, Power supply capacity},
}

@inproceedings{korber_towards_2020,
	title = {Towards Renewable Energy Communities - Assessing the techno-economic and -ecologic potentials of a collaborative, decentral multi-energy system},
	isbn = {27324494},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174643607&partnerID=40&md5=7b6cf131c49b6c43bf65217d7aa134fb},
	abstract = {Towards a real-world implementation of Renewable Energy Communities, this paper introduces a toolchain as decision support tool for techno-economic and -ecologic design choices, providing essential insights to a holistic energy concept for the Renewable Energy Communities. The methods include an in-depth data-driven assessment of actual energy demands and renewable energy potentials, as well as the comprehensive evaluation of the wide range of activities and technical options for the Renewable Energy Community, with a multi-criteria optimization model. The latter maps the stakeholder-related invest and operation options within a decentral multi-energy systems approach. Exemplary results for a rural community in Germany exhibit a variety of options for the future design of such a system involving the renovation of buildings, the replacement of decentral heating systems, the integration of renewable energies, the use of storage systems, in particular district energy storage systems, and the expansion of an existing district heating grid. Outcomes imply possible benefits in terms of costs and emission reductions from joint acquisition of assets, local energy sharing and the sector integration of electricity and heat. © 2022 {IET} Conference Proceedings. All rights reserved.},

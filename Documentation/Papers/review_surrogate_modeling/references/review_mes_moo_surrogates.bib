@ARTICLE{Mahmoud2025,
	author = {Mahmoud, Montaser and Haridy, Salah and Mdallal, Ayman and Alami, Abdul Hai and Abdelkareem, Mohammad Ali and Olabi, Abdul Ghani},
	title = {Modelling and optimization of a hybrid photovoltaic-parabolic trough concentrated solar power plant: Technical, economic, and environmental},

}

@inproceedings{rasheed_cost_2021,
	title = {Cost Effective Operational Planning of a Retail Market with Distributed Generations},
	isbn = {978-1-6654-2873-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85125013579&doi=10.1109%2fICPS52420.2021.9670302&partnerID=40&md5=c6a5533f78a888acedd1087d9f3c4c26},
	doi = {10.1109/ICPS52420.2021.9670302},
	abstract = {In the retail electricity market, retailers play a very crucial role. They exchange energy through the grid and serve the load demand. Encouragement to deploy more renewable energy sources and storage devices ({RSD}) is giving an opportunity to the retailers to install their own distributed generators ({DG}). In such cases, a market framework must be designed to maintain the rational behavior of an electricity market. In this paper, a retail market simulation model is framed considering {RSD} owned by retailers. Profit earned by all retailers is maximized individually, and loss is also minimized from a utility point of view. In this way, this problem can be designed in many ways. Two distinct algorithms based on mixed-integer conic programming are proposed here, depending upon the different solution approaches. The first algorithm is solved as a multi-objective optimization problem ({OP}) using {\textbackslash}epsilon-constraint method. The second algorithm is solved as mathematical programming with equilibrium constraints ({MPEC}) model, which is converted into a single objective {OP}. A non-cooperative game theory approach is employed in this algorithm to satisfy the multiple objectives for different players (retailers). The proposed methodology is implemented on the 16-bus distribution test system to analyze the feasibility and effectiveness of the proposed algorithms. Results of the proposed algorithms are also compared with the existing algorithm comprising no retailers.  © 2021 {IEEE}.},
	eventtitle = {{ICPS} 2021 - 9th {IEEE} International Conference on Power Systems: Developments towards Inclusive Growth for Sustainable and Resilient Grid},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Rasheed, S. and Abhyankar, A. R.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Cost effectiveness, Distributed power generation, Operational planning, Electric energy storage, Integer programming, Cost effective, Sales, Load demand, Power markets, game theory, Virtual storage, Electric industry, Mixed Integer Conic Programming, Exchange energy, Mathematical programming with equilibrium constraints, Mixed-integer conic programming, {MPEC}, retail electricity market, Retail electricity markets, Retail market, {SD}},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@article{rashid_multi-objective_2024,
	title = {A Multi-Objective Harmony Search Algorithm for Optimal Allocation and Sizing of Multi-Renewable Energy-Based {DG} and {DSTATCOM} in Radial Distribution Systems},
	volume = {19},
	issn = {18276660},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213456512&doi=10.15866%2firee.v19i4.24848&partnerID=40&md5=903919d98fdf2d75e2dbee3107eeb461},
	doi = {10.15866/iree.v19i4.24848},
	abstract = {Global power sector expansion has increased energy demand over the previous decade, exposing centralized model flaws. In the 1980s, Distributed Generation ({DG}) installed smaller, cleaner units near load centers. {DG} addresses cost, dependability, and sustainability. Environmental variables, voltage, and current quality are now included in multi-objective optimization. In current research work, the author proposes a methodology on the basis of Harmony Search Algorithm ({HSA}) to achieve optimal allocation as well as sizing of Distribution {STATCOM} ({DST}) and renewable Distribution Generation ({DG}) in Radial Distribution System ({RDS}). In this approach, a multi-objective function is considered which is inclusive of voltage profile, cost mitigation and enhanced stability index. The proposed method was validated with the help of two most commonly applied {IEEE} {RDSs} such as the 33-bus system and 69-bus system. The study outcomes were discussed in terms of enhanced system voltage profile and operational stability both prior to and after allotting the sizes to {DG} and {DST}. The authors plotted graphs for improved system voltage stability index values for various cases under study. The proposed method was compared for its performance and effectiveness against the existing state-of-the-art systems. The comparative analysis outcomes reveal that {HSA} algorithm-based optimization, in comparison with rest of the algorithms, yields highly accurate results in terms of reduced real and reactive power losses and increased bus voltage levels and overall system stability. Copyright © 2024 Praise Worthy Prize S.r.l.-All rights reserved. © 2024 Praise Worthy Prize S.r.l.-All rights reserved.},
	pages = {283--299},
	number = {4},
	journaltitle = {Int. Rev. Elec. Eng.},
	publisher = {Praise Worthy Prize S.r.l},
	author = {Rashid, Y. G. and Ismail, M. T. and Hussein, B. M. and Ibrahim, S. S.},
	date = {2024},
	keywords = {Multi-objective optimization, renewable distributed generation, photovoltaic system, wind turbine, {DSTATCOM}, Harmony Search Algorithm ({HSA})},
}

@article{rasool_comparative_2023,
	title = {Comparative assessment of multi-objective optimization of hybrid energy storage system considering grid balancing},
	volume = {216},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168776587&doi=10.1016%2fj.renene.2023.119107&partnerID=40&md5=12a650c2a383a98d3c0192b1af451c68},
	doi = {10.1016/j.renene.2023.119107},
	abstract = {With the accelerated transition towards affordable and clean energy sources, the energy sector is undergoing a structural transformation that has resulted in a further increase in the complexity of energy system planning with rapid changes in techno-economic, environmental, reliability and social constraints. This signifies the consideration of purpose-driven multi-objective functions depending upon the functionality and applicability of the model. However, most of the studies adopt conventional bi-objective optimization either involving techno-economic, reliability and grid balancing parameters but there is a lack of comparative assessment of multi-objective optimization sizing for grid-interactive hybrid renewable energy system ({HRES}) consisting of short and long-term, battery and pumped hydro storage ({PHS}), energy storage systems ({ESS}). This study presents a comparative multi-objective framework to assess bi- and tri-objective function sizing techniques under grid balancing and non-balancing modes, to understand the scope and adaptivity of the modeling process for large-scale grid-interactive {HRES}. The analysis of results shows that the non-balancing mode underestimates the cost of energy ({COE}) by 18–30\% compared to the grid balancing mode due to smaller decision variable space while long-term {ESS} dominance is vital for the reduction of grid burden compared to short-term {ESS}. In terms of configuration, a hybrid {ESS} system, 0.22 {MWh} battery, 18.1 {MWh} {PHS}, and 5.4 {MW} {PV} capacity, is the best optimal configuration in grid balancing mode with the {COE}, {EEI} and {EII} equal to 0.09 \$/{kWh}, 7.5\% and 10.5\% respectively, whereas higher grid energy mismatch is induced by non-balancing mode with the overestimation of {EEI} and {EII} indexes up to 30\% and 33\% respectively. The environmental analysis shows that the carbon emissions avoided ({CEA}) are underestimated by 59.1\% with the non-consideration of grid balancing. This signifies that the adaptive optimization model improves the design and planning process of grid-interactive {HRES} by capturing larger uncertainties related to {COE}, grid balancing, and {CEA} with changes in the system and {ESS} sizing. Overall, this analysis provides a purpose-driven perspective to energy modelers and policymakers for the energy system modeling process of grid-interactive {HRES}. © 2023 Elsevier Ltd},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Rasool, M. H. and Taylan, O. and Perwez, U. and Batunlu, C.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric batteries, Multi-objective optimization, optimization, alternative energy, Energy policy, complexity, energy storage, Storage systems, Energy systems, Hybrid renewable energies, Hybrid renewable energy system, Reliability, Hybrid energy storage system, Hydro energy, Pumped storage power plants, Hybrid energy storage systems, Energy system modeling, Energy-system models, Cost of energies, planning process, Comparative assessment, Grid balancing},
}

@inproceedings{rathish_multi-objective_2014,

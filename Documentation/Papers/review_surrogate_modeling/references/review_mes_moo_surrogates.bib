@ARTICLE{Patty2025,
	author = {Patty, Sukriti and Malakar, Tanmoy},
	title = {Assessment of battery energy storage uses in microgrid operation under varied demand uncertainties through a machine learning based stochastic optimization approach},
	year = {2025},
	journal = {Physica Scripta},
	volume = {100},
	number = {3},
	pages = {},
	doi = {10.1088/1402-4896/adb545},
	url = {https://www.scopus.com/pages/publications/85218629375?origin=resultslist},
	abstract = {The sustainability of Microgrid (MG) relies on improving reliability through effective energy management strategies. However, the presence of volatile Renewable Energy Sources (RES) and uncertain energy demand pose serious challenges. Although integrating Battery Energy Storage Systems (BES) is a promising solution, the utilization of BES under uncertain operating conditions remains underexplored. Given this, the present study aims to investigate BES operational behavior while minimizing the overall MG operation cost under varied operating conditions. Also, it evaluates the impact of prediction accuracy on overall MG operation costs and DER operation. Here, a Machine Learning (ML) -based Gaussian Process Regression (GPR) is utilized for predicting the volatile RES power output while the uncertain energy demand is estimated with Monte Carlo Simulation (MCS).The problem is formulated as a cost-minimization problem and solved using the physics-based Artificial Electric Field Algorithm (AEFA) at different MG operating conditions. Results show that MG operation cost varies approximately by 5%, with demand variations around the mean, and BES energy contribution is 1.3 times higher for the case with additional thermal load. Moreover, analysis confirms that the BES depreciation cost is faster with a lower initial State of Charge (SOC), and the proposed strategy ensures a higher SOC by day’s end. Additionally, GPR’s applicability is validated through comparison with the Gated Recurrent Unit (GRU), revealing lower BES depreciation and MG operation costs due to higher prediction accuracy. Further, a comparative analysis with 2m Point Estimate Method is done to highlight the superiority and robustness of the proposed approach. © 2025 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {Battery storage; machine learning; Microgrid; physics-based optimization; renewable energy; uncertainty},
	keywords = {Battery management systems; Battery storage; Cost benefit analysis; Microgrids; Renewable energy; State of charge; Battery energy storage systems; Battery storage; Machine-learning; Microgrid; Microgrid operations; Optimisations; Physic-based optimization; Physics-based; Renewable energies; Uncertainty; Depreciation},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Liao20257251,
	author = {Liao, Fengxiang and Zhang, Xi and Luo, Kui and Li, Suning},
	title = {Optimizing Reactive Power Outputs of SVC After Faults in Renewable Power Grids},
	year = {2025},
	journal = {Chinese Control Conference, CCC},
	pages = {7251 - 7255},
	doi = {10.23919/CCC64809.2025.11178358},
	url = {https://www.scopus.com/pages/publications/105020269843?origin=resultslist},
	abstract = {To address the issue of insufficient or excessive reactive power output in power systems equipped with a Static Var Compensator (SVC) during voltage sag and recovery events, this paper investigates the influence of SVC control parameters on reactive power output and thoroughly examines the corresponding voltage reactive power response characteristics. It is observed that, for the same set of control parameters K<sub>s</sub> and dU, the objectives of maximizing SVC reactive power output during voltage sag and minimizing it during voltage recovery are inherently conflicting, thereby forming a multi-objective optimization problem. To solve this, a neural network is first trained using actual simulation data to construct a surrogate model capable of accurately simulating the transient reactive power output characteristics of most SVCs, overcoming the high computational cost and extensive iterative solving typically required by the Non-dominated Sorting Genetic Algorithm II (NSGA-II). The neural network is then integrated with NSGA-II for multi-objective optimization, resulting in the Pareto optimal front for the SVC's reactive power output, which significantly enhances SVC performance. © 2025 Technical Committee on Control Theory, Chinese Association of Automation.},
	author_keywords = {Control Parameters; NSGA-II; Pareto Front; Reactive Power Output; SVC},
	keywords = {Computer system recovery; Electric power system control; Genetic algorithms; Iterative methods; Multiobjective optimization; Pareto principle; Power control; Sorting; Value engineering; Control parameters; Neural-networks; Non dominated sorting genetic algorithm ii (NSGA II); Pareto front; Power grids; Reactive power output; Renewable Power; VAR compensators; Voltage recovery; Voltage sags; Reactive power; Static Var compensators},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}


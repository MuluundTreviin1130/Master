	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@inproceedings{pazheri_environmental_2013,
	title = {Environmental and economic power dispatch for hybrid power system with distributed energy storage},
	isbn = {978-1-4799-1125-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84897729314&doi=10.1109%2fISIEA.2013.6738979&partnerID=40&md5=89b14e5e0fa1e2fbe09916c2b94c357d},
	doi = {10.1109/ISIEA.2013.6738979},
	abstract = {Distributed generation and distributed storage facilities help to utilize conventional and renewable energy resources in an efficient manner. Hybrid power system ({HPS}) with distributed generation and storage facilities guarantee minimum lifecycle cost and environmental impacts for generation units. A multi-objective optimization to minimize the amounts of overall generation cost and total pollutant emissions of {HPS} is discussed in this paper. The generation cost of thermal, renewable, storage based power plants and costs paid for health and environmental damages caused by emissions are considered in the analysis. {MATLAB} simulation is carried out with sequential quadratic programming ({SQP}) algorithm. Analysis shows that the cost of electricity from renewable energy resources ({RES}) based plants is smaller than conventional fuels based plants, provided the cost associated with health and environmental damages caused by the pollutants emissions from the thermal plants is taken into considerations. © 2013 {IEEE}.},
	pages = {117--121},
	author = {Pazheri, F. R. and Othman, M. F.},

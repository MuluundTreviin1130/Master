	date = {2024},
	keywords = {Multiobjective optimization, Energy management systems, Decision making, Microgrid, Microgrids, optimization, Optimisations, Energy management, Electric energy storage, Storage systems, Generation systems, Electric load flow, Renewable generation, Power control, Decisions makings, Integrated systems, Electricity system, Fuzzy control, integrated system, Regional energy systems, renewable generation system},

	title = {Optimization of energy storage in the active distribution network with multiple microgrids},
	isbn = {979-8-3315-1806-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000255306&doi=10.1109%2fEPEE63731.2024.10875499&partnerID=40&md5=5c847a0f6b1da479c9948d4c38e071a2},

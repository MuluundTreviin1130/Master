}

@inproceedings{shi_optimal_2016,
	title = {Optimal Scheduling of active distribution systems for transregional utilization of renewable energy},
	isbn = {978-1-4673-7106-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84968820484&doi=10.1109%2fDRPT.2015.7432276&partnerID=40&md5=8a48e7586aec7a599ab92f53905efe26},
	doi = {10.1109/DRPT.2015.7432276},
	abstract = {In this study, the optimal operation of active distribution system ({ADS}) is investigated considering renewable energy harvest in cross regions under a multi-objective optimization framework. For this end, we first deduce the active/reactive capability of renewable distributed generation ({RDG}) units under the decoupled state. On this basis, a multi-objective model for {ADS} scheduling is developed, which considers the minimization of operation cost, renewable energy curtailment and network losses simultaneously. In this model, various types of distributed energy resources, including {RDG}, energy storage and interruptible loads are incorporated collectively, and the inter-temporal constraints that associated are especially accounted for. The proposed optimization problem is solved by the Multi-objective Harmony Search ({MOHS}) algorithm. The effectiveness of the proposed method is verified on a modified 33-bus distribution system, and the necessity for incorporating reactive capability of renewable-based {DG} units is also revealed. © 2015 {IEEE}.},
	pages = {431--436},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Shi, J. and Zeng, B. and Zhou, Y. and Zhang, J. and Zheng, X. and Yang, X.},

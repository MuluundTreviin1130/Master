	isbn = {978-1-7281-2440-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074111064&doi=10.1109%2fSEGE.2019.8859872&partnerID=40&md5=ae99f3c39fe269db6a1937202d3c984b},

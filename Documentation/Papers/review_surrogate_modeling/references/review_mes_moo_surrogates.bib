@inproceedings{kang_coordination_2012,
	title = {Coordination strategy for harmonic compensation using multiple distributed resources},
	isbn = {19449933},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84870591798&doi=10.1109%2fPESGM.2012.6344671&partnerID=40&md5=64f3fa58d99dfe80f0a75cc327ff6b80},
	doi = {10.1109/PESGM.2012.6344671},
	abstract = {Nowadays, due to the development of power electronic technology, nonlinear electronic loads using power electronic circuits are widespread in power grids. The loads can consume more reliable and high-quality power through the power conversion circuits. However, the power grids can suffer significant harmonic currents caused by these power electronic circuits. This paper proposes a new harmonic compensation method of utilizing multiple power inverters that integrate distributed resources ({DRs}) to a microgrid. Therefore, harmonic problems can be solved without installing additional power filters to the grids. To coordinate multiple various {DGs} such as small distributed generators ({DGs}) and battery energy storage systems ({BESSs}), the proposed method considers multiple objectives in terms of energy cost, generation margins of {DGs} and energy margins of {BESSs}. The optimization algorithm is constructed based on fuzzy multi-objective optimization model so that the proposed method assigns the additional output power of each {DR} that is needed for harmonic elimination. Simulations of the suggested coordination strategy for harmonic compensation using multiple {DRs} are conducted in the microgrid including two inverter-based {DGs} and one {BESS} to verify the performance of the proposed method. © 2012 {IEEE}.},
	eventtitle = {{IEEE} Power and Energy Society General Meeting},
	editor = {Kang, H.-K. and Chung, I.-Y. and Moon, S.-I.},
	date = {2012},
	keywords = {Multiobjective optimization, Distributed resources, Multi-objective optimization, Micro grid, Distributed generators, Multi-objective optimization models, Distributed power generation, Optimization algorithms, Battery energy storage systems, Output power, Algorithms, Power grids, Energy cost, Multi objective optimizations ({MOO}), Harmonic analysis, Power filters, Multiple objectives, Coordination strategy, Electronic load, Electronic technologies, Energy margin, Harmonic compensation, Harmonic currents, Harmonic elimination, Harmonic problems, High quality, Inverter-based, Multiple distributed resources control, Power conversion, Power inverters, Power system harmonics},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: H.-K. Kang; School of Electrical Eng, Seoul National University, Seoul, 151-742, 301-Dong, South Korea; email: khyun9@powerlab.snu.ac.kr},
}

@article{kang_intelligent_2012,
	title = {Intelligent coordination method of multiple distributed resources for harmonic current compensation in a microgrid},
	volume = {7},
	issn = {19750102},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84868350356&doi=10.5370%2fJEET.2012.7.6.834&partnerID=40&md5=977791c66d1a694db77a4a1b799fb561},
	doi = {10.5370/JEET.2012.7.6.834},
	abstract = {Nonlinear electronic loads draw harmonic currents from the power grids that can cause energy loss, miss-operation of power equipment, and other serious problems in the power grids. This paper proposes a harmonic compensation method using multiple distributed resources ({DRs}) such as small distributed generators ({DGs}) and battery energy storage systems ({BESSs}) that are integrated to the power grids through power inverters. For harmonic compensation, {DRs} should inject additional apparent power to the grids so that certain {DRs}, especially operated in proximity to their rated power, may possibly reach their maximum current limits. Therefore, intelligent coordination methods of multiple {DRs} are required for efficient harmonic current compensation considering the power margins of {DRs}, energy cost, and the battery state-of-charge. The proposed method is based on fuzzy multiobjective optimization so that {DRs} can cooperate with other {DRs} to eliminate harmonic currents with optimizing mutually conflicting multi-objectives.},
	pages = {834--844},
	number = {6},
	journaltitle = {J. Electr. Eng. Technol.},
	author = {Kang, H.-K. and Yoo, C.-H. and Chung, I.-Y. and Won, D.-J. and Moon, S.-I.},
	date = {2012},
	keywords = {Multiobjective optimization, Distributed resources, Energy dissipation, Multi-objective optimization, Micro grid, Microgrid, Distributed generators, Distributed power generation, Battery energy storage systems, Multi objective, Power grids, Energy cost, State of charge, Multi objective optimizations ({MOO}), Harmonic analysis, Electronic load, Harmonic compensation, Harmonic currents, Multiple distributed resources control, Power inverters, Apparent power, Coordination methods, Current limits, Fuzzy multiobjective optimization, Harmonic current compensations, Power equipment, Power margins},
}

@inproceedings{kang_optimal_2023,
	title = {Optimal Capacity Allocation Method of Grid-Connected Wind and Solar Hydrogen Storage System Considering Stepped Carbon Emissions and Time-of-Use Electricity Price},
	isbn = {979-8-3503-1135-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165631248&doi=10.1109%2fICPST56889.2023.10164953&partnerID=40&md5=c2645b95b6708321fd83cc362bbc2e28},
	doi = {10.1109/ICPST56889.2023.10164953},
	abstract = {Due to the high proportion of renewable energy access, the reasonable capacity allocation of each unit of the system is the premise to ensure the economic, environmental protection and reliable operation of the system. A grid-connected hybrid energy storage system with hydrogen energy storage and battery is proposed, which takes the total annual net present cost, load deficiency rate and relative standard deviation of tie line power as the objective function. Considering that the system will generate carbon emissions from power purchase from the power grid, a stepped carbon emission model is established, which is included in the total annual net cost of the system to establish an optimal allocation model of system capacity, and an improved operation strategy considering time-of-use electricity price is proposed. Then, the multi-objective optimization algorithm is used to solve the optimization problem, and the optimal capacity allocation scheme of fan, photovoltaic and energy storage is obtained by making the optimal solution set decision based on the improved Critic-Topsis model. In the analysis of numerical examples, the optimal configuration schemes of three different Mode of operation systems are compared and discussed, and the superiority of the improved operation strategy is proved.  © 2023 {IEEE}.},
	pages = {729--734},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Kang, J. and Wan, J. and Han, X. and Li, Y. and Yan, H. G.},
	date = {2023},
	keywords = {Multiobjective optimization, Carbon, Hydrogen storage, Solar power generation, Costs, Electric energy storage, Numerical methods, Electric loads, Carbon emissions, hydrogen energy storage, Hydrogen energy storages, Grid-connected, Capacity allocation, Optimal capacity allocation, Critic-topsi model, critic-Topsis model, Emission model, stepped carbon emission model, Time-of-use electricity price, {TOPSIS} models},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: J. Kang; China Electric Power Research Institute Co., Ltd., Beijing, China; email: gjun\_m@126.com},
}

@article{kang_research_2024,
	title = {Research on optimization method of {CCHP} system coupled with renewable energy},
	volume = {79},
	issn = {28047699},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205802175&doi=10.2516%2fstet%2f2024069&partnerID=40&md5=6288c008b909b26ccef58ab1349ced24},
	doi = {10.2516/stet/2024069},
	abstract = {Renewable energy is widely used in combined cooling, heating and power ({CCHP}) systems. This is important for building a low-carbon, flexible, multi-energy complementary energy system. However, coupling different renewable energy sources can have a somewhat differentiated impact on the performance of the system. In this study, an approach combining a long short-term memory ({LSTM}) network with multiple optimization algorithms is proposed. Comparative performance analysis of {CCHP} systems coupling solar and wind subsystems is conducted. Firstly, the renewable energy output is predicted by {LSTM}. Then, the Pareto frontiers of the coupled renewable energy {CCHP} system are generated by the Non-dominated Genetic Sorting Algorithm. The results are fed into the distance between superior and inferior solution methods to arrive at a decision, completing the multi-objective optimization of the system. Results show that the {CCHP} system coupling photovoltaic ({PV}) and solar collector ({ST}) is superior to the {CCHP} system coupling photovoltaic-photovoltaic-thermal integrated device. The system performance can be further improved by adding wind turbines to the integrated system coupling {PV} and {ST}. © The Author(s), published by {EDP} Sciences, 2024.},
	journaltitle = {Sci. technol. Energy. Transition.},
	publisher = {Editions Technip},
	author = {Kang, L. and Sun, D. and Zhao, W. and Wang, W. and Wu, X. and Zhang, X. and Yang, Y. and Wang, Y.},
	date = {2024},
	keywords = {Renewable energy, genetic algorithm, optimization, Photovoltaics, alternative energy, Renewable energies, {TOPSIS}, Combined heat and power, {NSGA}-{II}, Optimization method, Artificial neural network, {LSTM}, Combined cooling heating and power, multicriteria analysis, Windmill, Combined cooling, System coupling, Low carbon, research, {CCHP} system, Heating and power system, Short term memory},
}


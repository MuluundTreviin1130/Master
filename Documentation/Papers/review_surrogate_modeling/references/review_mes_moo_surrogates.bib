@ARTICLE{Liu2026,
	author = {Liu, Wei and Zhang, Tao and Lin, Chenhui and Li, Kaiwen and Wang, Rui},
	title = {Graph attention networks unleashed: A fast and explainable vulnerability assessment framework for microgrids},

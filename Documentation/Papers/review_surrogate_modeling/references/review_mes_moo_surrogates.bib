	isbn = {21574839},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85060398790&doi=10.1109%2fAPPEEC.2018.8566354&partnerID=40&md5=691bb788d1853049700ffdcfb43787bf},
	doi = {10.1109/APPEEC.2018.8566354},
	abstract = {This paper proposes a multi-objective optimal dispatch strategy for dispatchable distributed generation units in an {AC}-{DC} hybrid microgrid. The proposed method determines optimal droop values of dispatchable distribution generation units to minimize total operation cost and emission in an {AC}-{DC} hybrid microgrid. Two objectives (minimization of operation cost and emission) are represented in the fuzzy domain by fuzzy membership functions. The membership function having the minimum value is considered as the membership value of the aggregated objective. The membership function value of the aggregated objective is maximized to obtain the optimal solution. Optimization is carried out using particle swarm optimization technique. A 6-bus {AC}-{DC} hybrid microgrid test system is used for the simulation study. Simulation results demonstrate the potency of the suggested method. © 2018 {IEEE}.},

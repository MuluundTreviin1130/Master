}

@article{wang_research_2022,
	title = {Research on Interval Security Region of Regional Integrated Energy System Integrated With Renewable Energy Sources, Part {II}: Full-dimensional Observation and Optimization of Region Geometric Features},
	volume = {42},
	issn = {02588013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149712892&doi=10.13334%2fj.0258-8013.pcsee.212758&partnerID=40&md5=a071229234718e8f1f0b40345a8f02a4},
	doi = {10.13334/j.0258-8013.pcsee.212758},
	abstract = {Security region method is an important method for security analysis of regional integrated energy system. As an important part of its research system, region morphology observation and optimization are the basis of subsequent region application. For the whole region, the researches on how to observe it without dimension reduction and realize the region geometric features optimization are not enough. Therefore, based on the practical interval security region ({PISR}) constructed in the first part of the series, this paper established the practical interval full-dimensional radius ({PIFR}) analytical model and numerical model from the perspective of full-dimension, and compared the application characteristics of them. Then a {PISR} full-dimensional observation method based on the latter one was proposed. Based on the {PIFR} model, the full-dimensional {PISR} balance degree index and impact degree index of renewable energy uncertainty were constructed to quantitatively analyze the geometric features of the region. And the capacity expansion cost index of key components of energy hub was established to measure features optimization cost. Then a {PISR} geometric features multi-objective optimization method based on {PIFR} was proposed. Finally, combined with a test case, the full-dimensional observation and geometric feature optimization analysis of the system security region were carried out to verify the effectiveness and practicability of the proposed model and method. The two {PIFR} solution models were compared. Aiming at the region defects, by changing the system parameters, i.e., the capacity expansion of key components, the multi-objective optimization scheme set of region geometric features was given and analyzed to realize the region morphology optimization from the perspective of full-dimension. The proposed method broadens the access to security information of regional integrated energy system with renewable energy, and lays a theoretical foundation for the application research such as planning and operation. © 2022 Chinese Society for Electrical Engineering. All rights reserved.},
	pages = {7809--7820},
	number = {21},
	journaltitle = {Zhongguo Dianji Gongcheng Xuebao},
	publisher = {Chinese Society for Electrical Engineering},
	author = {Wang, D. and Li, S. and Jia, H. and Guo, Y. and Xiao, J.},
	date = {2022},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Renewable energy sources, Optimisations, uncertainty analysis, Integrated energy systems, Geometry, regional integrated energy system, Security systems, Features optimizations, full-dimensional observation, Geometric feature, Geometric feature optimization, geometric features optimization, Morphology, practical interval security region, Security region},
}

@article{wang_online_2012,
	title = {Online voltage security assessment considering comfort-constrained demand response control of distributed heat pump systems},
	volume = {96},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84862817633&doi=10.1016%2fj.apenergy.2011.12.005&partnerID=40&md5=16c8f0996993ad6f4f7507f16174e11f},
	doi = {10.1016/j.apenergy.2011.12.005},
	abstract = {A resilient strategy for optimal demand response control based on the management of highly-distributed electric loads is presented to meet transmission-level control aimed at maintaining voltage stability. The proposed load control scheme balances device- and grid-level objectives simultaneously, and is demonstrated for a system comprising a distributed responsive population of 14,000 residential-sized buildings integrated in a transmission system network consisting of six buses. Air-source heat pumps are implemented as the primary heating source in the responsive building population, and are introduced as a dispatchable grid-side energy resource, where aggregated output can be objectively ramped up or down through the use of an optimal centralized control strategy. A two step multi-objective optimization procedure is implemented to simultaneously satisfy balancing of the power system and customer objectives across a multi-scalar system. At the power system-level, the optimal preventive control scheme is obtained based on steady-state voltage stability constraints. At the customer-level, an optimal demand response strategy is proposed, wherein the aggregate power demand from a population of heat pumps is controlled to follow load-shedding requirements. The customer comfort is continuously maintained by constrained regulation of the thermal set-point governing operation of the heat pump device.The proposed demand-side strategy achieves similar goals to conventional approaches to regulation and spinning reserve ancillary services, but with the significant benefit of higher efficiencies. Under the proposed scheme, ancillary services provided by the electric loads effectively become virtual generators that enhance the voltage stability in power systems operating under increased uncertainty, and replace severe or multiple contingency reserves typically supplied by conventional generators. The proposed demand response control scheme can be extended to other potentially responsive end-use appliances, and opens avenues for increased exploitation of intermittent renewable energy resources while reducing operating costs and emissions. © 2011 Elsevier Ltd.},
	pages = {104--114},

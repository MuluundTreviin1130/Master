@article{wang_performance_2024,
	title = {Performance analysis and optimization of a zero-emission solar-driven hydrogen production system based on solar power tower plant and protonic ceramic electrolysis cells},
	volume = {83},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201518781&doi=10.1016%2fj.ijhydene.2024.08.174&partnerID=40&md5=857225e4e2e11e97414e8baf3862108d},
	doi = {10.1016/j.ijhydene.2024.08.174},
	abstract = {The solar-driven high-temperature steam electrolysis is promising for efficient large-scale H2 production. In this study, a comprehensive component-to-system model and optimization framework is developed to investigate the performance of a zero-emission H2 production system based on solar power plant and protonic ceramic electrolysis cell. Compared to previous system studies, the detailed description of cell internal operating characteristics is realized by integrating multi-physics simulation and artificial neural network. After parametric analyses, it is found that the system energy/exergy efficiency and co-generation performance are complicated by each subsystem. And the optimal system performance (ηth = 50.63 \%, Z = 179.63 \$·h−1 and ηex = 33.03 \%, Z = 178.94 \$·h−1, with {LCOE} = 0.172 \$·{kWh}−1 and {ZH}2 = 6.497 \$·kg−1) is obtained considering cell operating features and system energy-exergy-economic factors through multi-objective optimizations. Besides, the tradeoff between system maximum H2 production capacity and cell internal thermal conditions is revealed. This study can facilitate the development of zero-emission green H2 production driven by renewable energy. © 2024 Hydrogen Energy Publications {LLC}},
	pages = {1415--1428},
	journaltitle = {Int J Hydrogen Energy},
	publisher = {Elsevier Ltd},
	author = {Wang, C. and Zhu, M. and Li, Z. and Xu, H. and Zheng, K. and Han, M. and Ni, M.},
	date = {2024},
	keywords = {Economics analysis, Exergy, Neural-networks, Power towers, Artificial neural network, Brayton cycle, Solar power plants, Brayton, Supercritical {CO} 2, supercritical {CO}2 Brayton cycle, Supercritical {CO}2 brayton cycle, Thermo dynamic analysis, Supercritical fluid extraction, Electrolysis cell, H 2 production, Fluidized bed process, Thermodynamic and economic analysis, Solar power tower, Green H2 production, Hydraulic mining, Protonic, Protonic ceramic electrolyse cell, Protonic ceramic electrolysis cell, Protonic ceramic fuel cells ({PCFC})},
}

@inproceedings{wang_multi-scenario_2011,
	title = {Multi-scenario, multi-objective optimization of grid-parallel Microgrid},
	isbn = {978-1-4577-0363-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-80053027469&doi=10.1109%2fDRPT.2011.5994160&partnerID=40&md5=434f6f5c9b493e1b0c8269d203653763},
	doi = {10.1109/DRPT.2011.5994160},
	abstract = {A multi-scenario, multi-objective optimization method of a grid-parallel Microgrid ({MG}) is presented aiming for more comprehensive and accurate assessment of a grid-parallel {MG}. First, different operational modes of a grid-parallel {MG} are analyzed and sorted. Normally, the {MG} will connect with the energy deliver system most of the time, providing functions such as peak shaving, system reserve. But it is also required to operate separately from the grid in planned or unplanned island mode due to different reasons, e.g., power outage, abnormal weather. Then, a multi-objective optimization method to size {MG} based on different operational scenarios study is proposed. The objectives consist of {MG} construction and operation cost, reliability cost, ancillary values, utilization of renewable energy and emission. An improved customer outage cost analysis method is demonstrated taking power outage reasons and reliability requirement of load into consideration. A demonstration {MG} considered in this paper consists of {PV}, wind turbine ({WT}), diesel generator, converter and battery energy storage. The results prove that the method presented is sound and effective. © 2011 {IEEE}.},

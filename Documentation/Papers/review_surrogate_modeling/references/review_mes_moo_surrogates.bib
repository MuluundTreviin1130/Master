@article{maheri_critical_2014,
	title = {A critical evaluation of deterministic methods in size optimisation of reliable and cost effective standalone hybrid renewable energy systems},
	volume = {130},
	issn = {09518320},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84903600222&doi=10.1016%2fj.ress.2014.05.008&partnerID=40&md5=02d4d13780d5229cb4400f8f42accac5},
	doi = {10.1016/j.ress.2014.05.008},
	abstract = {Reliability of a hybrid renewable energy system ({HRES}) strongly depends on various uncertainties affecting the amount of power produced by the system. In the design of systems subject to uncertainties, both deterministic and nondeterministic design approaches can be adopted. In a deterministic design approach, the designer considers the presence of uncertainties and incorporates them indirectly into the design by applying safety factors. It is assumed that, by employing suitable safety factors and considering worst-case-scenarios, reliable systems can be designed. In fact, the multi-objective optimisation problem with two objectives of reliability and cost is reduced to a single-objective optimisation problem with the objective of cost only. In this paper the competence of deterministic design methods in size optimisation of reliable standalone wind-{PV}-battery, wind-{PV}-diesel and wind-{PV}-battery-diesel configurations is examined. For each configuration, first, using different values of safety factors, the optimal size of the system components which minimises the system cost is found deterministically. Then, for each case, using a Monte Carlo simulation, the effect of safety factors on the reliability and the cost are investigated. In performing reliability analysis, several reliability measures, namely, unmet load, blackout durations (total, maximum and average) and mean time between failures are considered. It is shown that the traditional methods of considering the effect of uncertainties in deterministic designs such as design for an autonomy period and employing safety factors have either little or unpredictable impact on the actual reliability of the designed wind-{PV}-battery configuration. In the case of wind-{PV}-diesel and wind-{PV}-battery-diesel configurations it is shown that, while using a high-enough margin of safety in sizing diesel generator leads to reliable systems, the optimum value for this margin of safety leading to a cost-effective system cannot be quantified without employing probabilistic methods of analysis. It is also shown that deterministic cost analysis yields inaccurate results for all of the investigated configurations. © 2014 Elsevier Ltd. All rights reserved.},
	pages = {159--174},
	journaltitle = {Reliab Eng Syst Saf},
	publisher = {Elsevier Ltd},
	author = {Maheri, A.},
	date = {2014},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric batteries, Hybrid renewable energy systems, Cost effectiveness, Monte Carlo methods, Hybrid renewable energy system, Hybrid Renewable Energy System ({HRES}), Reliability analysis, Cost benefit analysis, Mean time between failures, Diesel engines, Cost effective systems, Design optimisation, Design optimisation under uncertainties, Deterministic methods, Non-deterministic designs, Power reliability, Safety factor, Wind-{PV}-battery, Wind-{PV}-battery-diesel, Wind-{PV}-diesel},
}

@article{maheri_multi-objective_2014,
	title = {Multi-objective design optimisation of standalone hybrid wind-{PV}-diesel systems under uncertainties},
	volume = {66},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84893647771&doi=10.1016%2fj.renene.2014.01.009&partnerID=40&md5=76206382efb98677715b60910559f763},
	doi = {10.1016/j.renene.2014.01.009},
	abstract = {Optimal design of a standalone wind-{PV}-diesel hybrid system is a multi-objective optimisation problem with conflicting objectives of cost and reliability. Uncertainties in renewable resources, demand load and power modelling make deterministic methods of multi-objective optimisation fall short in optimal design of standalone hybrid renewable energy systems ({HRES}). Firstly, deterministic methods of analysis, even in the absence of uncertainties in cost modelling, do not predict the levelised cost of energy accurately. Secondly, since these methods ignore the random variations in parameters, they cannot be used to quantify the second objective, reliability of the system in supplying power. It is shown that for a given site and uncertainties profile, there exist an optimum margin of safety, applicable to the peak load, which can be used to size the diesel generator towards designing a cost-effective and reliable system. However, this optimum value is problem dependent and cannot be obtained deterministically. For two design scenarios, namely, finding the most reliable system subject to a constraint on the cost and finding the most cost-effective system subject to constraints on reliability measures, two algorithms are proposed to find the optimum margin of safety. The robustness of the proposed design methodology is shown through carrying out two design case studies. © 2014 Elsevier Ltd.},
	pages = {650--661},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Maheri, A.},
	date = {2014},
	keywords = {Multiobjective optimization, Renewable energy resources, Design, Hybrid renewable energy systems, optimization, Cost effectiveness, uncertainty analysis, Optimal systems, Hybrid systems, algorithm, Hybrid Renewable Energy System ({HRES}), Reliability analysis, Multiobjective optimisation, photovoltaic system, Cost benefit analysis, Conflicting objectives, numerical model, Diesel engines, Levelised cost of energies, Design under uncertainties, Design under uncertainty, diesel, Cost effective systems, cost-benefit analysis, Wind-{PV}-diesel, Multi-objective design optimisation, Probabilistic reliability analysis},
}

@inproceedings{maheshwari_multi-objective_2022,
	title = {Multi-objective optimization of Smart Integrated Renewable Energy System ({SIRES})},
	isbn = {978-1-6654-6591-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85135121469&doi=10.1109%2fKPEC54747.2022.9814800&partnerID=40&md5=c1b7a902d102229d3aedc83907b4f1d7},
	doi = {10.1109/KPEC54747.2022.9814800},
	abstract = {Global energy shortage and environmental impacts of fossil fuels is leading to increased interest in renewable energy technology. Several approaches such as microgrids, hybrid systems have been proposed for the development of rural areas. However, these systems only supply electricity to remote rural areas. Smart Integrated Renewable Energy Systems ({SIRES}) is proposed as a means to harness renewable energy in a cost effective and viable manner to fulfill needs such as cooking, domestic water and irrigation water in addition to electricity. To meet these needs, a multi-objective optimization using Particle Swarm optimization ({PSO}) is developed in this paper. A tradeoff between the Annualized Cost of System ({ACS}), Carbon Emission Cost ({CEC}) and a novel reliability index called Need Fulfillment Probability ({NFP}) are analysed. Results obtained for {SIRES} are compared to microgrid for the same amount of needs.  © 2022 {IEEE}.},

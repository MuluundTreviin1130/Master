	author = {Elango, K. and Prakash, A. and Umasankar, L.},
	date = {2022},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric batteries, Natural resources, Particle swarm optimization ({PSO}), Gas emissions, Multi-objective optimization models, Optimisations, Sensitivity analysis, uncertainty analysis, Optimal design, Optimal systems, Cooling systems, Photovoltaic cells, Optimization algorithms, Load demand, Uncertainty, Fossil fuels, Probability distributions, Virtual storage, Availability, Combined cooling heating and power, turbine, Tanks (containers), Storage devices, Algorithm methods, battery and tank, Demand uncertainty, energy converters, photovoltaic/thermal collectors},

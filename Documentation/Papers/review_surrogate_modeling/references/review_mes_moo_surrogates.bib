}

@article{leng_modeling_2024,
	title = {Modeling of calculations on the performance optimization of a double-flash geothermal renewable energy-based combined heat/power plant coupled by transcritical carbon dioxide rankine cycle},
	volume = {237},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206186344&doi=10.1016%2fj.renene.2024.121595&partnerID=40&md5=70c22347ae3a026804dc154d8c4ab200},

	author = {Kim, Hyung Joon and Kim, Dongwoo and Tak, Hyunwoo and Lee, Jae Yong},
	title = {Interpretable probabilistic forecasting of building multi-energy loads using residual learning and global attention-enabled transformer: A case study for residential buildings in South Korea},
	year = {2026},
	journal = {Energy and Buildings},

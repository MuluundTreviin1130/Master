@article{chu_technology_2020,
	title = {Technology and Application of Multi-energy Coordinative Optimization With Complex Cascade Transmission Section},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092611613&doi=10.13335%2fj.1000-3673.pst.2020.0484&partnerID=40&md5=b247f25a77a89bdd66e63533cf947d32},
	doi = {10.13335/j.1000-3673.pst.2020.0484},
	abstract = {In the power system with high proportion of new energy, the doubly uncertainty of variable new energy and load make it difficult to control power flow finely and effectively. To resolve the contradiction between traditional transmission section control strategy that has adequate safety margin and new energy consumption demand, considering a certain security risk, an ultra-short-term new energy forecast revision method is established. Based on that, a multi-objective optimization model is established with complex cascade section in this paper. Besides system constraints, unit constraints and network constraints, while permit-tripped power generation constraints and uniqueness section limit constraints are set according to the characteristics of complex cascade transmission sections, the objective is set as to maximize new energy accommodation and power section utilization. It is found from results of a practical application in the Northwest China power grid that, the utilization rate of section increases more than 8 points during new energy curtailment time, and new energy power generation increases average 800 thousand {kW}•h per day when the model is adopted, which verify that the proposed optimization model is effective to control power flow finely and maximize new energy accommodation and section utilization. © 2020, Power System Technology Press. All right reserved.},
	pages = {3656--3662},
	number = {10},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Chu, Y. and Li, Q. and Ma, X. and Wang, K. and Liu, X. and Wang, W. and Li, Z. and Su, B.},
	date = {2020},
	keywords = {Multiobjective optimization, Electric power transmission, Electric power transmission networks, Energy utilization, Multi-objective optimization models, Complex networks, Electric load flow, Electric power system control, Optimization modeling, Power control, Network constraints, Cascade transmission section, Control power flow, Coordination optimization method, Coordinative optimization, Multi-energy dispatch, New energy accommodation, Northwest China power grid, Power channel utilization, Power generation constraints, Transmission sections},
}

@article{clarke_multi-objective_2015,
	title = {Multi-objective optimisation of renewable hybrid energy systems with desalination},
	volume = {88},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84940436909&doi=10.1016%2fj.energy.2015.05.065&partnerID=40&md5=a88fe1b33dd24db8b332ec1de9b77cf9},
	doi = {10.1016/j.energy.2015.05.065},
	abstract = {The optimisation, sizing and techno-economic assessment of stand-alone renewable energy systems affects not only the likelihood of deployment but also their reliability to supply electricity and potable water where needed. Very little work has been done earlier into the effects of integrating water desalination alongside meeting load demand. Moreover, the impact of intelligent techniques, in this context, against more established software tools has not been applied. In this paper, {PSO} (Particle Swarm Optimisation) is compared to {HOMER} for the simultaneous optimisation of size and {PMS} (Power Management Strategy) in stand-alone hybrid energy systems. These systems incorporate significant relative water load met by reverse osmosis. Multi-objective functions in {PSO} minimise Total {NPC} (Net Present Cost) (includes capital, maintenance and replacement costs over a 25 year system lifetime) and lifetime {CO}2 emissions whilst meeting these two loads. Results are analysed and compared for the conditions of dynamic (15 min resolved) versus static water demand in addition to meeting varying electric loads. The {PSO} algorithm is implemented using {MATLAB}/Simulink and compared to a similar overall configuration developed in {HOMER} to meet the same loads (electric, water).Results show using {PSO} achieves systems having lower {NPC} compared to {HOMER}, with the margin of improvement more pronounced in greater scale systems as water storage capacity and electrical load increase. Additionally, having a time-varying water profile negatively effects system performance by increasing {NPC} and {CO}2 emissions compared to a static water profile. © 2015 Elsevier Ltd.},
	pages = {457--468},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Clarke, D. P. and Al-Abdeli, Y. M. and Kothapalli, G.},
	date = {2015},
	keywords = {Multiobjective optimization, Renewable energy resources, Particle swarm optimization ({PSO}), Energy efficiency, optimization, Energy management, renewable resource, Power management, Power management strategies, Particle swarm optimisation, Potable water, {MATLAB}, electricity supply, Desalination, Water filtration, Solar {PVs}, {HOMER}, Stand -alone, Electric power measurement, osmosis, Power management strategy, Simulations, Solar-{PV}, Stand-alone desalination},
}

@inproceedings{cococcioni_solving_2016,
	title = {Solving the environmental economic dispatch problem with prohibited operating zones in microgrids using {NSGA}-{II} and {TOPSIS}},
	isbn = {978-1-4503-3739-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84975799379&doi=10.1145%2f2851613.2853130&partnerID=40&md5=dca7d2f97eabc5386c270a0a45dedaa9},
	doi = {10.1145/2851613.2853130},
	abstract = {This paper presents a multi-objective optimization framework for the environmental economic dispatch problem in microgrids. Besides classic constraints, also prohibited operating zones and ramp-rate limits of the generators are here considered. Pareto-optimal solutions are generated through the {NSGA}-{II} algorithm with customized constraint handling. The optimal solution is selected with {TOPSIS}. Simulations carried out on a prototype microgrid showed the effectiveness of the proposed framework in handling scenarios with Pareto fronts having up to four discontinuities. © 2016 {ACM}.},

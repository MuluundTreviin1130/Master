@inproceedings{cheng_multi-objective_2017,
	title = {A multi-objective based capacity optimization design of standalone microgrid},
	isbn = {978-1-5386-1427-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85049222110&doi=10.1109%2fEI2.2017.8244419&partnerID=40&md5=84410b7cb0435061fe6f1c76bf66c097},

@inproceedings{kohansal_multi-objective_2011,
	title = {Multi-objective optimization to improve transient performance of {VSI} in an off-grid micro-gird using imperialist competitive algorithm},
	isbn = {978-1-4673-1690-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84900025040&doi=10.1109%2fICCIAutom.2011.6356715&partnerID=40&md5=7081e11fb949cebdc62c0d54e6d213d1},
	doi = {10.1109/ICCIAutom.2011.6356715},
	abstract = {Micro-grids ({MGs}) are active networks known as an effective solution for the control of grids including high levels of Distributed Generation ({DG}). In off-grid {MGs}, {DGs} connected to Voltage Source Inverters ({VSIs}) enroll as controllers of voltage and frequency. These {VSIs} should share power between the {DGs} fairly. A precise power sharing may increase frequency drop. In this paper, a trade-off is obtained between power sharing and frequency behavior. A multi-objective function is defined including the aforementioned parameters. Imperialism Competitive Algorithm ({ICA}) is used for optimization process. The obtained parameters lead to the best performance of {VSI} controllers considering frequency behavior and power sharing. © 2011 {IEEE}.},
	pages = {536--541},

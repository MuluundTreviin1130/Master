	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Evolutionary algorithms, Microgrid, Multi-objective optimization problem, Objective functions, droop control, Pareto principle, Power sharing, Islanded microgrid, System stability, Droop controllers, Pareto-optimal frontiers, Small signal model},
}


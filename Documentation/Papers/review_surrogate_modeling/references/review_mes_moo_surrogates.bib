	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Gas emissions, Greenhouse gases, Sustainable development, Sensitivity analysis, Power- generations, Off-grids, Hybrid renewable energies, Power, carbon footprint, Optimization analysis, Optimal solutions, Gas industry, Greenhouse gas emission reduction, Oil and Gas Industry, Energy gas},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},

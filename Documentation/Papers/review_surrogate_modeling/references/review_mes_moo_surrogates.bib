	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 3},
}

@article{li_sustainable_2019,
	title = {Sustainable and reliable design of reverse osmosis desalination with hybrid renewable energy systems through supply chain forecasting using recurrent neural networks},
	volume = {178},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85065484527&doi=10.1016%2fj.energy.2019.04.114&partnerID=40&md5=bbda5178539192cbe0575b09159746c0},
	doi = {10.1016/j.energy.2019.04.114},
	abstract = {Renewable energy systems coupled with reverse osmosis ({RO}) desalination represent a great contribution to the fields of energy and sustainability. Especially in remote areas, where reliability issues associated with integrated systems result in problems of insufficient power supply or supply loss due to the intermittency of renewable sources and varying freshwater demand. This research aims to design a sustainable and reliable hybrid renewable energy system ({HRES}) coupled with {RO} desalination system ({HRES}-{RO}), considering different operational scenarios with fluctuating renewable energy supply, and changeable water demand. First, future energy supply from renewable sources, and water demand were forecasted to deal with the stochastic behavior of several variables including freshwater demand, ambient temperature, solar radiation, and wind speed by means of recurrent neural networks ({RNN}). Then, multi-criteria optimization was conducted using extended mathematical programming ({EMP}) with the aim of minimizing the total annual costs and greenhouse gas emission. Finally, the potential loss of power supply probability ({PLPSP}) was introduced as a tool to illustrate the sustainability of the proposed scenarios. The results showed that the proposed framework resulted in an {HRES} with optimized installation strategy using 111 photovoltaic panels and 5 wind turbines by considering three criteria (economic cost, environmental effect, and energy reliability). The designed system reduced {PLPSP} by 18.3\% compared with the base case. Furthermore, the results demonstrated the contribution of advanced forecasting algorithms to address future uncertainties in the energy supply chain. © 2019 Elsevier Ltd},
	pages = {277--292},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Li, Q. and Loy-Benitez, J. and Nam, K. and Hwangbo, S. and Rashidi, J. and Yoo, C.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Hybrid renewable energy systems, optimization, Greenhouse gases, Renewable energy systems, Sustainable development, multiobjective programming, Stochastic systems, alternative energy, greenhouse gas, Wind, Photovoltaic cells, Multicriteria optimization, Hybrid renewable energy system, Hybrid Renewable Energy System ({HRES}), Reliability, Photovoltaic effects, Supply chains, Supply chain management, Forecasting, Artificial neural network, design method, Desalination, Reverse osmosis, Reverse osmosis desalination, Water, Forecasting modeling, Recurrent neural networks, Mathematical Programming, forecasting method, Reliability Index, Recurrent neural network, wind velocity, water demand, Energy reliability index, Recurrent neural network ({RNN}), Supply chain forecasting model},
}

@inproceedings{li_optimization_2022,
	title = {Optimization of {PV} installation angles for increased self-consumption in residential neighbourhoods},
	isbn = {978-87-7475-698-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195783948&partnerID=40&md5=b56aa4e55f01819f90608e9532ee466a},
	abstract = {Increased shares of variable renewable energy ({VRE}) necessitate various approaches to match supply and demand patterns at different spatial and temporal scales. Within electricity distribution networks, which may experience grid constraints, energy communities could play an important role in enabling higher shares of solar photovoltaic ({PV}) integration, while reducing the overall costs and carbon footprint of the building sector. This can be achieved by adapting {PV} generation to better match demand patterns-and therefore improve the community's self-consumption and self-sufficiency-through different combinations of installation sizing, tilt, and azimuth angles. To assess the aggregation effects of demand from multiple prosumers with varied demand patterns and {PV} system configurations, we simulate a group of residential buildings (three singlefamily and two multi-family houses) and carry out a bi-objective (cost and carbon minimization) optimizations to investigate the optimal placement of {PV} systems on building rooftops and facades. The Pareto frontiers show the tradeoff between normalized costs and {GHG} emissions and indicate higher normalized costs for buildings with lower electricity demand as {PV} systems are scaled to the available rooftop and facade areas. When the placement of solar panels is optimized for the aggregated case, we observe an average gain of 16.7\% in self-consumption and 4.0\% in self-sufficiency, a reduction of 44\% in cost, and 1.9\% in greenhouse gas ({GHG}) emissions compared to when {PV} placement is optimized for each building individually. The study highlights the comparative advantage of group optimization that considers the aggregation effects in both demand and {PV} generation. © Proceedings of {ECOS} 2022 - 35th International Conference on Efficiency, Cost, Optimization, Simulation and Environmental Impact of Energy Systems.},
	pages = {1419--1430},
	publisher = {{DTU} Construct},
	author = {Li, Q. and Vulic, N. and Orehounig, K.},

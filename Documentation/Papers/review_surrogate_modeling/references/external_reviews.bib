@article{Bhosekar2018,
  author  = {Bhosekar, Atharv and Ierapetritou, Marianthi},
  title   = {Advances in surrogate based modeling, feasibility analysis, and optimization: A review},
  journal = {Computers \& Chemical Engineering},
  year    = {2018},
  volume  = {108},
  pages   = {250--267},
  doi     = {10.1016/j.compchemeng.2017.09.017},
  abstract = {This paper reviews recent advances in the area of surrogate models for problems in modeling, feasibility analysis, and optimization. Two of the frequently used surrogates, radial basis functions, and Kriging are tested on a variety of test problems. Finally, guidelines for the choice of appropriate surrogate model are discussed.},
  keywords = {Surrogate models; Derivative-free optimization; Feasibility analysis; Sampling; Model selection},
}

@article{Westermann2019,
  author  = {Westermann, Paul and Evins, Ralph},
  title   = {Surrogate modelling for sustainable building design -- A review},
  journal = {Energy and Buildings},
  year    = {2019},
  volume  = {198},
  pages   = {170--186},
  doi     = {10.1016/j.enbuild.2019.05.057},
  abstract = {This comprehensive review discusses significant publications in sustainable building design research where surrogate modelling was applied. We have aggregated 57 studies in a comprehensive table with details on objective, sampling strategy and surrogate model type. Based on the literature major research trends are extracted and useful practical aspects outlined.},
  keywords = {Sustainable building design; Building performance simulation; Surrogate model; Meta-model; Early design; Uncertainty analysis; Sensitivity analysis; Building design optimisation},
}

@article{Manco2024,
  author  = {Manc{\`o}, Giulia and Tesio, Umberto and Guelpa, Elisa and Verda, Vittorio},
  title   = {A review on multi energy systems modelling and optimization},
  journal = {Applied Thermal Engineering},
  year    = {2024},
  volume  = {236},
  pages   = {121871},
  doi     = {10.1016/j.applthermaleng.2023.121871},
  abstract = {This work presents a novel approach to the analysis of the MES literature, since it is devoted to guide a practical development of MES optimization. Through the discussion of six case studies, the mathematical formulation is presented to provide a clear reference to build the model. Emphasis is placed on how the aspects investigated can change the nature of the problem and the choice of the solvers for the process execution.},
  keywords = {Distributed generation; Energy Hub; Polygeneration; Optimal scheduling; Mathematical modelling; Energy planning},
}

@article{Fattahi2020,
  author  = {Fattahi, A. and Sijm, J. and Faaij, A.},
  title   = {A systemic approach to analyze integrated energy system modeling tools: A review of national models},
  journal = {Renewable and Sustainable Energy Reviews},
  year    = {2020},
  volume  = {133},
  pages   = {110195},
  doi     = {10.1016/j.rser.2020.110195},
  abstract = {We reviewed the literature focusing on nineteen integrated Energy System Models (ESMs) to identify capabilities and shortcomings, assess performance via derived criteria, and discuss potential solutions. A Multi-Criteria Analysis (MCA) framework identifies modeling gaps in MARKAL, TIMES, REMix, PRIMES, and METIS. Two conceptual modeling suites are suggested in which the integrated ESM is hard-linked with regional and energy-market models.},
  keywords = {Future energy systems; Energy system model; Energy modeling challenges; Multi-criteria analysis; Soft-linking models; Hard-linking models; Model integration},
}

@article{Klemm2021,
  author  = {Klemm, Christian and Vennemann, Peter},
  title   = {Modeling and optimization of multi-energy systems in mixed-use districts: A review of existing methods and approaches},
  journal = {Renewable and Sustainable Energy Reviews},
  year    = {2021},
  volume  = {135},
  pages   = {110206},
  doi     = {10.1016/j.rser.2020.110206},
  abstract = {This review evaluates current studies and identifies typical characteristics of models designed to optimize MES in mixed-use districts. Thirteen of 145 modeling tools turned out to be suitable for optimizing MES in mixed-use districts. If additional requirements are imposed -- non-financial assessment criteria and open-source availability -- only two tools remain.},
  keywords = {Energy system; Energy system modeling; Optimization; Multi-energy system (MES); Mixed-use districts; Urban districts; Modeling tools},
}

@article{Li2025_hydrogen,
  author  = {Li, Chenglong and Yang, Tianqi and Cai, Wenchao and Agbossou, Kodjo and B{\'e}nard, Pierre and Chahine, Richard and Zong, Yi and Li, Yaze and Su, Shenglin and Li, Guodong and Yan, Xianglin and Li, Jin and Xiao, Jinsheng},
  title   = {A comprehensive review of hydrogen integrated hybrid renewable energy systems: Configurations, models, simulation and optimization with artificial intelligence},
  journal = {Energy Reviews},
  year    = {2025},
  doi     = {10.1016/j.enrev.2025.100128},
  abstract = {This work presents a comprehensive review of hydrogen-based hybrid renewable energy systems (HRESs), covering mathematical models, simulation and AI-driven optimization approaches. Future directions suggest that physical model-assisted AI frameworks, which embed physical principles within AI models, hold promise for enhancing prediction accuracy and reliability in HRES applications.},
  keywords = {Hybrid renewable energy system; Solar; Wind; Hydrogen; Optimization; Artificial intelligence},
}

@article{Khan2024_DT,
  author  = {Khan, Abid Hossain and Omar, Salauddin and Mushtary, Nadia and Verma, Richa and Kumar, Dinesh and Alam, Syed},
  title   = {Digital Twin and Artificial Intelligence Incorporated With Surrogate Modeling for Hybrid and Sustainable Energy Systems},
  journal = {arXiv preprint},
  year    = {2024},
  doi     = {10.48550/arXiv.2210.00074},
  abstract = {This work presents a comprehensive framework/review on Artificial Intelligence-driven surrogate modeling and its applications with a focus on the digital twin framework and energy systems. Different surrogate models developed for different sustainable energy sources are presented. Finally, digital twin surrogate models and associated uncertainties are described.},
  keywords = {Artificial Intelligence; Hybrid Energy System; Digital Twin; Machine Learning; Surrogate Modeling},
}

@article{DiazManriquez2016,
  author  = {D{\'i}az-Manr{\'i}quez, Alan and Toscano, Gregorio and Barron-Zambrano, Jose Hugo and Tello-Leal, Edgar},
  title   = {A Review of Surrogate Assisted Multiobjective Evolutionary Algorithms},
  journal = {Computational Intelligence and Neuroscience},
  year    = {2016},
  volume  = {2016},
  pages   = {9420460},
  doi     = {10.1155/2016/9420460},
  abstract = {Multiobjective evolutionary algorithms have incorporated surrogate models in order to reduce the number of required evaluations to approximate the Pareto front of computationally expensive multiobjective optimization problems. In this paper, we center our focus on classifying multiobjective evolutionary algorithms with respect to their integration with surrogate models. This interaction has led us to classify similar approaches and identify advantages and disadvantages of each class.},
  keywords = {Multiobjective evolutionary algorithms; Surrogate models; Pareto front; Computationally expensive},
}

@article{FernandezGodino2023,
  author  = {Fern{\'a}ndez-Godino, M. Giselle},
  title   = {Review of Multi-Fidelity Models},
  journal = {Advances in Computational Science and Engineering},
  year    = {2023},
  volume  = {1},
  number  = {4},
  pages   = {351--400},
  doi     = {10.3934/acse.2023015},
  abstract = {This review offers a comprehensive analysis of multi-fidelity models, focusing on their applications in scientific and engineering fields, particularly in optimization and uncertainty quantification. It classifies publications on multi-fidelity modeling according to several criteria, including application area, surrogate model selection, types of fidelity, combination methods and year of publication. The work outlines best practices for presenting multi-fidelity-related savings in a standardized manner.},
  keywords = {Multi-fidelity; Variable-complexity; Variable-fidelity; Surrogate models; Optimization; Uncertainty quantification},
}

@article{Sahoo2025,
  author  = {Sahoo, Sushil Kumar and Pamucar, Dragan and Goswami, Shankha Shubhra},
  title   = {A Review of Multi-Criteria Decision-Making (MCDM) Applications to Solve Energy Management Problems From 2010-2025: Current State and Future Research},
  journal = {Spectrum of Decision Making and Applications},
  year    = {2025},
  volume  = {2},
  number  = {1},
  pages   = {218--240},
  doi     = {10.31181/sdmap21202525},
  abstract = {This paper reviews the current state of MCDM applications in energy management, focusing on renewable energy systems, energy efficiency, grid management, and policy planning from 2010-2025 using bibliometric analysis. It identifies popular methods such as AHP, TOPSIS, and hybrid models, highlighting their strengths and limitations. The analysis reveals trends, gaps, and challenges, such as handling uncertainty, integrating real-time data, and adapting to dynamic energy environments.},
  keywords = {Multi-Criteria Decision-Making; MCDM; AHP; TOPSIS; Energy management; Renewable energy; Bibliometric analysis},
}

@article{Etghani2025,
  author  = {Etghani, Mir Majid and Boodaghi, Homayoun},
  title   = {Artificial Neural Networks and Taguchi Methods for Energy Systems Optimization: A Comprehensive Review},
  journal = {Energy Engineering},
  year    = {2025},
  doi     = {10.32604/ee.2025.070668},
  abstract = {This comprehensive review examines the synergistic application of Artificial Neural Networks (ANN) and Taguchi methods in optimizing diverse energy systems. ANN models consistently achieve prediction accuracies exceeding 90% when compared to experimental data, while Taguchi-based methods combined with Grey Relational Analysis (GRA) or TOPSIS can improve system performance by up to 20\%-30\% in multi-objective optimization scenarios.},
  keywords = {ANN; Taguchi; GRA; TOPSIS; Hybrid optimization; Renewable energy; Machine learning; Robust design},
}

@article{Mohammadi2024,
  author  = {Mohammadi, Sina and Bui, Van-Hai and Su, Wencong and Wang, Bin},
  title   = {Surrogate Modeling for Solving OPF: A Review},
  journal = {Sustainability},
  year    = {2024},
  volume  = {16},
  number  = {22},
  pages   = {9851},
  doi     = {10.3390/su16229851},
  abstract = {This review provides a comprehensive overview of various surrogate modeling techniques utilized in OPF problems. It examines the most common surrogate model categories, including data-driven and physics-informed approaches, and discusses their advantages, limitations, and applications. Comparative insights into the performance of these models in addressing OPF challenges are presented, alongside a discussion of the methodologies employed for their development.},
  keywords = {Optimal power flow; Surrogate modeling; Data-driven; Physics-informed; Renewable integration},
}

@article{ChenRenZhou2023,
  author  = {Chen, Wenxin and Ren, Hongtao and Zhou, Wenji},
  title   = {Review of multi-objective optimization in long-term energy system models},
  journal = {Global Energy Interconnection},
  year    = {2023},
  volume  = {6},
  number  = {6},
  pages   = {645--660},
  doi     = {10.1016/j.gloei.2023.11.002},
  abstract = {Studies pertaining to the multi-objective optimization of long-term energy system models are summarized; the optimization objectives are classified into economic, environmental, social, and energy security aspects; and the multi-objective optimization methods are classified and explained based on the preferential expression of decision makers. Finally, the key development direction of MOO of energy system models is discussed.},
  keywords = {Long-term energy system models; Multi-objective optimization; Energy security},
}

@article{Zhang2026_building,
  author  = {Zhang, Bo and Chen, Jingwen and Song, Yumeng and Zhong, Luyang and Chen, Lixing and Zhang, Yingzi},
  title   = {AI-driven surrogate modeling for performance-oriented parametric optimization in sustainable building design: a systematic review},
  journal = {Energy and Buildings},
  year    = {2026},
  volume  = {358},
  pages   = {117238},
  doi     = {10.1016/j.enbuild.2026.117238},
  abstract = {This study conducts a comprehensive review of state-of-the-art AI surrogate models for building energy performance prediction and optimization. Through a rigorous selection process, 114 relevant studies were reviewed across five dimensions: parametric modeling and performance simulation, dataset construction protocols, state-of-the-art advancements in surrogate modeling, optimization algorithms selection, and multi-criteria decision-making methodologies for design scheme selection. A technical framework is proposed for AI-driven surrogate modeling applied to multi-objective optimization in sustainable building design. The review identifies limited exploration of deep learning techniques, the interpretability of surrogate models, insufficient optimization with consideration of uncertain parameters, and inadequate discussion on block-scale decarbonization as critical research gaps.},
  keywords = {Artificial intelligence; Multi-objective optimization; Sustainable building design; Machine learning; Multi-criteria decision-making; Review},
}

@article{Elwy2024,
  author  = {Elwy, Ibrahim and Hagishima, Aya},
  title   = {The artificial intelligence reformation of sustainable building design approach: A systematic review on building design optimization methods using surrogate models},
  journal = {Energy and Buildings},
  year    = {2024},
  volume  = {323},
  pages   = {114769},
  doi     = {10.1016/j.enbuild.2024.114769},
  abstract = {This study presents a comprehensive review of recent studies aimed at identifying innovative theories and critical factors for each component of the surrogate-assisted optimization process for sustainable building design. Considering passive form and envelope design variables, seventy-two relevant studies from Scopus were selected. Results include current trends for surrogate modeling and optimization methods, accuracy levels, and the extent of building performance improvement.},
  keywords = {Artificial intelligence; Surrogate modeling; Building performance optimization; Surrogate-assisted optimization; Energy efficiency; Low-carbon buildings; Sustainable building design},
}

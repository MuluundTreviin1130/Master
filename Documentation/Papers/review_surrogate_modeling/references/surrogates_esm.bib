@ARTICLE{Iqbal202660593,
	author = {Iqbal, Hasan and Sarwat, Arif},
	title = {Risk-Aware Data Center BESS Dispatch With MILP, Machine Learning, and Stochastic Outage Simulations},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {60593 - 60615},
	doi = {10.1109/ACCESS.2026.3682635},
	url = {https://www.scopus.com/pages/publications/105036686285?origin=resultslist},
	abstract = {Data centers increasingly adopt behind-the-meter (BTM) battery energy storage systems (BESS) to reduce electricity bills dominated by demand charges, while simultaneously facing strict service-continuity requirements under stochastic grid outages. A core challenge is that aggressive dispatch for peak shaving and arbitrage can erode state-of-charge (SOC) headroom, increasing the probability and severity of rare but high-impact interruption events. This paper presents a risk-aware evaluation framework that couples year-scale BESS dispatch on a coarse time grid with a secondwise outage-event simulator capturing uninterruptible power supply (UPS) ride-through, multi-unit generator start uncertainty (delays and fail-to-start), ramp-limited pickup, and SOC-limited BESS support. Four dispatch policies are compared across 900 configurations and 288,000 simulated operating years: an oracle mixed-integer linear program (MILP) that co-optimizes energy charges, demand charges, and cycling penalties under a soft reserve penalty; a standby-only reserve-maintenance policy; a rule-based heuristic; and a learning-based surrogate (XGBoost) trained on oracle MILP labels with online feasibility projection. Reliability is quantified using distributional and tail-focused metrics including ECDF/CCDF diagnostics, service-level agreement (SLA) exceedance probability, conditional value-at-risk (CVaR), and event time-to-failure survival. Results show that the cost-optimal MILP policy systematically depletes ride-through reserves: across 337,200 outage events it enters outages at a median SOC of 0.05 (the hard floor), producing a per-outage failure rate of 0.726 and a CVaR95 downtime of 2.15 hr compared to 0.386 and 0.30 hr for reserve-preserving standby operation, which also achieves the lowest total cost under the evaluated demand-charge-heavy tariff. Policy dominance is fundamentally tail-dependent: policies with similar mean downtime exhibit up to 7× differences in tailconditional severity. The learning-based surrogate attains near-oracle cost fidelity (R2 = 0.9998) at 3.8× lower mean computation time with near-zero latency variance (50 ms±1.7 ms vs. 188 ms mean / 5.1 s worstcase for the MILP solver), but inherits the oracle's reliability risk posture. Explicit operational guidance is provided for reliability-constrained, cost-constrained, and balanced operating regimes.  © 2026 The Authors.},

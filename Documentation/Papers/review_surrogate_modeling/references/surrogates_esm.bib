@ARTICLE{Pasta2023,
	author = {Pasta, Edoardo and Carapellese, Fabio and Faedo, Nicolás and Brandimarte, Paolo},
	title = {Data-driven control of wave energy systems using random forests and deep neural networks},
	year = {2023},
	journal = {Applied Ocean Research},

@ARTICLE{Koirala2024,
	author = {Koirala, Arpan and Geth, Frederik and Van Acker, Tom},
	title = {Day-ahead dynamic operating envelopes using stochastic unbalanced optimal power flow},
	year = {2024},
	journal = {Sustainable Energy, Grids and Networks},

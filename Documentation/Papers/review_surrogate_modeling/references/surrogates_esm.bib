	title = {Robustness of Deep-Reinforcement-Learning Control for Fast Load-Following-Operation of S-CO2 Microreactor},
	year = {2024},
	journal = {Transactions of the American Nuclear Society},
	volume = {131},
	number = {1},
	pages = {310 - 313},
	doi = {10.13182/T131-45897},
	url = {https://www.scopus.com/pages/publications/85215551865?origin=resultslist},
	abstract = {This paper investigated the feasibility of deep reinforcement learning (DRL) for the flexible operation of a supercritical carbon dioxide (S-CO<sub>2</sub>) microreactor. It aims to surpass the limitations of traditional Proportional Integral Derivative (PID)-based control in managing the nonlinear and dynamic behavior of S-CO<sub>2</sub> power systems. The approach included pre-training using surrogate models, transfer learning with system analysis codes, and the development of a DRL framework applied to the KAIST-MMR, a 10 MW class S-CO<sub>2</sub> cooled reactor. Results showed that the DRL agent maintained optimal control and stability within the trained scenario, demonstrating scalability and adaptability. Robustness tests were conducted to evaluate the performance of the DRL agent in untrained scenarios. In summary, the DRL agents exhibited robust performance in untrained scenarios, effectively managing continuous operation. However, their robustness diminished in scenarios that required control actions beyond the trained range. Based on these findings, it is suggested that training the DRL agents at the minimum load level and maximum load level to ensure the controllability. Ramp rate required by the performance specifications of a target system could enable the agents to perform robust control during continuous operation. In conclusion, this study demonstrated the potential of a DRL-based control methodology to significantly improve the operational flexibility and efficiency of S-CO<sub>2</sub> microreactors and power cycles. While robustness tests showed the DRL agent's ability to handle scenarios beyond the trained range, performance degraded in more extreme scenarios, indicating the need for further training or adaptation strategies. Future research could explore more complex operational scenarios, multi-objective optimization, and integration with other advanced control theories. Additionally, comparing PID control and DRL-based control for further optimization is suggested as future work. © 2024 American Nuclear Society. All rights reserved.},
	keywords = {Controllability; Deep learning; Multiobjective optimization; Optimal control systems; Reactor refueling; Reinforcement learning; Robust control; Robustness (control systems); Three term control systems; Transfer learning; Two term control systems; Continuous operation; Flexible operation; Load levels; Load-following operation; Micro-reactor; Reinforcement learning agent; Reinforcement learning control; Reinforcement learnings; Robustness tests; Supercritical carbondioxides; Deep reinforcement learning},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}


@ARTICLE{Xu2025144,
	author = {Xu, Longxun and Hu, Bo and Shao, Changzheng and Xie, Kaigui and Pan, Congcong and Tai, Heng-Ming and Li, Wenyuan},
	title = {A Fully Analytical Approach for the Real-Time Dynamic Reliability Evaluation of Composite Power Systems with Renewable Energy Sources},
	year = {2025},
	journal = {Engineering},
	volume = {51},
	pages = {144 - 157},
	doi = {10.1016/j.eng.2024.09.023},
	url = {https://www.scopus.com/pages/publications/105010964141?origin=resultslist},
	abstract = {Renewable energy sources (RES) have strong uncertainties, which significantly increase the risks of power imbalance and load shedding in composite power systems. It is thus necessary to evaluate the operational reliability for guiding economic dispatch and reducing the risks. Current methods cannot meet the requirement for the operational timeliness of reliability evaluations due to the high computational complexity of the optimal power flow (OPF) calculations of massive contingencies. This paper proposes a fully analytical approach to construct fast-to-run analytical functions of reliability indices and avoid reassessments when the load and RES change. The approach consists of uniform design (UD)-based contingency screening and a modified stochastic response surface method (mSRSM). The contingency screening method is used to select critical contingencies while considering the uncertainties. The mSRSM is used to construct the analytical functions of the load shedding to the load and RES generation for the selected contingencies. An analytical function of a smooth virtual variable that maps to the load shedding is established in such a way that, when the load and RES vary, the reliability can be assessed within a very short time rather than using laborious OPF calculations. Case studies illustrate the excellent performance of the proposed method for real-time reliability evaluation. © 2024 Chinese Academy of Engineering},
	author_keywords = {Fully analytical approach; Modified stochastic response surface method; Polynomial chaos expansion; Reliability evaluation; Uniform design-based contingency screening},
	keywords = {Electric load dispatching; Electric load shedding; Function evaluation; Natural resources; Renewable energy; Stochastic systems; Analytical approach; Chaos expansions; Contingency screening; Fully analytical approach; Modified stochastic response surface method; Polynomial chaos; Polynomial chaos expansion; Reliability Evaluation; Response surfaces methods; Stochastic response surfaces; Uniform design; Uniform design-based contingency screening; Surface properties},
	type = {Article},

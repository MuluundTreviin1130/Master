@ARTICLE{Friese2023,
	author = {Friese, Jana and Brandt, Niklas and Schulte, Andreas and Kirches, Christian and Tegethoff, Wilhelm and Köhler, Jürgen},
	title = {Quasi-optimal control of a solar thermal system via neural networks},
	year = {2023},
	journal = {Energy and AI},

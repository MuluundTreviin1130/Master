@ARTICLE{Lédée2025,
	author = {Lédée, François and Crawford, Curran and Evins, Ralph},
	title = {Improved surrogate modeling for multi-energy system design: Model architecture, sampling and scaling choices},
	year = {2025},
	journal = {Applied Energy},
	volume = {390},

@ARTICLE{Yurtseven2025,
	author = {Yurtseven, Kaan and Koirala, Arpan and Ergun, Hakan and Van Hertem, Dirk},
	title = {Stochastic optimal power flow for hybrid AC/DC grids considering continuous non-Gaussian uncertainty},
	year = {2025},
	journal = {International Journal of Electrical Power and Energy Systems},
	volume = {170},
	pages = {},
	doi = {10.1016/j.ijepes.2025.110828},
	url = {https://www.scopus.com/pages/publications/105009226724?origin=resultslist},
	abstract = {The integration of renewable energy sources (RES) and the increasing adoption of High Voltage Direct Current (HVDC) transmission are reshaping modern power systems. Whereas RES introduce complex uncertainties in power system operation, often contributing to grid congestion, HVDC technology provides flexibility for effective congestion management. Accurately leveraging this flexibility through optimal scheduling of HVDC converters and minimizing expected RES curtailment requires optimization frameworks that simultaneously account for (i) continuous non-Gaussian uncertainty, (ii) hybrid AC/DC grid compatibility, and (iii) RES curtailment. However, existing Stochastic Optimal Power Flow (SOPF) models do not combine all three dimensions because their interaction significantly increases the nonlinearity. To bridge this gap, this paper introduces a Polynomial Chaos Expansion based chance-constrained SOPF framework that integrates these three dimensions within a single model, paving the way for reliable and cost-efficient hybrid AC/DC grid operation under high RES penetration. The effectiveness of the proposed framework is demonstrated through four case studies on 5-bus, 67-bus, 118-bus, and 588-bus hybrid AC/DC test systems. Results show that by accurately capturing interactions between input uncertainty, HVDC converter set-points, and RES curtailment, the proposed framework minimizes expected RES curtailment and operational costs, leading to significant financial savings under high RES penetration. In addition, the framework is shown to maintain computational scalability on large-scale systems while preserving modeling accuracy under continuous non-Gaussian uncertainty. © 2025 The Authors},
	author_keywords = {Continuous non-Gaussian uncertainty; HVDC; Polynomial chaos expansion; RES curtailment; Stochastic optimal power flow},
	keywords = {Buses; Hybrid power; Large scale systems; Natural resources; Optimization; Polynomials; Renewable energy; Stochastic models; Traffic congestion; Uncertainty analysis; Chaos expansions; Continuous non-gaussian uncertainty; DC grid; High-Voltage Direct Current; Non-gaussian uncertainties; Polynomial chaos; Polynomial chaos expansion; Renewable energy source; Renewable energy source curtailment; Stochastic optimal power flows; HVDC power transmission; Stochastic systems},

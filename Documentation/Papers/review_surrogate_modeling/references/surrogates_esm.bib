@ARTICLE{Wang20224756,
	author = {Wang, Can and Wang, Aoqi and Chen, Sirui and Zhang, Gaorui and Zhu, Binxin},
	title = {Optimal Operation of Microgrids Based on a Radial Basis Function Metamodel},
	year = {2022},
	journal = {IEEE Systems Journal},

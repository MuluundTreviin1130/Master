@ARTICLE{Nawaz2024,
	author = {Nawaz, Aamir and Wang, Hongtao and Yang, Huiting and Armghan, Hammad and Gao, Jiechao},
	title = {Risk-constrained probabilistic coordination in coupled transmission and distribution system},
	year = {2024},
	journal = {Electric Power Systems Research},

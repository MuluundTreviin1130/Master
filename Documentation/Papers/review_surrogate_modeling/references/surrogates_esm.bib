@ARTICLE{Kumar2024,
	author = {Kumar, Sunil and Ali, Ikbal and Siddiqui, Anwar Shahzad},
	title = {Energy management in a grid-connected microgrid using hybrid Golden Jackal optimization and gradient descent optimization and the concept of loadability},
	year = {2024},
	journal = {e-Prime - Advances in Electrical Engineering, Electronics and Energy},
	volume = {9},

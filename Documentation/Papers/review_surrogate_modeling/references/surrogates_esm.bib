@ARTICLE{Yang2025,
	author = {Yang, Xiaohui and Li, Longxi},
	title = {A joint sharing-sharing platform for coordinating supply and demand resources at distributed level: Coupling electricity and carbon flows under bounded rationality},
	year = {2025},

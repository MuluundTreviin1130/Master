	keywords = {Electric power distribution; Electric power transmission; Electric power transmission networks; Integer programming; Intelligent systems; MATLAB; Monte Carlo methods; Power markets; Profitability; Renewable energy; System stability; Distribution systems; Energy markets; Local energy; Local energy market; Local flexibility; Local flexibility market; Plant distributions; Robust optimization; System operator; Virtual power plant-distribution system operator coordination; Virtual power plants; Virtual Power Plants},
	type = {Article},

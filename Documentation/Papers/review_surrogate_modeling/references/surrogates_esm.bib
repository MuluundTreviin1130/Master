@ARTICLE{Zhang2025,
	author = {Zhang, Jie and Fu, Kaixiang and Huang, Weizhi and Zhang, Yilin and Sun, Qing and Chi, Yuan and Tang, Junjie},
	title = {Efficient Probabilistic Evaluation and Sensitivity Analysis of Load Supply Capability for Renewable-Energy-Based Power Systems},

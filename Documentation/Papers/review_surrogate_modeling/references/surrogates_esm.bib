@ARTICLE{Xie20261163,
	author = {Xie, Rui and Chen, Yue and Pinson, Pierre},
	title = {Predict-and-Optimize Robust Unit Commitment with Statistical Guarantees via Weight Combination},
	year = {2026},
	journal = {IEEE Transactions on Power Systems},
	volume = {41},

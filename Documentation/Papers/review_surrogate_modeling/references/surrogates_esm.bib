	keywords = {Constrained optimization; Convex optimization; Decision making; Electric load dispatching; Electric load flow; Gages; Image registration; Linear programming; Neural networks; Problem solving; Quadratic programming; Deep learning; Hard constraints; Images registration; Learning to optimize; Linear-programming; Machine-learning; Neural-networks; Optimal power flows; Optimisations; Optimized production technology; Iterative methods},
	type = {Article},

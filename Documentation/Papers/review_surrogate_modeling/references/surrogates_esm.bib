@ARTICLE{Wang2025,
	author = {Wang, Jungang and Zhang, Chuntao and Mo, Ruina and Wang, Shizhao},
	title = {Electromagnetic Performance Analysis and Multi-Objective Optimization of Hybrid Multi-Circuit Monotonic Magnetic Ring Dual-Modulated Three-Rotor Coaxial Magnetic Gear},
	year = {2025},
	journal = {Journal of Vibration Engineering and Technologies},

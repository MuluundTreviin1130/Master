@ARTICLE{Sivhugwana2025,
	author = {Sivhugwana, Khathutshelo Steven and Ranganai, Edmore},
	title = {Short-Term Forecasting of Unplanned Power Outages Using Machine Learning Algorithms: A Robust Feature Engineering Strategy Against Multicollinearity and Nonlinearity},
	year = {2025},
	journal = {Energies},

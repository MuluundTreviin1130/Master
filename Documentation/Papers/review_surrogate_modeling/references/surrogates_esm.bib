@ARTICLE{Lei2025,
	author = {Lei, Zhengling and Lu, Jian and Wang, Fang and Huo, Haibo and Liu, Tao},
	title = {Uncertainty quantification in energy management of microgrid: Extended state observer surrogate model approach},

@ARTICLE{Kilwein2023,
	author = {Kilwein, Zachary and Jalving, Jordan and Eydenberg, Michael and Blakely, Logan and Skolfield, Kyle and Laird, Carl and Boukouvala, Fani},
	title = {Optimization with Neural Network Feasibility Surrogates: Formulations and Application to Security-Constrained Optimal Power Flow},
	year = {2023},

	note = {Cited by: 1; All Open Access; Green Open Access}
}

@ARTICLE{Starke2025214,
	author = {Starke, Allan R. and da Silva, Alexandre K.},
	title = {A review on the applicability of machine learning techniques to the metamodeling of energy systems},
	year = {2025},
	journal = {Numerical Heat Transfer, Part B: Fundamentals},
	volume = {86},
	number = {2},
	pages = {214 - 243},
	doi = {10.1080/10407790.2023.2280208},
	url = {https://www.scopus.com/pages/publications/105002286851?origin=resultslist},
	abstract = {The use of physics-based models for the development and optimization of energy systems is popular due to their versatility. However, their inherent complexity often makes these simulations computationally prohibitive, despite the current computational power available nowadays. This problem is aggravated when considering renewable energy systems, which are subjected to intermittent weather conditions and must be operated in connection with a grid of variable demand. In that sense, the use of metamodels has shown immense potential in the simulation, analysis, and optimization of energy systems. Therefore, this review presents a comprehensive analysis of the extensive application of metamodeling techniques in energy systems. After conducting a careful search using the Scopus database while targeting a well-defined group of keywords, 474 articles published from 2013 to 2023 were obtained in the present literature review. With a rigorous filtering and screening process, the first pool of articles was reduced to 126. The resulting articles were then separated in two main groups, reviews and research articles. Each of these groups was further organized in terms of the energy system studied, as well as the applicability, machine learning technique and error indicator. The results indicate a steady and significant growth in the number of publications associated with energy systems and different types of metamodeling techniques. The reasons are arguably twofold, reduction of computational time provided by the metamodels and their good accuracy. Nevertheless, and as reported by other studies, the review also identified the need to develop a standardized method for evaluating the error analysis of these models and a comparison between their actual efficiency, which includes accuracy and time. Furthermore, no clear relation was found between specific types of metamodels and specific energy systems. © 2023 Taylor & Francis Group, LLC.},
	author_keywords = {Artificial intelligence; digital twins; energy system; machine learning; metamodels; renewable energy; thermal science},
	keywords = {E-learning; Learning algorithms; Renewable energy resources; Energy systems; Machine learning techniques; Machine-learning; Meta model; Metamodeling; Metamodeling techniques; Optimisations; Physics-based models; Renewable energies; Thermal science; Machine learning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Li20251060,
	author = {Li, Meiyi and Mohammadi, Javad},
	title = {Learning to Optimize Joint Chance-constrained Power Dispatch Problems},
	year = {2025},
	journal = {CSEE Journal of Power and Energy Systems},
	volume = {11},
	number = {3},
	pages = {1060 - 1069},
	doi = {10.17775/CSEEJPES.2024.05670},
	url = {https://www.scopus.com/pages/publications/105008110612?origin=resultslist},
	abstract = {The ever-increasing integration of stochastic renewable energy sources into power systems operation is making the supply-demand balance more challenging. While joint chanceconstrained methods are equipped to model these complexities and uncertainties, solving these problems using traditional iterative solvers is often time-consuming, limiting their suitability for real-time applications. To overcome the shortcomings of today’s solvers, we propose a fast, scalable, and explainable machine learning-based optimization proxy. Our solution, called Learning to Optimize the Optimization of Joint Chance-Constrained Problems (LOOP−J CCP), is iteration-free and solves the underlying problem in a single-shot. Our model uses a polyhedral reformulation of the original problem to manage constraint violations and ensure solution feasibility across various scenarios through customizable probability settings. To this end, we build on our recent deterministic solution (LOOP − LC 2.0) by incorporating a set aggregator module to handle uncertain sample sets of varying sizes and complexities. Our results verify the feasibility of our near-optimal solutions for joint chance-constrained power dispatch scenarios. Additionally, our feasibility guarantees increase the transparency and interpretability of our method, which is essential for operators to trust the outcomes. We showcase the effectiveness of our model in solving the stochastic energy management problem of Virtual Power Plants (VPPs). Our theoretical analysis, supported by empirical evidence, reveals strong flexibility in parameter tuning, adaptability to diverse datasets, and significantly improved computational speed. © 2015 CSEE.},
	author_keywords = {Chance-constrained optimization; energy management; explainable artificial intelligence (XAI); machine learning (ML); power dispatch; uncertainty},
	keywords = {Constrained optimization; Electric load dispatching; Iterative methods; Learning systems; Machine learning; Natural resources; Problem solving; Renewable energy; Stochastic models; Stochastic systems; Virtual reality; Chance-constrained; Chance-constrained optimizations; Dispatch problems; Energy; Explainable artificial intelligence (XAI); Machine learning; Machine-learning; Optimisations; Power dispatch; Uncertainty; Energy management},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Wei2025219,
	author = {Wei, Hang and Huang, Dihong and Zhu, Jiangge and Cheng, Xu and Chen, Yong and Dai, Ningyi},
	title = {Efficient Control Parameters Optimization for Grid-Connected Converter via Data-Driven Surrogate Model},
	year = {2025},
	journal = {Proceedings - 2025 10th Asia Conference on Power and Electrical Engineering, ACPEE 2025},
	pages = {219 - 224},
	doi = {10.1109/ACPEE64358.2025.11041056},
	url = {https://www.scopus.com/pages/publications/105010583580?origin=resultslist},
	abstract = {Conventional methods for optimizing power converter control parameters primarily rely on extensive simulations and exhibit limited adaptability across diverse operational scenarios. To overcome these challenges, this study introduces a novel approach with deep neural network (DNN)-based surrogate model for efficient parameter optimization. The proposed method is implemented in a classical grid-connected converter. During the preprocessing stage, a high-accuracy classifier with 97% validation accuracy is incorporated to reduce the scale of the dataset. The model is trained using 16,000 validated simulation cases from a real-time digital simulator (RTDS), covering eight representative scenarios. The DNN structure is carefully designed to balance computational efficiency with generalization capability. The trained surrogate model enables performance evaluation in under one millisecond. Particle swarm optimization (PSO) is then used to identify optimal control parameters in less than 10 seconds while considering multiple scenarios simultaneously. Simulation results verify the accuracy of the surrogate model in performance prediction. The results indicate that multi-scenario optimization meets all constraints, while single-scenario optimization does not. Additionally, hardware-in-the-loop experimental tests confirm the effectiveness of the selected control parameters.  © 2025 IEEE.},
	author_keywords = {control parameter optimization; deep neural network; particle swarm optimization; power electronics converter},
	keywords = {Computational efficiency; Electric power system control; Fuel additives; Optimal control systems; Power control; Power converters; Power electronics; Control parameter optimization; Control parameters; Grid-connected converters; Neural-networks; Parameter optimization; Particle swarm; Particle swarm optimization; Power electronics converters; Surrogate modeling; Swarm optimization; Particle swarm optimization (PSO)},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}


@ARTICLE{Tan20251374,
	author = {Tan, Bendong and Zhao, Junbo and Chen, Yousu},
	title = {Scalable Risk Assessment of Rare Events in Power Systems With Uncertain Wind Generation and Loads},
	year = {2025},
	journal = {IEEE Transactions on Power Systems},
	volume = {40},

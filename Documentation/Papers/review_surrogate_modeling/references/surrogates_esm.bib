@CONFERENCE{Zhai20251001,
	author = {Zhai, L.X. and Zheng, J.H. and Li, Zhigang},
	title = {Surrogate-Assisted Optimization with Dynamic Model Management for Combined Economic/Emission Dispatch},
	year = {2025},
	journal = {2025 4th International Conference on Power Systems and Electrical Technology, PSET 2025},
	pages = {1001 - 1005},
	doi = {10.1109/PSET66242.2025.11296603},
	url = {https://www.scopus.com/pages/publications/105031888713?origin=resultslist},
	abstract = {The combined economic/emission dispatch (CEED) problem is crucial for operating power systems both economically and sustainably. However, solving the non-convex CEED problem, which requires frequent and computationally expensive AC power flow analyses, poses a significant challenge for online applications. This paper proposes a surrogate-assisted multi-objective evolutionary algorithm based on decomposition with improved epsilon constraint-handling (SA-MOEA/D-IEpsilon) to accelerate this optimization process without compromising solution quality. The key novelty lies in a dynamic model management strategy that intelligently arbitrates between a fast, graph neural network (GNN) based surrogate model and an exact, mechanism-based Newton-Raphson solver. This strategy is governed by a cosine annealing schedule that smoothly transitions the search from broad, surrogate-driven exploration to solver-based refinement. The framework's effectiveness was validated on the IEEE 14-bus and 118-bus systems. Results demonstrate that the proposed method reduces computation time by nearly 50% while discovering high-quality Pareto-optimal solutions, paving the way for new analysis methodologies.  © 2025 IEEE.},
	author_keywords = {Combined economic/emission dispatch; dynamic model management; graph neural network; multi-objective optimization; surrogate-assisted optimization},

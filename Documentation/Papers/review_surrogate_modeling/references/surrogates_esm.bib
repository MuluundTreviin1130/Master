@ARTICLE{Xu20212696,
	author = {Xu, Yijun and Korkali, Mert and Mili, Lamine and Valinejad, Jaber and Chen, Tao and Chen, Xiao},
	title = {An Iterative Response-Surface-Based Approach for Chance-Constrained AC Optimal Power Flow Considering Dependent Uncertainty},
	year = {2021},

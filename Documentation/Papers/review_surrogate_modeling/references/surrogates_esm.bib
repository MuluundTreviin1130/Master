	keywords = {Linear programming; Low temperature production; 4e analyze; Distributed energy systems; Energy; High temperature proton exchange membrane fuel cells; High-temperature electrochemical; Hydrogen pump; Hydrogen separation; Multi-objectives optimization; Response surfaces methods; Tri-generation; Cost benefit analysis},

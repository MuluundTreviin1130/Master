@ARTICLE{Ye2025,
	author = {Ye, Bitian and Xie, Ying and Cai, William and Sun, Yutian and Bai, Jing},
	title = {Design Optimization of Large-Capacity High-speed Permanent-Magnet Generator Based on Surrogate-Assisted Non-dominated Sorting Genetic Algorithm},
	year = {2025},
	journal = {IEEE Transactions on Energy Conversion},
	pages = {},
	doi = {10.1109/TEC.2025.3619516},
	url = {https://www.scopus.com/pages/publications/105018878849?origin=resultslist},
	abstract = {The large-capacity high-speed permanent-magnet generator, with its unique design, plays a crucial role in special applications such as aviation and integrated power system. However, it has strict requirements for power quality, and there is a problem of design optimization efficiency. In this article, a 2.5 MW, 7000 r/min large-capacity high-speed permanent-magnet generator is designed. To enhance the power quality and optimization efficiency, an efficient optimization method based on surrogate-assisted non-dominated sorting genetic algorithm II (SANSGA-II) is proposed. Initially, the surrogate model of the generator is constructed by using Latin hypercube sampling, and the relationship between optimization variables and objectives is explored. Subsequently, the surrogate model is utilized to predict and sort the objective values in the variable space. The variable values in the high-value area are taken as the adjustment directions for crossover and mutation, thereby improving the optimization efficiency and diversity of the algorithm. In addition, the dynamic point addition strategy is implemented. Then, the accuracy of the model is ensured and the reliability of the algorithm is enhanced. These improvements provide a theoretical basis for the optimization method of the generator. By using the proposed and traditional methods, the generator performance is optimized. The results show that the proposed method achieves faster iteration speed and higher solution quality than traditional method. Finally, the prototype is manufactured based on the design parameters and tested. The optimization results are validated for both accuracy and reliability. © 1986-2012 IEEE.},
	author_keywords = {Algorithm design and analysis; design optimization; genetic algorithms; optimization methods; permanent magnet motors},
	keywords = {Design; Economic and social effects; Efficiency; Electric generators; Electric power systems; Fuel additives; Permanent magnets; Reliability; Sorting; Algorithm design and analysis; Design optimization; High speed permanent magnet generators; Non-dominated sorting genetic algorithms; Optimization efficiency; Optimization method; Permanent magnet motor; Power; Special applications; Surrogate modeling; Genetic algorithms},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Wu2025121,
	author = {Wu, Yue and Zheng, Jianyong and Mei, Fei and Xu, Ruilin and Chen, Penghao and Tao, Yang},
	title = {Short-Term Load Forecasting Based on Informer and Multi-Source Meteorological Feature Optimization},
	year = {2025},
	journal = {2025 5th International Conference on Energy, Power and Electrical Engineering, EPEE 2025},
	pages = {121 - 126},
	doi = {10.1109/EPEE67527.2025.11428420},
	url = {https://www.scopus.com/pages/publications/105036362863?origin=resultslist},
	abstract = {To improve the accuracy of short-term power load forecasting, this study proposes a method that integrates meteorological feature optimization with long-sequence deep learning. Kriging interpolation and Fisher information entropy detection are first applied to correct spatiotemporal errors in meteorological data, enhancing input reliability. Highly correlated features are then selected using the maximum relevance method, and exploratory factor analysis is employed to extract physically interpretable latent factors, achieving feature fusion and dimensionality reduction. A forecasting framework based on long-sequence modeling is subsequently constructed to capture temporal dependencies of load. Case studies in a city of East China show that the method outperforms comparative models across multiple error measures, significantly enhancing accuracy and stability under extreme weather conditions, and providing reliable support for power system scheduling and operation.  © 2025 IEEE.},

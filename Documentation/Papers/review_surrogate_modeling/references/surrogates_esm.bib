@ARTICLE{Soltani-Gerdefaramarzi2025,
	author = {Soltani-Gerdefaramarzi, Somayeh and Pourebrahim, Sharareh and Ehteram, Mohammad},
	title = {Improved shark optimization algorithm-composite radial basis function neural network: a new version of the RBFNN model for forecasting monthly solar radiation},
	year = {2025},
	journal = {Results in Engineering},
	volume = {27},
	pages = {},
	doi = {10.1016/j.rineng.2025.106339},
	url = {https://www.scopus.com/pages/publications/105011296364?origin=resultslist},
	abstract = {Solar radiation prediction is essential for the optimal design and implementation of solar energy systems, which play a key role in addressing electricity shortages and promoting sustainable development. Thus, our study develops an improved shark optimization algorithm-composite radial basis function neural network (ISHO-CRBFNN) as a novel and advanced model for forecasting monthly solar radiation. The new model operates in several steps. First, the CRBFNN model is developed by incorporating a weighted combination of advanced activation functions into the radial basis function neural network (RBFNN) model. Then, the improved shark optimization algorithm is developed and combined with the CRBFNN model to adjust its parameters, such as the number of hidden neurons, spread parameters (widths), and prototype parameters (centers). The improved shark optimization (ISHO) algorithm incorporates a Gaussian mutation operator, which enhances the exploration and exploitation capabilities of the optimization process. Our study uses monthly climate parameters to forecast monthly solar radiation. These data are collected from different meteorological stations in the Kashan Plain of Iran. Additionally, the study develops the ISHO-random forest algorithm to select the most critical input variables for the ISHO-CRBFNN model. By reducing the number of input variables by 50 %, this hybrid algorithm enhances computational efficiency, improves model interpretability, and mitigates the risk of overfitting. The ISHO-CRBFNN model improves the Nash–Sutcliffe efficiency (NSE), mean absolute error, Kling-Gupta efficiency, and Willmott's Index values of all other models by 3–36 %, 16–48 %, 3.2–24 %, and 4–36 %, respectively. The findings indicate that the ISHO-CRBFNN model can precisely forecast monthly solar radiation data. © 2025},

	keywords = {Costs; Hydrogen fuels; Sales; Carbon trading; Fuel vehicles; Game models; Hydrogen fuel vehicle; Hydrogen-carbon trading; Integrated energy systems; Kriging meta models; Market coupling; Master slave; Master-slave game model; Multi-market coupling; carbon emission; emissions trading; energy market; game theory; hydrogen; kriging; optimization; price dynamics; Clean energy},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Eyimaya2025,
	author = {Eyimaya, Süleyman Emre},
	title = {Efficiency Analysis of Artificial Intelligence and Conventional Maximum Power Point Tracking Methods in Photovoltaic Systems},
	year = {2025},
	journal = {Applied Sciences (Switzerland)},
	volume = {15},
	number = {10},
	pages = {},
	doi = {10.3390/app15105586},
	url = {https://www.scopus.com/pages/publications/105006777173?origin=resultslist},
	abstract = {This study investigates the performance of different maximum power point tracking (MPPT) methods in a photovoltaic (PV) energy system, focusing on Artificial Neural Networks (ANNs), reinforcement learning (RL), and conventional MPPT approaches. The primary objective is to evaluate the efficiency of these methods in maximizing PV energy production under varying environmental conditions, while also analyzing their impact on battery state-of-charge (SOC) and load management. The system is modeled using MATLAB, incorporating real-world climate data from Ankara, including monthly solar irradiance, temperature, and sunlight hours. The ANN-based MPPT employs a multi-layer perceptron (MLP) to improve PV efficiency, while the RL-based MPPT utilizes Q-learning to optimize energy production. A conventional MPPT method serves as a baseline for comparison. Simulations are conducted on an hourly and monthly basis, considering a 7.5 kW PV system with a 20 kWh battery system. The results indicate that both ANN and RL methods outperform the conventional MPPT in terms of annual energy production, with RL achieving the highest efficiency gains. Additionally, the ANN and RL methods demonstrate improved battery SOC management, reducing energy losses. The study concludes that advanced MPPT techniques, particularly RL, offer significant potential for enhancing PV system performance, making them viable solutions for renewable energy optimization. © 2025 by the author.},
	author_keywords = {artificial neural networks; maximum power point tracking; reinforcement learning; renewable energy},
	keywords = {Battery management systems; Information management; Battery state of charge; Energy productions; Maximum Power Point Tracking; Neural network learning; Neural-networks; Photovoltaic systems; Reinforcement learning method; Reinforcement learnings; Renewable energies; Tracking method; Reinforcement learning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Li2025186,
	author = {Li, Mengchen and Liu, Baozhu and Hu, Junjie and Xie, Dongliang and Chang, Kang},
	title = {A Model-Data Hybrid Driven Method for Transient Stability Assessment of Power Systems},
	year = {2025},
	journal = {Lecture Notes in Electrical Engineering},
	volume = {1320 LNEE},
	pages = {186 - 202},
	doi = {10.1007/978-981-96-1671-8_13},
	url = {https://www.scopus.com/pages/publications/85218945719?origin=resultslist},
	abstract = {Power system transient stability assessment is the key to the safe and stable operation of power grids. As the complexity and volatility of power grid operation modes continue to climb, the application of both deterministic and probabilistic assessment methods in different scenarios is limited. Transient stability assessment in conventional scenarios using deterministic physical models is too slow and the calculations are too absolute for decision making such as risk assessment, while in extreme cases, where there is less historical data and the mode of operation fluctuates, the use of probabilistic models can lead to large biases. Therefore, this paper proposes a hybrid model-data driven approach for transient stability assessment of power system. Firstly, scenario identification is performed based on K-means clustering. Secondly, in general scenarios, the probabilistic assessment method of transient stability based on gaussian process regression (GPR) for particle swarm optimization (PSO) is used; and in extreme scenarios, the deterministic assessment method based on time-domain simulation is used. Finally, the validity of the method proposed in this paper is verified in IEEE39 node system. © State Grid Electric Power 2025.},
	author_keywords = {Probability Assessment; PSO-GPR; Time Domain; Transient Stability},
	keywords = {Electromagnetic transients; Hybrid power; Deterministics; Gaussian process regression; Modeling data; Particle swarm; Particle swarm optimization-gaussian process regression; Power; Probability assessments; Swarm optimization; Time domain; Transient stability assessment; Transient stability},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}


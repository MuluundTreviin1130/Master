@CONFERENCE{Ahmed2024,
	author = {Ahmed, Ubaid and Abbas, Syed Sami and Razzaq, Sohail and Mahmood, Anzar},
	title = {A Novel Integrated Approach for Short-Term Wind Power Forecasting},

@ARTICLE{Singh202479,
	author = {Singh, Kamna and Mistry, Khyati D and Patel, Hiren G},
	title = {Regression learner machine learning approach to predict wind speed considering various parameters and integration of DG in mesh distribution system through GWO},
	year = {2024},
	journal = {Australian Journal of Electrical and Electronics Engineering},
	volume = {21},

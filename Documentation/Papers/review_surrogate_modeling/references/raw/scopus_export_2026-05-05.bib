@ARTICLE{Wan20255353,
	author = {Wan, Yuyang and Wang, Ning and Liu, Xueshan and Wang, Yanbo and Blaabjerg, Frede and Chen, Zhe},
	title = {Inertia-Emulation-Based Fast Frequency Response From EVs: A Multi-Level Framework With Game-Theoretic Incentives and DRL},
	year = {2025},
	journal = {IEEE Transactions on Smart Grid},
	volume = {16},
	number = {6},

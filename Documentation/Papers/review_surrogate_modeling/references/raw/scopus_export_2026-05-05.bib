	title = {Online Ice Prediction Model for Transmission Lines Based on BOA-AOSVR},
	year = {2023},
	journal = {Proceedings - 2023 International Conference on Power System Technology: Technological Advancements for the Construction of New Power System, PowerCon 2023},
	pages = {},
	doi = {10.1109/PowerCon58120.2023.10331191},
	url = {https://www.scopus.com/pages/publications/85180405572?origin=resultslist},
	abstract = {Accurate prediction of transmission line ice cover is crucial to the safe and stable operation of power grids. To address the problems of low accuracy, high randomness, and poor interference resistance of traditional single prediction models, A butterfly optimization algorithm (BOA) is proposed to optimize accurate online support vector regression (AOSVR) model. First, principal component analysis is used to derive the main micrometeorological influences on ice cover as model input; Second, BOA is introduced to find the optimal parameters of the SVR model kernel function to establish the online icing thick prediction model; Finally, the ice prediction accuracy of the BOA-AOSVR model is verified by collecting micrometeorological and icing thick data from a 500 kV transmission line ice online detection system, while LSTM and BPNN prediction models are established for comparison. The prediction results show that the proposed method effectively improves the generalization ability and accuracy of the model, and the root mean square error is 0.045, and the prediction accuracy can reach 95.7%, which confirms the validity and feasibility of the model and provides effective data support for deicing and maintenance of transmission lines.  © 2023 IEEE.},
	author_keywords = {Accurate Online Support Vector Regression; Butterfly Optimization Algorithm; Ice Prediction; Prediction Model},
	keywords = {Electric lines; Electric power transmission; Ice; Long short-term memory; Mean square error; Optimization; Principal component analysis; Transmissions; Accurate online support vector regression; Butterfly optimization algorithm; Ice cover; Ice prediction; Online support; Optimization algorithms; Prediction modelling; Support vector regression models; Support vector regressions; Transmission-line; Forecasting},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Benayad2023166,
	author = {Benayad, Mohamed and Rochd, Abdelilah and Houran, Nouriddine and Benazzouz, Aboubakr and Maanan, Mehdi and Elarabi, Hassan and Rhinane, Hassan},
	title = {Assessing the Socio-Economic Potential of Electric Vehicle Charging Infrastructure: A Machine Learning based Approach for Marrakech-Safi Region, Morocco},
	year = {2023},
	journal = {12th IEEE International Conference on Renewable Energy Research and Applications, ICRERA 2023},
	pages = {166 - 174},
	doi = {10.1109/ICRERA59003.2023.10269379},
	url = {https://www.scopus.com/pages/publications/85175658385?origin=resultslist},
	abstract = {The evaluation of socio-economic potential plays a pivotal role in advancing sustainable transportation systems, particularly in the field of the infrastructure for electric vehicle charging. In this study, we present a comprehensive methodology that integrates the Analytic Hierarchy Process (AHP) and machine learning techniques to evaluate the socio-economic potential of the Marrakech-Safi region. By employing AHP, we determine the target variable, and subsequently apply RF (Random Forest) and SVM (Support Vector Machine) models incorporating 11 key factors such as demographics, road network, public facilities, typology, and power grid. The findings of our study reveal that the RF model, with an accuracy of 96.37%, outperforms the SVM model, which achieved an accuracy of 94.81%, in accurately predicting the socio-economic potential of our region. Building upon these results, we employ the RF model to project the potential of the Casablanca-Settat region, uncovering promising opportunities for the construction of an infrastructure for electric vehicle charging, notably in the city of Casablanca. The information provided by this study hold significant implications for decision-makers and policymakers involved in the planning and promotion of sustainable transportation infrastructure. By leveraging the combination of AHP and machine learning techniques, our methodology provides a solid framework for evaluating a region's socioeconomic potential, contributing to the formulation of informed strategies for sustainable transportation systems. © 2023 IEEE.},
	author_keywords = {AHP; ELECTRICAL VEHICLE; GIS; ML; RF; RS; SOCIO-ECONOMIC; SVM},
	keywords = {Charging (batteries); Decision making; Electric vehicles; Forestry; Geographic information systems; Hierarchical systems; Learning systems; Random forests; Support vector machines; Economic potentials; Electric vehicle charging; Electrical vehicles; ML; Process learning; Random forests; RS; Socio-economics; Support vectors machine; Sustainable transportation systems; Analytic hierarchy process},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@ARTICLE{Wang2023,

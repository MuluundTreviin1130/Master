@ARTICLE{Liu2026,
	author = {Liu, Longxin and Yang, Xiaohu},
	title = {Modeling the Land-Use-Driven Energy Consumption Nexus in Shaanxi Province, China: A Digital Approach Integrating Machine Learning and Spatial Simulation},
	year = {2026},
	journal = {Sustainability (Switzerland)},

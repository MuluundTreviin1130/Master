	title = {Co-Design for Real-Time Adaptability: Methodology, Implementation, and Real-Time Performance on a Morphing Wind Turbine},
	year = {2026},
	journal = {Journal of Dynamic Systems, Measurement and Control },
	volume = {148},
	number = {2},

@CONFERENCE{Zhou2025451,
	author = {Zhou, Ming and Ma, Yunjun and Hu, Xupu and Lin, Ran and Wang, Qiwen and Mao, Weixuan and Si, Chengxiang},
	title = {Characterizing Network Threats Against Industrial Control Systems Using Honeypot Technology},
	year = {2025},
	journal = {Proceedings - 2025 International Conference on Networking and Network Applications, NaNA 2025},

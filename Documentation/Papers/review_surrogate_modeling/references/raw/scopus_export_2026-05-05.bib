@ARTICLE{Lv2026,
	author = {Lv, Haihua and Jiang, Liu and Xia, Yan},
	title = {Optimized extreme gradient boosting model for forecasting of turbine power output based on real-time SCADA data},
	year = {2026},
	journal = {Sustainable Energy, Grids and Networks},
	volume = {46},
	pages = {},
	doi = {10.1016/j.segan.2026.102241},
	url = {https://www.scopus.com/pages/publications/105036279643?origin=resultslist},
	abstract = {Wind power can take a leading role in the shift of the renewable energy, and wind turbine is the keystone in this change. This makes accurate prediction of the power output of the turbine inalienable; to make efficient resource allocation of the energy resources and to make efficient integration into the grid. Recent progress in machine learning (ML) has made such techniques one of the most promising solutions in this field to work with large and complex data. The current study presents six optimized ML models; Decision Tree (DT), Support Vector Regression (SVR), Linear Regression (LR), Random Forest (RF), Gradient Boosting (GB), and Extreme Gradient Boosting (XGBoost) which are trained on Supervisory Control and Data Acquisition (SCADA) data collected in the wind farms found in Turkey. One of the significant contributions of this study is the use of the Salp Swarm Algorithm (SSA) to optimize the hyperparameters by improving the predictive performance in the environment of wind energy systems where the situation is highly dynamic and uncertain. Based on the results, the tree-based model, specifically the XGBoost-SSA model, indicates high efficiency in the estimation of wind power output with an outstanding R² value of 0.981 and the lowest RMSE of 174.558, which demonstrates its effectiveness in minimizing prediction errors and ensuring grid reliability. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Extreme gradient boosting; Machine learning algorithms; Renewable energy sources; SCADA dataset; Wind turbine power prediction},
	keywords = {Energy efficiency; Learning systems; Linear regression; Machine learning; Optimization; Random forests; Wind power; Wind turbines; Extreme gradient boosting; Gradient boosting; Machine learning algorithms; Power output; Power predictions; Renewable energy source; Supervisory control and data acquisition; Supervisory control and data acquisition dataset; Wind turbine power; Wind turbine power prediction; Decision trees},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Banka2026,
	author = {Banka, Sujatha and Ashok Kumar, D.V.},
	title = {Hierarchical Data-Driven and PSO-Based Energy Management of Hybrid Energy Storage Systems in DC Microgrids},
	year = {2026},
	journal = {Automation},
	volume = {7},
	number = {2},
	pages = {},
	doi = {10.3390/automation7020050},
	url = {https://www.scopus.com/pages/publications/105036827686?origin=resultslist},
	abstract = {In the era of renewable dominated grids, integration of dynamic loads such as EV charging stations have increased the operational challenges in multifolds, particularly in DC microgrids (DC MGs). Traditional battery-dominated grid energy management strategies (EMSs) are often not capable of handling fast transients due to the limitations of battery electrochemistry. To overcome this limitation, a hierarchical hybrid energy management strategy is proposed that uses the combination of data-driven and metaheuristic algorithms. The designed optimization framework consists of particle swarm optimization (PSO) and a neural network (NN) implemented in the central controller of a 4-bus ringmain DC MG. An efficient decoupling of fast and slow storage dynamics is performed, where the supercapacitor (SC) is optimized using the NN and the battery is optimized using PSO. This selective optimization reduces the computational overhead on the PSO making it more feasible for real-time implementation. The designed hybrid PSO-Neural EMS framework is initially designed on MATLAB and further validated on a real-time hardware setup. Robustness of the control scheme is verified with various case studies, such as renewable intermittency, dynamic loading and partial shading scenarios. An effective optimization of the SC in both transient and heavy load scenarios are observed. LabVIEW interfacing is used for MODBUS-based interaction with PV emulators and DC-DC converters. © 2026 by the authors.},
	author_keywords = {DC microgrids; hierarchical control; hybrid energy storage systems; neural network; particle swarm optimization; supercapacitor},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Doğan2026,
	author = {Doğan, Ayhan},
	title = {An ensemble unsupervised machine learning–GIS framework for transparent and data-driven offshore wind farm siting},
	year = {2026},
	journal = {Ocean Engineering},
	volume = {344},
	pages = {},
	doi = {10.1016/j.oceaneng.2025.123703},
	url = {https://www.scopus.com/pages/publications/105030064387?origin=resultslist},
	abstract = {This study presents the first offshore wind-farm siting model in the Eastern Black Sea integrating a fully data-driven Unsupervised Machine Learning–Geographic Information System (UML–GIS) framework. The model ensembles four unsupervised algorithms—Isolation Forest (IF), Unsupervised Random Forest (URF), k-means (KM), and Gaussian Mixture Model (GMM)—to generate a composite suitability ranking validated through bootstrap and Leave-One-Criterion-Out (LOCO) analyses. Fifteen multidisciplinary criteria encompassing physical, environmental, and socio-economic dimensions were evaluated. Principal Component Analysis (PCA) preserved 93.6 % of total variance, confirming low redundancy among variables. The ensemble exhibited strong consistency with IF (ρ = 0.82) and URF (ρ = 0.87), while bootstrap analysis identified ten highly stable core zones (stability = 0.95–1.00) across 1000 iterations. LOCO validation confirmed that no single criterion dominated the results (ρ = 0.96–1.00). Comparative analysis with the classical Multi-Criteria Decision-Making (MCDM) method, Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS), showed a significant inverse correlation (ρ = −0.633, p < 0.001), indicating that the UML–GIS framework captures complex, non-linear inter-criteria relationships beyond traditional linear models. The framework yields reproducible, unbiased, and statistically robust spatial decisions, offering a transparent and policy-ready tool for sustainable offshore wind planning. © 2025 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Eastern black sea; GIS; Offshore wind farm; Site selection; Unsupervised machine learning},
	keywords = {Black Sea; Data mining; Decision making; Electric utilities; Learning systems; Offshore oil well production; Principal component analysis; Unsupervised learning; Black sea; Data driven; Eastern black sea; Geographic information; Offshore winds; Random forests; Siting models; System framework; Unsupervised machine learning; Wind farm; bootstrapping; correlation; energy planning; GIS; machine learning; multicriteria analysis; offshore structure; principal component analysis; site selection; wind farm; Geographic information systems; Offshore wind farms; Site selection},

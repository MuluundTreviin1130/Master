@ARTICLE{Lin2023,
	author = {Lin, Faa-Jeng and Chang, Chao-Fu and Huang, Yu-Cheng and Su, Tzu-Ming},
	title = {A Deep Reinforcement Learning Method for Economic Power Dispatch of Microgrid in OPAL-RT Environment},
	year = {2023},
	journal = {Technologies},
	volume = {11},
	number = {4},
	pages = {},
	doi = {10.3390/technologies11040096},
	url = {https://www.scopus.com/pages/publications/85169036515?origin=resultslist},
	abstract = {This paper focuses on the economic power dispatch (EPD) operation of a microgrid in an OPAL-RT environment. First, a long short-term memory (LSTM) network is proposed to forecast the load information of a microgrid to determine the output of a power generator and the charging/discharging control strategy of a battery energy storage system (BESS). Then, a deep reinforcement learning method, the deep deterministic policy gradient (DDPG), is utilized to develop the power dispatch of a microgrid to minimize the total energy expense while considering power constraints, load uncertainties and electricity price. Moreover, a microgrid built in Cimei Island of Penghu Archipelago, Taiwan, is investigated to examine the compliance with the requirements of equality and inequality constraints and the performance of the deep reinforcement learning method. Furthermore, a comparison of the proposed method with the experience-based energy management system (EMS), Newton particle swarm optimization (Newton-PSO) and the deep Q-learning network (DQN) is provided to evaluate the obtained solutions. In this study, the average deviation of the LSTM forecast accuracy is less than 5%. In addition, the daily operating cost of the proposed method obtains a 3.8% to 7.4% lower electricity cost compared to that of the other methods. Finally, a detailed emulation in the OPAL-RT environment is carried out to validate the effectiveness of the proposed method. © 2023 by the authors.},
	author_keywords = {deep deterministic policy gradient (DDPG); deep Q-learning network (DQN); economic power dispatch (EPD); energy management system (EMS); long short-term memory (LSTM); microgrid; Newton-particle swarm optimization (Newton-PSO)},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Gasse202375,
	author = {Gasse, Baptiste and Verel, Sébastien and Do, Jean-Michel},
	title = {MOEA/D with Adaptive Mutation Operator Based on Walsh Decomposition: Application to Nuclear Reactor Control Optimization},
	year = {2023},
	journal = {International Joint Conference on Computational Intelligence},
	pages = {75 - 85},
	doi = {10.5220/0012177200003595},
	url = {https://www.scopus.com/pages/publications/85188230891?origin=resultslist},
	abstract = {France has a fleet of nuclear reactors that makes up a significant proportion of the electricity generation mix. This over-representation of nuclear power compared with other energy sources leads reactors to operate in load following mode in order to balance supply and demand on the electricity grid. The increasing penetration of intermittent energies in the mix and the desire not to renew the entire current nuclear fleet bring active research into optimising the control of reactors operating in load following mode to allow them greater flexibility. In this study, we propose to solve a new bi-objective unit commitment problem using an MOEA/D algorithm equipped with an adaptive mutation operator based on a Walsh surrogate model of a black-box function with a high computation cost. The method consists of taking advantage of the linear effects associated with the problem variables thanks to the Walsh coefficients to regularly update the mutation rate of the variation operator and explore the problem’s search space more judiciously. We show that this method enables to penalize some variables by decreasing their mutation probability without affecting the global performance of the search for Pareto-optimal solutions, which makes it similar to an adaptive in-line fitness landscape analysis. © 2023 by SCITEPRESS – Science and Technology Publications, Lda.},
	author_keywords = {Applied Computing Methodologies; Bi-Objective Optimization; Nuclear Reactor Physics; Surrogate Model/fitness Approximation},
	keywords = {Economics; Evolutionary algorithms; Nuclear fuels; Nuclear reactors; Pareto principle; Adaptive mutation operators; Applied computing; Applied computing methodology; Bi-objective optimization; Computing methodologies; Load following; Nuclear reactor physic; Reactor physics; Surrogate model/fitness approximation; Surrogate modeling; Electric loads},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Khayambashi202453,
	author = {Khayambashi, Kamiar and Hasnat, Md Abul and Alemazkoor, Negin},
	title = {HYBRID CHANCE-CONSTRAINED OPTIMAL POWER FLOW UNDER LOAD AND RENEWABLE GENERATION UNCERTAINTY USING ENHANCED MULTI-FIDELITY GRAPH NEURAL NETWORKS},
	year = {2024},
	journal = {Journal of Machine Learning for Modeling and Computing},
	volume = {5},
	number = {4},
	pages = {53 - 76},
	doi = {10.1615/JMachLearnModelComput.2024054885},
	url = {https://www.scopus.com/pages/publications/105006507634?origin=resultslist},
	abstract = {Power systems are transitioning toward renewable sources and electrification, introducing significant uncertainties in generation and demand that optimal power flow (OPF) methods must manage. Traditional deterministic methods struggle with these variabilities. Additionally, addressing uncertainty in OPF calculations incurs computational burdens due to the need for multiple evaluations across various scenarios. This necessitates the use of advanced surrogate models. However, these models require significant data for training, and surrogate-based optimization can yield unreliable results due to inaccuracies in constraint handling. To overcome these issues, this paper proposes a novel surrogate-based hybrid chance-constrained optimal power flow (HCC-OPF) methodology employing enhanced multi-fidelity graph neural networks (EMF-GNN) as power flow solver surrogates. This model integrates low-fidelity and high-fidelity simulations to significantly reduce training cost while maintaining high accuracy. We further enhance the robustness and accuracy of OPF solutions through a hybrid methodology that selectively uses exact power flow solver to correct surrogate inaccuracies near critical thresholds. Extensive testing on multiple IEEE systems under high-dimensional correlated uncertainty of load and generation shows the EMF-GNN model outperforms existing single-fidelity and multi-fidelity models. Furthermore, the proposed HCC-OPF methodology accurately solves OPF problems across various system sizes and conditions, exhibiting scalability and efficiency. Additionally, it effectively manages N-1 security constraints to further exhibit its robustness under operational challenges. © 2024 by Begell House, Inc.},
	author_keywords = {graph neural network; hybrid optimization; multi-fidelity data fusion; optimal power flow; renewable energy generation; uncertainty},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10}
}

@ARTICLE{Li2023,
	author = {Li, Sichen and Hu, Weihao and Cao, Di and Chen, Zhe and Huang, Qi and Blaabjerg, Frede and Liao, Kaiji},
	title = {Physics-model-free heat-electricity energy management of multiple microgrids based on surrogate model-enabled multi-agent deep reinforcement learning},
	year = {2023},
	journal = {Applied Energy},
	volume = {346},
	pages = {},
	doi = {10.1016/j.apenergy.2023.121359},
	url = {https://www.scopus.com/pages/publications/85164480644?origin=resultslist},
	abstract = {Reliability and cost-effectiveness in the operation of the multiple microgrid (MMG) system depend on the skillful management of its energy resources. Traditional energy management approaches are physics-model-based, which rely on the precise system parameters (e.g., line parameters) of the electricity and heat network. It is difficult to establish the precise system parameters in practice because they depend on a variety of factors. In this context, this paper proposes a physics-model-free control framework for the energy management of MMGs with heat-electricity energy, consisting of proposed surrogate model and multi-agent deep reinforcement learning (MADRL) approach. An important step is to use historical data to train a surrogate model in supervised manner that can imitate the realistic power and thermal flow calculations. Meanwhile, the energy management problem is reformulated as a Markov game. It is solved by the proposed MADRL-based approach by modeling each MG controller as an agent with a specific objective. The historical trajectories representation, parameter space technology, and deep dense architecture in reinforcement learning are introduced in MADRL to overcome the negative impact brought by the time series data from the input state on the decision-making process and construct an efficient exploration mechanism to overcome inefficient optimization of the MMG system in a multi-agent setting. During training period of MADRL, the trained surrogate models integrate into the environment of the MADRL, which can develop optimal energy management strategy based on the continuous interaction with the surrogate models. The proposed surrogate model enabled MADRL approach can reduce the reliance on precise physical systems and prevent having an impact on the real system while being trained involving trial and error process. Simulation results demonstrate the effectiveness of the proposed control framework. © 2023 Elsevier Ltd},
	author_keywords = {Combined heat and power; Energy management of multiple microgrids; Multi-agent deep reinforcement learning; Sparse variational Gaussian processes},
	keywords = {Cost effectiveness; Decision making; Deep learning; Energy management; Energy management systems; Energy resources; Learning systems; Multi agent systems; Combined-Heat and Power; Energy management of multiple microgrid; Gaussian Processes; Microgrid; Multi agent; Multi-agent deep reinforcement learning; Physics modeling; Reinforcement learnings; Sparse variational gaussian process; Surrogate modeling; combined heat and power; decision making; electricity; energy management; energy resource; Gaussian method; optimization; strategic approach; Reinforcement learning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 22; All Open Access; Green Open Access}
}

@CONFERENCE{Ali2023,
	author = {Ali, Ola and Mohammed, Osama A.},
	title = {Frequency Stability Enhancement in Low-Inertia Power System Using an Optimal Control Scheme},
	year = {2023},
	journal = {Proceedings - 2023 IEEE International Conference on Environment and Electrical Engineering and 2023 IEEE Industrial and Commercial Power Systems Europe, EEEIC / I and CPS Europe 2023},
	pages = {},
	doi = {10.1109/EEEIC/ICPSEurope57605.2023.10194829},
	url = {https://www.scopus.com/pages/publications/85168667800?origin=resultslist},
	abstract = {Power system dynamics have significantly changed with the global integration of renewable energy sources (RESs). Traditionally, the stored kinetic energy is used for compensating the generation mismatch using the rotating mass of the Synchronous Generators (SGs). With the increase in RESs penetration, SGs are being replaced by inverter-based RESs generation systems which are decoupled from the power systems through power converters. Therefore, the total inertia of the system has decreased, and the system's stability is significantly impacted as the value of the rate of change of frequency (ROCOF) and frequency deviations will be increased. To overcome these challenges, inertia emulation from various energy storage systems (ESS) is used to act as a virtual source of inertia power. This work presents an isolated microgrid (MG) that includes conventional power generation sources and RESs, and an optimal virtual inertia (VI) control loop is proposed for frequency stability enhancement. Supercapacitors (SC) bank with a PID controller presents the VI control loop and acts as a supplementary source for inertia power to support the frequency stability of the system. A genetic algorithm (GA) is used as an optimization technique to get the optimal values of the PID controller gains. The performance of the islanded MG with the proposed optimal control scheme is examined under different operating conditions with varying levels of RESs penetration and system parameters uncertainties. The proposed technique showed its effectiveness and robustness over the system's operation without VI control for keeping the system stable under different operating conditions.  © 2023 IEEE.},
	author_keywords = {Energy storage systems (ESS); Genetic algorithm (GA); Rate of change of frequency (ROCOF); Renewable energy sources (RESs); Virtual Inertia Control (VI)},
	keywords = {Controllers; Electric control equipment; Electric frequency control; Electric power system control; Electromagnetic wave emission; Energy storage; Frequency stability; Kinetic energy; Kinetics; Natural resources; Proportional control systems; Renewable energy resources; Three term control systems; Energy storage system; Genetic algorithm; Power; Rate of change of frequencies; Rate of change of frequency; Renewable energy source; Stability enhancement; Storage systems; Virtual inertia control; Genetic algorithms},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Olusanya2024,
	author = {Olusanya, Olamide O. and Olaiya, Olarinde Hakeem and Olugbenga, Folorunso A.},
	title = {Review on Predictive Model for Forecast of Renewable Energy Output: A Case Study of National Orthopedic Hospital, Igbobi},
	year = {2024},
	journal = {IEEE International Conference on Emerging and Sustainable Technologies for Power and ICT in a Developing Society, NIGERCON},
	number = {2024},
	pages = {},
	doi = {10.1109/NIGERCON62786.2024.10927082},
	url = {https://www.scopus.com/pages/publications/105005945364?origin=resultslist},
	abstract = {Planning and managing renewable energy systems effectively depends on accurate predictions of the energy sources' production. The National Orthopedic Hospital in Igbobi is the subject of a particular case study in this review paper, which focuses on the creation and use of predictive models for predicting the output of renewable energy. The objective is to provide an overview of the existing literature on predictive models and assess their effectiveness in forecasting renewable energy generation. The review begins by highlighting the importance of accurate renewable energy forecasts and their implications for energy management. It then explores the methodologies used in developing predictive models, including statistical techniques, machine learning algorithms, and hybrid models. Various factors influencing renewable energy output forecasting, such as weather conditions, system characteristics, and historical data availability, are discussed. Predictive models for renewable energy production forecasting in comparable healthcare contexts are reviewed, along with case studies and other relevant literature. It examines how well various modeling techniques - such as support vector regression (SVR), autoregressive integrated moving averages (ARIMA), and artificial neural networks (ANN) - capture the intricacies of the production of renewable energy. It discusses the significance of model validation and verification techniques to ensure reliable and robust forecasting results. The findings of this review contribute to the understanding of predictive models for renewable energy output forecasting in healthcare facilities. It highlights the potential benefits of accurate forecasts, such as improved energy planning, enhanced renewable energy utilization, and cost reduction. In addition, the assessment highlights areas for future research and development needs in the creation and use of predictive models for renewable energy forecasting in comparable settings. © 2024 IEEE.},
	author_keywords = {energy management; forecast; healthcare facilities; model performance evaluation; predictive model; renewable energy output},

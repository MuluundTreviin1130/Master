	keywords = {Control system stability; Electric power system stability; Feature extraction; Real time systems; Voltage control; Wind power; Asymmetric loss function; Dynamic feature selections; Gradient boosting; Improved transformer model; Light gradient boosting machine; Light gradients; Risk aware; Static voltage stability; Transformer modeling; Voltage stability assessment; Risk assessment},

@ARTICLE{Janthong202514265,
	author = {Janthong, Supakan and Phukpattaranont, Pornchai},
	title = {Power quality disturbance detection using improved grasshopper optimization and adaptive boosted random forest},
	year = {2025},
	journal = {Electrical Engineering},
	volume = {107},

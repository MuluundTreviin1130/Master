@ARTICLE{Caldas2026,
	author = {Caldas, Roberto P. and Melo, Albert C. G. and Falcão, Djalma M.},
	title = {Hybrid Linear and Support Vector Quantile Regression for Short-Term Probabilistic Forecasting of Solar PV Power},
	year = {2026},

@ARTICLE{El-Azab202193,
	author = {El-Azab, Rasha and Wazeer, Eslam M and Daowd, Mohamed and Abdel Ghany, A.M.},
	title = {Conventional generation emulation for power grids with a high penetration of wind power},
	year = {2021},
	journal = {Clean Energy},

	title = {Research on the application of artificial intelligence technology in the digital handover of pumped storage projects},
	year = {2026},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {14064},
	pages = {},
	doi = {10.1117/12.3090936},
	url = {https://www.scopus.com/pages/publications/105030467131?origin=resultslist},
	abstract = {This study addresses efficiency and reliability challenges in the digital handover of pumped storage projects by proposing an AI-driven integrated framework that combines virtual data generation, quality prediction, document classification, and progress analysis to advance smart city infrastructure management. Synthetic datasets simulating equipment logs, quality inspections, and project documents are developed to train a Random Forest-based quality prediction model, achieving 92% accuracy, with "measured value"identified as the dominant feature (65% weight). A hybrid TF-IDF and Naive Bayes classifier automates document categorization with 95% precision, reducing manual processing by 70%. Progress forecasting integrates linear regression and time-series models, achieving a 1.2% prediction error, while dynamic threshold adjustments and real-Time data pipelines enhance resilience to environmental disruptions. Experimental results demonstrate a 30% reduction in handover duration and a 12.4% improvement in risk detection sensitivity. Innovatively, optical sensing data (e.g., fiber-optic thermal gradients and LiDAR deformation monitoring) are embedded into risk control frameworks, establishing a dual-dimensional "physical-electrical"assessment system for high-dimensional non-convex optimization. Future work will prioritize multi-modal data fusion and blockchain-based audit trails to strengthen scalability and robustness in smart energy systems.  © COPYRIGHT SPIE. Downloading of the abstract is permitted for personal use only.},
	author_keywords = {Artificial Intelligence; Digital handover; Pumped storage projects; Quality prediction; Smart city infrastructure},

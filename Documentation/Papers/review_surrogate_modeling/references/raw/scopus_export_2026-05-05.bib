@ARTICLE{Carriere20196933,
	author = {Carriere, Thomas and Kariniotakis, George},
	title = {An Integrated Approach for Value-Oriented Energy Forecasting and Data-Driven Decision-Making Application to Renewable Energy Trading},
	year = {2019},
	journal = {IEEE Transactions on Smart Grid},
	volume = {10},

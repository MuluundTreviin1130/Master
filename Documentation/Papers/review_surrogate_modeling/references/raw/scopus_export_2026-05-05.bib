	source = {Scopus},
	note = {Cited by: 5; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Zaki2017656,
	author = {Zaki, Dina A. and Hasanien, Hany M. and El-Amary, Noha H. and Abdelaziz, A.Y.},

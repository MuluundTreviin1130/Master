@ARTICLE{Dong2023,
	author = {Dong, Bo and Li, Peng and Yu, Hao and Ji, Haoran and Song, Guanyu and Li, Juan and Zhao, Jinli and Wang, Chengshan},
	title = {Chance-constrained optimal dispatch of integrated energy systems based on data-driven sparse polynomial chaos expansion},

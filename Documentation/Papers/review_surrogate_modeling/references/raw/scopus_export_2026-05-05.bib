@ARTICLE{Chavarro-Barrera20212834,
	author = {Chavarro-Barrera, L. and Perez-Londono, S. and Mora-Florez, J.},
	title = {An Adaptive Approach for Dynamic Load Modeling in Microgrids},
	year = {2021},
	journal = {IEEE Transactions on Smart Grid},
	volume = {12},

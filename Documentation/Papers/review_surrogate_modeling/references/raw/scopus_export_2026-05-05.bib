@ARTICLE{Liao2025,
	author = {Liao, Haijun and Zhang, Hongshuo and Che, Wenxuan and Li, Ziming and Zhou, Wen and Zhou, Zhenyu and Tariq, Muhammad},
	title = {Round-trip information timeliness based energy storage control for cyber-physical integrated multi-energy system},
	year = {2025},

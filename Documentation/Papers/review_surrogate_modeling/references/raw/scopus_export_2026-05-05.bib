@CONFERENCE{Balderrama20192999,
	author = {Balderrama, Sergio and Lombardi, Francesco and Stevanato, Nicolo and Pena, Gabriela and Colombo, Emanuela and Quoilin, Sylvain},
	title = {Automated evaluation of levelized cost of energy of isolated micro-grids for energy planning purposes in developing countries},

@CONFERENCE{Rajaei2025,
	author = {Rajaei, Ali and Arowolo, Olayiwola and Cremer, Jochen L.},
	title = {Spatio-Temporal Graph Neural Networks for Multi-Period Optimal Power Flow},
	year = {2025},

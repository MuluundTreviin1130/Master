@ARTICLE{Qian2023,
	author = {Qian, Jie and Wang, Ping and Chen, Gonggui},
	title = {Improved gravitational search algorithm and novel power flow prediction network for multi-objective optimal active dispatching problems},
	year = {2023},
	journal = {Expert Systems with Applications},

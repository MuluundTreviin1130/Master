}

@ARTICLE{Yan2024,
	author = {Yan, Qin and Lu, Zhiying and Liu, Hong and He, Xingtang and Zhang, Xihai and Guo, Jianlin},
	title = {Short-term prediction of integrated energy load aggregation using a bi-directional simple recurrent unit network with feature-temporal attention mechanism ensemble learning model},
	year = {2024},

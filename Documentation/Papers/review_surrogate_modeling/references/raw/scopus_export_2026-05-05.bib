@ARTICLE{Bodini2023607,
	author = {Bodini, Nicola and Castagneri, Simon and Optis, Mike},
	title = {Long-term uncertainty quantification in WRF-modeled offshore wind resource off the US Atlantic coast},
	year = {2023},

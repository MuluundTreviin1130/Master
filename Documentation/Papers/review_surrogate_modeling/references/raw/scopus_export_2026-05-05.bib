@ARTICLE{Abbes20261369,
	author = {Abbes, Sana and Hassine, Hichem and Amari, Said and Chaari, Riadh and Haddar, Mohamed},
	title = {Remaining Useful Life Prediction for Aircraft Maintenance Using Machine Learning},
	year = {2026},
	journal = {Quality and Reliability Engineering International},
	volume = {42},

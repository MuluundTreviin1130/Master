@ARTICLE{Zhang20253601,
	author = {Zhang, Jing and Zhou, Kun and Wang, Lulu and Yang, Yang and Li, Yingna},
	title = {Detection Framework of FDIA for Smart Grid Based on Mode Decomposition and Gradient Boosting Decision},
	year = {2025},
	journal = {Journal of Electrical Engineering and Technology},
	volume = {20},
	number = {5},
	pages = {3601 - 3623},
	doi = {10.1007/s42835-025-02221-6},
	url = {https://www.scopus.com/pages/publications/105002163025?origin=resultslist},
	abstract = {The escalating frequency of cyberattacks poses a significant threat to the security of Cyber-Physical Systems. Recent studies have revealed that a specific type of cyberattack, known as false data injection attacks(FDIA), can easily breach the defense mechanisms of energy systems. As attack detection technology improves, attackers must prudently choose their targets and distribute discreetly small-scale resources to minimize the risk of detection. Without access to eliminate the strong coupling relationship between buses within single time domain, we propose a FDIA detection framework that can detect independent buses, which presents the characteristics of attack under the multi-mode perspective. The framework employs Variational Mode Decomposition and Fast Independent Component Analysis to extract the distinctive features of FDIA signals across various frequencies. Additionally, the framework utilizes the results obtained from Particle Swarm Optimization to replace the predetermined thresholds of Extreme Gradient Boosting on an individual bus, thereby augmenting both the detection accuracy and interpretability of the model. Simulation results of the IEEE-14 bus system demonstrate the efficient detection of attacks on individual buses by the proposed FDIA detection framework. Furthermore, the study evaluates the impact of attack intensity on the framework’s performance in the presence of specific noise interference, thus confirming the method’s high effectiveness and robustness. © The Author(s) under exclusive licence to The Korean Institute of Electrical Engineers 2025.},
	author_keywords = {Cyber-physical system security; False data injection attacks; Machine learning; Signal processing; Smart grid},
	keywords = {Adaptive boosting; Cyber attacks; Machine learning; Network security; Steganography; Time domain analysis; Variational mode decomposition; Variational techniques; Attack detection; Cyber-attacks; Cyber-physical system securities; Detection framework; False data injection attacks; Gradient boosting; Machine-learning; Mode decomposition; Signal-processing; Smart grid; Smart power grids},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@CONFERENCE{Boero2025,
	author = {Boero, Ignacio and Diaz, Santiago and Vázquez, Tomás and Coppes, Enzo and Belzarena, Pablo and Larroca, Federico},
	title = {Learning to Optimally Dispatch Power: Performance on a Nation-Wide Real-World Dataset},
	year = {2025},
	journal = {2025 15th IEEE International Conference on Pattern Recognition Systems, ICPRS 2025},
	pages = {},
	doi = {10.1109/ICPRS66293.2025.11302858},
	url = {https://www.scopus.com/pages/publications/105032188016?origin=resultslist},
	abstract = {The Optimal Reactive Power Dispatch (ORPD) problem plays a crucial role in power system operations, ensuring voltage stability and minimizing power losses. Recent advances in machine learning (ML), particularly within the “learning to optimize” framework, have enabled fast and efficient approximations of ORPD solutions, typically by training models on precomputed optimization results. While these approaches have demonstrated promising performance on synthetic datasets, their effectiveness under real-world grid conditions remains largely unexplored. This paper makes two key contributions. First, we introduce a publicly available power system dataset that includes both the structural characteristics of a complete nation’s electrical grid (Uruguay), as well as nearly two years of real-world operational data, encompassing actual demand and generation profiles. Given Uruguay’s high penetration of renewable energy in this network, the ORPD problem has become the primary optimization challenge in its operation. Equipped with this data, and as a second contribution, we assess the impact of these real-world inputs on ML-based ORPD solutions, revealing a significant increase in prediction errors when transitioning from synthetic to actual demand and generation profiles. Our results highlight the limitations of existing models in learning under the complex statistical properties of real grid conditions and emphasize the need for more expressive architectures. By providing this dataset and the associated code, we aim to facilitate further research into robust ML-based optimization techniques for power system management. ©2025 IEEE.},
	author_keywords = {Learning to Optimize; Optimal Reactive Power Dispatch; Real-World Power System Dataset},
	keywords = {Optimization; Renewable energy; Dispatch problems; Learning to optimize; Machine-learning; Optimal reactive power dispatch; Optimisations; Power; Power performance; Real-world; Real-world power system dataset; Uruguay; Learning systems},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Rinchi2025,
	author = {Rinchi, Bilal and Al-Dahidi, Sameer and Abdalla, Mohammed E.B. and Ayadi, Osama and Al-Akhras, Anas},
	title = {Economic and environmental analysis of forecasting errors in air conditioning energy demand under fixed and time-of-use tariffs: A case study},
	year = {2025},
	journal = {Case Studies in Thermal Engineering},
	volume = {72},
	pages = {},
	doi = {10.1016/j.csite.2025.106409},
	url = {https://www.scopus.com/pages/publications/105008939707?origin=resultslist},
	abstract = {Accurate forecasting of Air Conditioning (AC) energy demand is essential for mitigating economic and environmental challenges in energy planning, especially under extreme weather conditions. Despite advancements in prediction techniques, limited attention has been given to the real-world impacts of forecasting errors under different electricity tariff structures. This study quantifies these impacts by modeling a typical office space using the Hourly Analysis Program (HAP) and evaluating 8 machine learning models. Gradient Boosting Regressor (GBR) achieved the highest accuracy (R2 = 95.004%, RMSE = 0.0883 kWh) and was selected for subsequent economic and environmental analyses. Fixed and Time-of-Use (TOU) tariffs were assessed across three cases: (1) no penalties, (2) penalties for underestimation, and (3) penalties for both under- and overestimation. Sensitivity analysis showed that increasing underestimation penalties from 0.03 to 0.15 USD/kWh led to cost increases of 1.9%-10.6% under fixed tariffs and 2.0%-11.2% under TOU tariffs. Similarly, increasing overestimation penalties in the same range resulted in cost increases of 4.3%-8.6% for fixed tariffs and 4.5%-9.1% for TOU. While percentage increases were slightly higher under TOU, their normalized costs were consistently lower, resulting in lower absolute costs overall. TOU tariffs thus continued to favor commercial AC use, offering greater resilience to forecast inaccuracies. Seasonal analysis revealed higher winter penalties, while overestimations caused a 6.00% increase in CO2 emissions. The single-office case study offers a controlled setting to isolate forecasting impacts, with normalized metrics ensuring scalability. We find that it is important to integrate forecasting accuracy into tariff design and energy policy to avoid economic losses and environmental harm. © 2025 The Authors.},
	author_keywords = {Air conditioning; Case study; Economic analysis; Environmental analysis; Forecasting errors; Machine learning},
	keywords = {Cost benefit analysis; Economic analysis; Energy policy; Errors; Learning systems; Losses; Machine learning; Office buildings; Sensitivity analysis; Weather forecasting; Case-studies; Cost-increases; Economic challenges; Economics analysis; Energy demands; Environmental analysis; Forecasting error; Machine-learning; Time of use; Time-of-use tariffs; Air conditioning},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}


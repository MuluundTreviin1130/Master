@CONFERENCE{Yu20242024,
	author = {Yu, Zhongming and Du, Hongze and Lei, Yuan and Shan, Menghao},
	title = {Short-term Load Forecasting of Power System Based on Weighted Improved Adaptive Neuro-Fuzzy Inference System and Random Forest},
	year = {2024},
	journal = {2024 IEEE 2nd International Conference on Power Science and Technology, ICPST 2024},

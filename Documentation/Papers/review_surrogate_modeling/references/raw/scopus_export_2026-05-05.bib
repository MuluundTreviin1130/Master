@ARTICLE{Yin2025,
	author = {Yin, Linfei and Wang, Nannan and Li, Jishen},
	title = {Electricity terminal multi-label recognition with a “one-versus-all” rejection recognition algorithm based on adaptive distillation increment learning and attention MobileNetV2 network for non-invasive load monitoring},

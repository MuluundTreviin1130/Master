@ARTICLE{Yang2022,
	author = {Yang, Lizhong and Gil, Antoni and Leong, Pammy S.H. and Khor, Jun Onn and Akhmetov, Bakytzhan and Tan, Wooi Leong and Rajoo, Srithar and Cabeza, Luisa F. and Romagnoli, Alessandro},
	title = {Bayesian optimization for effective thermal conductivity measurement of thermal energy storage: An experimental and numerical approach},
	year = {2022},
	journal = {Journal of Energy Storage},
	volume = {52},

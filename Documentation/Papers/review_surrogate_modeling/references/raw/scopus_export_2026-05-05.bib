	year = {2025},
	journal = {2025 5th International Conference on New Energy and Power Engineering, ICNEPE 2025},
	pages = {112 - 122},
	doi = {10.1109/ICNEPE67923.2025.11384163},
	url = {https://www.scopus.com/pages/publications/105034801640?origin=resultslist},
	abstract = {Electric load forecasting is of great significance for the safe and stable operation and economic optimization of power systems. To improve the accuracy of short-term load forecasting, this study proposes a forecasting model based on discrete wavelet transform (DWT), artificial fish swarm algorithm (AFSA), and multi-model fusion. First, DWT is used to decompose the original load data. The low-frequency and high-frequency components are fed into suitable models: high-frequency components are input into convolutional neural network-long short-term memory (CNN-LSTM), multilayer perceptron (MLP), and random forest (RF), while low-frequency components are processed by ridge regression (RR). LightGBM is then employed as a meta-learner to integrate the prediction results. AFSA combined with 10-fold cross-validation is applied to optimize the model hyperparameters. Experiments were conducted using 2023 load data from a region in Northwest China, with meteorological input variables for each season determined through maximal information coefficient (MIC) feature selection. The results show that the proposed model achieves excellent performance in prediction error metrics across different seasons. Compared with single models and other combined models, it more accurately fits the electric load series, demonstrating its effectiveness and offering a new approach and methodology for electric load forecasting. © 2025 IEEE.},

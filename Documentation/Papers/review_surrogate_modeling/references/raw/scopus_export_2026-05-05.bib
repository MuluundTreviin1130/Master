	keywords = {Battery management systems; Extraction; Fast charging (Batteries); Feature extraction; Ions; Mean square error; Uncertainty analysis; Battery degradation; Battery surface temperatures; Capacity estimation; Feature extraction methods; Prognostics and health managements; Remaining useful lives; Root mean square errors; Uncertainty measurements; aging; degradation; energy planning; energy storage; extraction method; life cycle analysis; thermodynamics; Lithium-ion batteries},
	type = {Article},

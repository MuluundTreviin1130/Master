	title = {Explainable prognostics-optimization of hydrogen carrier biogas engines in an integrated energy system using a hybrid game-theoretic approach with XGBoost and statistical methods},
	year = {2025},
	journal = {International Journal of Hydrogen Energy},
	volume = {160},

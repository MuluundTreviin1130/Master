@CONFERENCE{Li2025207,
	author = {Li, Kui and Zhang, Qiuqiong and Wang, Yuejing and Shuai, Yong and Feng, Yubo and Zhang, Zhengnian},
	title = {Cost Prediction of Power Grid Transmission Project Based on a Hybrid Global-Local Modeling Approach},
	year = {2025},
	journal = {2025 15th International Conference on Power and Energy Systems, ICPES 2025},

@ARTICLE{Rajkumar20251312,
	author = {Rajkumar, N. and Roselyn, J. Preetha},
	title = {Golden eagle optimization approach for feature selection and XGBoost algorithm-based intrusion detection system in wireless mesh networks of smart grid},
	year = {2025},
	journal = {Journal of the Chinese Institute of Engineers, Transactions of the Chinese Institute of Engineers,Series A},
	volume = {48},

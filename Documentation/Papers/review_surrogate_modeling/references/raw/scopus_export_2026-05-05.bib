@CONFERENCE{Denis2021,
	author = {Denis, Boyarkin and Dmitry, Krupenev and Dmitrii, Iakubovskii},
	title = {Method for solving the problem of adequacy optimization of energy power systems based on simulated annealing},
	year = {2021},

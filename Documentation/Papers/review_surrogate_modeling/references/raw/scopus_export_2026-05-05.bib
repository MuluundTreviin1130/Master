	title = {Carbon-neutral tri- and multi-generation plants with CO2 capture unit integrated modified gas turbine, recuperative steam Rankine, absorption chiller, and MED: life cycle assessment and multi-scenario chameleon swarm optimization with XGBoost modeling},

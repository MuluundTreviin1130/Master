@ARTICLE{Köhnen20224550,
	author = {Köhnen, Clara Sophie and Priesmann, Jan and Nolting, Lars and Kotzur, Leander and Robinius, Martin and Praktiknjo, Aaron},
	title = {The potential of deep learning to reduce complexity in energy system modeling},
	year = {2022},

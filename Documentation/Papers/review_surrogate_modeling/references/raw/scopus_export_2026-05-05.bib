@ARTICLE{Mohebbi2024143,
	author = {Mohebbi, Milad and Sobhani, Behnam},
	title = {Enhancing Residential Electricity Consumption Forecasting with Meta-Heuristic Algorithms},
	year = {2024},
	journal = {Advances in Engineering and Intelligence Systems},
	volume = {3},
	number = {2},
	pages = {143 - 175},
	doi = {10.22034/aeis.2024.458696.1197},

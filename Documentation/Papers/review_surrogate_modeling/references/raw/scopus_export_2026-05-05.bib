@ARTICLE{Eshiemogie2025,
	author = {Eshiemogie, Stanley Aimhanesi and Aielumoh, Peace Precious and Okamkpa, Tobechukwu and Jude, Miracle Chinonso and Efe, Lois and Amenaghawon, Andrew Nosakhare and Darmokoesoemo, Handoko and Kusuma, Heri Septya},
	title = {A machine learning-supported framework for predicting Nigeria's optimal energy storage and emission reduction potentials},
	year = {2025},
	journal = {Renewable Energy Focus},

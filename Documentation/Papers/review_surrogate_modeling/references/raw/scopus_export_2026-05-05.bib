@ARTICLE{Hidayat202465,
	author = {Hidayat, M. Taufik Imam and Robandi, Imam and Wibowo, Rony Seto and Prakasa, Mohamad Almas and Djalal, Muhammad Ruswandi},
	title = {Optimal Tuning of Power System Stabilizer and Virtual Inertia Control Based On Black Widow Optimization Algorithm},

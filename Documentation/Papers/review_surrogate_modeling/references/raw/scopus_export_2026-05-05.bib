@CONFERENCE{Gernandt20241831,
	author = {Gernandt, Hannes and Hagemann, Willem and Krenzlin, Franziska and Schiffer, Johannes},
	title = {DATA-DRIVEN MODELING OF BOREHOLE THERMAL ENERGY STORAGE (BTES) FOR OPERATIONAL OPTIMIZATION OF RENEWABLE HEAT PRODUCTION SYSTEMS},

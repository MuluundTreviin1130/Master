@ARTICLE{Shi2026,
	author = {Shi, Xiaoliang and Lyu, Wenyu and Ding, Weiqi and Wang, Yizhen and Yang, Yuchen and Wang, Li},
	title = {Mapping the Spatial Distribution of Photovoltaic Power Plants in Northwest China Using Remote Sensing and Machine Learning},
	year = {2026},

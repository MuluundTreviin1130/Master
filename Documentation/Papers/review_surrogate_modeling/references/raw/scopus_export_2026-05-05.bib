@ARTICLE{Li2026,
	author = {Li, Yuankang and Xiao, Tannan and Chen, Ying and Huang, Shaowei and Li, Jie and Yang, Kang and Li, Ruojin},
	title = {Sensitivity-Aware and Fast-Converging Preventive Dispatch for Large-Scale Power Systems Using Transformer and Integrated Gradients under Transient Constraints},
	year = {2026},

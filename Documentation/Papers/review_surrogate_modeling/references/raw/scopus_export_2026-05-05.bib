@ARTICLE{Luque202630037,
	author = {Luque, Joaquín and Gómez, Álvaro and Carrasco, Alejandro and León, Carlos and Fernández, Alicia},
	title = {Advanced Feature Engineering for Non-Intrusive Load Monitoring},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {30037 - 30052},
	doi = {10.1109/ACCESS.2026.3667181},
	url = {https://www.scopus.com/pages/publications/105031483508?origin=resultslist},
	abstract = {Non-Intrusive Load Monitoring (NILM) aims to identify electrical appliances in a household from voltage and current signals, enabling energy efficiency and smart grid applications. This study investigates NILM classification using the PLAID sub-metered dataset, evaluating multiple feature extraction techniques and classification algorithms. The results demonstrate that generic statistical features outperform domain-specific electrical features, including those based on IEEE standards. Feature analysis reveals that transient-state signals generally lead to higher classification accuracy than steady-state signals. However, the best performance is achieved by combining statistical features from both states, specifically by characterizing the steady-state current signal, complemented by its phase shift, and the active-state current signal filtered through nine pass-band filters. Dimensionality reduction further improves classification by enhancing feature relevance. Among the classifiers tested, Random Forest achieves the highest performance, reaching 93% accuracy under optimal conditions. To address dataset imbalance, the Synthetic Minority Over-sampling Technique (SMOTE) was applied. While this technique does not improve overall performance, it enhances classification fairness by improving recognition of underrepresented categories at the cost of a slight decrease in the most populated ones. Learning curve analysis suggests that performance has not yet plateaued, indicating that a larger dataset would further enhance results. These findings highlight key challenges and opportunities in NILM, suggesting that future work should focus on expanding dataset diversity and refining feature extraction methods to improve classification robustness. © 2026 The Authors.},
	author_keywords = {electrical appliance classification; feature extraction; machine learning; Non-intrusive load monitoring (NILM); smart grid applications},
	keywords = {Classification (of information); Dimensionality reduction; Domestic appliances; Electric power transmission networks; Extraction; Feature Selection; IEEE Standards; Optimization; Signal analysis; Smart power grids; Current signal; Electrical appliance classification; Electrical appliances; Features extraction; Machine-learning; Non-intrusive load monitoring; Nonintrusive load monitoring; Performance; Smart grid applications; Statistical features; Learning systems},

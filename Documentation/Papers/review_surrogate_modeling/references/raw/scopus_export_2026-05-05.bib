@ARTICLE{Ozer2025,
	author = {Ozer, Rahim Aytug},
	title = {Heat sink optimization with response surface methodology for single phase immersion cooling},
	year = {2025},
	journal = {International Journal of Heat and Fluid Flow},
	volume = {112},

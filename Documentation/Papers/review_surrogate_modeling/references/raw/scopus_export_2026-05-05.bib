	title = {Two-Stage Robust Optimization for Microgrid Incorporating Renewable Energy Uncertainties via Bayesian Inference with Gaussian Processes},
	year = {2024},
	journal = {Proceedings - 2024 9th Asia Conference on Power and Electrical Engineering, ACPEE 2024},
	pages = {1089 - 1093},
	doi = {10.1109/ACPEE60788.2024.10532483},
	url = {https://www.scopus.com/pages/publications/85195594040?origin=resultslist},
	abstract = {This study contributes a data-driven two-stage robust optimization framework to account for the uncertainties in renewable energy sources within microgrid systems. The framework integrates Bayesian inference with Gaussian Process regression (GPR) analysis to evaluate and model the output uncertainties of photovoltaic (PV) and Wind turbine (WT) power sources. Furthermore, the correlation between these sources is established at various uncertainty levels. The two-stage optimization approach incorporates the day-ahead dispatch stage and real-time adjusting under economic factors in the second stage. So, the framework controls day-ahead dispatch strategies to optimize microgrids in the prospect of varying PV-WT output and electricity demand. Subsequently, it involves real-time optimization under the worst-case scenario, enhancing the microgrid's economic viability and operational efficiency. Finally, a column-and-constraint generation (C&CG) method is employed to address the robust optimization model by incorporating different levels of uncertainty. The proposed method is established on an IEEE 33-bus distribution network, ensuring its applicability and reliability.  © 2024 IEEE.},

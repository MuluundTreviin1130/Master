	title = {An Accelerated Approach to Time-Sequential Production Simulation for Integrated Generation-Grid-Storage Systems Combining Benders Decomposition and Data-Driven Methods},
	year = {2025},
	journal = {2025 IEEE International Conference on Smart Power and Energy Technologies, IEEE SPET 2025},
	pages = {},
	doi = {10.1109/SPET67577.2025.11335784},
	url = {https://www.scopus.com/pages/publications/105033537214?origin=resultslist},
	abstract = {The rapid growth of wind and solar power has made electricity system simulations increasingly complex, with high-dimensional, tightly interconnected variables that overwhelm traditional solution methods. To address this challenge, this paper proposes a new approach that combines Benders decomposition with data-driven techniques to accelerate large-scale, time-based simulations of integrated generation, grid, and storage operations under high renewable penetration. The method begins with a detailed analysis of the simulation model, which is mathematically structured as a large-scale mixed-integer linear program. Using decomposition, the model is split into a master problem dealing with discrete decisions and subproblems focused on continuous variables. To further streamline computation, the framework incorporates a pre-screening mechanism based on Gaussian process models. This mechanism uses patterns from past solutions to identify and remove inactive parts of the feasible region and redundant safety constraints, effectively narrowing the search space. A case study involving a 90-node provincial power system shows that the proposed method significantly improves computational efficiency without compromising accuracy.  © 2025 IEEE.},
	author_keywords = {Benders Decomposition; Coordinated Time-Series Simulation of Generation-Grid-Storage Systems; Gaussian Process; High-Dimensional Mixed-Integer Linear Programming},
	keywords = {Digital storage; Gaussian distribution; Integer linear programming; Integer programming; Mixed-integer linear programming; Solar energy; Benders' decompositions; Coordinated time-series simulation of generation-grid-storage system; Gaussian Processes; Grid Storage; High-dimensional; High-dimensional mixed-integer linear programming; Higher-dimensional; Integer Linear Programming; Mixed integer linear; Storage systems; Time-series simulation; Computational efficiency},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Fu2025,
	author = {Fu, Yang and Guosong, Wang and Yi, Xu and Qinfeng, Ma and Su, An and Junquan, Chen},
	title = {Small signal stability prediction and correction control algorithm for wind power systems based on LightGBM},
	year = {2025},
	journal = {Frontiers in Energy Research},
	volume = {13},
	pages = {},
	doi = {10.3389/fenrg.2025.1725371},
	url = {https://www.scopus.com/pages/publications/105024892412?origin=resultslist},
	abstract = {With the increasing penetration of wind power in electrical power systems, its impact on small signal stability has become increasingly significant. The volatility and uncertainty introduced by wind power integration pose new challenges to power system stability analysis and control. To accurately predict and correct the small signal stability of wind power systems, this paper proposes a prediction and correction method based on the Light Gradient Boosting Machine (LightGBM) algorithm. The LightGBM model offers high computational efficiency and low memory consumption, enabling large-scale data processing and automatic handling of missing values, thereby accurately extracting grid characteristics. To verify the reliability of the proposed method, Gaussian white noise with three different signal-to-noise ratios is introduced to evaluate the model’s performance and robustness. Case studies are conducted using a 3-machine 9-bus system and a 10-machine 39-bus system, in which certain conventional generators are replaced with aggregated wind farms. By applying the LightGBM model to predict the system’s minimum damping ratio and constructing a correction optimization model based on damping ratio sensitivity, unstable operating states are effectively adjusted. Simulation results demonstrate that the proposed method achieves high prediction accuracy and rapid correction response, confirming its feasibility and effectiveness in small signal stability analysis and control of wind-integrated power systems. Copyright © 2025 Fu, Guosong, Yi, Qinfeng, Su and Junquan.},
	author_keywords = {damping ratio sensitivity; doubly fed induction generators; LightGBM; machine learning; small signal stability analysis; wind power generators},
	keywords = {Computational efficiency; Control system stability; Data handling; Electric generators; Electric power system control; Electric power system stability; Electric utilities; Forecasting; Signal analysis; Signal to noise ratio; Wind power; Damping ratio; Damping ratio sensitivity; Doubly fed induction generators; Gradient boosting; Light gradient boosting machine; Light gradients; Machine-learning; Small signal stability; Small signal stability analysis; Wind-power generators; Damping; Learning systems},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Radhika2025,
	author = {Radhika, S. and Patil, Shashikant and Paul, Bishakh and Palo, Hemanta Kumar and Prerna and Gandhi, Ayush},
	title = {Machine Learning - Driven Decision Support System for Real-Time Smart Grid PerformanceMonitoring},
	year = {2025},
	journal = {2025 International Conference on Metaverse and Current Trends in Computing, ICMCTC 2025},
	pages = {},
	doi = {10.1109/ICMCTC62214.2025.11196187},
	url = {https://www.scopus.com/pages/publications/105022253821?origin=resultslist},
	abstract = {The increasing complexity of smart grids necessitates an effective Decision Support System (DSS) for realtime performance monitoring. This aims to design a Machine Learning (ML) driven DSS for Smart Grid monitoring by implementing an Adjustable Black-winged Kite Optimized Random Forest (ABWK-RF) model for accurate grid performance monitoring. Data is collected using IoT-enabled sensors across the Smart Grid, measuring key parameters such as voltage, current, power usage, and frequency. Normalization techniques such as Min-Max scaling are applied to pre-process the raw data, ensuring consistent feature ranges. Fast Fourier Transform (FFT) is used for feature extraction, transforming time-domain signals into the frequency domain. ABWK optimization enhances the RF model by fine-tuning hyperparameters for optimal Smart Grid performance prediction. The model is implemented in Python. Performance metrics, including accuracy (0.984), precision (0.979), recall (0.979), and F1-score (0.982), are calculated to evaluate the effectiveness of the ABWK-RF model in predicting Smart Grid system stability. The ABWK-RF model offers a robust approach for real-time Smart Grid monitoring. The system's high accuracy and performance metrics demonstrate its potential for enhancing grid reliability, energy management, and decision-making, paving the way for advanced smart grid technologies. © 2025 IEEE.},
	author_keywords = {Adjustable Black-winged Kite Optimized Random Forest (ABWK-RF); Decision Support Systems (DSS); Machine learning (ML); Real-Time Smart Grid},

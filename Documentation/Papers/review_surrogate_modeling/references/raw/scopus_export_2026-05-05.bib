@ARTICLE{Ye2025,
	author = {Ye, Zhaonian and Han, Qike and Han, Kai and Wang, Yongzhen and Zhao, Changlu and Yang, Haoran and Du, Jun},
	title = {Coordinating V2V Energy Sharing for Electric Fleets via Multi-Granularity Modeling and Dynamic Spatiotemporal Matching},

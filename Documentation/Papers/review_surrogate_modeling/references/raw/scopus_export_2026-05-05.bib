@ARTICLE{Lin2023,
	author = {Lin, Chenhao and Liang, Huijun and Pang, Aokang and Zhong, Jianwei},
	title = {Data-driven method of solving computationally expensive combined economic/emission dispatch problems in large-scale power systems: an improved kriging-assisted optimization approach},

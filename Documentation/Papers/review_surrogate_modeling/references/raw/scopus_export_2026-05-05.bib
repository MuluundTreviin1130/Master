@ARTICLE{Chen2026,
	author = {Chen, Chenpeng and Guo, Jinpeng and Pan, Xueping and Xu, Qing and Sun, Xiaorong and Xie, Zhou},
	title = {Dynamic feature selection and risk-aware transformer for real-time static voltage stability assessment in power systems including wind power},
	year = {2026},
	journal = {Electric Power Systems Research},
	volume = {258},
	pages = {},
	doi = {10.1016/j.epsr.2026.113173},
	url = {https://www.scopus.com/pages/publications/105036353702?origin=resultslist},
	abstract = {Existing AI-based methods for static voltage stability assessment (SVSA) are often hindered by redundant features, weak interpretability, and asymmetric prediction risks. To address these issues, this paper proposes a LightGBM-based feature contribution framework to quantitatively evaluate the impact of individual variables on the voltage stability margin (VSM). An adaptive Dynamic Threshold Cumulative Contribution (DTCC) method is further introduced to identify dominant features, thereby reducing redundancy and improving model generalization. Based on the refined feature set, a hybrid Transformer network is developed by integrating multi-channel dilated causal convolution for enhanced local feature extraction and an asymmetric Huber loss for risk-aware optimization. Case studies on the modified IEEE 39-bus system show that the proposed method reduces the mean absolute percentage error (MAPE) by up to 28.6% relative to conventional AI models, achieving an inference latency of 5.6 ms and meeting online assessment requirements. Even under 30 dB noise, the model maintains an accuracy above 94.9%, demonstrating strong robustness, interpretability, and practicality for real-time SVSA. © 2026 Elsevier B.V.},

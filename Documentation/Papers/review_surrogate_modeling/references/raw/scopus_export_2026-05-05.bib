@CONFERENCE{Liu2025339,
	author = {Liu, Shiqi and Ma, Jian and Zhao, Jinsong and Huang, Baocheng and Song, Dengwei and Jiang, Jinfu and Wang, Hualiang},
	title = {Model Selection and Optimization for Fault Diagnosis in Two-Stage Switching Power Supplies of HTOL Testing Systems},
	year = {2025},
	journal = {2025 7th International Conference on System Reliability and Safety Engineering, SRSE 2025},

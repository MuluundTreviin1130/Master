	author = {Zouloumis, Leonidas and Stergianakos, Georgios and Ploskas, Nikolaos and Panaras, Giorgos},
	title = {Dynamic simulation-based surrogate model for the dimensioning of building energy systems},
	year = {2021},
	journal = {Energies},

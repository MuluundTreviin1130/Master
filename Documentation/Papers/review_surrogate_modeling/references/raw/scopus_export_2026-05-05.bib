@ARTICLE{Tian2025,
	author = {Tian, Zhirui and Liu, Weican and Zhang, Jiahao and Sun, Wenpu and Wu, Chenye},
	title = {EDformer family: End-to-end multi-task load forecasting frameworks for day-ahead economic dispatch},
	year = {2025},
	journal = {Applied Energy},

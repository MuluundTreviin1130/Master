@ARTICLE{Ren2026,
	author = {Ren, Mifeng and Shi, Yujing and Sun, Fang and Zhang, Wenjie and Chen, Junghui},
	title = {Enhanced probabilistic forecasting of wind power using a distribution-free PDF evolution model},
	year = {2026},
	journal = {Renewable Energy},
	volume = {258},

@ARTICLE{Fu2025,
	author = {Fu, Xiaolong and Li, Chunjie and Chen, Yong and Li, Deyou and Yang, Jialiang and Wang, Hongjie},
	title = {Multi-objective optimization of guide-vane closure scheme with the consideration of pressure pulsations during the pump power trip of pump-turbines},

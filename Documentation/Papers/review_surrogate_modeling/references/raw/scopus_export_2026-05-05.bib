	title = {Towards sustainable and explainable dual-fuel diesel engine modeling:a SHAP-Based evaluation of Ammonia, Biogas, and hydrogen combustion dynamics},
	year = {2026},
	journal = {Energy Conversion and Management},
	volume = {351},

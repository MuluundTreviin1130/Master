@CONFERENCE{Balafas2022,
	author = {Balafas, Vasileios and Zouloumis, Leonidas and Ploskas, Nikolaos and Panaras, Giorgos},
	title = {A Decision Support System for Monitoring and Control of Thermal Substations in District Heating Networks},

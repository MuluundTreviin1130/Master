@ARTICLE{Lin2025,
	author = {Lin, Mingzhi and Li, Wei and Huang, Dongmei and Trisovic, Natasa},
	title = {Reliability Evaluation and Optimization of System with Fractional-Order Damping and Negative Stiffness Device},
	year = {2025},

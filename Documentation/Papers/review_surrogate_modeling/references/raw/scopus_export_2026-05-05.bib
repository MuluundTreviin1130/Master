@ARTICLE{Li2025,
	author = {Li, Manfeng and Wang, Mengmeng and Shi, Ping and Zhou, Guofeng and Lu, Yiji},
	title = {Techno-economic-environmental assessment and optimization of multi-energy complementary systems under dynamic building loads},
	year = {2025},

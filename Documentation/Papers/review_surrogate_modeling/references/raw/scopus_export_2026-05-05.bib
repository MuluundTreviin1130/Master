}

@CONFERENCE{Khan2025,
	author = {Khan, Hafiz Muhammad Soban and Pashiourtides, Kostas and Marnerides, Angelos K.},
	title = {Adaptive Fuzzing Framework for Embedded Systems Vulnerability Detection Using Reinforcement and Deep Learning},
	year = {2025},
	journal = {2025 IEEE Conference on Dependable and Secure Computing, DSC 2025},
	pages = {},
	doi = {10.1109/DSC65356.2025.11260865},
	url = {https://www.scopus.com/pages/publications/105030163599?origin=resultslist},
	abstract = {Embedded systems serve as the backbone of critical national infrastructures (CNI), controlling industrial automation, transportation networks, medical devices, and energy systems. Despite their central role, these systems remain vulnerable due to constrained hardware, proprietary firmware, and limited support for scalable security analysis. While techniques such as static analysis, symbolic execution, and manual code review have been applied to embedded vulnerability detection, they often fail to uncover zero-day bugs or adapt to complex, state-dependent execution patterns. Fuzz testing, which systematically generates and executes large volumes of test inputs, has emerged as a promising dynamic analysis method for this domain. In this work, we propose an Adaptive Fuzzing Framework that integrates Reinforcement Learning (RL) and Deep Learning (DL) with the AFL++ fuzzing engine to intelligently guide mutation scheduling and seed selection. Our design introduces a PPO-based mutation scheduler and a DL-based seed optimizer that leverage execution feedback to prioritize high-impact inputs and dynamically adapt mutation strategies. Additionally, we incorporate lightweight QEMU-based hardware emulation to enable scalable fuzzing of embedded targets without full-system virtualization. Through our evaluation on the LAVA-M benchmark and Zephyr RTOS components (UART and Modbus), we demonstrate that our framework improves code coverage by over 20 %, reduces time-to-exploit by 34 %, and uncovers memory corruption and logic bugs in resource-constrained environments. These results highlight the effectiveness of AI-enhanced fuzzing for automated, scalable vulnerability detection in embedded systems.  © 2025 IEEE.},
	keywords = {Biomedical equipment; Codes (symbols); Dynamic analysis; Firmware; Hardware security; Network security; Static analysis; Device system; Embedded-system; Energy systems; Industrial automation; Medical Devices; National infrastructure; Scalable securities; System vulnerability; Transportation network; Vulnerability detection; Embedded systems},

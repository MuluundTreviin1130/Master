	doi = {10.1109/EI268505.2025.11425500},
	url = {https://www.scopus.com/pages/publications/105035785327?origin=resultslist},
	abstract = {This study empirically examines the impact of artificial intelligence (AI) on investment efficiency using a combined framework of random forest and panel regression models, focusing on Chinese A-share listed electric power enterprises. By systematically analyzing heterogeneous effects across different levels of research report attention, analyst attention, and enterprise scales, the research reveals that AI adoption significantly enhances investment efficiency, with pronounced effects observed in firms characterized by higher external scrutiny (i.e., greater research report and analyst attention) and smaller scales. The underlying mechanism suggests that increased research report and analyst coverage intensifies external regulatory pressure, which in turn strengthens the facilitative role of AI in improving investment efficiency. For small-scale enterprises, the relative agility in AI implementation allows for more direct and impactful integration of AI-driven decision-making into investment processes, leading to more pronounced efficiency gains. Methodologically, the study employs random forest modeling for control variable selection, a technique that effectively mitigates model specification errors and enhances analytical precision. These findings contribute to both theoretical understandings of AI's organizational impact and practical insights for optimizing AI-driven investment strategies in the electric power sector. © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Electric Power Enterprises; Investment Efficiency; Random Forest Model},

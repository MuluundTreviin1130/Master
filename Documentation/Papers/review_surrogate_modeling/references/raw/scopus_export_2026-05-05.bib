@CONFERENCE{Chen2025638,
	author = {Chen, Yantao and Liu, Lin and Yang, Siyu},
	title = {AI and the Investment Efficiency of Electric Power Enterprises: Based on Random Forest and Panel Regression Models},
	year = {2025},
	journal = {2025 IEEE 9th Conference on Energy Internet and Energy System Integration, EI2 2025},

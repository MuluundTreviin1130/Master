@ARTICLE{Jia20251854,
	author = {Jia, Yixiong and Wu, Xian and Yang, Zhifang and Wang, Yi},
	title = {A Two-Stage Approach for Topology Change-Aware Data-Driven OPF},
	year = {2025},
	journal = {IEEE Transactions on Power Systems},
	volume = {40},

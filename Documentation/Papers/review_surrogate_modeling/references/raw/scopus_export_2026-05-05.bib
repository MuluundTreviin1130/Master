@ARTICLE{Wang2023,
	author = {Wang, Yanwen and Sun, Yanying and Dan, Yangqing and Li, Yalong and Cao, Jiyuan and Han, Xueqian},
	title = {Online load-loss risk assessment based on stacking ensemble learning for power systems},
	year = {2023},
	journal = {Frontiers in Energy Research},

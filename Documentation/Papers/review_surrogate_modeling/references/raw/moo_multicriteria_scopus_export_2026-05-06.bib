@article{liu_multi-objective_2025,
	title = {Multi-objective nutcracker optimization algorithm based on fast non-dominated sorting and elite strategy for grid-connected hybrid microgrid system scheduling},
	volume = {242},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216193866&doi=10.1016%2fj.renene.2025.122455&partnerID=40&md5=1b53d2e6ae1e461d5f9e2a22dd6b48cf},
	doi = {10.1016/j.renene.2025.122455},
	abstract = {The increasing demand for clean and sustainable energy has driven the development of hybrid microgrid systems that integrate multiple energy sources, offering a promising solution to mitigate climate change and environmental degradation. This paper presents an innovative approach to optimizing hybrid microgrid systems with flexible renewable energy configurations, tailored to address seasonal variations. A multi-objective optimization model is proposed to efficiently schedule the hybrid systems, minimizing operational costs while maximizing environmental benefits. To solve this complex optimization problem, we propose a novel multi-objective non-dominated sorting nutcracker optimization algorithm ({NSNOA}). In {NSNOA}, the fast non-dominated sorting method is used to rank the population to speed up its convergence and the crowding distance is utilized to preserve the population's diversity. In addition, an elite strategy is employed to assist individuals in exploring better candidate solutions. The algorithm is validated through extensive testing on 12 benchmark functions, demonstrating superior accuracy and computational efficiency compared to existing optimization algorithms. Then, {NSNOA} is applied to optimize hybrid system scheduling, analyzing diverse scenarios and comparing results across multiple objectives. The experimental results indicate that the most optimal microgrid configuration based on {PV}/wind/turbine/diesel/battery achieves investment costs of 81,411.95 yuan in summer and 76,607.70 yuan in winter. The findings of this study support the viewpoint that the advancement and utilization of renewable energy can protect the environment and reduce operational costs. © 2025 Elsevier Ltd},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Liu, Y. and Tang, Y. and Hua, C.},
	date = {2025},
	keywords = {Multi-objectives optimization, Renewable energy source, Renewable energy sources, Multi-objective optimization, Microgrid, optimization, alternative energy, energy resource, Climate change, Optimization algorithms, Smart grid, algorithm, Microgrid systems, Grid-connected, Optimal scheduling, Non-dominated Sorting, Grid-connected hybrid microgrid, Grid-connected hybrid microgrids, Nutcracker optimization algorithm},
}

@article{liu_multi-objective_2023-6,
	title = {{MULTI}-{OBJECTIVE} {OPTIMIZATION} {SCHEDULING} {MODEL} {OF} {FLEXIBLE} {ENERGY} {CONSUMPTION} {LOAD} {IN} {SUMMER} {FOR} {DIFFERENT} {TYPES} {OF} {RURAL} {HOUSEHOLDS} {IN} {GUANZHONG} {PLAIN}},
	volume = {44},
	issn = {02540096},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85170640419&doi=10.19912%2fj.0254-0096.tynxb.2022-0491&partnerID=40&md5=b5287cfef164866004710e3158c0d6ed},
	doi = {10.19912/j.0254-0096.tynxb.2022-0491},
	abstract = {It is crucial to develop rural renewable energy and solve the supply and demand matching problem caused by random supply fluctuations. Within the scope of economic feasibility，the existing supply and demand matching has been basically played to the upper limit. Flexible energy load regulation is a revolutionary new method to solve the problem from the demand side. Based on the field survey data in Guanzhong countryside，this study analyzes the energy consumption characteristics of different types of households in summer，and establishes a multi- objective optimization scheduling model with the goal of economy and comfort under the premise of fully considering the flexible energy use load. The results show that：i）According to the characteristics of energy use，rural families in Guanzhong can be divided into Single Elderly Families（ Type I），Three Generations of Family（ Type {II}），Home Youth Families （Type {III}）and Working Youth Families（ Type {IV}）；ii）Under peak-valley electricity price，the second type of household has the greatest potential for load regulation，with a reduction in electricity cost up to 19.5 \% and an increase in discomfort index up to 46.3 \%；The fourth type of household load adjustment potential is minimum，and the reduction rate of electricity cost is only up to 12.3 \%，and the discomfort index increase rate is only up to 17.8\%；iii）For shiftable flexible loads，the first three types of households have relatively great adjustable potential；for interruptible flexible loads，the first type of household has the greatest adjustable potential；for curtailable flexible loads，the second type of household has the greatest adjustable potential. © 2023 Science Press. All rights reserved.},
	pages = {110--118},
	number = {8},
	journaltitle = {Taiyangneng Xuebao},
	publisher = {Science Press},
	author = {Liu, Y. and Yang, Y. and Luo, X.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Energy utilization, Demand side management, Demand-side management, energy use, Cost reduction, Electric utilities, Energy-consumption, Electricity costs, K-means clustering, Flexible loads, Scheduling models, Optimization scheduling, Load regulations, Flexible load, Family characteristic, Family characteristics, K-means++ clustering},
}

@inproceedings{liu_optimal_2024-2,
	title = {Optimal dispatch of park integrated energy systems considering the uncertainty of both source and load sides},
	isbn = {979-8-3503-5265-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202533625&doi=10.1109%2fICEPET61938.2024.10626432&partnerID=40&md5=7ba4785c802365160fd4a4ddb6124d29},
	doi = {10.1109/ICEPET61938.2024.10626432},
	abstract = {In the context of multi energy coupling and deepening penetration of high proportion of new energy, the integrated energy system of the park has the characteristics of multi energy complementarity and energy cascade utilization, becoming an important solution for low-carbon transformation of the energy industry. Load aggregators can fully mobilize the flexibility of the load side through resource aggregation. Considering the uncertainty of new energy output, load and participation in demand response of user, this paper proposes a multi-objective optimization method for park integrated energy systems that takes into account the uncertainty of both source and load sides. Firstly, establish a multi-objective optimization model for the energy supply and demand sides of park integrated system; Secondly, considering the uncertainty of both sources and loads, uncertainty modeling is carried out based on fuzzy chance constrained programming. The clear equivalence method of fuzzy expressions is used to transform it into a deterministic model and solved by gurobi; Finally, through case simulation and analysis, the proposed method was verified by scenario to fully utilize the elastic space between energy supply and demand in the system, reduce carbon emissions, and balance the conservatism and economy of scheduling plans. © 2024 {IEEE}.},

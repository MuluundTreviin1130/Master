@article{andervazh_emission-economic_2017,
	title = {Emission-economic dispatch of thermal power generation units in the presence of hybrid electric vehicles and correlated wind power plants},
	volume = {11},
	issn = {17518687},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85021931797&doi=10.1049%2fiet-gtd.2016.1508&partnerID=40&md5=3b194c77c9db25587b90afb1baa0e038},
	doi = {10.1049/iet-gtd.2016.1508},
	abstract = {With the integration of plug-in hybrid electric vehicles ({PHEVs}) and renewable energy resources into the power system, the environmental-economic dispatch of conventional power generation units takes new dimensions due to several ineluctable uncertain factors. This study presents a probabilistic optimisation framework for the emission, economic dispatch of thermal power generation units, considering the stochastic charging demand of {PHEVs}, intermittent wind power generation and uncertain load demand. To characterise the uncertainty in the output variables, the point estimate method and Nataf transformation are employed, considering the correlation between wind power plants. To find Pareto optimal solutions concerning minimisation of the emission and fuel cost, heuristic fitness sharing mechanisms and a meta-heuristic algorithm are proposed. Monte Carlo simulation together with state-of-the-art optimisation techniques ({NSGA}-{II} and {SPEA}-2) are employed in a quantitative performance appraisal to scrutinise the effectiveness of the proposed method in the uncertainty quantification and multi-objective optimisation. © The Institution of Engineering and Technology.},
	pages = {2232--2243},
	number = {9},
	journaltitle = {{IET} Gener. Transm. Distrib.},
	publisher = {Institution of Engineering and Technology},
	author = {Andervazh, M.-R. and Javadi, S.},
	date = {2017},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric load dispatching, Wind power, optimization, Monte Carlo methods, Stochastic systems, uncertainty analysis, Electric power generation, Scheduling, Pareto principle, Energy resources, Pareto optimal solutions, Hybrid vehicles, Heuristic algorithms, Electric power plants, Electric power system economics, Environmental economics, Meta heuristic algorithm, Optimisation techniques, Plug-in hybrid electric vehicles, Plug-in hybrid vehicles, Point estimate method, Thermal power generation, Uncertainty quantifications},
}

@article{andervazh_active_2020,
	title = {Active distribution network operation management with large penetration of hybrid electric vehicles and sustainable distributed energy generation},
	volume = {62},
	issn = {2210-6707},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087855207&doi=10.1016%2fj.scs.2020.102313&partnerID=40&md5=80c48a8e46b7b5e010c44de442ada02a},
	doi = {10.1016/j.scs.2020.102313},
	abstract = {The unprecedented growth of technological advances, industrialization and sophisticated urbanization have contributed to a staggering proliferation of plug-in hybrid electric vehicles ({PHEVs}) and renewable energy sources ({RESs}) in transportation and electric power distribution systems. As a result, the nature of optimal distribution network operation is ever-changing due to the dramatic uncertainty in the increased energy supply and demand caused by large integration of these emerging technologies into the systems. This study proposes a synergistic approach for boosting power system operation performance in sustainable distribution networks considering renewable power generation and high integration of {PHEVs}, using multi-objective stochastic optimization and probabilistic analysis techniques. To this end, distribution network reconfiguration and evolutionary optimization schemes are deployed, and a probabilistic multi-criteria decision making ({MCDM}) system based on point estimate method is developed, considering stochastic correlation between distributed energy generation sources. The results obtained along with the performance appraisal observations, indicate the effectiveness of the proposed method in sustainable active distribution network operation management in their entirety. © 2020 Elsevier Ltd},
	journaltitle = {Sustainable Cities Soc.},
	publisher = {Elsevier Ltd},
	author = {Andervazh, M.-R. and Javadi, S. and Aliabadi, M. H.},

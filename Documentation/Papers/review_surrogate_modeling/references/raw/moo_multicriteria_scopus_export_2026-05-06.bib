	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: S. Yang; China Electric Power Research Institute, Nanjing, 210003, China; email: yangshengchun@epri.sgcc.com.cn},
}

@article{wang_performance_2024,
	title = {Performance analysis and optimization of a zero-emission solar-driven hydrogen production system based on solar power tower plant and protonic ceramic electrolysis cells},
	volume = {83},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201518781&doi=10.1016%2fj.ijhydene.2024.08.174&partnerID=40&md5=857225e4e2e11e97414e8baf3862108d},
	doi = {10.1016/j.ijhydene.2024.08.174},
	abstract = {The solar-driven high-temperature steam electrolysis is promising for efficient large-scale H2 production. In this study, a comprehensive component-to-system model and optimization framework is developed to investigate the performance of a zero-emission H2 production system based on solar power plant and protonic ceramic electrolysis cell. Compared to previous system studies, the detailed description of cell internal operating characteristics is realized by integrating multi-physics simulation and artificial neural network. After parametric analyses, it is found that the system energy/exergy efficiency and co-generation performance are complicated by each subsystem. And the optimal system performance (ηth = 50.63 \%, Z = 179.63 \$·h−1 and ηex = 33.03 \%, Z = 178.94 \$·h−1, with {LCOE} = 0.172 \$·{kWh}−1 and {ZH}2 = 6.497 \$·kg−1) is obtained considering cell operating features and system energy-exergy-economic factors through multi-objective optimizations. Besides, the tradeoff between system maximum H2 production capacity and cell internal thermal conditions is revealed. This study can facilitate the development of zero-emission green H2 production driven by renewable energy. © 2024 Hydrogen Energy Publications {LLC}},

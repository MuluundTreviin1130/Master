	date = {2017},
	keywords = {optimization, multiobjective programming, uncertainty analysis, renewable resource, Smart grid, Electric vehicle, photovoltaic system, Equipment, household energy, pump, {NSGA}2, Fixed battery capacity, Japan, Off-grid smart house},

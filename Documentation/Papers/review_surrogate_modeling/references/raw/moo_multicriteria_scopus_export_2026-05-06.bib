	volume = {46},
	issn = {10036520},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089716532&doi=10.13336%2fj.1003-6520.hve.20200430022&partnerID=40&md5=d79e08bff5c52ef4def6186e2c63bda1},

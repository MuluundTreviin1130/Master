	keywords = {Multiobjective optimization, Environmental impact, Microgrid, optimization, Greenhouse gases, Emission control, Global warming, Energy hub, Energy hubs, algorithm, Energy, Fuzzy sets, Peer to peer, Cost reduction, Environmental economics, Emission reduction, Multi energy, Environmental concerns, Environmental technology, Economic concerns, Multi-energy transactive microgrid, Peer-to-peer trading},
}


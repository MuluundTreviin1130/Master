	author = {Ding, Y. and Chen, H. and Wu, J. and Lou, Q. and Liao, J. and Li, B.},
	date = {2021},
	keywords = {Electric load dispatching, Multi-objective optimization, Energy efficiency, Energy utilization, Costs, {ECONOMICS}, integrated demand response, Epsilon-constraint method, Integrated energy systems, Integrated energy system, Electric network analysis, Natural gas networks, Energy utilization efficiency, Collaborative optimization, comprehensive energy efficiency, Coordinated optimization, Day-ahead dispatch, Fractional programming, Mathematical Programming, Overall energy efficiency},
}

@article{ding_study_2021,
	title = {Study on the capacity-operation collaborative optimization for multi-source complementary cogeneration system},
	volume = {250},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118490860&doi=10.1016%2fj.enconman.2021.114920&partnerID=40&md5=32349bbe7da652a538523ba8b6c50ce0},
	doi = {10.1016/j.enconman.2021.114920},
	abstract = {Combining renewable energy with fossil fuel-based energy systems is a promising way to develop renewable energy power generation and decrease {CO}2 emissions with lower capital investment. In this paper, a multi-source complementary cogeneration ({MCC}) system is investigated in which the wind farm and solar aided combined heat and power ({SA}-{CHP}) system are integrated at the power grid level. A bi-level capacity-operation collaborative optimization model for this {MCC} system has been established to simultaneously optimize main components capacities and system annual load dispatch. In the proposed model, the upper level is a multi-objective optimization searching for the optimal trade-off between economy and {CO}2 emissions. At the same time, the lower level aims to obtain the optimal load dispatch of the {MCC} system for the whole year to maximize the annual operating income. The linear model of the {SA}-{CHP} system is built to simplify the lower-level problem–solution process. The bi-level optimization model is handled with a nested approach that combines non-dominated Sorting Genetic algorithm-{II} and linear programming. The proposed bi-level model is applied in a study case to simultaneously optimize thermal energy storage capacity, solar field size, wind farm capacity, as well as annual power and heat load dispatch of an {MCC} system located in Zhangbei, China. Besides, the influences of capacity parameters on the performances of the {MCC} system are analyzed. © 2021 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Ding, Z. and Hou, H. and Duan, L. and Francesco Frate, G. and Zhang, N. and Desideri, U.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Electric power transmission networks, Wind power, Genetic algorithms, Multi-objective optimization, Economic and social effects, Linear programming, Optimisations, Carbon dioxide, Heat storage, Investments, Smart power grids, Cogeneration plants, Fossil fuels, Electric utilities, {CO} 2 emission, Electric power system economics, Cogeneration systems, Multi-Sources, Electric power plant loads, Load dispatch, Bi-level programming, Capacity-operation collaborative optimization, Multi-source complementary cogeneration, Sensitive analysis},
}

@inproceedings{ding_method_2020,
	title = {A Method for Microgrid Partitioning Based on Integration of Main Network and Microgrid},
	isbn = {978-1-7281-9164-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102080692&doi=10.1109%2fiSPEC50848.2020.9351022&partnerID=40&md5=5226f062e91541e872a9b2ba95baacb9},
	doi = {10.1109/iSPEC50848.2020.9351022},
	abstract = {According to the characteristics of a large number of distributed generations connected to regional power grid, a method for microgrid partitioning based on integration of main network and microgrid is proposed. Firstly, the initial range of microgrid is divided based on the principle of power balance in microgrid. Then, a multi-objective optimization model is established that aims at the minimum of switching operation and the minimum voltage deviation, considering the operation constraints of microgrid. The second-order cone relaxation technique is adopted to convert the original nonconvex nonlinear problem into a mixed integer second-order cone programming ({MISOCP}) problem, which can be solved easily. Finally, an example is analyzed to verify the effectiveness of the proposed model. © 2020 {IEEE}.},

	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Energy utilization, Electric power systems, Gas emissions, Greenhouse gases, uncertainty analysis, Carbon dioxide, Energy hubs, Operating costs, Integer programming, Cost benefit analysis, Solar energy, Solar concentrators, Point estimate method, residential energy, Residential energy hub, Weighted Sum, Fuzzy, {EHP}, Electrical heat pumps, Point-estimate methods, responsive equipment, weighted sum technique},
}

@article{ranjith_kumar_multi-objective_2019,

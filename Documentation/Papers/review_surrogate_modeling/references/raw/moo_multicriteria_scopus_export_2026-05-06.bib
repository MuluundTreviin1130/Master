	volume = {42},
	issn = {10001026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85054421242&doi=10.7500%2fAEPS20180228003&partnerID=40&md5=2ed1f546273598cd6ed846a885bca729},

@inproceedings{liu_study_2024,
	title = {A Study on the Economic Optimal Control Strategy of {AC}-{DC} Hybrid Microgrid Based on Consistency Theory},
	isbn = {979-8-3315-0455-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000252215&doi=10.1109%2fNPSIF64134.2024.10883417&partnerID=40&md5=4ff55e19345ecf35001fdcc81f045c50},
	doi = {10.1109/NPSIF64134.2024.10883417},
	abstract = {In recent years, renewable energy has been developing rapidly, accompanied by the wide application of distributed generation. {AC}-{DC} hybrid microgrid, as a flexible and efficient energy system, is an important and key part of the construction of a new power system. This paper conducts an in-depth study on the economic optimization control strategy of {AC}-{DC} hybrid microgrid, aiming at improving the overall operation efficiency and economy performance of the new power system. Firstly, the control mathematical model of {AC}-{DC} hybrid microgrid is established, and the output characteristics and load characteristics of different power sources are considered. Secondly, this study proposes an active power control strategy based on equal incremental rate consistency algorithm and an economic scheduling control model considering frequency recovery for microgrid networks, thus realizing the construction of power regulation and control model of microgrid system. Through the improved artificial bee colony algorithm based on Gaussian variation and chaos perturbation, the economic optimization scheduling model is solved and run, and the effectiveness and feasibility of the control strategy is verified by simulation cases. The research results show its capability to significantly reduce the operating cost and improve the utilization rate of renewable energy on the premise of ensuring the stable operation of the system, and provide theoretical basis and technical support for the practical application of {AC}-{DC} hybrid microgrid. © 2024 {IEEE}.},
	pages = {640--646},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Liu, Z. and Zeng, Q. and Zeng, Z. and Liu, P.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multi-objective optimization, Renewable energy, Microgrid, Hybrid power, Renewable energies, Artificial bees, Bee colony algorithms, Economic optimization, optimization control, Artificial bee colony algorithm, {AC}-{DC} hybrid microgrid, Economic optimization control},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: Z. Liu; Guangdong Grid Corporation, Shaoguan Electric Power Supply Bureau, Shaoguan, China; email: lzycl0738@163.com},
}

@article{liu_capacity_2023,
	title = {Capacity Allocation Optimization on Grid Connected System Consisting of Wind Power, Photovoltaic Power, Pumped Storage and Battery},
	volume = {43},
	issn = {16747607},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173439822&doi=10.19805%2fj.cnki.jcspe.2023.09.007&partnerID=40&md5=f69cd3a1918621bc4779f8b7c34c6660},
	doi = {10.19805/j.cnki.jcspe.2023.09.007},
	abstract = {A joint operation system consisting of wind power, photovoltaic power, pumped storage, and battery was constructed, and a capacity allocation optimization method with the lowest cost and the lowest lifecycle carbon emission as optimization objectives was proposed. Based on the real data of the reference region, the optimal capacity allocation scheme of the proposed system was obtained with the fast non-dominated sorting genetic algorithm with elite strategy ({NSGA}-Ⅱ) and technique for order preference by similarity to ideal solution ({TOPSIS}). Results show that the studied joint operation system can not only ensure the power supply reliability, but also achieve the effective accommodation of wind and solar power with low costs and carbon emissions. The system has good economic and environmental protection performance, and the effectiveness of the proposed model and method is validated. © 2023 Shanghai Power Equipment Research Institute. All rights reserved.},

	keywords = {Multiobjective optimization, Electric load dispatching, Wind power, Electric power systems, Multi-objective optimization models, Linear programming, Weather forecasting, Errors, Single objective optimization, Wind power forecasting, Chance-constrained programming, Dependent chance programming, Dependent-chance programming, Equality constraints, Large-scale wind power, Occurrence probability, Power balance equations, Rolling dispatch},
}


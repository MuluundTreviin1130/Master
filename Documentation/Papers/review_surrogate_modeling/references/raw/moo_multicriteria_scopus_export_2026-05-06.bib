	keywords = {Multiobjective optimization, Renewable energy resources, Microgrid, Microgrids, Multi agent systems, Energy management, Renewable energies, Electric loads, Power, Optimization method, Electric power utilization, game theory, Flexible loads, Active energy, active energy management, Generalized user, generalized users, load satisfaction, Potential game, Potential games},
}


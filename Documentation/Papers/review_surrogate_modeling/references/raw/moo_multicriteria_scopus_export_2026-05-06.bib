	publisher = {State Power Economic Research Institute},
	author = {Chen, Y. and Zhang, D. and Li, Y. and Wang, Y.},
	date = {2023},
	keywords = {Multi-objective optimization, bus load forecasting, multiple-objective slime mould algorithm ({MOSMA}), support vector machine ({SVM})},
}


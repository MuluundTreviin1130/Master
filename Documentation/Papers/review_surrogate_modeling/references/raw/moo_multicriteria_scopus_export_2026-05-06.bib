	author = {Vaithiyanathan, V. and Mani, V. and Govindasamy, S. and Selvaraj, J.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Design, Digital storage, Loss-of-load probabilities, Multi-energy systems, Optimization techniques, Time series, Optimization operation, Reduction techniques, Time series aggregation, {DL}, Loss of load probability reduction and optimization technique and operation planning, {LSLP} reduction and optimization techniques and operation planning, Operation planning},
}

@inproceedings{vanio_network_2023,
	title = {Network Reconfiguration and Distributed Generators Allocation and Sizing Using Multi-Objective Optimization Algorithms},
	isbn = {979-8-3503-1289-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179625847&doi=10.1109%2fSEPOC58810.2023.10322616&partnerID=40&md5=bc05c57ef0c075a4bf66f63d1fcc8b15},
	doi = {10.1109/SEPOC58810.2023.10322616},
	abstract = {The increment of losses can increase the operating costs and degrade the quality of power network distribution. The integration of renewable energy sources based on Distributed Generators ({DGs}) is one of the tools that can be used to operate distribution networks efficiently and have several technical benefits in distribution systems. However, these benefits require their installation in the proper locations with suitable sizes. Another approach that can be used to ensure efficient network operation is the network reconfiguration. The network reconfiguration is regarded as an operational approach for minimizing power losses. Thus, in this paper, two multi-objective optimization methods are used to reconfigure the distribution system and simultaneously allocate and size {DGs} to reduce power losses and investment costs, while respecting the operational constraints of the system. In this study, the adopted optimization methods were the Non-Dominated Sorting Genetic Algorithm {II} and Strength Pareto Evolutionary Algorithm 2. The {IEEE} 33-bus and 69-bus test networks were used to evaluate the proposed methodology.  © 2023 {IEEE}.},

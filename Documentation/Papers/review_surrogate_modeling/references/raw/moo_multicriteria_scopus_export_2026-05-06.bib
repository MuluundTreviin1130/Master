}

@article{doagou-mojarrad_probabilistic_2021,
	title = {Probabilistic integrated framework for {AC}/{DC} transmission congestion management considering system expansion, demand response, and renewable energy sources and load uncertainties},
	volume = {31},
	issn = {20507038},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85117336691&doi=10.1002%2f2050-7038.13168&partnerID=40&md5=0ee0247827acf39b5ce9c7b78c2228bb},
	doi = {10.1002/2050-7038.13168},
	abstract = {Congestion management ({CM}) is one of the most crucial tasks in power system operation and planning, which has become more challenging in recent years due to the growth of renewable energy sources ({RESs}) and flexible loads. This paper presents an integrated framework that simultaneously employs different methods, including re-scheduling, transmission expansion, and demand response programs ({DRPs}), to manage the {AC}/{DC} transmission congestion. The uncertainty associated with remote wind/solar farms and load demand is taken into account and is modelled using the probabilistic point estimate method. To provide a comprehensive analysis, three different management approaches taking both planning and operation phases into account are considered in this study. In the context of {CM}, the first management approach considered is to minimize the overall system cost including both investment and operational costs (cost-efficient approach). The second approach is to minimize the overall active power losses (energy-efficient approach). The last one is to make a trade-off between these two approaches (cost-/energy-efficient approach) by simultaneously minimizing system investment cost and operational loss as a multi-objective optimization problem. The effectiveness of the proposed framework is evaluated on {IEEE} two-area {RTS}-96 ({MRTS}) network using an {AC}/{DC} power flow tool. © 2021 John Wiley \& Sons Ltd.},
	number = {12},
	journaltitle = {Int. Trans. Elecr. Energy Sys.},
	publisher = {John Wiley and Sons Ltd},
	author = {Doagou-Mojarrad, H. and Rezaie, H. and Razmi, H.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power transmission, Natural resources, Decision making, Economic and social effects, Energy efficiency, uncertainty analysis, Costs, Investments, Congestions managements, Electric load flow, Demand response, {AC}/{DC} transmission system, {DC} transmission systems, Energy efficient, Expansion planning, Integrated frameworks, Probabilistics, Transmission congestion management},
}

@inproceedings{domyshev_microgrids_2015,
	title = {Microgrids multi-agent control based on power distribution and communication constraints},
	isbn = {19341768},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205461260&doi=10.23919%2fCCC63176.2024.10661762&partnerID=40&md5=9921b8c61adc29caae39f562597e4da0},
	doi = {10.23919/CCC63176.2024.10661762},
	abstract = {The multi-agent control system of a multi-energy microgrid systems is considered. A method of optimal multi-agent control is proposed, which includes solving the problem of routing information flows between the control agents. To determine the required amount of information for each agent, the concept of agent awareness is introduced, which includes observability and consistency of the agent's objective function with the general objective function of the system. © 2024 Technical Committee on Control Theory, Chinese Association of Automation.},

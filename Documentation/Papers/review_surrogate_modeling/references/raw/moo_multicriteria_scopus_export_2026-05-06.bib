}

@article{chen_framework_2019,
	title = {Framework of Integrated Charging Station for Renewable Energy Vehicle and Energy Optimal Dispatching Method},
	volume = {43},
	issn = {10001026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077645792&doi=10.7500%2fAEPS20181110001&partnerID=40&md5=ea617009c76e94b3541700eb00eb1f12},
	doi = {10.7500/AEPS20181110001},
	abstract = {The development of renewable energy vehicle can effectively improve environmental pollution. Aimed to provide safer and more efficient charging services, a multi-objective energy optimal dispatching method is proposed. Firstly, the concept of integrated charging station for renewable energy vehicle is defined, and the model of integrated charging station with solar-wind-hydrogen-storage energy and renewable energy vehicle is established and analyzed in structure and operation strategy. Then, an optimal dispatching model is built for the renewable energy vehicle charging station including wind power generation system, photovoltaic power generation system, fast charging devices of electric vehicle, hydrogen production storage and charging devices. Considering the charging demand of electric vehicle and hydrogen fuel cell vehicle, the multi-objective optimization problem is solved by using {NSGA}-Ⅱ algorithm, whose objective functions are the integrated operation cost and the battery cycle capacity. The optimal dispatching scheme of each component of the charging station is given. Finally, the optimization results are analyzed and compared with conventional dispatching schemes, which shows that the optimal dispatching scheme has obvious advantages. © 2019 Automation of Electric Power Systems Press.},

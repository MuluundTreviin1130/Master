	publisher = {Elsevier Ltd},
	author = {Simeoni, P. and Nardin, G. and Ciotti, G.},
	date = {2018},
	keywords = {Multiobjective optimization, Renewable energy resources, Economic and social effects, Environmental management, Environmental performance, Design, optimization, Sustainable development, Distributed power generation, distributed generation, Carbon dioxide, Optimal design, alternative energy, Energy conservation, Emission control, energy resource, Global warming, Heat storage, optimal operation, Smart grid, energy storage, Energy planning, Sustainability, Multi-energy systems, Combined heat and power, Artificial intelligence, trade-off, Competition, Italy, thermal power, Decision support systems, industrial technology, Evolutionary multi-objective optimization, Evolutionary multiobjective optimization, decision support system, Smart multi energy system, Planning and design, spatial distribution, Pareto, Food industry, competitiveness, incentive, Industrial districts, Smart multi energy systems},
}

@article{singh_multi-objective_2018,
	title = {Multi-Objective Optimization of Hybrid Renewable Energy System Using Reformed Electric System Cascade Analysis for Islanding and Grid Connected Modes of Operation},
	volume = {6},
	issn = {21693536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052631536&doi=10.1109%2fACCESS.2018.2867276&partnerID=40&md5=02ed6a1d3ac5bf2997b17a94652f47c4},
	doi = {10.1109/ACCESS.2018.2867276},
	abstract = {This paper presents a new methodology of reformed electric system cascade analysis ({RESCA}) for the optimization of hybrid renewable energy system ({HRES}) with wind energy conversion system, {PV} system, battery energy storage system, non-intermittent source, and grid as system components. Four different configurations of {HRES} in islanding and grid-connected mode is considered for analysis. The four configurations of {HRES} is optimized using {RESCA} with constraints, such as final excess energy, renewable energy fraction, energy generation ratio, loss of power supply probability, and annual system cost ({ASC}). The optimization is realized for a residential load in Newark, {USA} consisting of 100 households with a daily consumption of 30 {kWh} for each house. The paper successfully presents the application of the {RESCA} methodology for the optimization of {HRES} based on reliability and economic constraints for both isolated and grid connected mode of applications. © 2013 {IEEE}.},

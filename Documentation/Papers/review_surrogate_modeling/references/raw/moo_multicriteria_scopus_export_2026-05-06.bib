	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 14; Correspondence Address: P. Murray; {ETH} Zürich, Department of Building Physics, Zürich, Stefano-Francini-Platz 5, {CH}-8093, Switzerland; email: murrayp@ethz.ch},

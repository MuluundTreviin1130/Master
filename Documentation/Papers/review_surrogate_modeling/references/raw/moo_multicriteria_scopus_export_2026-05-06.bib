	doi = {10.1007/978-981-99-1439-5_114},
	abstract = {The significant uncertainty brought by renewable energy has brought challenges to the grid dispatch operation. To solve this problem, a real-time dispatch model of power grid considering multi-objective optimization is designed to maximize renewable energy consumption and minimize operation costs on the basis of ensuring the secure operation of the grid. Taking the adjustment of the active power output of the unit as the action space, the deep deterministic policy gradient ({DDPG}) algorithm is introduced to interact with the environment to learn and improve the dispatch policy. First, in view of the unstable training problem of {DDPG} algorithm, this paper proposes a rule-guided {DDPG} algorithm, and then a dual-value network is added in the training process to improve the stability of the algorithm. Finally, the effectiveness of the proposed method is verified by a case study. © 2023, State Grid Electric Power.},
	pages = {1241--1252},

	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power distribution, Evolutionary algorithms, Natural resources, Renewable energy sources, Micro grid, Multi-objective optimization problem, optimization, Optimization problems, Wind, Differential evolution algorithm, Differential evolution algorithms, Electric vehicles, Charging (batteries), Electric vehicle charging, Algorithms, Electric Vehicles ({EVs}), Autonomous microgrid, Electric losses, System stability, Crashworthiness, Problem solving, Load characteristics, Electric vehicle charging stations},
}

@article{moradi_multi-objective_2014,
	title = {Multi-objective {PFDE} algorithm for solving the optimal siting and sizing problem of multiple {DG} sources},
	volume = {56},
	issn = {01420615},

	keywords = {Multiobjective optimization, Renewable energy resources, Environmental impact, Pollution, Distributed power generation, Hybrid energy system, Costs, energy storage, Cost benefit analysis, {MATLAB}, renewable power, power dispatch, Industrial electronics, pollutant emission, environmental/economic dispatch},

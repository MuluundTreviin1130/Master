@article{al-hawary_multiobjective_2023,
	title = {Multiobjective optimization of a hybrid electricity generation system based on waste energy of internal combustion engine and solar system for sustainable environment},
	volume = {336},
	issn = {00456535},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164210753&doi=10.1016%2fj.chemosphere.2023.139269&partnerID=40&md5=b2b62e2fc8ac0674dc450c3ed5219b0f},
	doi = {10.1016/j.chemosphere.2023.139269},
	abstract = {In recent years, the interest in generating power through hybrid power generation systems has increased. In this study, a hybrid power generation system including an internal combustion engine ({ICE}) and a solar system based on flat plate collectors to generate electricity is investigated. To benefit from the thermal energy absorbed by solar collectors, an organic Rankine cycle ({ORC}) is considered. In addition to the solar energy absorbed by the collectors, the heat source of the {ORC} is the wasted heat through exhaust gases and the cooling system of the {ICE}. A two-pressure configuration for {ORC} is proposed for optimal heat absorption from the three available heat sources. The proposed system is installed to produce power with a capacity of 10 {kW}. A bi-objective function optimization process is carried out to design this system. The objective of the optimization process is to minimize the total cost rate and maximize the exergy efficiency of the system. The design variables of the present problem include the {ICE} rated power, the number of solar flat plate collectors ({SFPC}), the pressure of the high-pressure ({HP}) and low-pressure ({LP}) stage of the {ORC}, the degree of superheating of the {HP} and {LP} stage of the {ORC}, and its condenser pressure. Finally, it is observed among the design variables the most impact on total cost and exergy efficiency is related to the {ICE} rated power and the number of {SFPCs}. © 2023 Elsevier Ltd},
	journaltitle = {Chemosphere},
	publisher = {Elsevier Ltd},
	author = {Al-Hawary, S.I.S. and Ricardo Nuñez Alvarez, J. and Ali, A. and Kumar Tripathi, A. and Rahardja, U. and Al-Kharsan, I. H. and Romero-Parra, R. M. and Abdulameer Marhoon, H. and John, V. and Hussian, W.},
	date = {2023},
	keywords = {Hybrid power generation, Multi-objectives optimization, Multiobjective optimization, Renewable energy, Decision making, genetic algorithm, optimization, Power generation, electricity generation, Power, Exergy, Article, Electricity, Solar energy, Simulation, Organic Rankine Cycle, exhaust gas, Rankine cycle, absorption, astronomy, Combustion, controlled study, Cooling, enthalpy, Exergoeconomic analysis, Exhaust gases, Flat-plate collector, Heat, heat exchange, heat source, Heat transfer, high temperature, Hot Temperature, Hybrid power generation systems, Ice, Internal combustion engine, Internal combustion engines, Organics, pressure, Solar collectors, Solar flat plate, Solar flat plate collector, Solar system, Sunlight, thermodynamics, Waste incineration},

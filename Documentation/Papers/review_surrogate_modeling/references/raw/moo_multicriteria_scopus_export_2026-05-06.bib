}

@article{guo_optimal_2022,
	title = {Optimal design of a communication network for a distributed consensus algorithm},
	volume = {50},
	issn = {16743415},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147191568&doi=10.19783%2fj.cnki.pspc.221155&partnerID=40&md5=081beb7990e12ce9f0819b3e17a65e77},
	doi = {10.19783/j.cnki.pspc.221155},
	abstract = {Communication networks are the infrastructure for distributed control. For a distributed consensus algorithm and future smart microgrid application requirements, a communication network optimization design method that takes into account dynamics, delay robustness, and economy is proposed. First, the relation between the communication network and the corresponding matrix is established by algebraic graph theory. Then, three performance indices related to the communication network are defined by different matrices, and the relationship between the maximum communication delay time ι and the Laplacian matrix L eigenvalues is deduced using the Nyquist stability criterion. Finally, using an algebraic connectivity related theorem, an edge decrement cycle network optimization process is proposed. A multi-objective optimization model including three indices is established in each cycle, and a solution is achieved using the {NSGA}-{II} algorithm for the number of edges. The process is repeated until the network is disconnected, and the final optimization network is selected from all the satisfactory solutions according to the network dynamics and delay robustness. Simulation examples verify the feasibility and effectiveness of the proposed optimization method. © 2022 Power System Protection and Control Press. All rights reserved.},
	pages = {151--160},
	number = {23},
	journaltitle = {Dianli Xitong Baohu yu Kongzhi},
	publisher = {Power System Protection and Control Press},
	author = {Guo, W. and Fan, W. and Yang, S. and An, J. and He, C. and Wang, T. and Jing, T.},
	date = {2022},
	keywords = {Multiobjective optimization, optimization, Optimisations, Stability criteria, Graph theory, Distributed parameter control systems, Matrix algebra, communication, Eigenvalues and eigenfunctions, Electric power system protection, Robustness (control systems), Network optimization, algebraic connectivity, Communications networks, Consensus algorithms, delay, Delay robustness, distributed, Distributed consensus, Laplace transforms, Laplacian matrices, Laplacian matrix},
}

@article{guo_multi-objective_2022-2,
	title = {Multi-objective optimization model of micro-grid access to 5G base station under the background of China’s carbon peak shaving and carbon neutrality targets},
	volume = {10},
	issn = {2296598X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142681485&doi=10.3389%2ffenrg.2022.1032993&partnerID=40&md5=d7e9dd05ce52838a941f18c3126d95e2},
	doi = {10.3389/fenrg.2022.1032993},
	abstract = {Abstract: a large number of 5G base station are connected, which provides a new possibility for the future low-carbon development of power systems. By encouraging 5G base station to participate in demand response and incorporating it into the Microgrid, it can reduce the power consumption cost of 5G base stations and promote the efficient utilization of renewable energy. Based on the microgrid operation structure, 5G base station and multi-objective problem algorithm, a multi-objective optimization operation model of microgrid access to 5G base station is built. Considering the physical constraints of Microgrid, the objective is to minimize the operating cost and carbon emission. Through the joint dispatching of distributed clean energy generation, micro gas turbine, energy storage system and 5G base station in Microgrid, the comprehensive optimization of system economy and low-carbon benefits can be achieved. In this paper, a microgrid in Beijing is taken as the research object, and the Whale Optimization Algorithm algorithm is used to solve the multiobjective problem. The analysis results show that 5G base station can flexibly respond to microgrid scheduling, which helps microgrid to improve the consumption and utilization efficiency of renewable energy, thus bringing higher economic benefits and low-carbon benefits, and helping China to achieve the goal of carbon peak shaving and carbon neutrality at an early date. Copyright © 2022 Guo, Mao, Chen and Zhang.},
	journaltitle = {Front. Energy Res.},
	publisher = {Frontiers Media S.A},
	author = {Guo, W. and Mao, Y. and Chen, Y. and Zhang, X.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Economic and social effects, Energy efficiency, Microgrid, Carbon, Renewable energies, Optimization algorithms, Carbon neutralities, {ECONOMICS}, 5G mobile communication systems, Base stations, Multi objective optimization, Peak-shaving, 5g base station, carbon peak shaving and carbon neutrality, Carbon peaks, whale optimization algorithm},
}

@article{guo_power_2021,
	title = {Power Transaction Method of Microgrid Group Based on Blockchain},
	volume = {47},
	issn = {10036520},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85120908995&doi=10.13336%2fj.1003-6520.hve.20210373&partnerID=40&md5=1b29f9993fecd3b7ca5e400c8e8948e1},
	doi = {10.13336/j.1003-6520.hve.20210373},
	abstract = {Aimed at the problems of low security, low transaction efficiency and unbalanced economic benefits in the current microgrid ({MG}) group transaction model, an {MG} group power transaction model based on blockchain is constructed. In the data layer, the asymmetric encryption algorithm {SM}2 and hash algorithm {SM}3 independently developed by the state are used to authenticate the participants of the transaction, and the roles of the buyer and the seller are determined by the net load value. In the consensus layer, the delegated proof of stake ({DPOS}) consensus mechanism based on credit value is used to prevent the transaction participants from cheating and malicious attacks. In the incentive layer, the price adjustment and contract matching mechanism based on credit value incentive are designed to encourage all participants to actively participate in the transaction and improve the transaction efficiency. In the contract layer, the multi-objective optimization based on particle swarm optimization is integrated into the intelligent contract to select the optimal power purchase scheme of {MG} swarm optimization to maximize the interests of both parties. Based on Python simulation environment, the proposed method is verified by experiments, the experimental results show that the incentive mechanism and consensus mechanism of the proposed method are effective, and the longest consensus time is only 1.11 ms. Although the proposed method increases part of the transaction delay, it achieves higher security and economic benefits. © 2021, High Voltage Engineering Editorial Department of {CEPRI}. All right reserved.},
	pages = {3810--3818},
	number = {11},
	journaltitle = {Gaodianya Jishu},
	publisher = {Science Press},
	author = {Guo, W. and Yang, P. and Zhang, K. and Wang, C. and Zhang, W.},
	date = {2021},
	keywords = {Multiobjective optimization, Particle swarm optimization ({PSO}), Economic and social effects, Microgrid, Network security, Efficiency, Particle swarm optimization, Block-chain, Economic benefits, Computer software, Microgrid group, Authentication, Blockchain, Credit value, Credit value incentive mechanism, Delegated proof of stake, Hash functions, Identity authentication, Incentive mechanism, Power transaction, Power transactions},
}


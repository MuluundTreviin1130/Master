@inproceedings{huo_two-step_2020,
	title = {A two-step multi-objective optimization frame-work for microgrid scheduling problem based on cloud-edge computing},
	isbn = {978-1-7281-9606-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101639091&doi=10.1109%2fEI250167.2020.9347092&partnerID=40&md5=358bbdca29a010794b9c252f3d2d31e3},
	doi = {10.1109/EI250167.2020.9347092},
	abstract = {The application of smart metering terminals ({SMTs}) can collect online data of electricity customers, which would help microgrid system to obtain more accurate information of electricity load demand by edge-computing. Hence reasonable dispatch schemes can be made. In this paper, a two-step multi-objective optimization framework for microgrid scheduling problem is proposed based on cloud-edge computing. A typical microgrid structure with smart metering terminals ({SMTs}) is introduced and the cloud-edge computing framework is designed, in which the central energy management system ({CEMS}) is utilized to compute the day-ahead microgrid economical/environmental scheduling problem on the cloud side by forecast data, and the edge-computing servers are applied to re-compute the local optimum schemes on the edge-side during the operation process. Thereafter, the two-step multi-objective optimization strategy is proposed taking advantages of the global computing in cloud-side and the distributed computing in edge-side. The day-ahead global optimization model and the online local optimization model are employed to meet different goals by the two steps. Experimental results show that the proposed strategy is efficient in dealing with the microgrid scheduling problem to reduce cost and emission and can take account of the forecast data errors as well as the global optimum information. © 2020 {IEEE}.},
	pages = {2764--2768},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Huo, Z.-H. and Wang, P. and Zhang, S.-J. and Wang, D. and Kong, Z.},
	date = {2020},
	keywords = {Multiobjective optimization, Energy management systems, Microgrid, Microgrids, Scheduling, Micro-grid systems, Global optimization, Scheduling problem, Information management, Electric power measurement, Cloud-edge computing, Computing frameworks, Dispatch scheme, Edge computing, Electric measuring instruments, Electricity customers, Global computing, Local optimizations, Microgrid structures, Multi-objective optimization strategy, Operation process, Smart metering terminal},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 5},
}

@inproceedings{husain_comparative_2020,
	title = {A Comparative Analysis of Multi-objective Optimization Algorithms for Stand-Alone Hybrid Renewable Energy System},
	isbn = {978-1-7281-4167-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084529345&doi=10.1109%2fICIMIA48430.2020.9074903&partnerID=40&md5=9bbf94bce0d4e325f467ca26dcd0326c},
	doi = {10.1109/ICIMIA48430.2020.9074903},
	abstract = {Energy scarcity is one of the greatest challenges faced by the developing countries like India. Researches are now heading towards developing non-conventional energy sources that are both economical and available naturally in large quantities. In this regard, an urgent requirement has been posed to reduce our dependency on fossil fuels for generating sustainable energy. Standalone systems plays a crucial role in promoting rural electrification. Previous studies have focused single objective optimization or weighted sum approach for multi-objective optimization. We have introduced multi-objective optimization approach in this paper which provides a range of solutions for different objectives. The paper proposes a standalone system consisting of renewable energy sources, namely {PV} and wind combined with battery and diesel generator to fulfill the demand of housing loads in a village of Gujarat. Component sizing have been done by three multi-objective optimization algorithms namely {NSGA} {II}, {NSGA} {III} and {MOPSO} to minimize {LPSP}, {COE} and maximize {RF}. Also we have performed some studies to compare the results of multi-objective optimizations. © 2020 {IEEE}.},

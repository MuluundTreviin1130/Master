	isbn = {978-0-88986-952-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84883520711&doi=10.2316%2fP.2012.785-108&partnerID=40&md5=697f5208f679e9e96ad0c967d1987368},

	title = {Modeling and multi-objective optimization of {WEDM} of spark plasma sintered boron carbide considering preferences of users},
	volume = {377},
	isbn = {17578981},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050472727&doi=10.1088%2f1757-899X%2f377%2f1%2f012094&partnerID=40&md5=d8ac5b5f0b642fc19e900569dd7a2b07},

	keywords = {Multi-objectives optimization, Multi-objective optimization, Microgrid, Clean energy, distributed energy resources, Demand response, Distributed energy, Greenhouse gas emissions, Emission reduction, Low emission, Response model, time of use, Emission costs, emissions cost, Incentive based demand, time of use-based demand},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: M.A. Modibbo; Southeast University, School of Electrical Engineering, Nanjing, China; email: engrmustyboss@gmail.com},

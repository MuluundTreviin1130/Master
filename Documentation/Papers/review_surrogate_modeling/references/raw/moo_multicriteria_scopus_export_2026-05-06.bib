	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power distribution, Reinforcement learning, Reinforcement learnings, Investments, Learning systems, Reactive power, Investment costs, Planning, Optimization planning, Active distributions, Distribution networks planning, active distribution network planning, Computational performance, Solution space},
}


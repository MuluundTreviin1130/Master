	date = {2021},
	keywords = {Multiobjective optimization, Microgrids, Multi-objective optimization models, Emission control, Investments, Multi-energy systems, Optimization method, Investment costs, Emission reduction, Component configurations, Development directions, External environments},
}

@article{he_towards_2021,
	title = {Towards cleaner heating production in rural areas: Identifying optimal regional renewable systems with a case in Ningxia, China},
	volume = {75},
	issn = {2210-6707},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114214808&doi=10.1016%2fj.scs.2021.103288&partnerID=40&md5=2927f6a9cebbc1bfbd2e0bac1e8bd7f3},
	doi = {10.1016/j.scs.2021.103288},
	abstract = {Heating demand applied by fossil energy sources have inevitably caused tremendous carbon emissions. Renewable energy, in contrast, is more sustainable and desirable for heating but relevant decision-making process is yet in its infancy. This study thus promotes a decision framework for regional rural heating system driven by renewable energy sources ({RES}). A novel filter on six widely applied {RES} is introduced for smoother evaluation according to characteristic of the area in question, expertise and existing studies. The potentially feasible alternatives are then evaluated on a uniform criteria system identified from latest studies and empirical policy practices from economic, {RE} supply potential, environmental and social factors regardless of different types and combinations of {RES} for the first time. A novel integral weight method and an extended multi-objective optimization based on ratio analysis method are suggested by this paper and could contain arbitrary information during decision making process. The framework is then applied a real case study in Ningxia province, China. The result shows that based on local natural resources, a photovoltaic-wind-geothermal hybrid {RES} system performs the best. Further discussion justifies the framework and provide development and application recommendations for the {RES} technologies for regional and rural heating. © 2021},
	journaltitle = {Sustainable Cities Soc.},
	publisher = {Elsevier Ltd},
	author = {He, J. and Wu, Y. and Wu, J. and Li, S. and Liu, F. and Zhou, J. and Liao, M.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy source, Wind power, Decision making, Energy utilization, optimization, Sustainable development, alternative energy, Multi criteria decision-making, Multi-criteria decision making, Multicriteria decision-making, Sustainability, photovoltaic system, performance assessment, heating, rural area, multicriteria analysis, Multi-criterion decision-making, Geothermal energy, geothermal power, Regional energy systems, Rural areas, China, Decision-making process, G1 method, Green community, heat production, Ningxia Huizu, Regional energy system, Sustainable clean heating, Sustainable energy consumption},
}

@article{he_optimal_2019,
	title = {Optimal economic and emission dispatch of a microgrid with a combined heat and power system},
	volume = {12},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061977279&doi=10.3390%2fen12040604&partnerID=40&md5=4803e2dbc2368ab90ae98b50e6dd5ad9},
	doi = {10.3390/en12040604},
	abstract = {With the rapid development of the new concept of energy internet, electric power systems often need to be investigated together with thermal energy systems. Additionally, to reduce pollution from gas emissions, it is very important to study the economic and emission dispatch of integrated electrical and heating systems. Hence, this paper proposes a multi-objective optimization dispatch model for a microgrid ({MG}) with a combined heat and power ({CHP}) system. This {CHP}-based {MG} system consists of a {CHP} unit, a wind turbine, a {PV} system, a fuel cell, an electric boiler, an electric storage, and a heat storage. It can exchange electricity with the distribution network and exchange heat with the district heating network. Minimum economic cost and minimum environmental cost are considered as the two objectives for the operation of this {CHP}-based {MG} system. To solve the two objective optimization problem, the multi-objective bacterial colony chemotaxis algorithm is utilized to obtain the Pareto optimal solution set, and the optimal solution is chosen by the Technique for Order of Preference by Similarity to Ideal Solution method. Finally, numerical case studies demonstrate the effectiveness of proposed model and method for the optimal economic and emission dispatch of the {CHP}-based {MG} system. © 2019 by the authors.},
	number = {4},
	journaltitle = {Energies},
	publisher = {{MDPI} {AG}},
	author = {He, L. and Lu, Z. and Pan, L. and Zhao, H. and Li, X. and Zhang, J.},
	date = {2019},
	keywords = {Multiobjective optimization, Electric load dispatching, Multi-objective optimization, Electric power systems, Micro grid, Microgrid, Gas emissions, Optimal systems, Power generation, Fuel cells, Heat storage, Pareto principle, Numerical methods, Wind turbines, District heating, Heating equipment, Pareto optimal solutions, Combined heat and power system, Fuel storage, Energy internet, Two-objective optimization, District heating networks, Bacterial colony chemotaxis algorithm, Biochemistry, Economic and emission dispatch},
}

@article{he_comprehensive_2025,
	title = {A comprehensive thermo-enviro-economic assessments of a novel geothermal-based multigeneration process: Integrating power generation, hydrogen production, {CO}2 capture, and absorption cooling},
	volume = {380},

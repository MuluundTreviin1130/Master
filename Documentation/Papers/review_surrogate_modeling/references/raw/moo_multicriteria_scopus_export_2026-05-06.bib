@article{sedighizadeh_voltage_2017,
	title = {Voltage and frequency regulation in autonomous microgrids using Hybrid Big Bang-Big Crunch algorithm},
	volume = {52},
	issn = {15684946},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85008354412&doi=10.1016%2fj.asoc.2016.12.031&partnerID=40&md5=7f2dd2ef7eaeb2e16ef2f0e944acca10},
	doi = {10.1016/j.asoc.2016.12.031},
	abstract = {This paper proposes an optimal power control strategy for inverter-based Distributed Generation ({DG}) units in autonomous microgrids. It consists of power, voltage, and current controllers with Proportional-Integral ({PI}) regulators. The droop concept is used for the power control strategy. Static parameters in {PI} regulators may not ensure the most optimal solution due to inevitable changes happening in microgrid configuration and loads. In the proposed method, after occurring a load change in a standalone microgrid, parameters of the {PI} controller are dynamically adjusted to get the most optimal operating point that satisfies objective functions. The optimization problem is formulated as a multi-objective programming with objective functions of minimizing overshoot/undershoot, settling time, rise time, and Integral Time Absolute Error ({ITAE}) in the output voltage. These objective functions are combined using fuzzy memberships. The Hybrid Big Bang-Big Crunch algorithm ({HBB}-{BC}) is used to solve the optimization problem. The proposed methodology is simulated on a case study and according to obtained results, the suggested tuning of {PI} parameters leads to a better voltage response than previous methods. The case study is also solved using the Particle Swarm Optimization ({PSO}) and Big Bang-Big Crunch ({BB}-{BC}) algorithms and it is found that the {HBB}-{BC} gives a better solution than the {PSO} and {BB}-{BC}. © 2016 Elsevier B.V.},
	pages = {176--189},
	journaltitle = {Appl. Soft Comput. J.},
	publisher = {Elsevier Ltd},
	author = {Sedighizadeh, M. and Esmaili, M. and Eisapour-Moarref, A.},
	date = {2017},
	keywords = {Multiobjective optimization, Multi-objective optimization, Particle swarm optimization ({PSO}), optimization, multiobjective programming, Two term control systems, Voltage control, Controllers, Pulse width modulation, Distributed generation units, Power control, Frequency regulations, Optimal operating point, Integral time absolute errors, Voltage Sourced Inverter ({VSI}), Voltage sourced inverters, Big Crunch, Hybrid Big Bang-Big Crunch ({HBB}-{BC}) algorithm, Power control strategies, Pulse-Width Modulation ({PWM})},
}


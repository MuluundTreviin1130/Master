	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy, Life cycle, Microgrid, Hybrid power, Carbon, Hybrid energy system, Costs, Renewable energies, optimal operation, Integer programming, Optimal sizing, {MATLAB}, carbon emission, Carbon emissions, Advanced direct load control, Diesel engines, Diesel generator, Diesel generators, Direct load control, Electric load management},

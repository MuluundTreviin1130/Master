@inproceedings{du_multi-objective_2021,
	title = {Multi-Objective Optimal Dispatch of Integrated Electricity and Heat System},
	isbn = {978-1-6654-1439-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128104848&doi=10.1109%2fiSPEC53008.2021.9735779&partnerID=40&md5=3f69dca8ec1a45fc7feb1615ed651192},
	doi = {10.1109/iSPEC53008.2021.9735779},
	abstract = {With the increasing penetration of renewable energy, the dispatch of integrated electricity and heat system ({IEHS}) needs to fully consider the uncertain factors and a variety of optimization indicators. This paper proposes a bus-based multi-objective optimal dispatch model to realize the global optimal dispatch of {IEHS} considering the uncertainty of renewable energy. The proposed model is established according to the multi-objective optimization theory. Economic index and environmental index are the primary concerns in the multi-objective. The impact of uncertainty in the power supply of wind turbines and photovoltaics are analyzed by introducing chance constrained programming ({CCP}). We pay attention to comparing three optimization algorithms in terms of the optimal results and calculation speed. Three algorithms are analyzed in detail: (a) simplex method combined with branch-and-bound method ({SCBB}); (b) combination of {KKT} condition, the interior point method, and the {BFGS} method ({KIPB}); (c) particle swarm optimization ({PSO}). The results show that the proposed model is reasonable and the first algorithm obtains a more accurate result within the shortest time when it is applied to the proposed model. © 2021 {IEEE}.},

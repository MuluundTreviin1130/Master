	publisher = {State Power Economic Research Institute},
	author = {Tan, Q. and Ding, Y. and Li, Y. and Li, R.},
	date = {2020},
	keywords = {Multi-objective optimization, Economic-environmental equilibrium, Joint power dispatching, Wind-solar-thermal power system},
}

@article{tan_research_2022,
	title = {Research on Low-Carbon Optimization Strategy of Regional Power Supply Based on Large-Scale V2G},
	volume = {43},

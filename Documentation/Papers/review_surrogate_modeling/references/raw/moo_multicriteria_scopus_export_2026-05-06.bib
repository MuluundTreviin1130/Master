	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Ming, M. and Wang, R. and Zha, Y. and Zhang, T.},
	editor = {{Cao J.} and {Liu W.} and {Wang J.} and {Xie K.}},

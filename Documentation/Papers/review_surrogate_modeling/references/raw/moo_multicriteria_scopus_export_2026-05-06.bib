@article{nebel_role_2022,
	title = {The Role of Renewable Energies, Storage and Sector-Coupling Technologies in the German Energy Sector under Different {CO}2 Emission Restrictions},
	volume = {14},
	issn = {2071-1050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137729887&doi=10.3390%2fsu141610379&partnerID=40&md5=a081500e72c8fcbff6d2def8267873df},
	doi = {10.3390/su141610379},
	abstract = {This study aimed to simulate the sector-coupled energy system of Germany in 2030 with the restriction on (Formula presented.) emission levels and to observe how the system evolves with decreasing emissions. Moreover, the study presented an analysis of the interconnection between electricity, heat and hydrogen and how technologies providing flexibility will react when restricting (Formula presented.) emissions levels. This investigation has not yet been carried out with the technologies under consideration in this study. It shows how the energy system behaves under different set boundaries of (Formula presented.) emissions and how the costs and technologies change with different emission levels. The study results show that the installed capacities of renewable technologies constantly increase with higher limitations on emissions. However, their usage rates decreases with low (Formula presented.) emission levels in response to higher curtailed energy. The sector-coupled technologies behave differently in this regard. Heat pumps show similar behaviour, while the electrolysers usage rate increases with more renewable energy penetration. The system flexibility is not primarily driven by the hydrogen sector, but in low (Formula presented.) emission level scenarios, the flexibility shifts towards the heating sector and electrical batteries. © 2022 by the authors.},
	number = {16},

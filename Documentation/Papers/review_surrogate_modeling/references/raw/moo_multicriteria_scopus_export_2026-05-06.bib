	title = {Performance assessment of a modified multi-objective Cuckoo's search algorithm for microgrid planning considering uncertainties},
	isbn = {978-1-4503-5764-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85051516433&doi=10.1145%2f3205651.3205728&partnerID=40&md5=472f6a17eeffc59aea7a517dc231101c},

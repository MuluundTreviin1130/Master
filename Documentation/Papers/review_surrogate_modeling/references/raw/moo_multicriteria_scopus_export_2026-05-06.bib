	title = {Automatic Generation Control Strategy with Aggregated Generation Units Based on Mesh Adaptive Multi-Objective Optimization Algorithm},
	isbn = {979-8-3503-4009-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174318314&doi=10.1109%2fPSGEC58411.2023.10255979&partnerID=40&md5=49b339a48a338b3489e6d696e48fdc7b},

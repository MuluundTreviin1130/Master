@article{cheng_multi-objective_2018,
	title = {Multi-objective optimization model of regional power-heat-water energy system compatible with demand-side resources},
	volume = {{COMPENDIUM} 1},
	issn = {02184540},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85059144994&partnerID=40&md5=190b2b8a3f2740956412d14c4c563225},
	abstract = {The construction of integrated energy system including mechanical energy and chemical energy and water energy, is an important way to promote renewable energy consumption, achieve multi energy cooperation, and improve energy utilization efficiency. Considering operation cost, {CO}2 emission intensity and the benefit of photovoltaic power ({PV}) and wind power abandon reduction, a multi-objective optimization model of regional hybrid energy system ({RHES}) compatible with demand-side resources is built. With the help of ε constraint and fuzzy satisfying decision method ({FSDM}), the multi-objective mixed integer optimization problem is transformed into a single objective optimization problem and then be solved. A numerical example shows that based on the constructed multi-objective optimization model of {REHS}, the system cost, emissions and abandon reduction benefits can be comprehensive optimized. In addition, when considering demand-side resources, the daily peak and valley difference of the system is reduced, and the operation cost and emission reduction target are further optimized. © 2018, {SHPMedia} Sdn Bhd. All rights reserved.},

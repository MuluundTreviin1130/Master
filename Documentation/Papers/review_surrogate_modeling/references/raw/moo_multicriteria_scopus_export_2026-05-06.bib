	date = {2023},
	keywords = {Hybrid systems, Multi-criteria optimization, Sustainable, Renewable resources, Polygeneration, Decentralized off-grid energy services},
	annotation = {Book {chapterExport} Date: 03 April 2025; Cited By: 0},
}


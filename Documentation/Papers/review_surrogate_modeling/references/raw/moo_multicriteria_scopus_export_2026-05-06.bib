@article{wang_multi-objective_2020-2,
	title = {Multi-objective optimal design of hybrid renewable energy system under multiple scenarios},
	volume = {151},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075835566&doi=10.1016%2fj.renene.2019.11.015&partnerID=40&md5=5b72f22eb760e9ea097e0cfb38808f32},
	doi = {10.1016/j.renene.2019.11.015},
	abstract = {The design of hybrid renewable energy system ({HRES}) is crucial in terms of providing reliable power by renewable energies. So far, a number of studies have been conducted amongst which a single scenario based design is the mostly studied. However, we argue that handling multiple scenarios in the context of {HRES} design is more practical since operating conditions of a {HRES} (e.g., load demand) can be different periodically. For example, when designing {HRES} for a farmland, the busy season time and slack season time are two representative scenarios that correspond to substantially different load demand. Surprisingly, there is no adequate study of multi-scenario oriented multi-objective optimal {HRES} design. This study therefore fills in this research gap. A multi-scenario optimization based method is proposed for {HRES} design. Specifically, taking the {PV}(photovoltaic)–{WT} (wind turbines)–Bat(Battery)–{DG} (Diesel generator) as an example, a two-scenario bi-objective optimization model (minimization of system cost while maximization of system reliability) is proposed. In order to solve the model effectively, a scenario-dominance based multi-objective evolutionary algorithm (denoted as s-{NSGA}-{II}) is proposed. Lastly, a case study is shown to demonstrate the effectiveness of the proposed method, that is, s-{NSGA}-{II} is able to find well-balanced solutions for all scenarios, which therefore leads the s-{NSGA}-{II} to be a good alternative for dealing with the optimal design of {HRES} under multiple scenarios. © 2019 Elsevier Ltd},
	pages = {226--237},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Wang, R. and Xiong, J. and He, M.-F. and Gao, L. and Wang, L.},
	date = {2020},
	keywords = {Multiobjective optimization, Renewable energy resources, Evolutionary algorithms, Multi-objective optimization, Hybrid renewable energy systems, optimization, Optimal design, Optimal systems, alternative energy, algorithm, Hybrid Renewable Energy System ({HRES}), {NSGA}-{II}, design method, operations technology, Multi objective evolutionary algorithms, Bi-objective optimization, Multiple scenarios, scenario analysis, evolutionary theory, Optimal design of {HRES}, Scenario-based design},
}

@article{wang_robust_2023,
	title = {Robust multi-objective load dispatch in microgrid involving unstable renewable generation},
	volume = {148},
	issn = {01420615},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147089277&doi=10.1016%2fj.ijepes.2023.108991&partnerID=40&md5=8cc315c0b50bf271f0e23a58253de086},
	doi = {10.1016/j.ijepes.2023.108991},
	abstract = {The microgrid improve productivity and performance by rational load balancing and intelligent energy management schemes. This paper addresses a robust multi-objective load dispatch problem to tactically schedule various resources for an microgrid equipped with controllable distributed generators and unstable renewable energy ({RE}) sources. Power generation cost and emissions are considered as the key indicators for the load dispatching. In such smart grid system, the indeterminate renewable energy generation ({REG}) imposes intractable dispatching challenges. To properly cope with the uncertain {RE}, a model with uncertain distribution is developed to depict the fluctuation in a flexible yet detailed manner. Chance constraint ({CC}) approximations and robust optimization ({RO}) methods are involved to change the prime issue to a more solvable form. We further explore a framework based on deep reinforcement learning ({DRL}) to deal with multi-objective optimization which is generally computational intractable. Real-world data-based simulation has verified the superiority of the proposed uncertain model in handling unstable {REG}. Furthermore, the {DRL} based framework is time-efficient in solving the multi-objective load dispatch problem and surpasses the state-of-art methods by having 56.74\% and 15.62\% better efficiencies on average. © 2023 Elsevier Ltd},
	journaltitle = {Int J Electr Power Energy Syst},
	publisher = {Elsevier Ltd},
	author = {Wang, R. and Xu, T. and Xu, H. and Gao, G. and Zhang, Y. and Zhu, K.},
	date = {2023},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric load dispatching, Electric power distribution, Renewable energy, Microgrid, Microgrids, Renewable energies, Deep Learning, Reinforcement learning, Reinforcement learnings, Learning systems, Smart power grids, Robust optimization, Electric power plant loads, Load dispatch, Deep reinforcement learning, Uncertainty models, renewable energy ({RE}), Deep reinforcement learning ({DRL}), Distribution uncertainty model, Robust optimization ({RO})},
}

@article{wang_day-ahead_2022,
	title = {Day-ahead multi-objective optimal operation of Wind–{PV}–Pumped Storage hybrid system considering carbon emissions},
	volume = {8},
	issn = {2352-4847},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126583160&doi=10.1016%2fj.egyr.2022.02.293&partnerID=40&md5=72cf4e5b20a7bc759bb74b009aff2ed9},
	doi = {10.1016/j.egyr.2022.02.293},
	abstract = {It is crucial to alleviate the problems of energy consumption and grid fluctuations caused by the randomness and intermittency of variable renewable energy ({VRE}) such as wind power and photovoltaic ({PV}). Under the new situation of “carbon neutrality”, the optimal operation of Wind–{PV}–Pumped Storage ({PS}) hybrid system is studied in this paper. The direct economic benefits, carbon emissions and the stability of active power connected to the grid are selected as the objectives of the hybrid operation system. The Wind–{PV}–{PS} optimal operation model is established with the constraints of unit spinning reserve and reservoir capacity with the characteristics of hydropower system. The optimization is executed through Non-dominated Sorting Genetic Algorithm-{II} ({NSGA}-{II}) and the optimal solution is selected by the membership normalization method from the Pareto optimal solution set. The results of the objective values before and after the configuration of {PS} system show that the stability of power grid decreases with the increase of economic and environmental benefits. The {VRE} curtailment rate is reduced by 8.57\%; the economic rate of return is increased by 14.37\%; the carbon emissions are reduced by 3.984 million t/year; and the active power volatility of the grid is reduced as well. The hybrid system with {PS} plays an important role in promoting the safe, economic and efficient grid connection of {VRE}. © 2022},
	pages = {1270--1279},
	journaltitle = {Energy Rep.},
	publisher = {Elsevier Ltd},
	author = {Wang, R. and Yang, W. and Li, X. and Zhao, Z. and Zhang, S.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power transmission networks, Wind power, Genetic algorithms, Multi-objective optimization, Economic and social effects, Energy utilization, Non dominated sorting genetic algorithm ii ({NSGA} {II}), Photovoltaics, Optimal systems, Carbon, Hybrid systems, optimal operation, Pareto principle, Carbon neutralities, {NSGA}-{II}, Variable renewable energies, Carbon emissions, Pumped storage, Electric power system economics, System stability, Active power, carbon neutrality, Wind–photovoltaic–pumped storage hybrid system, Wind–{PV}–pumped storage hybrid system},
}

@inproceedings{wang_multi-objective_2016,
	title = {Multi-objective optimal design of hybrid renewable energy systems using evolutionary algorithms},
	isbn = {21579555},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84960408187&doi=10.1109%2fICNC.2015.7378161&partnerID=40&md5=b4568bc3d7638e999f010810c82d659d},
	doi = {10.1109/ICNC.2015.7378161},
	abstract = {On the design of a hybrid renewable energy system multiple objectives are in general required to be optimized simultaneously. This study presents a general multi-objective combinatorial model for optimizing the hybrid {PV}-wind-diesel-battery system configuration. The model considers four objectives, i.e., minimizing the lifetime system cost, lifetime {CO}2 and {SO}2 emissions and maximizing the system output power. The multi-objective evolutionary algorithm based on decomposition ({MOEA}/D) approach is employed to obtain a set of Pareto optimal solutions to the problem. Each solution corresponds to a non-inferior design, i.e., a good combination of {PV}, wind, diesel and battery. By further considering the practical situation, a satisfied design could be selected. © 2015 {IEEE}.},

	date = {2014},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Evolutionary algorithms, Energy efficiency, Energy utilization, Multi agent systems, Multi-objective optimization problem, Optimization problems, Demand side management, Energy management, Smart power grids, {ECONOMICS}, Electric utilities, Building energy managements, Coordination mechanisms, Distributed renewable energy resources, Energy generations, Evolution algorithms, Supply and demand},

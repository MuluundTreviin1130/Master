	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: C. Jiang; South China University of Technology, School of Electrical Power, Guangzhou, China; email: 1647641766@qq.com},
}

@inproceedings{jiang_research_2016,
	title = {Research on Multi-Objective Optimization Strategy of Active Distribution Network Based on Network Reconfiguration and Demand Response},
	isbn = {21617481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212059333&doi=10.1109%2fCICED63421.2024.10754473&partnerID=40&md5=7712255e74072362535c0da6caa3f83a},
	doi = {10.1109/CICED63421.2024.10754473},
	abstract = {The widespread integration of distributed generation ({DG}), primarily based on renewable energy source ({RES}), poses challenges to distribution networks, including supply-demand imbalance, large voltage fluctuations, increased network losses, and heightened scheduling complexity. Despite network reconfiguration and demand response ({DR}) being effective tools for optimal scheduling, joint research on their application remains limited and their comprehensive potential has yet to be fully explored. To tackle these issues, this paper proposes a multi-objective optimization strategy for active distribution network ({ADN}) based on network reconfiguration and {DR}. Firstly, mathematical models for loads and {DG} are established, considering their time-varying characteristics. Then, aiming to minimize system voltage deviations, enhance operational economy, and promote daily load balancing, a multi-objective regulation model for distributed energy resources ({DER}) in {ADN} is constructed, taking into account the time-of-use ({TOU}) tariff mechanism and network switch configuration. To solve the optimization problem, second-order cone relaxation ({SOCR}) technology is applied to transform the optimization problem into a mixed integer second-order cone programming ({MISOCP}) model that can be solved efficiently, rapidly and accurately. Finally, the effectiveness of the proposed strategy in improving operational efficiency and economy is demonstrated through testing on the {IEEE} 33-bus system. © 2024 {IEEE}.},
	eventtitle = {Research and application on demand side control strategy of microgrid considering customer satisfaction index},
	pages = {1371--1382},
	publisher = {{IEEE} Computer Society},
	author = {Jiang, H. and Liu, H.},
	editor = {Zhang, H. and Zhang, F.},
	date = {2016},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Optimization problems, distributed energy resources, Demand response, Power distribution networks, Active distribution network, Active distributions, Network reconfiguration, Networks reconfiguration, Optimization strategy, Network-based, Network demands},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@article{jiang_droop_2024,
	title = {Droop Frequency Limit Control and Its Parameter Optimization in {VSC}-{HVDC} Interconnected Power Grids},
	volume = {17},

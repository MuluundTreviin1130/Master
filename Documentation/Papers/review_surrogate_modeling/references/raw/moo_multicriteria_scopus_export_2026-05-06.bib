@article{he_thermodynamic_2023,
	title = {Thermodynamic analysis and optimization of a compressed carbon dioxide energy storage system coupled with a combined heating and power unit},
	volume = {277},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144951177&doi=10.1016%2fj.enconman.2022.116618&partnerID=40&md5=6ba6c436e1111f9697bb0bf12b2b6c11},
	doi = {10.1016/j.enconman.2022.116618},
	abstract = {Compressed carbon dioxide energy storage ({CCES}) systems are beneficial for power grids as they absorb energy from intermittent renewable energy sources. This study proposes a {CCES} system coupled with a combined heating and power ({CHP}) unit to analyze the impact of the {CCES} system on the {CHP} unit performance. The feasibility of the system and its superiority over conventional systems were evaluated using thermodynamic modeling and analysis. Based on the results of the parameter analysis, multi-objective optimization was performed using the chaotic particle swarm algorithm to obtain the optimal solution and corresponding performance criteria targets. The results show that the improved configuration of the {CCES} system coupled with the {CHP} unit achieved better performance than the basic configuration, with the system power efficiency ({SPE}), power change ratio ({PCR}), and energy storage density ({ESD}) increasing from 47.21\%, 12.51\%, and 0.99 {kWh}/m3 to 63.07\%, 19.51\% and 1.32 {kWh}/m3, respectively. Considering the performance of both the {CCES} system and {CHP} unit comprehensively, the multi-objective optimization obtained the best results with optimization criteria round-trip efficiency ({RTE}), {SPE}, and {PCR} of 22.34\%, 64.94\%, and 21.66\%, respectively. The total exergy efficiency ({TEE}) and {ESD} under this optimal condition were 35.96\% and 1.54 {kWh}/m3. © 2022 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},

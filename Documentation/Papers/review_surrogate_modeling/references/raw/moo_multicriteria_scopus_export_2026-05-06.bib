}

@inproceedings{badawy_quantum-inspired_2014,
	title = {Quantum-inspired evolution for smart building energy management in future power networks},
	isbn = {978-1-138-02725-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84941979000&doi=10.1201%2fb17488-140&partnerID=40&md5=b3585f59bc1e11cc469db2c40a27b91f},
	doi = {10.1201/b17488-140},
	abstract = {Smart Grid has become the future choice by many utility departments to attain bottom line goals of energy management. Smart Grid will depend on a large number of distributed renewable energy resources which require sophisticated control and coordination mechanisms for efficient and reliable Demand Side Management ({DSM}). Demand side management is concerned with actions that reshape the energy consumption pattern for the end-users during peak energy consumption times. Technology is moving toward a situation in which households manage their own energy generation and consumption, possibly in cooperation with each other. Studies have shown that 40\% of the worldwide energy is consumed in buildings. In order to make the future Smart Grid more efficient, it requires innovative Smart Building (home) Energy Management ({SBEM}) systems. In this paper, we propose an approach that integrates a quantum-inspired evolution algorithm and multi-agent system, which in turn controls the power consumption within smart buildings for matching supply and demand. The optimization problem is formulated as a multi-objective optimization problem solved by quantum-inspired evolution algorithm. In this paper, we use a number of household device models to test the effectiveness of the proposed approach. © 2015 Taylor \& Francis Group, London.},
	pages = {787--792},

@inproceedings{li_power_2016,
	title = {Power Quality Control and Multi-Objective Optimization Compensation Strategy for Grid-Connected Multi-Functional Inverters},
	isbn = {21617481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212132080&doi=10.1109%2fCICED63421.2024.10754248&partnerID=40&md5=8c02ff40fc8ee64f4da6a6ca15afcdd4},
	doi = {10.1109/CICED63421.2024.10754248},
	abstract = {To better utilize the residual capacity of grid-connected inverters and improve the power quality of distribution substations, this paper investigates a control strategy for a multi-functional grid-connected inverter with power quality control capabilities. Compared with traditional grid-connected inverters, the proposed multifunctional inverter introduces the control concept of an active filter based on grid-connected power generation. Through the harmonic detection stage, compensating currents are added to the inverter's output to counteract the harmonics and reactive current components generated by the load. Subsequently, based on the Catastrophe Theory, a comprehensive power quality assessment method based on is adopted to evaluate the power quality of the microgrid comprehensively. Finally, a multi-objective optimization compensation strategy is proposed. The reference current for the multifunctional grid-connected inverter is optimized using a multi-objective particle swarm algorithm, balancing the effectiveness of power quality management and the minimization of compensation capacity. Experimental results demonstrate that the proposed method can achieve the optimal compensation strategy for the inverter while meeting the comprehensive power quality indicators, thereby significantly enhancing the performance of the grid-connected inverter. © 2024 {IEEE}.},

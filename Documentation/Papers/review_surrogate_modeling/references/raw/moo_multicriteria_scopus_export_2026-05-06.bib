@inproceedings{liu_unit_2023,
	title = {Unit Commitment Based Optimal Aggregation and Control Method for Energy Storage Systems},
	isbn = {979-8-3503-4509-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194178662&doi=10.1109%2fEI259745.2023.10512450&partnerID=40&md5=73baa5ce05711d3596285fb1c1ddafb0},
	doi = {10.1109/EI259745.2023.10512450},
	abstract = {With the ever-increasing penetration of intermittent renewable energy generation in a power system, the emerging energy storage system ({ESS}) plays an increasingly important role in promoting the accommodation capability of fluctuating renewable energy generation, improving load profile, as well as enhancing operational security and economics. Given this background, an unit commitment based multi-objective optimization problem is first formulated for optimal aggregation and control of multiple types of {ESSs}, with power system operation economics and the utilization efficiency of {ESSs} as optimization objectives, and with operation security constraints respected. The multi-objective optimization problem is next transformed into a single-objective optimization problem by weighting different objectives. The built optimization model is non-convex and is then convexified for facilitating the solving procedure. Finally, a modified {IEEE} 33-bus distribution system is employed to demonstrate the proposed optimal aggregation and control method, and the Pareto front and the compromised optimal solution of the multi-objective optimization problem are obtained.  © 2023 {IEEE}.},
	pages = {1336--1341},
	publisher = {Institute of Electrical and Electronics Engineers Inc},

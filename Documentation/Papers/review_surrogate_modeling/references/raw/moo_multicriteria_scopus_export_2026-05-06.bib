	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 3; Correspondence Address: J. Das; Muthoot Institute of Technology and Science, Department of Electrical and Electronics, Ernakulam, Kerala, India; email: janidas@mgits.ac.in},

	date = {2020},
	keywords = {Multiobjective optimization, optimization, Optimisations, Techno-economics, Emission control, Electric energy storage, Digital storage, Storage systems, District heating, Multi-energy systems, Renewable energy community, Decision support systems, Energy-system models, Decision supports, {DECENTRAL} {MULTI}-{ENERGY} {SYSTEMS}, Petroleum reservoir evaluation, Energy system modelling, Real-world implementation, {RENEWABLE} {ENERGY} {COMMUNITIES}, Support tool},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: N. Körber; {IAEW}, {RWTH} Aachen University, Aachen, Schinkelstraße 6, Germany; email: n.koerber@iaew.rwth-aachen.de},

@article{chu_technology_2020,
	title = {Technology and Application of Multi-energy Coordinative Optimization With Complex Cascade Transmission Section},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092611613&doi=10.13335%2fj.1000-3673.pst.2020.0484&partnerID=40&md5=b247f25a77a89bdd66e63533cf947d32},
	doi = {10.13335/j.1000-3673.pst.2020.0484},
	abstract = {In the power system with high proportion of new energy, the doubly uncertainty of variable new energy and load make it difficult to control power flow finely and effectively. To resolve the contradiction between traditional transmission section control strategy that has adequate safety margin and new energy consumption demand, considering a certain security risk, an ultra-short-term new energy forecast revision method is established. Based on that, a multi-objective optimization model is established with complex cascade section in this paper. Besides system constraints, unit constraints and network constraints, while permit-tripped power generation constraints and uniqueness section limit constraints are set according to the characteristics of complex cascade transmission sections, the objective is set as to maximize new energy accommodation and power section utilization. It is found from results of a practical application in the Northwest China power grid that, the utilization rate of section increases more than 8 points during new energy curtailment time, and new energy power generation increases average 800 thousand {kW}•h per day when the model is adopted, which verify that the proposed optimization model is effective to control power flow finely and maximize new energy accommodation and section utilization. © 2020, Power System Technology Press. All right reserved.},
	pages = {3656--3662},
	number = {10},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Chu, Y. and Li, Q. and Ma, X. and Wang, K. and Liu, X. and Wang, W. and Li, Z. and Su, B.},

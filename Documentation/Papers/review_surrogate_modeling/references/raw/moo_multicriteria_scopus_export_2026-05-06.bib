	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2},
}

@article{perera_integrated_2017,
	title = {An integrated approach to design site specific distributed electrical hubs combining optimization, multi-criterion assessment and decision making},
	volume = {134},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85020438235&doi=10.1016%2fj.energy.2017.06.002&partnerID=40&md5=5568adef7a0498bcd88d2170d559e20a},
	doi = {10.1016/j.energy.2017.06.002},
	abstract = {An integrated approach is presented in this study to design electrical hubs combining optimization, multi-criterion assessment and decision making. Levelized Energy Cost ({LEC}), Initial Capital Cost ({ICC}), Grid Integration Level ({GI}), Levelized {CO}2 emission ({LCO}2), utilization of renewable energy, flexibility of the system, loss of load probability ({LOLP}) are considered as criteria used to assess the design. The novel approach consists of several steps. Pareto analysis is conducted initially using 2D Pareto fronts to reduce the dimensions of the optimization problem. Subsequently, Pareto multi objective optimization is conducted considering {LEC}, {GI} and {ICC} which were identified as the best set of objective functions to represent the design requirements. Next, fuzzy {TOPSIS} and level diagrams are used for multi-criterion decision making ({MCDM}) considering the set of criteria and the boundary matrix that represents the design requirements of the application. Pareto analysis shows that 5D optimization problem can be reduced to a 3D optimization problem when considering {LEC}, {ICC} and {GI} as the objective functions. Finally, results obtained from the case study shows that the novel method can be used design distributed energy systems considering a set of criteria which is beyond the reach of Pareto optimization with different priority levels. © 2017 Elsevier Ltd},
	pages = {103--120},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Perera, A.T.D. and Nik, V. M. and Mauree, D. and Scartezzini, J.-L.},
	date = {2017},
	keywords = {Multiobjective optimization, Multi-objective optimization, Decision making, optimization, Optimization problems, Multi-Criterion, distribution system, Pareto principle, cost analysis, Loss of load probability, Fuzzy {TOPSIS}, Distributed energy systems, integrated approach, assessment method, design method, multicriteria analysis, fuzzy mathematics, Natural gas transportation, electrical hub, numerical method, Distributed energy system, Integrated control, Levelized energy costs, Loss of load probabilities ({LOLP}), Multi-criterion assessment, Multi-criterion decision makings},
}

@article{perera_electrical_2017,
	title = {Electrical hubs: An effective way to integrate non-dispatchable renewable energy sources with minimum impact to the grid},
	volume = {190},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85008656645&doi=10.1016%2fj.apenergy.2016.12.127&partnerID=40&md5=5423381b7f841abc50e3b2796f6b1931},
	doi = {10.1016/j.apenergy.2016.12.127},
	abstract = {A paradigm change in energy system design tools, energy market, and energy policy is required to attain the target levels in renewable energy integration and in minimizing pollutant emissions in power generation. Integrating non-dispatchable renewable energy sources such as solar and wind energy is vital in this context. Distributed generation has been identified as a promising method to integrate Solar {PV} ({SPV}) and wind energy into grid in recent literature. Distributed generation using grid-tied electrical hubs, which consist of Internal Combustion Generator ({ICG}), non-dispatchable energy sources (i.e., wind turbines and {SPV} panels) and energy storage for providing the electricity demand in Sri Lanka is considered in this study. A novel dispatch strategy is introduced to address the limitations in the existing methods in optimizing grid-integrated electrical hubs considering real time pricing of the electricity grid and curtailments in grid integration. Multi-objective optimization is conducted for the system design considering grid integration level and Levelized Energy Cost ({LEC}) as objective functions to evaluate the potential of electrical hubs to integrate {SPV} and wind energy. The sensitivity of grid curtailments, energy market, price of wind turbines and {SPV} panels on Pareto front is evaluated subsequently. Results from the Pareto analysis demonstrate the potential of electrical hubs to cover more than 60\% of the annual electricity demand from {SPV} and wind energy considering stringent grid curtailments. Such a share from {SPV} and wind energy is quite significant when compared to direct grid integration of non-dispatchable renewable energy technologies. © 2016 Elsevier Ltd},
	pages = {232--248},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Perera, A.T.D. and Nik, V. M. and Mauree, D. and Scartezzini, J.-L.},
	date = {2017},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric load dispatching, Electric power transmission networks, Natural resources, Wind power, Multi-objective optimization, optimization, Commerce, Distributed power generation, distributed generation, Costs, electricity generation, energy resource, renewable resource, Electric energy storage, Energy policy, Wind turbines, Electrical power, Solar power, Systems analysis, Grid integration, Dispatchable energies, Renewable energy integrations, Renewable energy technologies, Power markets, wind turbine, Electric power utilization, electricity supply, Solar and wind energies, Levelized energy costs, Electrical hubs, Non-dispatchable energy, Sri Lanka, Swinepox virus ({STRAIN} {KASZA})},
}


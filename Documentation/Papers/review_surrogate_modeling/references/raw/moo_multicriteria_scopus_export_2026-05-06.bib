@inproceedings{lopez_multi-objective_2012,
	title = {Multi-objective optimization of hybrid power systems using evolutionary algorithms},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84900297907&partnerID=40&md5=55fd376f5fa997a7759aac4da63b718f},
	abstract = {In the present work, a Genetic Algorithm is used to approximate the optimal solutions for a Hybrid Micro-Grid considering multiple objectives. The main objectives considered in the present study are the minimization of the total lifecycle cost, including the capital, replacement, operation, maintenance, fuel and interest costs, and the minimization of green gas house emissions. The objective functions were evaluated using simulation techniques to predict the behavior of the Hybrid Micro-Grid system as well as the mathematical forecasts of wind and solar resources to account for the stochastic nature of the renewable energy sources as they relate to meteorological factors. Moreover, to increase the effectiveness of the multi-objective approach, the model considers different energy storage systems which are incorporated into the Hybrid Micro-Grid. The final solution to the multi-objective renewable energy integration problem is a set of solutions known as Pareto Optimal solutions.},

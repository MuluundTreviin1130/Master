@inproceedings{wang_resilience-oriented_2019,
	title = {Resilience-oriented multi-energy complementary microgrid robust optimal operation strategy considering the uncertainty},
	volume = {2019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081595643&doi=10.1049%2fcp.2019.0434&partnerID=40&md5=b78547428cd7460e84023de637f1c274},
	doi = {10.1049/cp.2019.0434},
	abstract = {This paper proposes a novel resilience-oriented optimal operation strategy for multi-energy complementary ({MEC}) microgrid. The objectives in the proposed optimal strategy consist of the resilience, the operation cost and the total pollutant emissions. Since distributed energy resources ({DER}) exist in the {MEC} microgrid, the problem formulated is a multi-objective optimization considering the uncertainty wherein the resilience is maximized while the cost is minimized. Thus, it can be solved as a min-max dual robust optimization problem. Benders decomposition ({BD}) is employed to decouple it, then improved simulated annealing algorithm ({SAA}) is deployed to search the min/max value. Compared with other robust optimal model, the proposed strategy can be applied in the {MEC} microgrid as well as consider the resiliency. The case with photovoltaic ({PV}) panels, wind turbines ({WT}), combined cooling, heating and power ({CCHP}) system, ground source heat pump ({GSHP}) and different loads demonstrates the effectiveness of the proposed optimal operation strategy. © 2019 Institution of Engineering and Technology. All rights reserved.},
	eventtitle = {{IET} Conference Publications},
	issue = {{CP}764},
	publisher = {Institution of Engineering and Technology},
	editor = {Wang, J. and Zheng, X. and Tai, N. and Yang, Z. and Wei, W. and Li, L.},
	date = {2019},
	keywords = {Multiobjective optimization, Micro grid, Microgrids, optimal operation, Energy resources, Uncertainty, Distributed energy resource, Simulated annealing, Geothermal heat pumps, Combined cooling, Groundsource heat pump ({GSHP}), heating and power ({CCHP}), Improved simulated annealing algorithm, Mec Microgrid, Resiliency-Oriented, Robust Optimal Operation},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: X. Zheng; School of Electronic Information and Electrical Engineering, Shanghai Jiao Tong University, Shanghai, China; email: xiaodongzheng@sjtu.edu.cn},
}

@article{wang_multi-energy_2024,
	title = {Multi-energy complementary integrated energy system optimization with electric vehicle participation considering uncertainties},
	volume = {309},
	issn = {0360-5442},
	url = {https://www.sciencedirect.com/science/article/pii/S0360544224028846},
	doi = {10.1016/j.energy.2024.133109},
	abstract = {Multi-energy complementary integrated energy system ({MCIES}) can promote the utilization of renewable energy and facilitate the transition to a low-carbon society. With the popularization of electric vehicles ({EVs}), the charging load is a non-negligible load demand and brings unknown impacts on the {MCIES}. Moreover, the uncertain nature of renewable energy and {EVs} charging load may hinder the desired performance of {MCIES}. This study optimized the capacities of {MCIES} considering the {EVs} charging load and source-load uncertainties. An integrated solution method was used to deal with the multi-objective optimization problem, i.e., minimizing the annual total cost ({ATC}), annual total {CO}2 emissions ({ATE}) and power grid load volatility (F). In addition, the complementarity between the {EVs} charging load and power grid load for {MCIES} was investigated, as well as the impacts of the {EVs} charging strategy. An actual swimming pool building with {MCIES} was used as a case study to illustrate the procedure. The results show that the capacity configuration for {MCIES} considering {EVs} participation and uncertainties has better comprehensive performance. Moreover, the {EVs} charging strategy can further affect the load volatility of {MCIES} and its volatility is reduced by 61.3 \% under an orderly charging strategy.},
	pages = {133109},
	journaltitle = {Energy},
	author = {Wang, Jiaqiang and Cui, Yanping and Liu, Zhiqiang and Zeng, Liping and Yue, Chang and Agbodjan, Yawovi Souley},
	urldate = {2024-11-15},
	date = {2024},
}

@article{wang_muti-objective_2024,
	title = {Muti-objective robust optimization method for energy storage stations considering confidence theory},
	volume = {13},
	issn = {20954239},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217024580&doi=10.19799%2fj.cnki.2095-4239.2024.0691&partnerID=40&md5=07e13ebf46adb2877e423bdd241470be},
	doi = {10.19799/j.cnki.2095-4239.2024.0691},
	abstract = {The intermittency and instability of renewable energy generation pose significant challenges to the stable operation of power grids, and the application of energy storage technology is key to addressing these issues. Therefore, a multi-objective optimization method for the capacity configuration of renewable energy and energy storage stations based on confidence theory is developed in this paper, aiming to enhance grid stability and reliability. First, the uncertainties brought by the high proportion of renewable energy integration into the grid are analyzed and a multi-objective robust optimization model is established. Then, based on confidence theory, a normalized regularization constraint method is developed to generate a diverse Pareto solution set, ensuring the validity and diversity of solutions under different uncertainties. Finally, the long-term performance of each Pareto solution is simulated through posterior sample analysis to evaluate its practical effect. Case studies on the {IEEE} transmission network show that at lower confidence interval values, the total system cost is lower but the adjustment capability is limited; while at higher confidence interval values, the system's adjustment capability significantly improves, but the total cost also increases. Additionally, when facing a 5\% load fluctuation, the system's operating cost is reduced by 15\%, and power supply reliability is increased by 10\%. © 2024 Editorial office of Energy Storage Science and Technology. All rights reserved.},
	pages = {4017--4029},
	number = {11},
	journaltitle = {Energy. Storage. Sci. Technol.},
	publisher = {Editorial office of Energy Storage Science and Technology},
	author = {Wang, K. and Liang, Y. and Gao, J. and Zheng, X. and Zhao, H. and Jing, Y.},
	date = {2024},
	keywords = {Multi-objective robust optimization, confidence theory, energy storage stations, normalized regular constraints},
}

@article{wang_short-term_2020,
	title = {Short-term Coordinated Scheduling of Wind-pumped-hydro-thermal Power System With Multi-energy Complementarities},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092638312&doi=10.13335%2fj.1000-3673.pst.2020.0476&partnerID=40&md5=bcaebe2d4020ae96b6cb5d8ec52c9612},
	doi = {10.13335/j.1000-3673.pst.2020.0476},
	abstract = {The coordinative optimization of different energy sources in power system is an effective means to deal with the randomness of wind power and promote the utilization of large scale renewable energy. For the multi-energy complementary system with wind, pumped storage, hydro and thermal power, a coordinated scheduling model and its solving method are proposed to fully exploit the complementary benefits of multi-energy and improve the accommodation capacity of renewable energy. Firstly, a multi-objective short-term coordinated scheduling model is proposed considering the economic and stable operation of the thermal power units, the utilization of renewable energy and the fluctuation of the load deducting wind power. Secondly, to take full advantage of the regulation ability of the pumped storage, a mean value deviation based method is designed to predetermine the operating state of the pumped storage. The number of thermal units to start up is determined in advance based on the load and spinning reserve requirement in the peak and valley period. Thus the integer variables in the model are solved independently, which can effectively avoid the problem of "dimension disaster" in multivariable coupling solution space. Finally, according to the flexibility, cleanliness and complementarities of different energy sources, a multi-objective optimization solution with "piecewise-sequence-feedback" strategy is established based on dispatching requirements, to realize the segmented and coordinated optimization of dispatching output of each power. Simulations of test systems with different typical days and different pumped storage capacities are carried out, and the results indicate that the proposed model can comprehensively optimize the operation characteristics of wind, pumped storage, hydro and thermal power units and maximize the comprehensive benefits of the multi-energy system. The proposed model and method have good applicability to multi-energy coordinative optimization problem. © 2020, Power System Technology Press. All right reserved.},
	pages = {3631--3640},
	number = {10},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Wang, K. and Luo, X. and Jia, R. and Zhou, C.},
	date = {2020},
	keywords = {Multiobjective optimization, Wind power, Multi-objective optimization, Scheduling, Fossil fuel power plants, Pumped storage power plants, Renewable energy accommodation, Complementary systems, Coordinated scheduling, Wind power generation, Multi-energy complementary, Coordinative optimization, Coordinated optimization, Different energy sources, Thermal power system, Comprehensive benefit, Operation characteristic, Disaster prevention, Pumped-storage},
}

@article{wang_multi-objective_2018,
	title = {Multi-objective operation optimization for integrated electricity and gas systems considering the accommodation capability of wind power},
	volume = {39},
	issn = {10007229},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85051957858&doi=10.3969%2fj.issn.1000-7229.2018.06.014&partnerID=40&md5=6f81a2d4fa32c9457ab353d26dc762ac},
	doi = {10.3969/j.issn.1000-7229.2018.06.014},
	abstract = {An integrated electric power and natural gas system, as a special example of an integrated energy system, is of great potential for promoting the accommodating capability of intermittent renewable energy generation through flexible operation of various energy carriers. However, the overall operation cost and energy transmission loss may suffer from significant changes depending on the penetration level of renewable energy sources. It is necessary to study the multi-objective optimal operation strategy for integrated electric power and gas systems considering the accommodation of wind power generation. First, a multi-objective operation optimization model is established by minimizing the operation cost, wind power curtailment and energy loss of the integrated electric power and gas system. Then, the nonlinear constraints are simplified by piecewise linearization, and the original mixed integer nonlinear planning model is then transformed into a mixed integer linear planning one. Moreover, the multi-objective optimization technique based on the augmented e-constraint method is employed to solve the model, and the fuzzy comprehensive evaluation is employed to find the compromised optimal solution from the attained Pareto optimal solutions. Finally, an integrated and revised version of the {IEEE} 39-bus power system and the Belgium 20-bus natural gas system is served to demonstrate the feasibility and efficiency of the proposed method.},
	pages = {105--116},
	number = {6},

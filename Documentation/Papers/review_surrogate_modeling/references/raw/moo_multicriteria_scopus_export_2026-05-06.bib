@inproceedings{corredor_utility_2011,
	title = {Utility resource planning using modular simulation and optimization},
	isbn = {08917736},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84858017050&doi=10.1109%2fWSC.2011.6147821&partnerID=40&md5=2f3bf43822b49e2c00001cc3914b4b81},

	keywords = {optimization, Optimisations, Energy management, Photovoltaics, Storage systems, Energy, Prosumer, Electricity-consumption, Self-consumption, residential energy, Multiobjective modeling, Photovoltaic  prosumer, Photovoltaic ({PV}) prosumer},
}


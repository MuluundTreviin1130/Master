	keywords = {Energy efficiency, Hybrid power, Energy storage system, Storage systems, Clean energy, Energy, Energy Efficiency ({EE}), Energy storage system ({ESS}), Energy systems, Hybrid renewable energies, Hybrid renewable energy system, Hybrid Renewable Energy System ({HRES}), Microgrid system modeling, Microgrid System Modelling, Microgrid systems, Small hydropower, Small-hydropower, Small-hydropower ({SHP}), System models},

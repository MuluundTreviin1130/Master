}

@article{mobayen_multi-functional_2025,
	title = {Multi-functional hybrid energy system for zero-energy residential buildings: Integrating hydrogen production and renewable energy solutions},
	volume = {102},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214508906&doi=10.1016%2fj.ijhydene.2025.01.061&partnerID=40&md5=6cb47e2f1985a8245eebcb97f1d3d2ad},
	doi = {10.1016/j.ijhydene.2025.01.061},
	abstract = {The increasing global residential energy demand causes carbon emissions and ecological impacts, necessitating cleaner, efficient solutions. This study presents an innovative hybrid energy system integrating wind power and gas turbines for a four-story, 16-unit residential building. The system generates electricity, heating, cooling, and hydrogen using a Proton Exchange Membrane electrolyzer and a compression chiller. Integrating the electrolyzer enables hydrogen production and demonstrates hydrogen's potential as a versatile, clean energy carrier for systems, contributing to advancements in hydrogen utilization. Simulations with Engineering Equation Solver software, coupled with neural network-based multi-objective optimization, fine-tuned parameters such as gas turbine efficiency, wind turbine count, and gas turbine inlet temperature to enhance exergy efficiency and reduce operational costs. The optimized system achieves an energy efficiency of 33.69\% and an exergy efficiency of 36.95\% and operates at \$446.04 per hour, demonstrating economic viability. It produces 51,061 {MWh} annually, exceeding the building's energy demands and allowing surplus energy use elsewhere. {BEopt} simulations confirm the system meets residential needs by providing 2.52 {GWh} of electricity, 3.36 {GWh} of heating, and 5.11 {GWh} of cooling annually. This system also generates 10 kg of hydrogen per hour and achieves a {CO}₂ reduction of 10,416 tons/year. The wind farm (25 turbines) provides most of the energy at 396.7 dollars per hour, while the gas turbine operates at 80\% efficiency. By addressing the challenges of intermittent renewable energy in residential Zero-Energy Buildings, this research offers a scalable and environmentally friendly solution, contributing to sustainable urban living and advancing hydrogen energy applications. © 2025},
	pages = {647--672},
	journaltitle = {Int J Hydrogen Energy},
	publisher = {Elsevier Ltd},
	author = {Mobayen, S. and Assareh, E. and Izadyar, N. and Jamei, E. and Ahmadinejad, M. and Ghasemi, A. and Agarwal, S. and Pak, W.},
	date = {2025},
	keywords = {Wind power, Electrolyzers, Proton exchange membranes, Zero energy buildings, Wind turbines, Power, Generation systems, Multi generations, Zero-carbon, Wind power integration, Exergy efficiencies, Green buildings, Exergy efficiency, Multi-generation system, Brayton cycle, Brayton, Proton exchange membrane electrolyze, proton exchange membrane electrolyzer, Artificial neural network optimization, Chilling, cleaner production, Electrolytic cleaning, Neural network optimization, Prestressed materials, Windows},
}

@inproceedings{modibbo_optimization_2024,
	title = {Optimization of Microgrid Performance and Emission Reduction Through Incentive Based and {TOU} Demand Response Models},
	isbn = {979-8-3315-2809-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000692752&doi=10.1109%2fCEECT63656.2024.10898409&partnerID=40&md5=b5a247dc18b48b535ecb8aecc4df70fd},
	doi = {10.1109/CEECT63656.2024.10898409},
	abstract = {The global reliance on fossil fuels for power generation contributes significantly to greenhouse gas emissions and environmental degradation, driving the need for cleaner, more sustainable energy solutions. This paper proposes a microgrid system that integrates distributed energy resources, diesel generators, and demand-side resources, focusing on two demand response ({DR}) models: incentive-based ({IBDR}) and time-of-use ({TOU}). The {IBDR} model incentivizes consumers to shift usage away from peak times, enhancing grid stability and reducing diesel reliance, while the {TOU} model shifts demand to off-peak periods, minimizing operational cost and reducing emissions. A multi-objective optimization approach assesses the models, revealing that {IBDR} effectively manages loads, while {TOU} is more cost-efficient in emissions reduction. Overall, the combined strategies improve grid sustainability, reduce costs, and lower emissions, demonstrating the microgrid's viability for integrating renewable energy. Simulation results validate the models' effectiveness in enhancing microgrid sustainability and operational performance.  © 2024 {IEEE}.},
	pages = {458--463},

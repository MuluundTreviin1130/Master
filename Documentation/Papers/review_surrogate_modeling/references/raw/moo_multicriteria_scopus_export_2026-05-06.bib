@inproceedings{ullah_swarm_2024,
	title = {A Swarm Intelligence-Based Approach for Multi-Objective Optimization Considering Renewable Energy in Smart Grid},
	isbn = {979-8-3503-9591-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207452649&doi=10.1109%2fICECET61485.2024.10698431&partnerID=40&md5=4500b388c9c479cd6f39e226523c16c4},
	doi = {10.1109/ICECET61485.2024.10698431},
	abstract = {In this study, the optimization of two crucial objec-tives of smart grid ({SG}), operational cost and pollution emissions, is taken as a multi-objective problem. The coordination between the output power of wind energy and the overall demand is addressed as a demand-side management ({DSM}) strategy. The proposed system model utilizes renewable and non-renewable energy sources, including wind, battery, micro-turbine, and the utility grid. Inverse Weibull distribution ({IWD}) is used to predict wind speed. This problem is tackled through a hybrid scheme involving two heuristic algorithms, namely multi-objective par-ticle swarm optimization and non-dominated sorting genetic algorithm-{II} (Hybrid-{NSGA}-{II}-{MOPSO}) while adhering to spec-ified constraints. The results obtained from the Hybrid-{NSGA}-{II}-{MOPSO} algorithm are compared with those of the multi-objective wind-driven optimization ({MOWDO}) algorithm, which serves as a benchmark. The findings reveal the superiority of the proposed algorithm, showcasing its ability to converge to the global optimum and avoid premature convergence. Furthermore, the proposed algorithm outperforms the existing method when considering the operational cost and pollution emission of {SG}. To validate the model, it is implemented on {SG} using {MATLAB} software. © 2024 {IEEE}.},
	eventtitle = {International Conference on Electrical, Computer, and Energy Technologies, {ICECET} 2024},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Ullah, K. and Alghamdi, H. and Hafeez, G. and Khan, I. and Ullah, S. and Murawwat, S.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Renewable energies, Weibull distribution, Smart grid, Multi objective, Output power, {NSGA}-{II}, Heuristic algorithms, Pollution emissions, Multi-objective problem, Swarm intelligence, inverse Weibull distribution},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@article{ullah_energy_2025,
	title = {Energy optimization using hybrid demand response, renewable energy, and storage battery: A tri-objective optimization approach},
	volume = {122},
	issn = {2210-6707},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219147001&doi=10.1016%2fj.scs.2025.106145&partnerID=40&md5=6359b54e17c2981079d2f851ea045e8d},
	doi = {10.1016/j.scs.2025.106145},
	abstract = {This study presents an energy optimization model for smart grids ({SG}), addressing the critical need for improved energy, economic, and environmental efficiency. The model employs a tri-objective approach: (i) minimizing operational costs and pollution emissions, (ii) synchronizing adjustable loads ({ALs}) with renewable energy source ({RES}) output, and (iii) reducing load curtailment costs for curtailable loads ({CLs}). Probability density function ({PDF}) is used for precise wind speed and solar irradiance predictions. The model leverages smart grid operator ({SGO}) capabilities to enable seamless bidirectional communication and implement demand-side management ({DSM}). To solve this tri-objective optimization problem, three algorithms are utilized: multi-objective particle swarm optimization ({MOPSO}), non-dominated sorting genetic algorithm {II} ({NSGA}-{II}), and multi-objective wind-driven optimization ({MOWDO}), along with a hybrid demand response program (H-{DRPs}) that integrates real-time pricing ({RTP}) and real-time incentives ({RTI}). The model's effectiveness is evaluated across three scenarios: basic operation, maximum {RES} utilization, and combined {RES} and H-{DRPs}. Comparative results indicate that {NSGA}-{II}, particularly in scenarios incorporating H-{DRPs} with {RES}, outperforms the other approaches in achieving desired objectives. © 2025 Elsevier Ltd},
	journaltitle = {Sustainable Cities Soc.},
	publisher = {Elsevier Ltd},
	author = {Ullah, K. and Hafeez, G. and Khan, I. and Ullah, S. and Alghamdi, B. and Alsafran, A. S. and Kraiem, H.},
	date = {2025},
	keywords = {Multi-objectives optimization, Renewable energy source, Renewable energy sources, Multi-objective optimization, genetic algorithm, optimization, Non dominated sorting genetic algorithm ii ({NSGA} {II}), alternative energy, energy resource, Demand response programs, Battery, Probability density function, Smart grid, energy storage, Solar radiation, Demand-side management, Demand response, Energy optimization, Objective optimization, Storage battery, efficiency measurement, storage batteries, wind velocity, Hybrid demand response program},
}

@article{ullah_multi-criteria_2021,
	title = {Multi-criteria decision-making model for optimal planning of on/off grid hybrid solar, wind, hydro, biomass clean electricity supply},
	volume = {179},
	issn = {0960-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111333547&doi=10.1016%2fj.renene.2021.07.063&partnerID=40&md5=c2f6ca1a0210436c6da2e0cf7dcc0ab5},
	doi = {10.1016/j.renene.2021.07.063},
	abstract = {Worldwide, the emerging trend of hybrid renewable energy sources integration in modern power systems is increasing due to privileged prices and clean electricity supply. However, the optimal planning of rural hybrid systems is a challenging and complex task, especially when different alternatives and sustainability aspects are considered. This paper develops an integrated decision-making approach for the optimal planning of a 100\% renewable energy supply system comprising solar, wind, hydro, and biomass sources in a rural area located in Pakistan. An hourly-based design optimization analysis of twelve on/off-grid electrification alternatives is performed. The optimization model simultaneously addresses five sustainability criteria related to economy, reliability, ecology, society, and topography aspects. Furthermore, a novel hybrid decision-making model has developed to identify the unique best configuration with on-grid and off-grid options. The proposed model combines fuzzy analytic hierarchy process, multi-objective optimization based on ratio analysis technique for order of preference by similarity to an ideal solution, and evaluation based on distance from average solution methods. The results reveal that the solar-hydro-biomass battery with a life cycle cost of 10.9 M\$ is the top-ranking off-grid system. When the hybrid system is connected to the grid, the solar-hydro-battery has found the most appropriate design with a life cycle cost of 12.96 M\$. Both scenarios have a negligible capacity shortage of 0.09\%. Ecologically, the optimal off-grid system produces only 408.37 kg/yr of {CO}2 due to the significant energy share of solar and hydro sources (99.3\%). The optimal on-grid system produced the minimum {CO}2 with 29,177.89 kg/yr compared to other alternatives. Also, employing the optimal on/off-grid designs require land area and jobs of 96.6 m2, 14 jobs, and 118 m2, 15 jobs, respectively. Overall, the developed approach with the presented case study offers a valuable benchmark and guidelines for investors and stakeholders to create realistic investment plans for the energy industry looking to push efficient inducements to encourage the high dissemination of renewables. © 2021 Elsevier Ltd},
	pages = {885--910},
	journaltitle = {Renew. Energy},
	publisher = {Elsevier Ltd},
	author = {Ullah, Z. and Elkadeem, M. R. and Kotb, K. M. and Taha, I.B.M. and Wang, S.},
	date = {2021},
	keywords = {Multiobjective optimization, Wind power, Decision making, Life cycle, Sustainable development, Carbon dioxide, Hybrid systems, Off-grids, Costs, Secondary batteries, Energy planning, Investments, Multi criteria decision-making, Multicriteria decision-making, Solar power, Hydroelectric power, numerical model, Biomass, {ECONOMICS}, Optimal planning, Planning, Electric utilities, 100\% renewable energy, electricity supply, multicriteria analysis, Multi-criterion decision-making, electrification, Rural electrification, Rural areas, Multi-criteria decision-making, Biomass power, Feasibility analysis, Clean electricity, Topography, Pakistan, Hybrid clean electricity supply},
}

@article{ur_rahman_habib_analysis_2022,
	title = {Analysis of Microgrid's Operation Integrated to Renewable Energy and Electric Vehicles in View of Multiple Demand Response Programs},
	volume = {10},
	issn = {21693536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122884451&doi=10.1109%2fACCESS.2022.3140587&partnerID=40&md5=378ceb2e95d0c8754f708f577345e811},
	doi = {10.1109/ACCESS.2022.3140587},
	abstract = {A suitable energy management scheme and integrating renewable energy resources ({RERs}) can significantly increase energy efficiency and the stability of future grids operation. This work modeled a household energy management comprising a microgrid ({MG}) system and demand response programs ({DRPs}). Residential loads with price-based tariffs are introduced to reduce peak load demands and energy costs. For incorporating the uncertainties in {RERs}, their stochastic nature is modeled with a probabilistic method. This paper proposes a joint optimization approach for the optimal planning and operation of grid-connected residential, rural {MG} integrated into renewable energy and electric vehicles ({EVs}) in view of {DRPs}. The investigation focuses on energy saving of residential homes under different {DRPs} and {RERs} integration. The {EVs} are integrated into {MG} by including photovoltaic ({PV}), wind turbine ({WT}), fuel cell ({FC}), and diesel engines ({DEs}). A multi-objective optimization problem has been formulated to minimize the operating cost, pollutant treatment cost, and carbon emissions cost defined as C1, C2, and C3, respectively. The load demand has been rescheduled because of three {DRPs}, i.e., critical peak pricing ({CPP}), real-time electricity pricing ({RTEP}), and time of use ({TOU}). Further, the {EV} load has also been analyzed in autonomous and coordinated charging strategies. Using a judgement matrix, the proposed multi-objective problem is transformed into a single-objective problem. The results of an artificial bee colony ({ABC}) algorithm are compared with the particle swarm optimization ({PSO}) algorithm. The simulation analysis was accomplished by employing {ABC} and {PSO} in {MATLAB}. The mathematical model of {MG} was implemented, and the effects of {DRPs} based {MG} were investigated under different numbers of {EVs} and load data to reduce different costs. To analyze the impact of {DRPs}, the residential, rural {MG} is implemented for 50 homes with a peak load of 5 {kW} each and {EV} load with 80 {EVs} and 700 {EVs}, respectively. The simulation results with different test cases are formulated while analyzing the tradeoff between {ABC} and {PSO} algorithms. The simulation analysis shows that multiple {DRPs}, {EVs}, and {RERs} offered a substantial trade-off. © 2013 {IEEE}.},
	pages = {7598--7638},
	journaltitle = {{IEEE} Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Ur Rahman Habib, H. and Waqar, A. and Hussien, M. G. and Junejo, A. K. and Jahangiri, M. and Imran, R. M. and Kim, Y.-S. and Kim, J.-H.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power transmission networks, Genetic algorithms, Multi-objective optimization, Particle swarm optimization ({PSO}), Energy efficiency, Distributed power generation, Stochastic systems, uncertainty analysis, distributed generation, Energy management, Power- generations, Fuel cells, Housing, Demand response programs, Electric vehicles, Electric vehicle, {MATLAB}, Uncertainty, Cost reduction, Resource management, Electric Vehicles ({EVs}), Residential microgrid, Demand response program, Demand response programs ({DRPs}), Distributed generations ({DG}), Joint sequential optimization, Residential microgrids, Sequential optimization},
}

@inproceedings{ur_rehman_design_2017,
	title = {Design and optimization of a De-centralized community sized solar heating system for Nordic Region},
	isbn = {978-3-9814659-7-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050562989&doi=10.18086%2fswc.2017.29.09&partnerID=40&md5=8f92e458f22d314cda0c12623c613115},
	doi = {10.18086/swc.2017.29.09},
	abstract = {There is a need to accelerate the application of advanced clean energy technologies to resolve the challenges of climate change. Solar heating is a feasible solution among clean energy technologies. These technologies are not yet highly used in high latitudes due to various challenges. This paper focuses on the community sized solar district heating system configuration for cold climates. The proposed configuration consists of a partially decentralized heating system. Each individual house heat pump was connected between large centralized solar-charged low temperature tank and smaller de-centralized individual high temperature tank in each house. Additionally, the large centralized tank was directly charged by solar-charged borehole storage during winters. Dynamic simulation approach was used through {TRNSYS} software coupled with {MOBO} (multi-objective building optimizer) for {NSGA}-{II} optimization algorithm. The purchased electricity and investments were two objectives minimized. The impact of the energy system on the renewable energy fraction, purchased electricity and investments as a function of the building heating demand, collectors and photovoltaic areas, short-term tanks storages and boreholes volumes were evaluated. Results showed that purchased electricity varied 47 {kWh}/m2/yr-25 {kWh}/m2/yr and renewable energy fraction 75\%-91\%. © 2017. The Authors.},

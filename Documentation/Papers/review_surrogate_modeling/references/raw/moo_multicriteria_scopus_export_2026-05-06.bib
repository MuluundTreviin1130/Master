	date = {2016},
	keywords = {Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Renewable energy, Decision making, optimization, Distributed power generation, distributed generation, Renewable energies, Investments, Algorithms, Pareto front, Radial distribution systems, Investment costs, Fuzzy decision making, Optimal allocation, Solution methodology, fuzzy decision making and Pareto front, Genetic optimization algorithm},
}

@inproceedings{hassan_mwoa_2020,
	title = {{MWOA} {FOR} {OPTIMAL} {INTEGRATION} {OF} {HYBRID} {RENEWABLE} {RESOURCES} {INTO} {THE} {DISTRIBUTION} {SYSTEMS} {FOR} {TECHNO}-{ECONOMIC} {BENEFITS}},
	isbn = {27324494},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181535325&doi=10.1049%2ficp.2023.0617&partnerID=40&md5=fefb4e5c3afe631b46950ad630632b58},
	doi = {10.1049/icp.2023.0617},
	abstract = {As a motivating solution for the Distributed Generation ({DG}) multi-objective optimization siting and sizing problem, this paper introduces the application of a modified nature-inspired algorithm for enhancing the performance of Electric Distribution Networks ({EDN}) through the integration of Hybrid Renewable Energy Resources ({RERs}). The Whale Optimization Algorithm ({WOA}), and then the Modified whale Optimization Algorithm ({MWOA}), have been employed in this study. The objectives are set to optimize the active power losses, the Voltage Stability, and the total costs, considering the constraints, which are represented in the {DG} penetration level and the {DG} units' operating power factor. The proposed algorithms have been applied on various benchmark {IEEE} test systems (30-bus and 118-bus) as small and large {EDN} models. The results show that the {MWOA} optimization technique is more effective and successful in determining the objectives in a minimum time within a minimum number of iterations. © The Institution of Engineering and Technology 2023.},

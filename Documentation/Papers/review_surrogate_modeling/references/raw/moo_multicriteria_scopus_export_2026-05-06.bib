	volume = {42},
	issn = {0253231X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100190817&partnerID=40&md5=ff7ca9c55ad27beaf55faa23602a7e1a},
	abstract = {Complementation of natural gas and renewable energy is an effective way to solve environmental pollution and overcome the instability of renewable energy. In this paper, a hybrid combined cooling, heating and power ({CCHP}) system coupled with solar and geothermal energy is proposed. Based on the operation strategy of following electric load ({FEL}) and following thermal load ({FTL}), the operation mode that the output ratio of ground source heat pump varies according to the hourly electricity prices and seasons is proposed. Taking the primary energy saving rate, annual cost saving rate and carbon dioxide emission reduction rate as objective functions, the optimization model of {CCHP} system is established, and the system configuration and operation strategy are optimized by using multi-objective genetic algorithm. The results show that the hybrid {CCHP} system can achieve the best performance in {FEL} mode. © 2021, Science Press. All right reserved.},

	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Decision making, Energy utilization, Life cycle, Photovoltaics, Solar panels, Costs, Heat pump systems, Energy-consumption, Decisions makings, Renewable energy applications, Curtain-walls, Dual-source heat pumps, Heat-pump systems, Photovoltaic modules, {PV} curtain wall},

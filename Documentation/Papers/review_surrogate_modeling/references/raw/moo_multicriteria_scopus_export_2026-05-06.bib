	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1},
}

@article{tavakolan_parallel_2022,
	title = {A parallel computing simulation-based multi-objective optimization framework for economic analysis of building energy retrofit: A case study in Iran},
	volume = {45},
	issn = {23527102},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118842784&doi=10.1016%2fj.jobe.2021.103485&partnerID=40&md5=e38b3b1a51b9682cd74c6008d680f633},
	doi = {10.1016/j.jobe.2021.103485},
	abstract = {The building sector represents a large share of rising global energy demand. Improving energy efficiency in existing building stock is a crucial strategy. Adopting the best energy retrofitting strategy in a specific building is a challenging task due to a plethora of possible combinations of retrofit measures and mutually contrasting objective functions. In addition, peculiar conditions of Iran, such as extremely subsidized energy prices, and step utility tariffs, escalate the challenges of building energy retrofit. Accordingly, the current study presents a simulation-based multi-objective optimization framework characterized by parallel processing structure and results-saving archive. The framework is implemented by integrating {MATLAB}® as an optimization engine with {EnergyPlus} as a dynamic energy simulator to minimize primary energy consumption and discounted payback period while maximizing the net present value. The algorithm explores a vast domain of possible solutions including, building envelope, cooling and heating systems, and renewable energy sources. The framework is applied to a single-family residence located in Iran. Three different scenarios are examined with reference to prospective energy pricing policies to evaluate their effect on the attractiveness of energy retrofit projects. For each scenario, final solutions are selected from respective Pareto fronts according to cost-optimality and energy-efficiency criteria and considering budget constraints. The results indicate that even though significant reductions in primary energy consumption can be achieved, implementing energy retrofit under the current energy pricing policy in Iran would not yield economic benefits. However, the elimination of subsidies along with offering incentives for building energy retrofits presents promising outcomes. © 2021 Elsevier Ltd},
	journaltitle = {J. Build. Eng.},
	publisher = {Elsevier Ltd},
	author = {Tavakolan, M. and Mostafazadeh, F. and Jalilzadeh Eirdmousa, S. and Safari, A. and Mirzaei, K.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Genetic algorithms, Multi-objective optimization, Energy efficiency, Energy utilization, genetic algorithm, Budget control, Buildings, Economic analysis, Cooling systems, Costs, Energy policy, Pareto principle, Investments, {MATLAB}, Optimization framework, Energy retrofit, Retrofitting, Building energy, Primary energy consumption, Building energy retrofit, Energy pricing, Parallel computing, pricing policy, Energy pricing policy, Parallel com- puting},
}

@article{tawfiq_optimal_2021,
	title = {Optimal Reliability Study of Grid-Connected {PV} Systems Using Evolutionary Computing Techniques},
	volume = {9},
	issn = {21693536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102636938&doi=10.1109%2fACCESS.2021.3064906&partnerID=40&md5=82eaf243f640209f4be416208ce5f2ed},
	doi = {10.1109/ACCESS.2021.3064906},
	abstract = {Integrating renewable energy sources ({RESs}) into electrical power systems has gotten highly noticeable among researchers and those interested in electrical energy production due to the increase in energy demands, fossil fuel exhaustion, and ecological effects. {PV}-based renewable energy generation is one of the essential {RESs} that has appeared and had played a vital role in electrical power systems recently due to their advantages. In this regard, this paper presents a multi-objective computation problem for optimal siting and the design of grid-tied {PV} systems to achieve optimum generating reliability, considering some states of different generation probabilities. The proposed paper studies the evaluation of the grid-tied {PV} systems reliability, the states of generation probabilities, the generation buses availabilities, the capacities of the generation's system in or out of service for each failure state, and the frequency and mean duration of generation failure states. The presented multi-objective computation problem is optimized using a modified adaptive accelerated particle swarm optimization ({MAACPSO}) algorithm. The effectiveness of the proposed method is demonstrated through {IEEE}\_EPS\_24\_bus integrated with {PV} systems. Results revealed the ability of {MAACPSO} to solve the multi-objective optimization problem presented, consequently supporting the system reliability.  © 2013 {IEEE}.},
	pages = {42125--42139},
	journaltitle = {{IEEE} Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Tawfiq, A.A.E. and El-Raouf, M.O.A. and Mosaad, M. I. and Gawad, A.F.A. and Farahat, M.A.E.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Particle swarm optimization ({PSO}), Multi-objective optimization problem, Solar power generation, Renewable energy generation, Electromagnetic wave emission, Reliability, Fossil fuels, System reliability, Fossil fuel power plants, Particle swarm optimization, Outages, Grid connected {PV} system, Reliability evaluation, Electrical power system, Accelerated particles, Failure rate, Computation problems, Evolutionary computing, optimum reliability, probability failure, {PV}{\textasciitilde}system, repair rate},
}

@article{tebibel_methodology_2021,
	title = {Methodology for multi-objective optimization of wind turbine/battery/electrolyzer system for decentralized clean hydrogen production using an adapted power management strategy for low wind speed conditions},
	volume = {238},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85105831949&doi=10.1016%2fj.enconman.2021.114125&partnerID=40&md5=ef2b8316dc69a9dcf4cc4d5267c6b574},
	doi = {10.1016/j.enconman.2021.114125},
	abstract = {In this study, the utilization of renewable energy sources ({RESs}) like wind energy for clean hydrogen production via water electrolysis in small-scale decentralized plant is addressed. This paper proposes an approach for multi-objective optimization of wind-hydrogen production system ({WHPS}) while satisfying multiple technical constraints based on a dynamic power and hydrogen management strategy ({PHMS}). {WHPS} consists of wind turbines ({WTs}), water electrolyzer, battery bank, power converters and hydrogen tank. Multi-objective optimization consists of minimizing the total hydrogen deficit ({THD}), energy dump possibility ({EDP}), levelized cost of hydrogen ({LCOH}) as well as {CO}2 emission avoided ({CO}2EA) and natural gas preserved ({NGP}). Battery assistance for electrolyzer is enhanced through a dynamic {PHMS} adapted to low wind speed conditions. {PHMS} based multi-objective optimization algorithm is developed to find Pareto-optimal solutions. The optimization results reveal that the adequate design of {PHMS} plays a crucial role in minimizing {THD}, {LCOH} and {EDP}, while ignoring the {EDP} objective may reduce potentially {LCOH}. Under the selected base case conditions, small-scale hydrogen production via {WHPS} consisting of 250 {kW} alkaline-electrolyzer, 857.5 {kW} {WTs}, 719 {kW} h battery bank and 2022 kg hydrogen tank, for supplying hydrogen demand at full reliability ({THD} = 0\%), results in {LCOH} of 33.70 \$/kg, {CO}2EA of 87.75 ton/year, {NGP} of 28.96 ton/year and {EDP} of 9.96\%. © 2021 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Tebibel, H.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric batteries, Wind power, Multi-objective optimization, Electrolytic cells, Electrolyzers, Hydrogen production, Wind, Pareto principle, Power management, Wind turbines, Energy, Levelized costs, Natural gas, Management strategies, Tanks (containers), Alkalinity, Hydrogen management, Levelized cost of hydrogen, Natural gas preserved, Power and hydrogen management strategy, Wind hydrogen production},
}

@article{tee_sizing_2023,
	title = {Sizing of Battery Energy Storage System: A Multi-Objective Optimization Approach in {DIgSILENT} {PowerFactory}},
	volume = {13},
	issn = {13090127},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186889547&doi=10.20508%2fijrer.v13i4.14232.g8838&partnerID=40&md5=e233f8bc432c16d32e96e1db843129e2},
	doi = {10.20508/ijrer.v13i4.14232.g8838},
	abstract = {In the paradigm of the increasing trend to prevent global warming, renewable energy sources applications integrated with battery energy storage system ({BESS}) are gaining attention for reducing the usage of fossil fuels in electrical power generation. In this regard, a multi-objective optimization script in {DIgSILENT} Programming Language ({DPL}) which links with software modelling and scripting simulation is developed in this study. Formulation for multiple objectives for optimization of {BESS} sizing with particle swarm optimization ({MOPSO}) and load flow simulation are applied in the {DPL} script. The considered objective functions aim to improve the network performance by reducing power loss, voltage deviations and system costs.Pseudo code of {BESS} optimal sizing with multi-objective algorithm is presented in this research. The {BESS} with optimal sizing was discovered for improving the network performance in the tested reference network. The optimal {BESS} size obtained is 2.94 {MW} with a system cost of {MYR} 2404.76. The total energy losses can be reduced by approximately 16\% from the base case energy losses with the optimal {BESS} size. The findings of the research reveal that the {BESS} sizing with {MOPSO} is applicable in {DPL} operations alone to solve power system problems. © (2023), (International Journal of Renewable Energy Research). All Rights Reserved.},
	pages = {1604--1613},
	number = {4},
	journaltitle = {Int. J. Renew. Energy Res.},
	publisher = {Gazi Universitesi},
	author = {Tee, W. H. and Qaid, K. A. and Gan, C. K. and Keek, J. S. and Sardi, J.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Battery storage, Electric batteries, Energy dissipation, Multi-objective optimization, Particle swarm optimization ({PSO}), Linear programming, Optimal systems, Global warming, Battery energy storage systems, Optimal sizing, Electric load flow, Fossil fuels, Particle swarm, Battery energy storage system, System sizings, Particle swarm optimization, Swarm optimization, System costs, System size, Computer software, Modeling languages, {DIgSILENT} {PowerFactory}},
}

@inproceedings{teh_maximization_2017,
	title = {Maximization of wind energy utilization through a multi-objective optimization framework},
	isbn = {21593442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85044174178&doi=10.1109%2fTENCON.2017.8227836&partnerID=40&md5=bc5e000f6bed185a1e685bfeee329adf},
	doi = {10.1109/TENCON.2017.8227836},
	abstract = {The integration of renewable energy sources, especially wind energy, has been on the rise throughout the power system worldwide. Due to this relatively new introduction, the integration of wind energy is often not optimized. Moreover, owing to the technical constraints and transmission congestion of the power network, much wind energy that could have reached load centers has to be curtailed. Due to various factors that influence the connectivity of wind energy, this paper proposes a well-organize posterior multi-objective ({MO}) optimization algorithm for maximizing the connection of wind energy. In this regards, the dynamic thermal rating ({DTR}) system and the static {VAR} compensator ({SVC}) have been identified as effective tools for improving the loadability of the network. The propose {MO} in this paper aims to minimize: (1) wind energy curtailment, (2) operation cost of the network considering all investments and operations, known as total social cost, and (3) {SVC} operation cost. © 2017 {IEEE}.},
	pages = {54--59},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Teh, J. and Koo, Y. C. and Lai, C.-M. and Cheng, Y.-H.},
	date = {2017},
	keywords = {Multiobjective optimization, Renewable energy resources, Wind power, Genetic algorithms, Energy utilization, genetic algorithm, optimization, Costs, Wind, Operating costs, Optimization algorithms, Investments, Integration of renewable energies, Static Var compensators, Transmission congestion, Technical constraints, {DTR} system, Dynamic thermal ratings ({DTR}), Static {VAR} compensators ({SVC}), {SVC}, Wind energy curtailments},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; {CODEN}: 85QXA},
}

@article{teng_integrated_2020,
	title = {Integrated Demand Side Response Model Considering Collaborative Optimization of Regional Multi-energy System Clusters},
	volume = {40},
	issn = {02588013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097500013&doi=10.13334%2fj.0258-8013.pcsee.191715&partnerID=40&md5=03596c5ff7b29bc0168bab64535ca9a9},
	doi = {10.13334/j.0258-8013.pcsee.191715},
	abstract = {Due to the increasing proportion of fluctuating power supply in regional multi-energy system, such as wind power and photovoltaic power, the ability of energy transformation and coordination is weakened. Therefore, the integrated demand side response model and response strategy solution algorithm for multi-objective collaborative optimization in multiple regional multi-energy systems interconnection were proposed in this paper. Firstly, the concept and mode of integrated demand side response were proposed. On such basis, the energy transformation model between different energy forms in multi-regional electric, gas and heat (cold) interconnection system was established. Then, a multi-objective optimization model of multi-regional electric, gas and heat (cold) interconnection system was established with minimum overall operating costs and minimum carbon emissions. Secondly, the strategy of multi-objective operation optimization scheduling for multi-regional electric, gas and heat (cold) interconnection system was established, and the collaborative optimization algorithm for multi-regional energy interconnection system based on {NSGA}-Ⅱ algorithm was established. Finally, on the basis of three-regional electric, gas and heat multi-energy systems in Northeast China, the integrated demand side response and its simulation model were established. The simulation results show that the integrated demand side response model and its optimal operation strategy proposed in this paper can effectively improve the energy coordination ability of multiple regional energy systems and the overall demand response ability of multi-energy interconnection systems. The demand side response costs are also reduced. © 2020 Chin. Soc. for Elec. Eng.},
	pages = {7282--7295},
	number = {22},
	journaltitle = {Zhongguo Dianji Gongcheng Xuebao},
	publisher = {Chinese Society for Electrical Engineering},

	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Energy supplies, Multi-objective optimization, Hydroelectric power plants, Hydrogen, Hydrogen system, Electric power system economics, Water, Integrated energy systems, Integrated energy system, New energies, Energies (power), Coupling optimization, Energy supply security, Hydropower system, safety culture},
}


@article{cabrera_large-scale_2021,
	title = {Large-scale optimal integration of wind and solar photovoltaic power in water-energy systems on islands},
	volume = {235},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102344706&doi=10.1016%2fj.enconman.2021.113982&partnerID=40&md5=ba15f039c08e14c9d81c1644232d5b3b},
	doi = {10.1016/j.enconman.2021.113982},
	abstract = {This paper presents a new method based on the Smart Energy System concept to link the water infrastructure and the energy system of an island. The principal aim of this study is to determine whether this new method can increase the contribution of renewables (wind power and photovoltaic) to the primary energy supply of the island. The method considers water production and treatment systems as flexible loads and explores a wide range of possible water supply infrastructures and {PV}/wind power combinations in the search for an optimal energy-water configuration. The final optimal solution is based on a balance between energy fuel needs and energy excesses, {CO}2 emissions, oil consumption, minimization of total annual costs and maximization of the renewable contribution. The proposed method increased the contribution of renewables from 5.14\% to 24.6\%. This corresponds to, on average, over 35\% of the hourly electricity demand throughout 2018 being covered by renewables, against the current 6.6\%. The study reveals that wind technology integration is of fundamental importance for renewable exploitation in insular water-energy systems, with wind energy contributing more than 70\% of the renewable participation in this case study. © 2021 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Cabrera, P. and Carta, J. A. and Lund, H. and Thellufsen, J. Z.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewables, Wind power, Solar power generation, Photovoltaic cells, Energy, Energy systems, Integration, Large-scales, Water treatment, Water supply, Energy-water planning, Energy-water synergies, Energy-water synergy, Pareto multi-objective optimization, Renewable energy integration on island, Renewable energy integration on islands, Smart energy-water system approach, Water energy},
}

@article{cagnano_online_2024,
	title = {An online cooperative control strategy for enhancing microgrid participation into electricity market},
	volume = {235},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199101022&doi=10.1016%2fj.epsr.2024.110846&partnerID=40&md5=859e190d9ef780e7059c4e987e8e94dd},
	doi = {10.1016/j.epsr.2024.110846},
	abstract = {This paper develops a cooperative control methodology for the online energy management of grid-connected microgrids. The main aim of this methodology is to actively manage the active power outputs of all dispatchable energy sources available within the microgrid as well as the power exchanged with the utility grid so as to match the total load demand at the minimum operating cost. This implies to solve a constrained multi-objective dynamic optimization problem aimed at minimizing the total microgrid operating costs and ensuring the real-time balance within the microgrid in compliance with its technical-operational constraints. Lyapunov's theorem using sensitivity theory is adopted to solve this optimization. To test the performances of the proposed control methodology, several computer simulations corresponding to different operating scenarios have been conducted on the {PrInCE} Lab experimental microgrid built at the Polytechnic University of Bari. © 2024},
	journaltitle = {Electr Power Syst Res},

	date = {2016},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power distribution, Genetic algorithms, Multi-objective optimization problem, optimization, distributed generation, distribution network reconfiguration, droop control, islanded microgrids, Non dominated sorting genetic algorithm ii ({NSGA} {II}), Operational characteristics, Operational constraints, Operational planning, Reconfiguration problems, Switching operations, Voltage instability proximity indices},
}

@article{abdelsattar_optimal_2024,
	title = {Optimal design and analyzing the techno-economic-environmental viability for different configurations of an autonomous hybrid power system},
	volume = {106},
	issn = {09487921},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184485547&doi=10.1007%2fs00202-024-02252-8&partnerID=40&md5=80fe0108905231917b7467e180b076e2},
	doi = {10.1007/s00202-024-02252-8},
	abstract = {In the present day, there is widespread acceptance of autonomous hybrid power systems ({AHPSs}) that rely on renewable energy sources ({RESs}), owing to their minimal adverse effects on the environment. This paper evaluates and compares three various {AHPS} configurations comprising photovoltaic ({PV}) modules, wind turbines ({WTs}), batteries, and diesel generators ({DGs}), using a recent optimization approach. A new optimizer 'Dandelion-Optimizer' ({DO}) is applied to tackle design problems. Real-time meteorological data from Siwa Oasis in northwest Egypt was utilized to determine an optimum design of system components for the purpose of providing sustainable power to this remote region. The system configurations are effectively modelled and optimized to achieve the minimum cost of energy ({COE}), while also minimizing the loss of power supply probability ({LPSP}) and carbon dioxide ({CO}2) emissions. As per the results, the last configuration ({PV} with both backup equipment) is the most optimal one in terms of the lowest cost, whereas the first configuration ({PV} and {WT} with both types of backup equipment) is the most optimal one with regards to the lowest carbon emissions. © The Author(s) 2024.},
	pages = {4747--4764},
	number = {4},

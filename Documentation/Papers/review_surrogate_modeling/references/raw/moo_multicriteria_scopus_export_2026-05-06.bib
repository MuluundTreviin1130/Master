	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@inproceedings{padamanabhan_renewable_2023,
	title = {Renewable Energy Storage Systems with Grid Connected Solar Using Multi-Objective Optimization Technique},
	isbn = {979-8-3503-2092-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85157986138&doi=10.1109%2fINOCON57975.2023.10101240&partnerID=40&md5=0315cd102523b120591dd8c86485839a},
	doi = {10.1109/INOCON57975.2023.10101240},
	abstract = {For renewable energy sources that are linked to a grid, the dynamic mode has been identified. To ensure dependable mode selection, the criticality of the load is taken into account. To maximize battery life, the Z-Soft Fuzzy Intelligence ({ZS}-Fuzzy) algorithm decides whether or not to equalize the battery. Battery energy power, net present cost, {LPSP}, prediction error, cost of energy, and variation rate are some of the key performance metrics used to evaluate the suggested model in comparison to the existing systems. The photovoltaic solar ({PV}) and wind hybrid {RES}, as well as the {PI} controllers in a storage solution utilized to smooth the output changes of those {RES}. How well the suggested model does in contrast to two widely used {AI} methods, the particle swarm optimization ({PSO}) and the genetic algorithm ({GA}). Thus, a comparative approach is used here. The suggested approach has been shown to be superior to both the {PSO} and {GA} algorithms in terms of convergence to the minimum value, resilience under stress, and tracking speed. In order to verify the effectiveness of the proposed techniques, a {MATLAB}/Simulink model was developed and optimization and simulation were performed on the proposed system. The optimization and simulation results demonstrated that the proposed approach is a viable one for addressing a wide range of technical issues.  © 2023 {IEEE}.},
	eventtitle = {2023 2nd International Conference for Innovation in Technology, {INOCON} 2023},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Padamanabhan, P. and Sharma, R.},
	date = {2023},
	keywords = {Multiobjective optimization, Electric batteries, Wind power, Genetic algorithms, Particle swarm optimization ({PSO}), Optimisations, Solar power generation, Storage systems, Photovoltaic systems, {MATLAB}, Multi-objective optimization techniques, Grid-connected, Renewable energy storages, Fuzzy approach, Fuzzy Approach and Grid {RES} Assessment, Fuzzy grids, Grid Connected Wind Energy},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: P. Padamanabhan; Galgotias University, Department of Computer Science and Engineering, Greater Noida, Uttar Pradesh, India; email: padmanabhan.p@galgotiasuniversity.edu.in},
}

@article{pallante_decision_2020,
	title = {Decision support methodologies and day-ahead optimization for smart building energy management in a dynamic pricing scenario},
	volume = {216},
	issn = {0378-7788},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082001664&doi=10.1016%2fj.enbuild.2020.109963&partnerID=40&md5=c1ed7eea759c5e292286d27c157501a8},
	doi = {10.1016/j.enbuild.2020.109963},
	abstract = {Nowadays identifying techniques aimed at a rational use of electric power has become even more important than the production of energy itself. This is caused by different factors, as the progressive saturation of the electricity grid, which is increasingly subject to connection requests, mainly due to the development of plants which exploit renewable energy sources. This work suggests a new approach based on the combination of the optimizer and the simulator developed in the {MATLAB}/Simulink environment, in order to reduce the energy costs in buildings during the summer while taking into consideration the user comfort. The electrical consumption of the entire building is taken into consideration is here examined with the aim of applying an air-conditioning system. The goal is to find, the day before, which is the optimal hourly scheduling of the control variables that must be applied the next day, taking into consideration all external conditions; weather conditions and the hourly energy price. In order to achieve this objective, the control variables, that have been changed, are the room temperature set points and the flow water temperature set point. As required by the {UNI} {EN} {ISO} 7730:2006 standard, comfort measurement is calculated by {PPD} (Predicted Percentage of Dissatisfied) index. Different scenarios are investigated and two optimization algorithms are compared. The results show that there is an average of 10−28\% potential cost saving, while maintaining a high level of comfort ({PPD} ≤ 12). The study is carried out by simulating a real office building in Italy, and the comparisons are shown regarding the actual settings applied to it. © 2020 Elsevier B.V.},
	journaltitle = {Energy Build.},
	publisher = {Elsevier Ltd},
	author = {Pallante, A. and Adacher, L. and Botticelli, M. and Pizzuti, S. and Comodi, G. and Monteriu, A.},
	date = {2020},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Costs, Optimization algorithms, {MATLAB}, Energy cost, Simulation, Air conditioning, Office buildings, Multi objective optimization, Building energy managements, Decision support systems, Electrical consumption, Identifying techniques, {MATLAB}/Simulink environment},
}

@inproceedings{pan_analysis_2023,
	title = {Analysis of demand response potential of industrial consumer based on multi-energy complementation},
	isbn = {979-8-4007-0951-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190361435&doi=10.1145%2f3644523.3644649&partnerID=40&md5=e719559e45c0dabeba3bd18925f8bb4d},
	doi = {10.1145/3644523.3644649},
	abstract = {With the continuous development of the social economy and the promotion of the carbon peaking and carbon neutrality goals, the new power system is connected to a high proportion of new energy, and the social electricity consumption is showing a continuous increasing trend. The peak valley difference of power grid load has become increasingly prominent, bringing greater challenges to the peak shaving of the power system. This article analyzes the potential of coal-fired self-owned power plant enterprises to participate in the optimization of source-grid-load operation. By analyzing the costs and benefits of reducing the various systems of plant power, it proposes a multi-objective optimization method for coal-fired self-owned power plants to consider minimizing economic costs, load fluctuations and risk fluctuations. The optimization method for plant power load participation in source-grid-load collaborative operation is proposed. Through example analysis, it has been proven that the participation of auxiliary power loads in the collaborative scheduling of source-grid-load can reduce peak load and fill valley load, effectively improve the utilization efficiency of unit auxiliary equipment, and reduce enterprise electricity costs.  © 2023 {ACM}.},
	pages = {690--695},
	publisher = {Association for Computing Machinery},
	author = {Pan, M. and Yuan, J. and Xu, Z. and Wang, G. and Yang, J. and Zhang, P.},

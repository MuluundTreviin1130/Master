	journaltitle = {Int J Energy Res},
	publisher = {John Wiley and Sons Ltd},
	author = {Han, X. and Liu, D. and Liu, J. and Kong, L.},
	date = {2017},
	keywords = {Multiobjective optimization, Particle swarm optimization ({PSO}), optimization, Multi-objective optimization models, Sensitivity analysis, Photovoltaic cells, energy storage, Digital storage, Energy storage systems, Particle swarm optimization algorithm, Renewable energy power, Calibration, Capacity configuration, data mining, Particles (particulate matter), acquisition granularity, continuous change state, Data mining technology, Filtration, sampling span},
}


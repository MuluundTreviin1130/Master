	author = {Han, J. and Du, E. and Lv, X. and Hou, J.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Renewable energy, Energy utilization, Life cycle, Carbon, Global warming, Energy systems, Investments, Natural gas, {MATLAB}, Carbon emissions, {ECONOMICS}, Integrated energy systems, Integrated energy system, Low carbon, optimal configuration, Pareto set, improved ε-constraint approach, life-cycle carbon emission, Natural gas energy},
}


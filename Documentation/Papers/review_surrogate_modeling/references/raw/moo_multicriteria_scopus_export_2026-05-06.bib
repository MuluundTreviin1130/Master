	keywords = {Renewable energy resources, Electric power distribution, Multi-objective optimization, Decision making, optimization, uncertainty analysis, distribution network reconfiguration, Multi-criteria decision making, Renewable power generation, {ECONOMICS}, Stochastic optimizations, Probability distributions, Active distribution network, Plug-in hybrid electric vehicles, Plug-in hybrid vehicles, Active distribution networks, Distributed energy generation, Electric power distribution systems, Evolutionary optimizations, Hybrid electric vehicles, Sustainable energy},
}


	doi = {10.1016/j.egyr.2021.11.201},
	abstract = {The high voltage direct current ({HVDC}) is widely incorporated into today's {AC} power grids. It is a key technology to address the issues for large power transmission and power flow control. However, the {HVDC} may influence the consumption-ability of systems for renewable energy sources ({RES}). This paper studies the solvability region in the {AC}–{DC} system with {HVDC} under the volatile {RES} generation and system operation constraints. The set of all admissible injection patterns of {RES} is termed dispatchable region, which is depicted by the Pareto frontier of multi-objective optimization problems. An adopted ε-constraints method is used to solve the multi-objective optimal power flow problem. Cases study on an adopted {IEEE}-30 bus system are provided to analyze the impaction of {HVDC} control strategies and parameters. © 2021},

@inproceedings{li_multi-objective_2022,
	title = {Multi-Objective Optimal Dispatching Strategy for Active Distribution Network Considering Controllable Load and Energy Storage},
	isbn = {978-1-6654-7896-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149576311&doi=10.1109%2fCCDC55256.2022.10034127&partnerID=40&md5=7ef9fe7dcf2ddc4ac94b8423e55a9a2c},

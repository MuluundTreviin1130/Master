}

@article{dougier_multi-objective_2021,
	title = {Multi-objective non-weighted optimization to explore new efficient design of electrical microgrids},
	volume = {304},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118770203&doi=10.1016%2fj.apenergy.2021.117758&partnerID=40&md5=4ece85fe4ee9bf788cb46bba98290f80},
	doi = {10.1016/j.apenergy.2021.117758},
	abstract = {Centralized electrical networks induce a dependency of local territories for their power supply. However, thanks to microgrids, territories can increase their decision-making autonomy to design a network that matches their values. Technological and management choices are critical to minimize microgrids negative impacts on their environment. Influence of the latter on the design space is rarely discussed whereas extending the design space would help to find innovative microgrids. The purpose of this paper is to find several microgrids with various performances and parameters that are compromises between economic, technical and environmental objectives. The solutions’ variety therefore extends the decision-makers’ design space. A tool has been developed to answer this goal. Design parameters are both technological and management parameters. A physical modelling is implemented in a sequential simulation of the microgrid operation. The performance of the simulation allows to use genetic algorithms to perform multi-objective non-weighted optimizations. Two two-objective optimizations are performed. Results show how the solutions’ diversity in terms of performances and parameters helps the user choosing innovative microgrids. Especially, it underlines the potential of this approach to find microgrids with close performances but different parameters. © 2021},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Dougier, N. and Garambois, P. and Gomand, J. and Roucoules, L.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Decision making, genetic algorithm, Microgrid, Optimisations, Multi objective, performance assessment, Simulation, Performance, modeling, Innovation, detection method, management practice, Decision support systems, Parameter estimation, Design spaces, autonomy, best management practice, Decision-support tool, Efficient designs, Electrical micro-grids, Energy system simulation, Energy system simulations, industrial performance, Microgrid modeling, Microgrid modelling},
}

@article{drabecki_multi-objective_2022,
	title = {Multi-Objective Approach for Managing Uncertain Delivery from Renewable Energy Sources within a Peer-to-Peer Energy Balancing Architecture},
	volume = {15},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123161183&doi=10.3390%2fen15030675&partnerID=40&md5=aa19ce919ddd8b88485c349c893d29a6},
	doi = {10.3390/en15030675},
	abstract = {On the energy markets, conscious customers may exist who are not only interested in minimising the cost of energy purchase, but, simultaneously, in optimising some other quality criteria (arising from ecological concerns, or social responsibility of the energy producers). In this paper, we develop both a mathematical optimisation problem and a market framework for balancing a power system in a peer-to-peer market setup, where product differentiation can be considered directly on the market. Thus, origins of energy may be clearly identified, and product quality characteristics can be understood by various actors (including households). We derive a multi-objective (mixed-integer) linear programming optimisation problem for balancing the energy system in a peer-to-peer energy trading environment, where not only the cost but also other additional quality criteria are considered. We have identified many possible actors to be present within the proposed market setup. They include consumers, producers, brokers and flexible prosumers with storage. The approach was tested on the {IEEE} 30-bus standard test system, over three different scenarios, by analysing the impact of various actors/peers activities and different extensions. It has been shown that a multi-objective energy balancing scheme may be developed through crafted optimisation problem and that each type of studied peers may bring some added value to the power system balancing. © 2022 by the authors. Licensee {MDPI}, Basel, Switzerland.},
	number = {3},
	journaltitle = {Energies},
	publisher = {{MDPI}},
	author = {Drabecki, M. and Toczyłowski, E.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Linear programming, Multi-objective optimisation, Energy policy, Integer programming, Energy, Peer to peer, Peer to peer networks, Power markets, Distributed computer systems, Network architecture, Energy sharings, Peer-to-peer energy sharing, Network constraints, Energy trade, Market architecture, Market architectures, Multi-commodity, Multi-commodity offer, Multi-commodity offers, Product differentiation},
}

@inproceedings{drogemuller_extended_2022,
	title = {An extended optimization model for decentral multi-energy systems including cold district heating for the integration of renewable heating and cooling},
	volume = {2022-October},
	isbn = {978-1-6654-8032-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143807258&doi=10.1109%2fISGT-Europe54678.2022.9960562&partnerID=40&md5=a8f868138a70c2b21c313a74a552d7f1},
	doi = {10.1109/ISGT-Europe54678.2022.9960562},
	abstract = {The latest generation of district heating networks, the so-called cold district heating networks, are characterised by a system temperature between 5°C and 35°C. This allows for the efficient integration of renewable heat sources with low supply temperatures. Furthermore, cold district heating networks enable the district's cooling demand to be met centrally. These advantages can play an important role in the future design of sustainable decentralized energy systems, as the heating sector is still predomiantly fueld by fossile resources and cooling demands rise. In this context, this paper highlights the modelling of cold district heating networks in an existing multi-criteria optimization model for decentral multi-energy systems. This enables the possibility to investigate the techno-economic and -ecologic efficiency of cold district heating networks and their competition and synergies with other design options especially in the interlinked heat, cooling and electricity sectors. Exemplary results of the applied model exhibit the required and achieved detail in the modeling. For the analysed district, we identify an optimal grid temperature of 18°C. The main parameters influencing this ideal grid temperature are the grid heat pumps efficiency and the heat losses within the grid.  © 2022 {IEEE}.},

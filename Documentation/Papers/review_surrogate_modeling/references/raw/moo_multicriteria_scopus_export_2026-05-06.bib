	date = {2021},
	keywords = {Electric power transmission networks, Power system planning, Wind power, Multi-objective optimization, Renewable energy, Energy utilization, uncertainty analysis, Optimization algorithms, Investments, {ECONOMICS}, Electric power system economics, Economy, Economic operations, Renewable energy power, Electric power system planning, Solar power plants, Flexibility, Renewable energy consumption, Expansion planning, Electric lines, Transmission capacities, Transmissions, Power grid operations, Power system planning and operation},
}


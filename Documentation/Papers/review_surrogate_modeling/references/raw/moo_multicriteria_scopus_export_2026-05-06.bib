}

@inproceedings{ruzive_optimising_2024,
	title = {Optimising Hybrid Energy Solutions for Hydrogen Production in South Africa},
	isbn = {979-8-3503-9118-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216019843&doi=10.1109%2fICECCME62383.2024.10796753&partnerID=40&md5=be61175f285f4bb3845307596c7e8644},
	doi = {10.1109/ICECCME62383.2024.10796753},
	abstract = {South Africa's heavy reliance on coal for electricity generation contributes adversely to global warming. This has led to a national initiative to transition to variable renewable energy sources for electricity and green hydrogen production. However, the variability and intermittency of the renewable energy sources raises reliability and efficiency concerns. To help improve the reliability and efficiency of the variable renewable energy systems, this paper proposes a Hybrid Hydrogen Energy System optimisation model, which uses wind and solar energy to power a Proton Exchange Membrane electrolyser for green hydrogen production. The Non-dominated Sorting Genetic Algorithm {II} is used to implement the optimisation. The optimisation objectives considered for the study are minimisation of total system cost and maximisation of system efficiency at high system reliability. Results demonstrate that total system cost and system efficiency are successfully optimised. This highlights {NSGA}-{II}'s potential for optimising larger hybrid hydrogen energy systems in South Africa, which can contribute to an increase in the reliability and efficiency of variable renewable energy systems. © 2024 {IEEE}.},

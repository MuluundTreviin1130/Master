@article{chen_optimizing_2024,
	title = {Optimizing solar full-spectrum integration in a methanol-driven district energy system: A comprehensive ecological assessment},
	volume = {478},
	issn = {0959-6526},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206194900&doi=10.1016%2fj.jclepro.2024.143912&partnerID=40&md5=353eb438fc656375ba8e1aec98c71fee},
	doi = {10.1016/j.jclepro.2024.143912},
	abstract = {Incorporating local solar resources into traditional energy systems to meet various building needs has the potential to enhance the adoption of renewable energy sources and address environmental concerns. Departing from conventional approaches that rely solely on solar power or thermal energy, this study proposes a novel energy system driven by full-spectrum solar energy and methanol, leveraging thermal-chemical reactions utilizing both renewable and waste thermal energy. Through device modeling and multi-objective optimization, configurations are optimized considering ecological carbon emissions and costs to assess specific carbon footprints and techno-environmental performance. Findings reveal that indirect carbon emissions, accounting for over 50\% of total emissions from an ecological perspective, result in higher environmental and economic burdens compared to conventional methods. The system achieves energy and exergy efficiencies of 90.9\% and 62.1\%, respectively, under ideal configurations. Sensitivity analysis demonstrates that cities with high cooling demands necessitate larger heat pump capacities, leading to increased specific costs and reliance on the power grid, while higher capacities of solar devices reduce costs at the expense of reduced consumption rates. This research provides valuable insights into maximizing the utilization of local solar resources across the full spectrum to meet diverse production demands. © 2024 Elsevier Ltd},
	journaltitle = {J. Clean. Prod.},
	publisher = {Elsevier Ltd},
	author = {Chen, Y. and Yang, K. and Guo, W. and Wang, J. and Du, N. and Lund, P. D.},
	date = {2024},
	keywords = {Sensitivity analysis, Energy, Zero-carbon, Carbon sequestration, Carbon capture and utilization, Anthropogenic, Ecological perspective, Environmental costs, Full-spectrum, Sensitivity analyzes, Solar full-spectrum utilization, Solar resources, Specific techno-environmental cost, Spectrum utilization, Thermal chemical reactions, Thermal modeling, Thermal-chemical reaction},
}

@article{chen_multi-objective_2023-2,

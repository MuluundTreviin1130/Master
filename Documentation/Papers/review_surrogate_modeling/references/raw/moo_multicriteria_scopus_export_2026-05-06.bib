@inproceedings{hui_research_2020,
	title = {Research on charge and discharge control strategy of electric vehicles in building micro-grid based on V2G mode},
	isbn = {978-1-7281-7687-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100934971&doi=10.1109%2fCAC51589.2020.9327601&partnerID=40&md5=fbba34a39f993b20b896d2827e6c84fb},
	doi = {10.1109/CAC51589.2020.9327601},
	abstract = {The application of electric vehicle V2G technology in the building micro-grid is to take the electric vehicle as a movable energy storage unit to participate in the coordinated control of the electric energy flow in the building micro-grid. Based on the characteristics of the electric vehicle's power consumption period and behavior, the energy storage potential of the vehicle battery is analyzed, and the optimization model of the electric vehicle participating in the building microgrid response based on the V2G working mode is constructed. The established multi-objective function is transformed into a single-objective optimization function in a weighted manner, and the objective function is optimized by combining genetic algorithm, and the weights in the optimization function are adjusted to meet the relevant needs of the building micro-network and users. Electric vehicles participate in the coordinated control of the building micro-grid through V2G technology, which can reduce the peak-to-valley difference of the building micro-grid load to a certain extent, while also reducing the cost of electric vehicle users. © 2020 {IEEE}.},

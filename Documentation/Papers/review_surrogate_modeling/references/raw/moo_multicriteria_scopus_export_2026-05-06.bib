	author = {Li, M. and Li, J.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy management systems, Multi-objective optimization, Microgrid, Energy management, Photovoltaics, Micro-Grid, Smart grid, System models, Timing circuits, Demand side response, Energy management strategy, Management method, Energy circuits, Model method, Systems management},
}

@inproceedings{li_multi-objective_2023-3,
	title = {Multi-Objective Optimization for Dynamic {VAR} Planning based on Power System Partitioning Method},
	isbn = {979-8-3503-4009-9},

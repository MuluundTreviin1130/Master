@article{lokeshgupta_dynamic_2022,
	title = {Dynamic Economic and Emission Dispatch with Renewable Energy Integration Under Uncertainties and Demand-Side Management},
	volume = {104},
	issn = {09487921},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122260233&doi=10.1007%2fs00202-021-01476-2&partnerID=40&md5=bcb6d40a323b1bc234059f17cf94b1e0},
	doi = {10.1007/s00202-021-01476-2},
	abstract = {Integration of renewable energy resources ({RERs}) along with demand-side management ({DSM}) is almost inevitable in the present scenario to meet the growing energy demand with minimum environmental pollution. This paper proposes a combined model of dynamic economic and emission dispatch ({DEED}) and {DSM} with the integration of renewable energy resources ({RERs}). In this analysis, the {DSM} load shifting scheme is incorporated with the {DEED} problem to obtain the generation-side operational benefits as well as the reduction in environmental pollution level. In this study, various smart home appliances and their complex constraints are included in the {DSM} load shifting process. The variability and stochastic nature of the load demand and {RERs} such as solar and wind are modeled with Normal, Beta, and Weibull distribution functions, respectively. The proposed model is implemented in both deterministic and stochastic approaches with the help of non-dominated sorting genetic algorithm ({NSGA}-{II}) and Monte Carlo Simulation ({MCS}) approach. In the stochastic model, the {MCS} approach appropriately handles the uncertainties of system load demand and {RERs}. Four different case studies are carried out in the simulation analysis to show the impacts of {RERs} and {DSM} integration on the traditional {DEED} problem. © 2022, The Author(s), under exclusive licence to Springer-Verlag {GmbH} Germany, part of Springer Nature.},
	pages = {2237--2248},
	number = {4},
	journaltitle = {Electr Eng},
	publisher = {Springer Science and Business Media Deutschland {GmbH}},
	author = {Lokeshgupta, B. and Sivasubramani, S.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Electric load dispatching, Genetic algorithms, Multi-objective optimization, Pollution, Intelligent systems, Monte Carlo methods, Stochastic systems, Demand side management, Costs, Environmental pollutions, Stochastic models, Pareto principle, Distribution functions, Integration, Integration of renewable energies, Renewable energy integration, Renewable energy integrations, Uncertainty, Automation, Electric utilities, Economic dispatch problems, Load shifting, Dynamic economic dispatch, Emission dispatch problem, Economic and emission dispatch, Dynamic economic and emission dispatch},
}

@inproceedings{lombardi_multi_2011,

@article{gao_multi_2021,
	title = {Multi Agent Coordinated Optimal Control Strategy for Smart Microgrid Based on Digital Twin Drive},
	volume = {45},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85107597542&doi=10.13335%2fj.1000-3673.pst.2020.2278&partnerID=40&md5=e50d13ba8740517b3c974481173d81db},
	doi = {10.13335/j.1000-3673.pst.2020.2278},
	abstract = {With the increasing panoramic information of load, weather, equipment, electricity-gas-heat multi-energy flow in the power system operation, it is difficult for the traditional power system modeling and simulation technology to adapt to the needs of future intelligent energy system operation control. The digital twin technology combined with machine learning, communication network, high-performance analysis and calculation, and internet of things can effectively solve this technical problem. Firstly, according to the basic definition and application scenarios of digital twin technology in different fields at home and abroad, this paper discusses the construction modes and the future development ideas of digital twin technology for a smart energy system, and designs the digital twin and multi-agent control architecture of the smart microgrid considering multi communication protocol interaction. Considering the physical space, the digital space and their coupling relationship, this paper decomposes the whole life cycle management process of the smart microgrid, and constructs the regulation resource agent, the regulation process agent and the regulation service agent. Then, it constructs the digital and physical twin of the system, and uses the twin data of the distributed components and the surrounding environment collected by the sensors to update the database. Finally, the smart microgrid test model based on the Opal-{RT} hardware in the loop simulation platform is constructed, and the {UDP}(user datagram protocol) is used to sense the test data in real time to verify the control strategy proposed in this paper in the two working scenarios of microgrid grid connection and island. The results show that the smart microgrid is implemented in the actual system according to the optimized test scheme of the digital twin, and the implementation interacts with the digital twin system in real time to provide the operation guidance for the whole life cycle management. © 2021, Power System Technology Press. All right reserved.},
	pages = {2483--2491},
	number = {7},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Gao, Y. and He, X. and Ai, Q.},
	date = {2021},
	keywords = {Life cycle, Microgrids, Multi agent systems, Digital storage, Electric power system control, Network architecture, Power system operations, Optimal control systems, Combined power prediction, Coupling relationships, Digital twin, Distributed components, Distributed database systems, Engineering education, {HIL} simulation, Multi-agent, Multi-objective optimization decision, Optimal control strategy, Surrounding environment, Traction (friction), Traditional power system, {UDP} communication, User datagram protocol, Whole-life cycle managements},
}

@inproceedings{gao_multi-objective_2024,
	title = {Multi-Objective Optimization of a Integrated {PV}-{CSP}-Wind Power System Under Two Different Operational Mechanisms},
	isbn = {979-8-3315-1661-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000468083&doi=10.1109%2fIFEEA64237.2024.10878642&partnerID=40&md5=aa78f9d3fafd9a85d0ba567d58b1451a},
	doi = {10.1109/IFEEA64237.2024.10878642},
	abstract = {As the pace of the energy transition accelerates, the {PV}-{CSP}-wind integrated system has gained increasing attention to address the intermittency and volatility challenge of renewable energy sources. In order to integrate the study with real-world applications, this research explores two distinct operational mechanisms of a hybrid system, comprising various elements such as a {CSP} power plant, thermal energy storage, photovoltaic ({PV}) panels, wind turbines, batteries, and electric heaters. A multi-objective optimisation for the design parameters of subsystems is performed in the two operational mechanisms considering actual load curve and time-sharing tariff. As the result, the {PPT} mechanism shows remarkable advantages in subsystem capacity and operational characteristics compared with the {DPI} mechanism. Under the {DPI} mechanism, the required wind farm capacity varies from 0.4MW to 971.9 {MW}, accompanied with the {LPSP} decreases from 69.99\% to 9.83\% and the {LCOE} rises from 0.1212/{kWh} to 3.2391/{kWh}. While in {PPT} mechanism, a wind farm capacity of 0.2-254.4 {MW} can reach a better {LCOE} of 0.1212-0.5019/{kWh} and lower {LPSP}. © 2024 {IEEE}.},
	pages = {1194--1199},
	publisher = {Institute of Electrical and Electronics Engineers Inc},

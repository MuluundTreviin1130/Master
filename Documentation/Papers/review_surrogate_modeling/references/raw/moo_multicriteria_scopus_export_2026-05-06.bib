@inproceedings{pramodini_multi_2022,
	title = {Multi Objective Optimization of {PV}/Wind Hybrid Renewable Energy System for A Zero Net Energy Campus},
	isbn = {978-1-6654-9499-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136328735&doi=10.1109%2fINCET54531.2022.9824135&partnerID=40&md5=ad9cc5681d42ed68f98f7a00d7cb7444},
	doi = {10.1109/INCET54531.2022.9824135},
	abstract = {In the recent days, large-scale solar power plants and wind farms have been widely used as an alternative to fossil fuels, nuclear, geothermal and hydro power generation. However, these resources will not be reliable enough if used on their own at smaller capacities since they may result in an inefficient and over-sized design when used individually. This challenge could be solved by hybridizing the sources. The ideal design of a hybrid power system is generally complicated due to the uncertainty of {PV} and wind sources induced by varying climate conditions. This paper intends to financially and reliably optimize a grid-interactive Zero Net Energy Campus using the Strength Pareto Evolutionary Algorithm ({SPEA}2) optimization technique. Bi-objective and tri-objective optimization is performed and the results are compared for various scenarios. The former considers Cost and {LPSP} as its objectives and the Payback period is also included as an objective in the latter. Finally, the Technique for Order of Preference by Similarity to Ideal Solution ({TOPSIS}) method is used to achieve one optimal solution set from a huge number of solution sets in the Pareto front. The outcomes of numerous case studies were compared and examined. By further taking into account the preference of the decision-maker, the most reliable configuration of the {HRES} can be obtained. © 2022 {IEEE}.},
	eventtitle = {2022 3rd International Conference for Emerging Technology, {INCET} 2022},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Pramodini, N. and Rajan Singaravel, M. M. and Niveditha, N.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Wind power, Decision making, Wind turbines, Energy systems, Hybrid renewable energies, Hybrid renewable energy system, Investments, Solar energy, Fossil fuels, wind turbine, Multi objective optimization, Geothermal energy, Ideal solutions, Solar power plants, {PV} panel, Solution algorithms, {PV} panels, {SPEA}2 algorithm, Technique for order of preference by similarity to ideal solution algorithm, {TOPSIS} algorithm, Zero Net Energy Campus},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 3; Correspondence Address: N. Pramodini; National Institute of Technology, Puducherry, Department of Electrical and Electronics Engineering, Karaikal, India; email: pramo2704@gmail.com},

	keywords = {Multiobjective optimization, Wind power, Genetic algorithms, Environmental impact, Fuel cells, Hydrogen storage, Housing, cost analysis, Variable renewable energies, Ammonia, Engines, Sustainable energy, Local energy systems, Economic performance, Cost estimating, Ammonia production, Economically viable, Hydrogen transport, Power-to-fuel, Renewable energy storage, Residential districts, Sustainable fuel},

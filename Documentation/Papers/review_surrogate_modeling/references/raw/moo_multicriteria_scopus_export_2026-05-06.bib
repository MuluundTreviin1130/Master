	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric load dispatching, Energy management systems, Multi-objective optimization, Optimisations, Distributed power generation, distributed generation, Energy management, Solar power generation, Wind turbines, Cost benefit analysis, Cost reduction, game theory, distributed generation ({DG}), Outages, Power systems reliability, Index, Generation cost, {DG} cost, Distributed generation cost, energy management ({EM}) system, Expected outage cost, expected outage cost ({ECOST}), game theory approach, Outage cost},
}


@inproceedings{contreras_multi-objective_2018,
	title = {Multi-objective probabilistic power resources planning for microgrids with ancillary services capacity},
	isbn = {978-1-910963-10-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85051490355&doi=10.23919%2fPSCC.2018.8450878&partnerID=40&md5=e7e639030e0c9edccc5195c94ea1a256},
	doi = {10.23919/PSCC.2018.8450878},
	abstract = {Microgrids have become an attractive strategy to guaranty a reliable, efficient and sustainable electricity delivery to the distribution network, as well as to offer effectively ancillary services to the power utility. Therefore, special features have to be introduced to the planning methodology, while the optimization problem has also to be re-evaluated to contemplate the large number of variables, multiple objectives, and different constraints and uncertainties. Hence, a probabilistic multi-objective microgrid planning methodology based on the optimal size and location of distributed generation is proposed. In this methodology, the mismatch power in islanded mode and the annual energy losses in grid-connected mode are minimized, while the residual power for reserve provision is maximized. For that purpose, probabilistic models, distributed storage units, and constructive constraints are contemplated in the methodology. The methodology is tested in an adapted {PG}\&E 69-bus distribution system and the {NSGAII} optimization method is used to solve the optimization problem. © 2018 Power Systems Computation Conference.},
	eventtitle = {20th Power Systems Computation Conference, {PSCC} 2018},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Contreras, S. F. and Cortes, C. A. and Myrzik, J.M.A.},
	date = {2018},
	keywords = {Multiobjective optimization, Energy dissipation, Multi-objective optimization, Micro grid, Microgrid, Optimization problems, Distribution systems, Planning, Ancillary service, Ancillary services, Attractive strategies, Electricity delivery, Metaheuristic, Probabilistic models},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 9},
}

@article{contreras_optimal_2019,
	title = {Optimal microgrid planning for enhancing ancillary service provision},
	volume = {7},
	issn = {2196-5420},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067086407&doi=10.1007%2fs40565-019-0528-3&partnerID=40&md5=660dcfe765a92834d4ef93ad89dcf151},
	doi = {10.1007/s40565-019-0528-3},
	abstract = {Microgrids have presented themselves as an effective concept to guarantee a reliable, efficient and sustainable electricity delivery during the current transition era from passive to active distribution networks. Moreover, microgrids could offer effective ancillary services ({AS}) to the power utility, although this will not be possible before the traditional planning and operation methodologies are updated. Hence, a probabilistic multi-objective microgrid planning ({POMMP}) methodology is proposed in this paper to contemplate the large number of variables, multiple objectives, and different constraints and uncertainties involved in the microgrid planning. The planning methodology is based on the optimal size and location of energy distributed resources with the goal of minimizing the mismatch power in islanded mode, while the residual power for {AS} provision and the investment and operation costs of the microgrid in grid-connected mode are maximized and minimized, respectively. For that purpose, probabilistic models and a true multi-objective optimization problem are implemented in the methodology. The methodology is tested in an adapted {PG}\&E 69-bus distribution system and the non-dominated sorting genetic algorithm {II} ({NSGA}-{II}) optimization method and an analytic hierarchy process for decision-making are used to solve the optimization problem. © 2019, The Author(s).},
	pages = {862--875},
	number = {4},
	journaltitle = {J. Mod. Power Syst. Clean Energy},
	publisher = {Springer Heidelberg},
	author = {Contreras, S. F. and Cortes, C. A. and Myrzik, J.M.A.},
	date = {2019},
	keywords = {Multiobjective optimization, Distributed resources, Genetic algorithms, Multi-objective optimization, Decision making, Micro grid, Microgrid, Multi-objective optimization problem, Optimization problems, Non dominated sorting genetic algorithm ii ({NSGA} {II}), Investments, Planning, Active distribution networks, decision-making, Ancillary service, Ancillary services ({AS}), Traditional planning},
}

@article{contreras_probabilistic_2020,
	title = {Probabilistic multi-objective microgrid planning methodology for optimizing the ancillary services provision},
	volume = {189},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089488264&doi=10.1016%2fj.epsr.2020.106633&partnerID=40&md5=7daf383db623e54ae1d2f3efefeb61a4},
	doi = {10.1016/j.epsr.2020.106633},
	abstract = {Microgrids have attracted the attention of researchers and stakeholders because of their well-known impacts and related benefits. Especially the provision of ancillary services has drawn attention. However, traditional planning should be re-defined to optimally achieve such promising advantages, which leads to a complex decision-making problem that should be progressively addressed with a more modern and comprehensive holistic approach. Hence, this paper proposes an enhanced version of the probabilistic multi-objective microgrid planning methodology ({POMMP}2) that includes a novel strategy to apply graph partitioning and metaheuristic optimization to consider simultaneously the planning of a cluster-based topology with the size and location of distributed energy resources under the paradigm of a microgrid with capacity for providing ancillary services. {POMMP}2 is tested in an adapted {IEEE}-37 node system, and {NSGAII} and {AHP} are used as optimization and decision-making algorithms, respectively. Results show the benefits of a planning methodology viewed as a comprehensive problem and not a set of independent tasks. © 2020 Elsevier B.V.},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Contreras, S. F. and Cortés, C. A. and Myrzik, J.M.A.},
	date = {2020},
	keywords = {Multi-objective optimization, Decision making, Microgrids, optimization, Energy resources, Micro-grid planning, distributed energy resources, Meta-heuristic optimizations, Topology, Ancillary services, Traditional planning, Graph Partitioning, Independent tasks, Location based services, Networked microgrid, Optimization and decision makings, Planning methodology, Probabilistic, Topology planning},
}

@inproceedings{correa-delval_appliance_2022,

	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: J. Gui; East China Jiaotong University, School of Electrical and Automation Engineering, {NanChang}, China; email: 17339829010@163.com},
}

@inproceedings{guixi_two-tier_2023,
	title = {Two-tier optimal scheduling of microgrid cluster distribution system based on energy interaction},
	isbn = {979-8-3503-2269-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185374055&doi=10.1109%2fiSPEC58282.2023.10403076&partnerID=40&md5=045260c6bcc295a6977e7d3e74d2f094},
	doi = {10.1109/iSPEC58282.2023.10403076},
	abstract = {Vigorously developing new energy is an inevitable choice for constructing a new type of power system and promoting energy transformation. The article presents a two-tier optimization and scheduling method for microgrid cluster distribution systems considering energy sharing. Firstly, considering the collaborative interaction mechanism between the distribution system and microgrid system, a two-tier optimization framework for microgrid cluster distribution systems based on energy interaction is established. Secondly, considering the energy interaction among microgrids, a lower-level model is established to minimize the system cost of the microgrid cluster. Then, taking into account operating costs and net load peak-valley differences, an upper-level multi-objective optimization model for the distribution system is established, and a method for transforming and solving the multi-objective model is proposed. Finally, case analysis is conducted using {MATLAB}, and the results demonstrate that the proposed optimization method effectively reduces the operating costs of both the distribution system and the microgrid cluster system while alleviating the net load peak-valley differences in the distribution system. © 2023 {IEEE}.},
	eventtitle = {2023 {IEEE} Sustainable Power and Energy Conference, {iSPEC} 2023},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Guixi, M. and Xin, W. and Liang, Y. and Wei, H. and Hui, M.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power distribution, Multi-objective optimization, Microgrid, distribution system, Distribution systems, Operating costs, Cost benefit analysis, Optimization method, Optimal scheduling, Cluster distributions, energy interaction, Energy interactions, Microgrid cluster, Microgrid clusters, Peak- valley, Two tiers},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1},
}


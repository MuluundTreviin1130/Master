	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 4; Correspondence Address: A.T.D. Perera; Solar Energy and Building Physics Laboratory ({LESO}-{PB}), Ecole Polytechnique Fédérale de Lausanne ({EPFL}), Lausanne, {CH}-1015, Switzerland; email: dasun.perera@epfl.ch},
}

@article{perera_sensitivity_2012,
	title = {Sensitivity of internal combustion generator capacity in standalone hybrid energy systems},
	volume = {39},

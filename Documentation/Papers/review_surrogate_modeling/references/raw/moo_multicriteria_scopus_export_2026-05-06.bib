	author = {Cao, Y. and Gao, C. and Liu, Z. and Liu, J. and Liu, M.},
	date = {2021},
	keywords = {Multiobjective optimization, Electric power transmission networks, Genetic algorithms, Particle swarm optimization ({PSO}), Energy efficiency, Solar power generation, Electric energy storage, Electric vehicles, Electric vehicle, Digital storage, Screening, Energy storage systems, Multi objective particle swarm optimization, Fast charging stations, Electric Vehicles ({EVs}), Electric power system economics, {MOPSO}, Electricity prices, Scheduling strategies, Charging and discharging, Economic performance, Fast charging (Batteries), Photovoltaic generation, Predictive analytics, Scheduling strategy, Software engineering},

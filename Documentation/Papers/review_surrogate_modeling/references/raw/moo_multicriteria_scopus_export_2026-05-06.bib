}

@article{lu_multi-objective_2017-1,
	title = {Multi-objective Optimal Sizing for Distributed Generation of Isolated Hybrid Microgrid Using Markov-based Electromagnetism-like Mechanism},
	volume = {37},
	issn = {02588013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85020211016&doi=10.13334%2fj.0258-8013.pcsee.152851&partnerID=40&md5=1757654adc04ba87f8498e19180392f2},
	doi = {10.13334/j.0258-8013.pcsee.152851},
	abstract = {Taking the comprehensive optimum of economy, environmental protection and energy efficiency as the objective, and the system reliability as the constraint, an optimal allocation model of distributed generation in the hybrid microgrid was built. The common optimization process needed to be iterated through the annual data for time series analysis, which would result in extensive computations and low operation efficiency. To solve this problem, the fuzzy c-means clustering algorithm ({FCM}) was used to extract typical operational scenarios from the annual 8760 h wind speed, light and load data. Then the corresponding Markov models were built by using stochastic process method. To get rid of the subjectivity of artificial weight, the entropy theory was introduced to determine the weight coefficient of multi-objective function. Moreover, the population mobile strategy, self-adaptive variable steps, genetic variations and reduction of search space according to the proportion coefficient were adopted to improve the convergence of electromagnetism-like mechanism ({ELM}). Finally, the aforementioned Markov models were embedded in the improved {ELM} for optimization solution. Taking Guangxi Weizhou Island as a case study, the effectiveness of the models and algorithms were verified. The results show that, compared to chronology-based {ELM}, the proposed Markov-{ELM} has obvious advantages in rapidity, accuracy and global convergence. © 2017 Chin. Soc. for Elec. Eng.},
	pages = {1927--1936},
	number = {7},
	journaltitle = {Zhongguo Dianji Gongcheng Xuebao},
	publisher = {Chinese Society for Electrical Engineering},
	author = {Lü, Z. and Tan, Y. and Li, J. and Wang, H. and Wang, X.},
	date = {2017},
	keywords = {Multiobjective optimization, Multi-objective optimization, Energy efficiency, Micro grid, optimization, Distributed power generation, Stochastic systems, Stochastic models, Wind, Random processes, Fuzzy systems, Clustering algorithms, Isolated microgrid, Markov processes, Time series analysis, Entropy, Fuzzy clustering, Electromagnetism-like mechanism, Electromagnetism-like mechanisms, Entropy theory, Fuzzy C mean, Fuzzy C-means, Markov model},
}

@inproceedings{luhao_multi-objective_2015,
	title = {Multi-objective optimization scheduling of combined cold heat and power system with multi-renewable energy},
	isbn = {19341768},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84946565312&doi=10.1109%2fChiCC.2015.7260065&partnerID=40&md5=8800207a587fa67c9e20a2b8d678cc62},

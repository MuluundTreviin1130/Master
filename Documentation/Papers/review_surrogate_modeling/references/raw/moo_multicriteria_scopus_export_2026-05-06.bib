	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power distribution, Evolutionary algorithms, Multi-objective optimization, optimization, Optimization problems, Distributed power generation, Distribution systems, Solar power generation, Operating costs, Operation cost, Automation, annual operation cost, Evolutionary techniques, power loss, Power-losses, Process control, solar distributed generation, {SPEA}2, Strength pareto evolutionary algorithm},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 5},
}

@article{ben_taher_multi-objective_2022,
	title = {Multi-objective optimization of a grid-connected {PV} system for a public building: Faculty of Sciences and Technology at Pau},

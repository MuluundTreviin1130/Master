	isbn = {17551307},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85056872759&doi=10.1088%2f1755-1315%2f189%2f5%2f052085&partnerID=40&md5=592dfa5772cef328b0fb772cc1ffee71},

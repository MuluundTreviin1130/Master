@article{musharavati_artificial_2022,
	title = {Artificial neural network-based Sobol algorithm for multi-objective optimization of renewable energy supply in buildings: A transient approach},
	volume = {46},
	issn = {0363907X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85132846764&doi=10.1002%2fer.8274&partnerID=40&md5=d07f980e785cd0f0fc89baf01ff34d6e},
	doi = {10.1002/er.8274},
	abstract = {The need to increase the share of renewable energy supply in buildings has been a subject of concern for many authors. Renewable energies can offset building electrical and thermal energy loads, thus reducing constrains on national grid networks. The aim of this paper is to construct, model and optimize a hybrid renewable energy supply system under transient conditions. The supply system consists of solar-{PV} panels and vertical axis wind turbines, while batteries are used for energy storage. {TRNSYS} software is used to model the energy demand of an office building that operates under the average standard building as specified in {EnergyPlus} software. In order to determine the optimal size of the energy supply system an Artificial Neural Network ({ANN}) combined with a Sobol algorithm are employed. Two objective functions are developed to: (a) minimize the cost of purchasing solar-{PV} panels and wind turbines, and (b) minimize the electricity required from the national grid network. The simulation and optimization results show that the best condition is achieved with 461 panels and one vertical axis wind turbine. At this best condition, the amount of electricity required from the national grid network is 5.55 {MWh}/year, and this will cost 2.4 \$/h. Moreover, 3\% of electricity will be obtained from the grid, 31\% from batteries and 66\% are supplied directly through panels and turbines. © 2022 John Wiley \& Sons Ltd.},
	pages = {21326--21337},
	number = {15},
	journaltitle = {Int J Energy Res},
	publisher = {John Wiley and Sons Ltd},
	author = {Musharavati, F.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Battery storage, Electric batteries, Electric power transmission networks, Energy supplies, Genetic algorithms, Multi-objective optimization, genetic algorithm, Renewable energies, Wind turbines, Energy supply system, Neural networks, Artificial neural network, Office buildings, In-buildings, {TRNSYS}, Vertical axes wind turbines, Grid network, National Grid, Solar {PV} panels, solar-{PV} panels, vertical axis wind turbines},
}

@inproceedings{muthamizhan_optimization_2024,
	title = {Optimization Techniques and Algorithmic Control in Power Electronics for Renewable Energy Systems},
	isbn = {979-8-3503-6469-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000015355&doi=10.1109%2fIC3TES62412.2024.10877626&partnerID=40&md5=6b143c2e4a29c3e25f7a9f5e75324592},
	doi = {10.1109/IC3TES62412.2024.10877626},
	abstract = {The research area of interest covers the application of mathematical optimization, and control theory in power electronics interfacing renewable energy systems to achieve higher efficiency, reliability and system performance. In this context, the Paper's key strengths are proposed as follows: By identifying the suitable datasets and designing the improved optimization techniques like genetic algorithm, particle swarm optimization, and neural network the proposed methodology intends to overcome the issue associated with the variability and intermittency of the renewable energy sources. Ensured to work with efficient software tools like {MATLAB}/Simulink and Python the methodology has undergone simulation and real world tests. Results demonstrated significant improvements: efficiency was raised to a level of 7-8\%, at the same time as the cost was decreased in the range of 16\%. Between 7-20\%, power quality had received improvement in voltage and frequency fluctuations that was reduced to half; while the reliability factor increased to 5\%. The outcomes of this study underscore the ability of multi-objective optimization in development of proper balanced solutions for the analysis of renewable energy system. Furthermore, the study stresses the necessity of a steady examination and fine-tuning process for the effective incorporation of {RES} into the power grid and the effective and eco-friendly power supply. As for the future works, Component performance optimization, compatibility with current infrastructure and effective control of large distributed generation should be the focus of future researches. © 2024 {IEEE}.},

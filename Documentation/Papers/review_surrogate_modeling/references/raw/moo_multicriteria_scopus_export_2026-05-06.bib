	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: K.R. Kurte; Jio Platforms Limited, Ai Centre of Excellence, India; email: kuldeep.kurte@gmail.com},
}

@article{kusatake_peer--peer_2023,
	title = {A Peer-to-Peer Energy Trading Model for Optimizing Both Efficiency and Fairness},
	volume = {16},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166271855&doi=10.3390%2fen16145501&partnerID=40&md5=9e2b1ab1572315b345cfdfff57f2a082},
	doi = {10.3390/en16145501},
	abstract = {In recent years, there has been a growing global trend towards transitioning from centralized energy systems to distributed or decentralized models, with the aim of promoting the widespread utilization of renewable energy sources. As a result, the concept of direct energy trading among consumers has garnered considerable attention as a means to effectively harness the potential of distributed energy systems. However, in this decentralized trading scenario, certain consumers may encounter challenges in receiving electricity from their preferred suppliers due to limited supply capacities. As a result of this constraint, there is a reduction in the advantages enjoyed by consumers. While previous studies have predominantly focused on optimizing resource allocation efficiency, the issue of equitable consumer benefits has often been overlooked. Therefore, it is crucial to develop a trading mechanism that considers the preferences of market participants, in addition to balancing supply and demand. Such a mechanism aims to enhance both fairness and efficiency in the market. This paper introduces the formulation of a single-objective optimization and multi-objective optimization problem for an electricity market trading mechanism. To address this challenge, two single-objective algorithms and six evolutionary algorithms ({EAs}) are employed to solve the optimization problem. By analyzing the simulation results, this study demonstrates the efficacy of the chosen evolutionary algorithms ({EAs}) and a single-objective optimization approach in effectively optimizing both the utilization of resources and the equitable distribution of consumer benefits. © 2023 by the authors.},
	number = {14},
	journaltitle = {Energies},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Kusatake, E. and Imahori, M. and Shinomiya, N.},
	date = {2023},
	keywords = {Multiobjective optimization, Renewable energy resources, Evolutionary algorithms, Efficiency and fairness, Energy trading, Graph theory, Peer to peer, Power markets, Trading models, Single objective optimization, Decentralized energy, Trading mechanism, Consumer benefits, Decentralized energy transaction, decentralized energy transactions, multi-objective evolutionary optimization, Multi-objective evolutionary optimizations},
}

@inproceedings{kusatake_efficiency_2023,
	title = {Efficiency and Fairness in P2P Transactions with Variable Pricing for Electricity},
	isbn = {979-8-3503-6151-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85200001719&doi=10.1109%2fCSCI62032.2023.00170&partnerID=40&md5=f832e8ad73f3295922f92c18439e1396},
	doi = {10.1109/CSCI62032.2023.00170},
	abstract = {With the promotion of renewable energy projects, there has been a growing emphasis on decentralized models in the electricity trading system instead of centralized transactions. One of the models gaining attention in decentralization is Peer-to-Peer (P2P) trading. By leveraging P2P trading, not only power utilities but also general consumers participating in the market can secure effective benefits. In this study, using P2P trading, we propose an optimal method considering fairness to ensure improvement in the interests of each consumer without monopolization of benefits within the market. The methodology covers both single-objective and multi-objective optimization. For multi-objective optimization, we will employ evolutionary algorithms. Additionally, as a differentiation from prior research, we approach the electricity unit cost as real-world data, utilizing it as a variable data. © 2023 {IEEE}.},
	pages = {1029--1033},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Kusatake, E. and Shinomiya, N.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Evolutionary algorithms, Evolutionary algorithm, Costs, Energy policy, Efficiency and fairness, electricity trading, Energy trading, Graph theory, Peer to peer, Peer to peer networks, Peer-to-peer energy trading, Power markets, Centralised, Renewable energy projects, Decentralized models, Trading systems},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@article{kwon_multi-objective_2020,
	title = {Multi-objective optimization of home appliances and electric vehicle considering customer's benefits and offsite shared photovoltaic curtailment},
	volume = {13},

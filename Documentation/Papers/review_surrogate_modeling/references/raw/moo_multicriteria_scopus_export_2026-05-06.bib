	author = {Shen, H. and Zhang, H. and Xu, Y. and Chen, H. and Zhu, Y. and Zhang, Z. and Li, W.},
	date = {2022},
	keywords = {Multiobjective optimization, Electric power transmission networks, Genetic algorithms, Gas emissions, Electric power generation, Carbon, Multi objective, Organic Rankine Cycle, Rankine cycle, Organics, Virtual storage, Waste heat, Waste heat utilization, Integrated energy systems, Integrated energy system, Configuration optimization, Capacity configuration, Energy couplings, Carbon Singular Point, Heterogeneous energy coupling, Singular points},
}

@article{shen_microgrid_2016,
	title = {Microgrid operation optimization with regulation of grid tie-line power fluctuations and risk management},
	volume = {26},
	issn = {20507038},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84961784478&doi=10.1002%2fetep.2203&partnerID=40&md5=69290a987912aa9285b35987ff3fed57},
	doi = {10.1002/etep.2203},
	abstract = {This paper presents a novel multi-objective energy management method for a microgrid that includes renewable energy, diesel generators, battery storage, and various loads. The fluctuation of the grid tie-line power flow is regarded as one of the optimal objectives in order to decrease the power exchange between the microgrid and the main grid caused by intermittent and variable renewable resources. The uncertainty of renewable energy and loads is also considered in this paper. Stochastic optimization method is implemented for the output of renewable resources and controllable loads. Using the ε-constrained and weighted sum method, the multi-objective operation optimization problem, which includes the minimum microgrid operation costs, fluctuations of the grid tie-line power, and the risk management, is converted to a single-objective mixed-integer linear optimization problem. The scheduling is achieved for controllable units such as diesel generators, batteries, controllable loads, and grid tie-line power under various weights. The main contribution of the study is to achieve the energy management for a microgrid with regulation of the grid tie-line power fluctuations and peak shaving. Copyright © 2016 John Wiley \& Sons, Ltd. Copyright © 2016 John Wiley \& Sons, Ltd.},
	pages = {2308--2321},
	number = {11},
	journaltitle = {Int. Trans. Elecr. Energy Sys.},
	publisher = {John Wiley and Sons Ltd},
	author = {Shen, J. and Jiang, C. and Liu, Y. and Wang, X. and Qian, J.},
	date = {2016},
	keywords = {Multiobjective optimization, Electric batteries, Electric power transmission networks, Multi-objective optimization, Renewable energy, Micro grid, Microgrid, optimization, Linear programming, Energy management, Renewable energies, Integer programming, Electric load flow, Electric power system control, Constrained optimization, Operation optimization, Peak shaving, Microgrid operations, risk management, Stochastic optimization methods, Controllable loads, Controllable load, Mixed-integer linear optimizations},
}

@article{shen_multi-objective_2024,
	title = {A Multi-Objective Optimization Method of Sustainable Wind–Photovoltaic–Hydro Systems Considering Source–Grid Coordination},
	volume = {16},
	issn = {2071-1050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181920425&doi=10.3390%2fsu16010061&partnerID=40&md5=94d7ac010961b6873186e37b557db38d},
	doi = {10.3390/su16010061},
	abstract = {Hydropower compensating for wind and solar power is an efficient approach to overcoming challenges in the integration of sustainable energy. Our study proposes a multi-objective scheduling model for the complementary operation of wind–photovoltaic–hydro systems. The model aims to maximize the total generation while minimizing the mean square deviation of the system output and grid load. Taking wind and solar bases and key peak-shaving cascade hydropower stations in Hubei Province as a case study, various multi-objective Pareto solution sets were obtained for different scheduling periods. The analysis dissects the relationship between total generation and the stability of residual load after adjustment by the wind–photovoltaic–hydro systems. Furthermore, the study analyzes the role that a complementary system should play in the power grid and discusses the effect of cascade hydropower scheduling methods on the operational characteristics of multi-energy complementary systems. © 2023 by the authors.},
	number = {1},
	journaltitle = {Sustainability},

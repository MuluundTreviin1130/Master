@article{pereira_multiobjective_2018,
	title = {A Multiobjective Optimization Model for the Design of Hybrid Renewable Energy Systems},
	volume = {16},
	issn = {15480992},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071300408&doi=10.1109%2fTLA.2018.8804258&partnerID=40&md5=c25d57de384c290a0bede27f5ac2e062},
	doi = {10.1109/TLA.2018.8804258},
	abstract = {Fossil fuels are the main energy sources nowadays. Nevertheless, they issue huge amount of carbon dioxide and other byproducts to atmosphere boosting air pollution and greenhouse effect. Beside those issues fossil fuels are vehicles of geopolitical and market instability and bad wealth distribution among countries. The consequent environment impact and increasing energy costs impose the need for other cleaner and equitable sources. Hybrid renewable energy systems ({HRES}) poses as viable alternative sources for conventional fossil fuels. In this paper, we present a multiobjective optimization model in {MILP} for the selection and sizing of components of {HRES}, which considers sustainability criteria in objective function. The model is dynamic in the sense of what technologies should be selected (activated) and what should be withdraw (deactivated) within the planning horizon to satisfy optimization criteria and demand dynamics. The model was conceived for evaluating energy generation and charge technologies and it is general enough to cover all kinds of energy technologies. The suitability of the model is tested for different hypothetical scenarios. Results demonstrated the model is suitable to assist decision makers in planning strategically the energy resource needs in different contexts. © 2003-2012 {IEEE}.},
	pages = {2925--2933},
	number = {12},
	journaltitle = {{IEEE}. Lat. Am. Trans.},
	publisher = {{IEEE} Computer Society},
	author = {Pereira, M. T. and Rego, E. E. and Nagano, M. S.},
	date = {2018},
	keywords = {Multiobjective optimization, Renewable energy resources, Decision making, Hybrid renewable energy systems, optimization, Multi-objective optimization models, Sustainable development, Carbon dioxide, Integer programming, Multi objective, Hybrid Renewable Energy System ({HRES}), Fossil fuels, Strategic planning, Mixed integer programming, Greenhouse effect, Sustainability criteria, Multiobjective, Increasing energy costs, Optimization criteria},
}

@inproceedings{perera_multi_2011,
	title = {Multi objective optimization of lifecycle cost, unmet load, and renewable energy capacity for an expansion of existing standalone Internal Combustion Generator ({ICG}) systems},
	isbn = {978-0-7918-5468-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84879090301&doi=10.1115%2fES2011-54287&partnerID=40&md5=76decae03d429c0cb7c158bcd6c5e26d},

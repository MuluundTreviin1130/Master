	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Particle swarm optimization ({PSO}), Photovoltaics, Wind turbines, Multi-energy systems, Integration, Multi energy, Configuration optimization, Capacity configuration, Energy-integration, Integration systems, Multi-energy integration, port},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: Z. Chen; State Key Laboratory of Maritime Technology and Safety, Wuhan University of Technology, Wuhan, China; email: zhechen@whut.edu.cn; Y. Yuan; State Key Laboratory of Maritime Technology and Safety, Wuhan University of Technology, Wuhan, China; email: ypyuan@whut.edu.cn},

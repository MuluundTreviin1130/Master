	volume = {36},
	issn = {10001026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84867853131&doi=10.3969%2fj.issn.1000-1026.2012.17.007&partnerID=40&md5=1ab83d36d93cc27735117a693599a927},
	doi = {10.3969/j.issn.1000-1026.2012.17.007},
	abstract = {Aimed at the island microgrid integrated with wind turbine, photovoltaic, diesel generator, energy storage, and desalination plant, a multi-objective optimal design model considering the allocation ratio of net present cost ({NPC}) in the full life cycle, the utilization of renewable energy and the pollutant emission level is proposed. The optimal number of distributed generators and the optimal capacity of energy storage are determined as optimization variables. Based on the established control strategy, a floating elitist preserved genetic algorithm is used to solve this problem. The island microgrid is designed and the simulation results are compared with the {HOMER} optimization results to illustrate that the proposed method is more reasonable and feasible than that of {HOMER}. © 2012 State Grid Electric Power Research Institute Press.},

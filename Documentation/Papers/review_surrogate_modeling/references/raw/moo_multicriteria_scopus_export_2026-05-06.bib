@inproceedings{chalishazar_paired_2024,
	title = {Paired Hydro-Battery Hybrid System Operations Using {MIQP} Based Multi-Objective Optimization},
	isbn = {19449925},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212410956&doi=10.1109%2fPESGM51994.2024.10761091&partnerID=40&md5=d041f9945fe29b957c13e5a6a7a99b62},
	doi = {10.1109/PESGM51994.2024.10761091},
	abstract = {Hybridizing a hydropower plant with a battery energy storage system is often a very expensive decision. So to make the case for feasibility of hybridization the cost benefit analysis must be comprehensive. Most literature found on this subject only uses one out of many different available value streams to carry out a feasibility analysis. To that end, in this study we propose a multi-objective optimization formulation and a mixed-integer quadratic programming optimization engine that considers multiple different value streams and optimizes hydro-battery hybrid system paired operations to maximize revenue generated from energy arbitrage while simultaneously minimizing the total hydro turbine mileage thus reducing turbine starts and stops and improving turbines life all while following all environmental constraints and not violating any limitations either regulatory or preferential (i.e., to support recreational activities like white water rafting, etc.), In this study we also implemented the developed optimization methodology to a real-world case study of Bagnell dam hydropower facility (8 units totaling 240 {MW} rated power capacity) which is owned and operated by our industry partner Ameren. The case study outcomes shows that by hybridizing the Bagnell dam hydropower facility with a 60 {MW} x 2-hr battery energy storage system, the annual benefits can be increased over 6 million while reducing the annual mileage averaged per turbine and number of start/stops by over 98\% and 85\% respectively. © 2024 {IEEE}.},
	eventtitle = {{IEEE} Power and Energy Society General Meeting},
	publisher = {{IEEE} Computer Society},
	editor = {Chalishazar, V. H. and Ma, X. and Harnish, R. and Somani, A. and Wu, D. and Bhatnagar, D. and Bellgraph, B. and Hartt, T.},
	date = {2024},
	keywords = {Multi-objectives optimization, Battery management systems, Battery storage, Multi-objective optimization, Renewable energy, Hybrid power, Renewable energies, Integer programming, Battery energy storage systems, Cost benefit analysis, Hydropower, Hydroelectric power, Hydroelectric power plants, Battery energy storage system, Integer Linear Programming, Mixed-integer linear programming, Mixed integer quadratic programming, Case-studies, Taxation, quadratic programming, Asset management, Assets management, Battery hybrid systems, Chemical laboratories, Energy arbitrage, Energy arbitrages, Financial markets, Hydraulic turbines, Research laboratories, Value streams},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: V.H. Chalishazar; Pacific Northwest National Laboratory, Energy \& Environment Directorate, Richland, 99354, United States; email: vishvas.chalishazar@pnnl.gov},
}

@article{chamandoust_multi-objective_2020,
	title = {Multi-objective operation of smart stand-alone microgrid with the optimal performance of customers to improve economic and technical indices},
	volume = {31},
	issn = {2352152X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089153926&doi=10.1016%2fj.est.2020.101738&partnerID=40&md5=d206c2d16696fa8ba825db596ca99d74},
	doi = {10.1016/j.est.2020.101738},
	abstract = {he operation problem of the Smart Stand-Alone Microgrids ({SSAMGs}) considering the economic and the technical indices is investigated in many studies. The aim of the most studies is to meet the demand of the system with the minimum cost and high reliability considering the technical constraints of the system. In this paper, maximizing the {RES} penetration and improving the voltage profile of the system are modeled besides the minimization of the operation cost through a multi-objective optimization model. Moreover, the demand side management ({DSM}) strategies consisting of the demand shifting ({DS}) and the demand curtailing ({DC}) are employed in the decision-making problem of the {SSAMGs} to improve its economic and technical indices. To analysis the performance of the system, the battery bank ({BB}) lifetime and the peak-to-average ratio ({PAR}) indices are used. The resulted model is solved by the augmented epsilon-constraint approach in General Algebraic Modeling System ({GAMS}) optimization software environment. The best solution is selected using the fuzzy and the weight sum approaches. To investigate the effectiveness of the model and its solution methodology, it is applied on the {IEEE} 33-bus through defining four case studies. The results show the better performance of the objective functions in the presence of {DSM} strategies. Moreover, the {PAR} and the {BB} lifetime indices are improved when the {DSM} strategies are used in the {SSAMGs} to meet the demand. © 2020 Elsevier Ltd},
	journaltitle = {J. Energy Storage},
	publisher = {Elsevier Ltd},
	author = {Chamandoust, H. and Bahramara, S. and Derakhshan, G.},
	date = {2020},
	keywords = {Multiobjective optimization, Decision making, Microgrids, Objective functions, Multi-objective optimization models, Demand side management, Demand Side Management ({DSM}), Electric utilities, Peak to average ratios, Optimal performance, Augmented epsilon-constraint approach, Customer's participation, Decision-making problem, Multi-objective optimal operation, Optimization software, Smart Stand-Alone Microgrid ({SSAMG}), Solution methodology, Technical constraints},
}

@article{chamandoust_energy_2021,
	title = {Energy management of a smart autonomous electrical grid with a hydrogen storage system},
	volume = {46},
	issn = {03603199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85103703361&doi=10.1016%2fj.ijhydene.2021.02.174&partnerID=40&md5=5845a602baf185f90355990038852343},
	doi = {10.1016/j.ijhydene.2021.02.174},
	abstract = {The problem of energy management in the smart autonomous electrical grids ({SAEGs}) is a main challenge in the active distribution networks. In such systems, the operator of the network decides on the optimal scheduling of the resources to supply the local demand. In this paper, a multi-objective optimization model is developed for a {SAEG} considering responsive consumers ({RCs}) and a hydrogen storage system ({HSS}). The objective functions are maximizing the reliability and minimizing both the operation cost and the gap between the energy consumption and its optimal value. The participation of the {RCs} is modeled through the demand shifting strategy and the local generation of the plug-in electric vehicles. To model the uncertainties of the renewable energy sources and the demand, the Monte Carlo simulation approach is used. The resulted model is solved using the shuffled frog leaping algorithm ({SFLA}) regarding which the non-dominated solutions are generated. Then, the best solution is obtained using the fuzzy and the weighted sum methods. To investigate the effectiveness of the proposed model, it is applied on a 24-node test system through defining four case studies. The results shown that in the presence of the {RCs} and the {HSS}, the operation cost and the reliability of the system both improve. © 2021 Hydrogen Energy Publications {LLC}},
	pages = {17608--17626},
	number = {34},
	journaltitle = {Int J Hydrogen Energy},
	publisher = {Elsevier Ltd},
	author = {Chamandoust, H. and Hashemi, A. and Bahramara, S.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Energy management systems, Energy utilization, Multi-objective optimization models, Intelligent systems, Monte Carlo methods, Energy management, Hydrogen storage, Plug-in Electric Vehicles, Operating costs, Energy, Active distributions, Operations cost, Optimal scheduling, Hydrogen storage system, Autonomous electrical grids, Multi-objective optimization approach, Responsive consumer, Responsive consumers, Shuffled frog leaping algorithm},
}

@article{chammam_multiobjective_2023,
	title = {Multiobjective optimization and performance assessment of a {PEM} fuel cell-based energy system for multiple products},
	volume = {337},
	issn = {00456535},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163862433&doi=10.1016%2fj.chemosphere.2023.139348&partnerID=40&md5=16208bfa665391eb3193ac900d724444},
	doi = {10.1016/j.chemosphere.2023.139348},
	abstract = {In this article, the optimal design of a novel multi-generation system for the production of electricity, cooling, heat and freshwater is discussed. In this system, a Proton exchange membrane fuel cell ({PEM} {FC}) is used to generate electricity, and the heat produced by it is absorbed by the Ejector Refrigeration Cycle ({ERC}) and used to provide cooling and heating capacity. A reverse osmosis ({RO}) desalination system is also used to supply freshwater. The esign variables in this research are operating temperature and pressure and current density of {FC}, as well as the operating pressure of the {HRVG}, evaporator, and condenser of the {ERC} system. In order to optimize the considered system, the exergy efficiency and total cost rate ({TCR}) of the system are considered as optimization objective functions. To this end, the genetic algorithm ({GA}) is used and the Pareto front is extracted. Also, three refrigerants R134a, R600 and R123 areused as {ERC} system refrigerant and their performance are evaluated. Finally, the optimal design point is selected. At the mentioned point, the exergy efficiency is 70.2\% and the {TCR} of the system is 1.78 S/h. © 2023 Elsevier Ltd},

	date = {2020},
	keywords = {Multiobjective optimization, Electric load dispatching, Electric power transmission networks, Decision making, Multi-objective optimization problem, Renewable energies, Energy management system, Electric power system economics, Renewable energy power, Renewable energy accommodation, Optimization strategy, Power system, Automatic generation control, Multiple constraint, Human intervention, Real time dispatches, Real-time dispatch},
}

@article{wang_case_2022,
	title = {Case studies of a distributed building energy system incorporating with {EVs} considering effects of random charging behaviors and time-of-use pricing in electricity},
	volume = {38},
	issn = {2214157X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137155652&doi=10.1016%2fj.csite.2022.102297&partnerID=40&md5=4644fd1bd0419303e6c934e3a800a3e8},
	doi = {10.1016/j.csite.2022.102297},
	abstract = {Reaching carbon neutrality needs global actions in various industry sectors. Building energy systems and electric vehicles ({EV}) are two main contributors to the decarbonization in the energy and transportation sectors, and the distributed building energy system with {EV} charging driven by renewable energy can greatly reduce carbon emissions. However, in the research about distributed building energy systems with {EVs}, the time-of-use ({TOU}) pricing of the grid and uncertain {EVs} charging loads (caused by random daily miles, departure/return time, and charging modes) are not considered simultaneously, which will influence the performances of the system. In this research, a distributed building energy system with {EV} is studied under the uncertain {EV} charging behaviors and {TOU} pricing of electricity, and the corresponding operation strategy is designed. The economic, environment, renewable energy penetration, and power trading performances are analyzed, and the crucial parameters of the system are optimized with three goals of minimum electricity cost, maximum renewable energy utilization ratio, and minimum net power purchase from the grid simultaneously based on the nondominated sorting genetic algorithm {II} ({NSGA}-{II}). The optimal system is analyzed from the perspective of energy flow and typical daily operation. The influences of the {EV} fast charging ratio and carbon tax on the optimal system are also studied. According to the results, the electricity cost, renewable energy utilization ratio, and net power purchase can be 0.0773 \$ {kWh}-1, 54.3\%, and 172.65 {MWh} year-1 simultaneously.  © 2022 The Authors.},
	journaltitle = {Case Stud. Therm. Eng.},
	publisher = {Elsevier Ltd},
	author = {Wang, B. and Yu, X. and Wu, Q. and Li, Z. and Jiang, R. and Qian, G. and Huang, R.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Genetic algorithms, Multi-objective optimization, Renewable energy, Energy utilization, Buildings, Optimal systems, Carbon, Costs, Renewable energies, Charging (batteries), Electric vehicle charging, Performance, Electricity costs, Building energy systems, Energy utilization ratio, Distributed building energy system, Time-of-use pricing, Uncertain electric vehicle charging, Uncertain {EV} charging},
}

@article{wang_analysis_2019,
	title = {Analysis of operation cost and wind curtailment using multi-objective unit commitment with battery energy storage},
	volume = {178},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064873123&doi=10.1016%2fj.energy.2019.04.108&partnerID=40&md5=93930fc3d6e76f82fa495c6f143292cf},
	doi = {10.1016/j.energy.2019.04.108},
	abstract = {In modern power systems, the increasing penetration of renewable energy provides promising ways to operate the system at low cost and low pollution. Unfortunately, the noticeable uncertainties caused by the forecast errors of renewable generation as well as power load restrict the utilization of renewable energy (e.g. cause wind curtailment), and moreover, bring unprecedented challenges to maintain system reliability (e.g. cause load shedding which generally leads to high compensation). One prevailing solution is to prearrange sufficient spinning reserve of thermal units, which however, deviates from the ambition of cost saving. This paper analyzes the relationship between operation cost and wind curtailment amount using multi-objective unit commitment. The main contents include: First, systems with mixed generation sources including thermal units, wind farms and battery-based energy storage are investigated, whereafter Value-at-Risk-based worst-case estimations on load shedding and wind curtailment are established under hybrid uncertainties. Second, operation cost with generation, emission and load shedding concerns is established, whereafter multi-objective optimization is performed to investigate the inherent nature between operation cost and wind curtailment. Third, a multi-objective particle swarm optimization algorithm with reinforcement learning is developed to solve the complicated model. Finally, experiments on two case studies were performed to demonstrate the research effectiveness. © 2019 Elsevier Ltd},
	pages = {101--114},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Wang, B. and Zhou, M. and Xin, B. and Zhao, X. and Watada, J.},
	date = {2019},
	keywords = {Multiobjective optimization, Battery storage, Electric batteries, Wind power, Particle swarm optimization ({PSO}), Power generation, alternative energy, Renewable energies, Battery energy storage, Operating costs, algorithm, energy storage, Reinforcement learning, Cost benefit analysis, performance assessment, Operation cost, Multi-objective particle swarm optimization algorithms, Value engineering, System reliability, Renewable generation, Particle swarm optimization, Equipment, Electric power plant loads, Risk perception, experimental study, Electric load shedding, Unit-commitment, Hybrid uncertainties, Multi-objective unit commitment, Wind curtailment},
}


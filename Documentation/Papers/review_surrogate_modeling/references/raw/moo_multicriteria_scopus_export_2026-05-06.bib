	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 3},
}

@article{li_sustainable_2019,
	title = {Sustainable and reliable design of reverse osmosis desalination with hybrid renewable energy systems through supply chain forecasting using recurrent neural networks},
	volume = {178},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85065484527&doi=10.1016%2fj.energy.2019.04.114&partnerID=40&md5=bbda5178539192cbe0575b09159746c0},
	doi = {10.1016/j.energy.2019.04.114},
	abstract = {Renewable energy systems coupled with reverse osmosis ({RO}) desalination represent a great contribution to the fields of energy and sustainability. Especially in remote areas, where reliability issues associated with integrated systems result in problems of insufficient power supply or supply loss due to the intermittency of renewable sources and varying freshwater demand. This research aims to design a sustainable and reliable hybrid renewable energy system ({HRES}) coupled with {RO} desalination system ({HRES}-{RO}), considering different operational scenarios with fluctuating renewable energy supply, and changeable water demand. First, future energy supply from renewable sources, and water demand were forecasted to deal with the stochastic behavior of several variables including freshwater demand, ambient temperature, solar radiation, and wind speed by means of recurrent neural networks ({RNN}). Then, multi-criteria optimization was conducted using extended mathematical programming ({EMP}) with the aim of minimizing the total annual costs and greenhouse gas emission. Finally, the potential loss of power supply probability ({PLPSP}) was introduced as a tool to illustrate the sustainability of the proposed scenarios. The results showed that the proposed framework resulted in an {HRES} with optimized installation strategy using 111 photovoltaic panels and 5 wind turbines by considering three criteria (economic cost, environmental effect, and energy reliability). The designed system reduced {PLPSP} by 18.3\% compared with the base case. Furthermore, the results demonstrated the contribution of advanced forecasting algorithms to address future uncertainties in the energy supply chain. © 2019 Elsevier Ltd},
	pages = {277--292},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Li, Q. and Loy-Benitez, J. and Nam, K. and Hwangbo, S. and Rashidi, J. and Yoo, C.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Hybrid renewable energy systems, optimization, Greenhouse gases, Renewable energy systems, Sustainable development, multiobjective programming, Stochastic systems, alternative energy, greenhouse gas, Wind, Photovoltaic cells, Multicriteria optimization, Hybrid renewable energy system, Hybrid Renewable Energy System ({HRES}), Reliability, Photovoltaic effects, Supply chains, Supply chain management, Forecasting, Artificial neural network, design method, Desalination, Reverse osmosis, Reverse osmosis desalination, Water, Forecasting modeling, Recurrent neural networks, Mathematical Programming, forecasting method, Reliability Index, Recurrent neural network, wind velocity, water demand, Energy reliability index, Recurrent neural network ({RNN}), Supply chain forecasting model},
}

@inproceedings{li_optimization_2022,
	title = {Optimization of {PV} installation angles for increased self-consumption in residential neighbourhoods},
	isbn = {978-87-7475-698-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195783948&partnerID=40&md5=b56aa4e55f01819f90608e9532ee466a},
	abstract = {Increased shares of variable renewable energy ({VRE}) necessitate various approaches to match supply and demand patterns at different spatial and temporal scales. Within electricity distribution networks, which may experience grid constraints, energy communities could play an important role in enabling higher shares of solar photovoltaic ({PV}) integration, while reducing the overall costs and carbon footprint of the building sector. This can be achieved by adapting {PV} generation to better match demand patterns-and therefore improve the community's self-consumption and self-sufficiency-through different combinations of installation sizing, tilt, and azimuth angles. To assess the aggregation effects of demand from multiple prosumers with varied demand patterns and {PV} system configurations, we simulate a group of residential buildings (three singlefamily and two multi-family houses) and carry out a bi-objective (cost and carbon minimization) optimizations to investigate the optimal placement of {PV} systems on building rooftops and facades. The Pareto frontiers show the tradeoff between normalized costs and {GHG} emissions and indicate higher normalized costs for buildings with lower electricity demand as {PV} systems are scaled to the available rooftop and facade areas. When the placement of solar panels is optimized for the aggregated case, we observe an average gain of 16.7\% in self-consumption and 4.0\% in self-sufficiency, a reduction of 44\% in cost, and 1.9\% in greenhouse gas ({GHG}) emissions compared to when {PV} placement is optimized for each building individually. The study highlights the comparative advantage of group optimization that considers the aggregation effects in both demand and {PV} generation. © Proceedings of {ECOS} 2022 - 35th International Conference on Efficiency, Cost, Optimization, Simulation and Environmental Impact of Energy Systems.},
	pages = {1419--1430},
	publisher = {{DTU} Construct},
	author = {Li, Q. and Vulic, N. and Orehounig, K.},
	editor = {{Elmegaard B.} and {Sciubba E.} and {Blanco-Marigorta A.M.} and {Jensen J.K.} and {Markussen W.B.} and {Meesenburg W.B.} and {Arjomand Kermani N.} and {Zhu T.} and {Kofler R.}},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric power distribution, Multi-objective optimization, Environmental impact, Gas emissions, Greenhouse gases, Optimisations, Solar panels, Solar power generation, Housing, Photovoltaic systems, carbon footprint, Cost reduction, Solar concentrators, Greenhouse gas emissions, Building simulation, Photovoltaics generations, Consumption communities, Demand pattern, Photovoltaic installation, {PV} generation, Self-consumption communities, Self-consumption community},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: N. Vulic; Urban Energy Systems Laboratory, Empa, Dübendorf, Switzerland; email: natasa.vulic@empa.ch},
}

@article{li_multi-objective_2019-2,
	title = {Multi-objective optimization of solar powered adsorption chiller combined with river water heat pump system for air conditioning and space heating application},
	volume = {189},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073234666&doi=10.1016%2fj.energy.2019.116141&partnerID=40&md5=045c2e399f5b3461e4b84de4e36a07cc},
	doi = {10.1016/j.energy.2019.116141},
	abstract = {Multi-energy system is currently under rapid development due to their potential to reduce the use of fossil fuel resources and improve system stability. A systematic simulation-based, multi-objective optimization model of for solar hybrid heat pump heating and cooling system is presented. A combined energy, economic and environmental analysis of the system is conducted to calculate the primary energy use as well as the levelized total annual cost. A multi-objective optimization model is formulated using a genetic algorithm to simultaneously minimize these objective. Linear programming technique for multidimensional analysis of preference ({LINMAP}) is used to select the optimal point from the Pareto front. A sensitivity analysis is also performed to assess the influence of fuel cost, capital cost of innovative components and the annual interest rate on the Pareto front of the optimal solution. © 2019},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Li, R. and Dai, Y. and Cui, G.},
	date = {2019},
	keywords = {Multiobjective optimization, Genetic algorithms, Multi-objective optimization, genetic algorithm, optimization, Multi-objective optimization models, Linear programming, Sensitivity analysis, multiobjective programming, Costs, Heat pump systems, Solar power, Pumps, Cost benefit analysis, Multi-energy systems, Solar energy, heating, Water resources, Fossil fuels, Multi-energy system, linear programing, Air conditioning, System stability, Fossil fuel deposits, Adsorption, Heating and cooling systems, Linear programming techniques, Multi-dimensional analysis, River water, River water heat pumps, River water source heat pump, Solar heating and cooling},
}

@article{li_multi-objective_2023-5,
	title = {Multi-objective study and optimization of a solar-boosted geothermal flash cycle integrated into an innovative combined power and desalinated water production process: Application of a case study},
	volume = {282},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85169053026&doi=10.1016%2fj.energy.2023.128706&partnerID=40&md5=66bc3c0ea15a8bd357d6295efc97dddb},
	doi = {10.1016/j.energy.2023.128706},
	abstract = {Zero-emission hybrid renewable energy resources have been introduced as a viable solution for international programs aimed at eliminating greenhouse gases. Consequently, this research is motivated to propose a novel solar-boosted integrated geothermal flash cycle-driven combined system for the simultaneous production of electricity, heating load, and desalinated water. The system comprises the integration of a geothermal flash cycle, a solar power tower, a dual-loop organic flash cycle, a humidification-dehumidification desalination cycle, and a multi-effect desalination unit. The proposed model is evaluated from three perspectives: energetic, exergetic, and economic. A seasonal case study is conducted for Jiangsu, China. The results demonstrate a generated desalinated water rate of 28.46 kg/s, a total exergy destruction of 4517 {kW}, an exergetic efficiency of 21.9\%, and a payback period of 4.74 years. Furthermore, a combined {MOPSO} and {LINMAP} method is employed to optimize the proposed model in three scenarios. In the first scenario, the objectives are defined as the exergetic efficiency and the exergy destruction rate of the system, which yield optimal values of 22.39\% and 4310.21 {kW}, respectively. The second scenario focuses on the rate of generated desalinated water and the rate of exergy destruction of the system, resulting in objective function values of 27.94 kg/s and 4451.34 {kW}, respectively. In the third scenario, {NPV} and exergy destruction rate are the objective values with obtained values of 1.983 \$M and 4420 {kW}, respectively. © 2023 Elsevier Ltd},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Li, R. and Xu, D. and Tian, H. and Zhu, Y.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, optimization, Greenhouse gases, Optimisations, alternative energy, Emission control, Electric loads, Multi objective, Investments, Solar power, Power, Exergy, air pollution, Solar energy, Case-studies, Humidity control, Desalination, Water filtration, Geothermal energy, zero-emission, China, Zero emission, Exergetic efficiency, Exergy destructions, Desalinated water, Destruction rates, Jiangsu},
}

@article{li_hybrid_2021,
	title = {Hybrid techno-economic and environmental assessment of adiabatic compressed air energy storage system in China-Situation},
	volume = {186},
	issn = {13594311},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099002158&doi=10.1016%2fj.applthermaleng.2020.116443&partnerID=40&md5=34f86757655f418b0045cc7f30defd62},
	doi = {10.1016/j.applthermaleng.2020.116443},
	abstract = {Adiabatic compressed air energy storage technology is found to reliably stabilize the power load and support renewable energy generation. Comprehensive life cycle techno-economic and environmental optimization analysis for this technology are of great importance to improve system performance. In this study, we first proposed an integrated hybrid life cycle optimization framework to understand trade-offs between the techno-economic and environmental performance of adiabatic compressed air energy storage plant in China, by combining integrated hybrid life cycle analysis with multi-objective optimization. The results show that solutions with investment cost, carbon dioxide emission, water and energy consumption of 1.47 k\$/{kW}, 1.48 kg/{kWh}, 0.097 m3/{kWh} and 2.08 × 104 {kJ}/{kWh}, respectively, are promising for a practical adiabatic compressed air energy storage system design in China. An analysis of the materials and energy contribution towards the environmental impact at selected optimum points are carried out in detail to elucidate means for reducing the life-cycle emission of the plant; besides, an impact comparison for plant installation in different provinces was performed to provide guidance for policymakers in site selection. As a result, the life-cycle carbon dioxide emission, water and energy consumption of the plant were found to be large in the provinces with a high proportion of thermal power generation — for example, Shandong and Jiangsu — yet the most environmental benefit is achieved in these provinces if the system is combined with the local power grid. © 2020 Elsevier Ltd},
	journaltitle = {Appl Therm Eng},
	publisher = {Elsevier Ltd},
	author = {Li, R. and Zhang, H. and Chen, H. and Zhang, Y. and Li, Z. and Zhao, J. and Wang, X. and Wang, H.},
	date = {2021},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Economic and social effects, Energy utilization, Environmental impact, Environmental management, Life cycle, Carbon dioxide, Economic analysis, Global warming, Life cycle emissions, Renewable energy generation, Compressed air, Compressed air energy storage, Pressure vessels, Investments, Environmental impact assessments, Optimization framework, Thermal power generation, Optimization analysis, Site selection, Environmental technology, Environmental benefits, Carbon dioxide emissions, Storage (materials), Adiabatic compressed air energy storage, Integrated hybrid, Life cycle optimization, Plant installations, Techno-economic and environmental performance},
}

@inproceedings{li_multi-objective_2021-2,
	title = {Multi-Objective Planning of Thermal-Electric Coupling Micro-Energy System to Promote the Consumption of Renewable Energy},
	isbn = {978-1-6654-3425-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128211186&doi=10.1109%2fEI252483.2021.9713335&partnerID=40&md5=dc945d01e81d56fa2522910962dbbb14},
	doi = {10.1109/EI252483.2021.9713335},
	abstract = {Under the current integrated energy background, the development of thermal-electric coupling micro-energy system has become an effective solution to promote the consumption of renewable energy and sta bilize the fluctuation of renewable energy. Therefore, we propose a multi-objective planning method for thermal-electric coupling micro-energy system. First, on the basis of an analysis of the interaction characteristics of "source-grid-load" and its effect on the absorption of renewable energy in thermal-electric coupling environment, the equipment of thermal-electric coupling micro energy system is modeled. Then the multi-objective planning model of thermal-electric coupling micro-energy system is constructed with the aim of minimizing investment operation cost and system peak-valley fluctuation respectively, and then the multi-objective problem is solved by the combination of {NSGA}-{II} and {TOPSIS}. Finally, the simulation based on actual data verifies the rationality and feasibility of the proposed scheme. © 2021 {IEEE}},
	pages = {2088--2092},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Li, R. and Zhang, M. and Yan, S. and Zhou, Y.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Energy utilization, Renewable energies, Energy systems, Investments, 'current, Multi-objective planning, Renewable energy consumption, Micro energy, Thermal electric couplings, thermal-electric coupling micro-energy system},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: Y. Zhou; North China Electric Power University, Beijing, China; email: zhouyinyuyy@163.com},
}

@article{li_multi-objective_2022-2,
	title = {Multi-objective optimal power flow with stochastic wind and solar power},
	volume = {114},
	issn = {15684946},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85119474604&doi=10.1016%2fj.asoc.2021.108045&partnerID=40&md5=1b45e04fde38d352abd69561b19f4565},
	doi = {10.1016/j.asoc.2021.108045},
	abstract = {The classical optimal power flow problem is usually formulated with only thermal generators, in which the fuel used to generate power is limited and emissions from the network system are often ignored. Due to several promising features like renewability, richness, and cleanness, renewable energy sources have been drew growing attention. As a result, more and more renewable energy sources are penetrated into the electrical grid. In this paper, the standard {IEEE}-30 bus system is modified by integrating renewable energy sources as the case study, where the traditional thermal generators on buses 5 and 11 are replaced by wind generators, and bus 13 is replaced by solar generators. In addition, to address the intermittence and uncertainty of renewable sources, the Weibull probability density function is used to calculate the available wind power. Meanwhile, the lognormal probability density function is employed to calculate the available solar power. The optimal power flow with stochastic wind and solar energy is formulated as a multi-objective optimization problem. A multi-objective evolutionary algorithm based on non-dominated sorting with constraint handling technique are presented to solve it. In addition, another larger test system i.e., {IEEE}-57 bus system is selected to further verify the performance of the proposed approach in handling large dimensional problem. Simulation results indicate that proposed approach can obtain competitive compromise solution on different optimization objectives. © 2021 Elsevier B.V.},
	journaltitle = {Appl. Soft Comput. J.},
	publisher = {Elsevier Ltd},
	author = {Li, S. and Gong, W. and Wang, L. and Gu, Q.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy source, Evolutionary algorithms, Natural resources, Wind power, Multi-objective optimization, Renewable energy, Stochastic systems, Renewable energies, Probability density function, Weibull distribution, Bus systems, Power, Solar energy, Optimal power flow, Acoustic generators, Buses, Constraint handling, Electric load flow, Thermal generators, Optimal power flows, Power systems, Power system, Stochastic winds},
}

@article{li_hierarchical_2020,
	title = {Hierarchical Multi-objective Safety Margin Optimization of Renewable Energy Island Collecting Delivery System by {VSC}-{HVDC}},
	volume = {44},
	issn = {10003673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097576911&doi=10.13335%2fj.1000-3673.pst.2020.0047a&partnerID=40&md5=41bfe31b07ecddabde9ad584877ec227},
	doi = {10.13335/j.1000-3673.pst.2020.0047a},
	abstract = {Large-scale renewable generation integration and {DC} power grid are two hot subjects in the future power grid. The renewable generation cluster is connected to the voltage sourced converter ({VSC}) station, under the control mode of {VF}, forming a renewable energy island colleting delivery system based on High Voltage Direct Current with {VSC} ({VSC}-{HVDC}). Compared with the {AC} delivery mode, this mode has higher controllability and better adaptability, in which the voltage support is dominated by the control strategy of {VSC} station and coordinated with the reactive voltage control of the {AC} collecting network. However, the optimization of the safety margin of {VSC} station becomes a key problem affecting the system security because it may change rapidly with the working conditions caused by the strong fluctuation of the renewable energy. This paper proposes a multi-objective optimization method of safety margin for {VSC} station based on station-network coordination. The voltage of the point of common coupling ({PCC}) is used as the inter layer exchange variable. The voltage of {PCC} is determined by the reactive voltage safety margin optimization of {VSC} station in the upper layer, while the economic optimization of the renewable collecting network is achieved based on the voltage of {PCC} in the lower layer. In this way the optimization of safety margin is realized which satisfies the needs of multiple objectives, like network loss, reactive voltage safety and so on. Finally, the simulation verifies that the proposed optimization strategy can get a high and stable safety margin in different working conditions based on the renewable energy delivery system of an actual {VSC}-{HVDC} project. © 2020, Power System Technology Press. All right reserved.},
	pages = {4513--4520},
	number = {12},
	journaltitle = {Dianwang Jishu},
	publisher = {Power System Technology Press},
	author = {Li, S. and Qiao, Y. and Xu, M. and Wu, L. and Lu, Z. and Xian, W.},
	date = {2020},
	keywords = {Multiobjective optimization, Electric power transmission networks, Renewable generation, Economic optimization, Point of common coupling, Voltage sourced converters, Electric fault currents, Optimization strategy, Multiple-objectives, {HVDC} power transmission, Dynamic reactive power margin, Hierarchical multi-objective optimization, High energy forming, High voltage direct current, Occupational risks, Renewable energy island collecting delivery system by {VSC}-{HVDC}, Renewable generation integrations, Voltage safety margin, {VSC} station},
}

@inproceedings{li_multi-objective_2021-3,
	title = {Multi-objective optimization scheduling of micro-grid with energy storage under time-of-use price mechanism},
	isbn = {978-1-6654-1025-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124013167&doi=10.1109%2fICECEM54757.2021.00096&partnerID=40&md5=46242910a27603c390578fb6a89ab8d1},
	doi = {10.1109/ICECEM54757.2021.00096},
	abstract = {During the operation of the microgrid, the output power of some distributed power sources is fluctuating and intermittent, which will bring huge challenges to the planning and operation of the microgrid. In view of the high penetration rate of renewable energy connected to the microgrid, combined with the effect of the energy storage device in the microgrid on peak shaving and valley filling of the grid according to the changes in user demand at different times and the difference in electricity prices, this paper formulates energy dispatch under dynamic market pricing. The goal is to minimize economic costs and minimize environmental pollution during system operation. By adjusting the switch state of the controllable unit, the charge and discharge state of the energy storage battery, and the interaction between the microgrid and the large grid, when formulate the best control sequence of each unit in every cycle. The improved fast non-dominated sorting genetic algorithm ({NSGA}-{II}) is used to find the Pareto optimal solutions for the four scenarios. Through the analysis of the energy scheduling strategy and the non-adopted scheduling strategy, the results show that the proposed scheduling strategy can effectively reduce the economic cost and optimize the environmental benefits, verifying the effectiveness of the proposed method.  © 2021 {IEEE}.},
	pages = {468--472},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Li, S. and Sun, Y. and Gao, Z. and Liu, G. and Xu, Y.},
	date = {2021},
	keywords = {Multiobjective optimization, Electric load dispatching, Electric power transmission networks, Genetic algorithms, Microgrid, Optimal systems, Electric energy storage, Scheduling, Pareto principle, Multi objective, Energy, Cost benefit analysis, Pareto optimal solutions, {NSGA}-{II} algorithm, multi-objective, Electric power supplies to apparatus, Grid-connected, Electric power system economics, Scheduling strategies, Grid-connected microgrid, improved {NSGA}-{II}, Time-of-use price, Distributed power supplies, Pareto optimal solution, Time-of-use prices, Distributed power supply, Energy scheduling strategy, Energy storage device, Improved {NSGA}-{II} algorithm},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: S. Li; Shandong University of Science and Technology, Department of Electrical Engineering, Qingdao, 266400, China; email: lsgskd@163.com; Y. Sun; Shandong University of Science and Technology, Department of Electrical Engineering, Qingdao, 266400, China; email: 798701631@qq.com; Z. Gao; Shandong University of Science and Technology, Department of Electrical Engineering, Qingdao, 266400, China; email: skdgzz@163.com; G. Liu; Shandong University of Science and Technology, Department of Electrical Engineering, Qingdao, 266400, China; email: 673973273@qq.com; Y. Xu; Shandong University of Science and Technology, Department of Electrical Engineering, Qingdao, 266400, China; email: 2567317802@qq.com},
}

@article{li_solar_2024,
	title = {Solar photovoltaic power forecasting system with online manner based on adaptive mode decomposition and multi-objective optimization},
	volume = {118},
	issn = {0045-7906},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196868764&doi=10.1016%2fj.compeleceng.2024.109407&partnerID=40&md5=9cb2be9b3a483b2e42a23ba56ba43220},
	doi = {10.1016/j.compeleceng.2024.109407},
	abstract = {Constructing an accurate and reliable solar photovoltaic ({PV}) power forecasting system is crucial for smart grid management and dispatch. However, due to the intermittent, non-stationary and random nature of solar energy, current methods cannot effectively capture the dynamic change patterns of {PV} data, resulting in a forecasting accuracy that cannot satisfy the requirement for stable operation of smart grids. To address this issue, in this paper, a new solar {PV} power forecasting system is proposed based on a new adaptive mode decomposition method that combines machine learning models. First an adaptive mode decomposition method is proposed for adaptively eliminating high-frequency information of {PV} data, mitigating the impact of high noise on the forecasting performance. Then the powerful mapping ability of machine learning model is utilized to construct a solar {PV} power generation combination forecasting system. The system adopts a multi-objective optimization strategy to determine the optimal weights of the combination model, which reduces the volatility of the forecasting results and enhances the stability of the forecasting system. Experimental results demonstrate that the proposed system achieves the best overall performance with online manner on 10 state-of-the-art baselines. Furthermore, the evaluation analysis by Diebold–Mariano test, improvement ratio and sensitivity analysis further show that the stability and accuracy of the proposed system outperforms the comparative baselines. © 2024 Elsevier Ltd},
	journaltitle = {Comput Electr Eng},
	publisher = {Elsevier Ltd},
	author = {Li, S. and Wang, J. and Zhang, H. and Liang, Y.},
	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Multi-objective optimization, Renewable energy, Sensitivity analysis, Solar power generation, Renewable energies, Smart grid, Machine learning, Smart power grids, Solar energy, Forecasting, Solar concentrators, System stability, Photovoltaic power, Solar photovoltaic power, Power forecasting, Forecasting system, Adaptive mode, Mode decomposition, Photovoltaic data, photovoltaic power forecasting, Solar energy conversion},
}

@article{li_research_2023-2,
	title = {Research on Optimal Configuration of Landscape Storage in Public Buildings Based on Improved {NSGA}-{II}},
	volume = {15},
	issn = {2071-1050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165110196&doi=10.3390%2fsu15021460&partnerID=40&md5=49a16654913a8f4db92398abedfc20c8},
	doi = {10.3390/su15021460},
	abstract = {The transition to clean and low-carbon energy in public buildings is crucial to energy saving and green social development. This paper focus on the sustainable development of public buildings and the construction of complementary power generation systems in existing public buildings. In the study, it was found that the constraints of the energy storage system could not be satisfied, which would result in the failure of the energy storage system for the purpose of peak regulation and stable operation of the microgrid. In order to satisfy the constraint conditions of the energy storage system, a spatial transformation method was proposed that improves the Non-dominated Sorting Genetic Algorithm-{II} ({NSGA}-{II}). The simulation results show that the spatial transformation Non-dominated Sorting Genetic Algorithm-{II} ({STNSGA}-{II}) has advantages in dealing with the strong constraints of the energy storage system. The introduction of the complementary power generation system with energy storage system in public buildings can save 23.74\% to 31.17\% from the perspective of optimal cost, and can reduce of {CO}2 emissions by at least 2478 kg from the perspective of carbon emission reduction. This study presents a case for transforming public buildings from simple consumers of energy systems to active contributors supporting large-scale wind and {PV} access. © 2023 by the authors.},
	number = {2},
	journaltitle = {Sustainability},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Li, S. and Zhou, H. and Xu, G.},
	date = {2023},
	keywords = {Wind power, Renewable energy, genetic algorithm, optimization, Carbon dioxide, Power generation, alternative energy, energy storage, photovoltaic system, carbon emission, energy use, {CO}2 emissions, {PV} system, Multi objective optimization, wind generation},
}

@inproceedings{li_multi-objective_2024-8,
	title = {Multi-Objective Planning for Hydrogen Production Considering Complementary Hydrogen Production Technologies in Source-Grid-Load-Storage System},
	isbn = {979-8-3315-1608-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218489261&doi=10.1109%2fICNEPE64067.2024.10860367&partnerID=40&md5=d6be9655a4314c0defab7fc0b664a3be},
	doi = {10.1109/ICNEPE64067.2024.10860367},
	abstract = {This paper addresses the issue of poor controllability of off-grid hydrogen production from renewable energy sources, which makes it difficult to meet hydrogen load demands. A multi-objective planning method combining various hydrogen production technologies is proposed. By integrating water electrolysis hydrogen production, biomass gasification hydrogen production, and natural gas reforming hydrogen production, the utilization rate of hydrogen production by-products is improved, and the controllability of hydrogen production is enhanced, achieving complementary advantages among hydrogen production technologies. Additionally, the paper describes the characteristics of three types of hydrogen load demands, enhancing the coordination capabilities of the production-storage-use processes. Finally, simulation examples verify the rationality of the proposed hydrogen production system.  © 2024 {IEEE}.},
	pages = {91--96},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Li, T. and Chen, X. and Ni, X. and Ai, X.},
	date = {2024},
	keywords = {Multi-objectives optimization, Renewable energy source, Multi-objective optimization, Hydrogen production, Hydrogen storage, Off-grids, Storage systems, {NSGA}-{II}, Load demand, planning method, Multi-objective planning, hydrogen load, Hydrogen production technology},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: X. Ai; Huazhong University of Science and Technology, School of Electrical and Electronic Engineering, Wuhan, China; email: xiaomengai@hust.edu.cn},
}

@article{li_v2g_2021,
	title = {V2G Multi-Objective Dispatching Optimization Strategy Based on User Behavior Model},
	volume = {9},
	issn = {2296598X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85116035274&doi=10.3389%2ffenrg.2021.739527&partnerID=40&md5=870649d2afad68881937c0f9b80af3a9},
	doi = {10.3389/fenrg.2021.739527},
	abstract = {V2G (Vehicle to Grid) technology can adjust the grid load through the unified control of the charging and discharging of electric vehicles ({EVs}), and achieve peak shaving and valley filling to smooth load fluctuations. Aiming at the random and uncertain problem of {EV} users travel and behavior decision-making, this paper proposes a V2G multi-objective dispatching strategy based on user behavior. First, a V2G behavior model was established based on user behavior questionnaire surveys, and the effective effect of {EV} load was simulated through Monte Carlo simulation. Then, combined with the regional daily load curve and peak-valley time-of-use electricity prices, with the goal of stabilizing grid load fluctuations and increasing the benefits of {EV} users, a multi-objective optimal dispatching model for {EV} clusters charging and discharging is established. Finally, Considering the needs of {EV} users and the operation constraints of the microgrid, the genetic algorithm is used to obtain the Pareto optimal solution. The results show that when dispatching with the maximum benefit of users, the peak-to-valley ratio of the grid side can be reduced by 2.99\%, and the variance can be reduced by 9.52\%. The optimization strategy can use peak and valley time-of-use electricity prices to guide the intelligent charging and discharging of {EVs} while meeting user needs, so as to achieve the optimal multi-objective benefit of V2G participation in power response. © Copyright © 2021 Li, Tao, He, Lu, Xie, Yang and Sun.},
	journaltitle = {Front. Energy Res.},
	publisher = {Frontiers Media S.A},
	author = {Li, T. and Tao, S. and He, K. and Lu, M. and Xie, B. and Yang, B. and Sun, Y.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Electric load dispatching, Electric power transmission networks, Genetic algorithms, Multi-objective optimization, Decision making, Intelligent systems, Monte Carlo methods, Costs, Pareto principle, Vehicle-to-grid, Charging (batteries), Multi objective, Behavioral research, V2G, Landforms, Monte Carlo Simulation, Monte Carlo's simulation, Optimization strategy, Vehicle users, Load fluctuations, Peak- valley, grid load dispatching, Load dispatching, Surveys, user behavior, User behaviors},
}

@article{li_configuration_2024,
	title = {Configuration Optimization of Mobile Photovoltaic-Diesel-Storage Microgrid System Based on {CPS}-{MOEA}},
	volume = {14},
	issn = {20763417},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192573200&doi=10.3390%2fapp14073015&partnerID=40&md5=5b28cce23fdbecddcfdbe245010c3ca2},
	doi = {10.3390/app14073015},
	abstract = {This paper presents a two-step approach for optimizing the configuration of a mobile photovoltaic-diesel-storage microgrid system. Initially, we developed a planning configuration model to ensure a balance between the mobility of components and a sustainable power supply. Then, we introduced a method that merges optimization and decision-making. The first phase identifies Pareto optimal solutions ({POSs}) with a favorable distribution by using a multi-objective evolutionary algorithm with classification-based preselection ({CPS}-{MOEA}). In the second phase, we utilize the fuzzy C-means algorithm ({FCM}) and the grey relational projection ({GRP}) method for comprehensive decision-making. This aims to select the most suitable and compromise solution from the {POSs}, closely aligning with the decision-maker’s preferences. Beyond addressing the optimal planning and configuration issue, the experimental results show that the method surpasses other widely used multi-objective optimization algorithms, including the Preference Inspired Co-evolution Algorithm ({PICEA}-g), the Multi-Objective Particle Swarm Optimization Algorithm ({MOPSO}), and the third stage of Generalized Differential Evolution ({GDE}3). © 2024 by the authors.},

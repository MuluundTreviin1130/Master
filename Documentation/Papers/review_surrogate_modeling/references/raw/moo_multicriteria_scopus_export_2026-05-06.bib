	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Renewable energy, Energy utilization, optimization, Optimisations, Optimizers, Renewable energies, Energy planning, Energy systems, Gray wolves, Automation, Renewable energy system, Planning problem, Gray wolf optimizer, grey wolf optimizer, Energy Planning Problem},

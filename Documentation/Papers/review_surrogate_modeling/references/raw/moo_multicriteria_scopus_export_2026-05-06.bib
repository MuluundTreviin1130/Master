}

@inproceedings{kumar_optimal_2014,
	title = {Optimal Allocation and Sizing of Distributed Generation in {IEEE}-85 {BUS} System Considering Various Load Models Using Multi-objective Metaheuristic Algorithms},
	isbn = {18761100},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184092602&doi=10.1007%2f978-981-99-7630-0_2&partnerID=40&md5=c84bd0ef4fb4540c98bc67475c479b21},
	doi = {10.1007/978-981-99-7630-0_2},
	abstract = {Present-day distribution systems are bidirectional due to the integration of renewable energy sources and distributed generation. For efficient operation of the distribution systems, the loss reduction and voltage management are of the essential operational requirements. In India, the overall transmission and distribution losses for the 2018–2019 financial year were 20.66\% and that needs major concerns for better efficiency of the system. The distribution system experiences voltage deviation and stability issues due to the improper management of the reactive power management and load growth. In order to limit these losses and better voltage profile, the system shall be planned with better control of reactive power and reduced losses. The losses and voltage can be better managed with the distribution generation integration into the existing system with optimal location and size. In this paper, {DGs} (distributed generation) in the radial distribution network have been optimally located and sized to minimize the line loss and enhance the voltage profile. This study aims to develop a multi-objective optimization model that considers various distribution load models while maximizing both technical and financial advantages. The appropriate positioning and sizing of {DG} resources in distribution networks are significantly influenced by load models and therefore, different load models have been incorporated in this study. The multi-objective function ({MOF}) contains the cost of active power loss reduction, voltage deviation enhancement, and the cost of installing {DGs}. The effects of four different load models are investigated using metaheuristic techniques. The study is carried out on an {IEEE} 85-bus radial distribution network as a test system. A comparison of results using Whale Optimization ({WO}), Grey Wolf Optimization ({GWO}), and Firefly Algorithm ({FA}) is analyzed to verify the effectiveness of the applied techniques. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd 2024.},
	pages = {15--31},
	publisher = {Springer Verlag},
	author = {Kumar, S. and Kumar, A.},
	date = {2014},
	keywords = {Multiobjective optimization, Electric power transmission, Electric power transmission networks, Renewable energy, Distributed power generation, distribution system, Distribution systems, distributed generation, Electric loads, Optimal sizing, Reactive power, Active and Reactive Power, Optimal allocation, Voltage profile, Optimization techniques, Load modeling, Radial distribution networks, Voltage deviations, An Optimization technique},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: S. Kumar; National Institute of Technology, Kurukshetra, Haryana, India; email: sumeet\_32114301@nitkkr.ac.in},
}

@inproceedings{kumar_optimal_2018,
	title = {Optimal allocation of distribution generation units in radial distribution systems using nature inspired optimization techniques},
	isbn = {978-1-5386-3817-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85057586934&doi=10.1109%2fICPECTS.2018.8521630&partnerID=40&md5=59c739507482d254c6aaad8d842f7537},
	doi = {10.1109/ICPECTS.2018.8521630},
	abstract = {Growth in energy demand is more than the energy production due to various reasons like industrial growth, rapid urbanization, increasing affordability of electric gadgets etc. The integration of existing grids with renewable energy sources provides economical, sustainable and efficient power distribution, and this allows the control of the greenhouse effect. The reduction in power loss and voltage profile improvement in distribution system can be done using some techniques such as feeder or network reconfiguration, {VAR} compensation with capacitor banks and distributed generation ({DG}). {DG} is localized small scale generation installed in the distribution network capable of injecting active power and providing limited reactive power support, reduced distribution losses, improved voltage profile in the system and hence the quality of the power is improved. The significant process to improve the power quality of the system is finding the size of the {DG} unit and their suitable locations in the system. In this paper, {IPSO} and a new gradient free, metaheuristic, population based algorithm called Bat Inspired Algorithm is described to evaluate the optimal size and location of {DG} units. Distributed load flow is carried out for 33-bus and 69-bus systems to obtain power losses and voltage at each bus. Optimization techniques {IPSO} and {BAT} algorithms are considered for the optimal placement and optimal sizing of distributed generators in radial distribution system by multi-objective optimization approach has been discussed. The practical application and efficiency of this method is evaluated using two various test systems (33 and 69-bus). The proposed methods are carried out using {MATLAB}. © 2018 {IEEE}.},
	pages = {1--6},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Kumar, Y. A. and Kumar, N. P.},
	date = {2018},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power transmission, Particle swarm optimization ({PSO}), Objective functions, Distributed power generation, Objective function, Radial distribution systems, Reactive power, Electric load flow, Electric power system control, Electric power system economics, Power control, Power flows, Power flow, Distributed Generation({DG}), Greenhouse effect, Improved Particle Swarm Optimization ({IPSO}), Placement And Sizing, Population-based algorithm, Small-scale generations, Voltage profile improvement},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 13},
}

@inproceedings{kumari_mrfo_2022,
	title = {{MRFO} Based Multi-objective Optimization for Minimization of Peak Demand and Load Curtailment},
	isbn = {978-1-6654-5883-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85129424268&doi=10.1109%2fDELCON54057.2022.9753018&partnerID=40&md5=445e60c11fde03b96361e77dc7cb552e},
	doi = {10.1109/DELCON54057.2022.9753018},
	abstract = {Emergence of smart grid has revolutionized the power system network in this new era of communication. Demand side management ({DSM}) is one of the smart grid's significant functional areas. {DSM} is a concept that helps to manage demand by either reducing consumption of electricity or moving load from peak hour to off-peak hour and by doing so, {DSM} seeks to balance demand and supply without adding additional generation capacity or without reinforcing transmission and distribution network. In this paper a {MRFO} based multi-objective optimization is implemented to minimize peak load demand ensuring least amount of load curtailment by utilizing available solar power. Firstly, the paper proposes a new multi-objective formulation of {DSM} that minimises peak demand while minimizing the amount of load curtailed over a period of a day. Secondly, a comparatively new optimization method, {MRFO}, is used to solve the multi-objective problem. Finally, the proposed method is implemented and tested on a real-life system data of {NIT} Patna campus and shows promising results. The results obtained indicate considerable decrease in demand for peak hour and load curtailment over 24 hours is also seen to be reduced to a negligibly small value. The power consumption from main grid also reduces. © 2022 {IEEE}.},
	eventtitle = {2022 {IEEE} Delhi Section Conference, {DELCON} 2022},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Kumari, V. and De, M.},
	date = {2022},
	keywords = {Multiobjective optimization, Electric power transmission networks, Renewable energy, Optimisations, Demand side management, Renewable energies, Smart power grids, Solar energy, Electric utilities, Peak demand, Minimisation, load curtailment, {DSM}, Manta ray foraging optimization, Manta Ray Foraging Optimization ({MRFO}), minimization of load curtailment, Minimization of peak demand, smart metering},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1},
}

@inproceedings{kuo_dynamic_2016,
	title = {Dynamic demand-side management with user's privacy concern in residential community},
	isbn = {21618070},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85001054688&doi=10.1109%2fCOASE.2016.7743526&partnerID=40&md5=04e3b1d7dbca54a8151e0605c6ee100a},
	doi = {10.1109/COASE.2016.7743526},
	abstract = {In smart grids, demand-side management ({DSM}) plays an important role between customers and utility company, since it can reduce the total electricity cost of each customer meanwhile alleviate the aggregate peak-to-average ratio ({PAR}) of utility of a community of customers subject to real-time pricing ({RTP}) policy. Moreover, a good {DSM} system should also be able to react quickly when users do not take its advice or when the environment state changes. This works aims at making the {DSM} system dynamic, which means that the proposed {DSM} can reschedule the order of activities in nearly real-time whenever original schedule is no longer feasible due to the aforementioned situations. In our problem formulation, each home is assumed to connect to a renewable energy resource, say, photovoltaic ({PV}) system, and equipped with an energy storage device so that the scheduling can be made more flexible. Thus, besides the case where the original recommended schedule is not followed by the user, another case where the solar power distribution changes from what was predicted also initiates the rescheduling under the dynamic {DSM}. In addition, for a residential community composed of multiple homes, keeping the privacy of lifestyle for each home is also an issue as important as the energy saving, and therefore a cooperative game is also formulated so as to transfer only the necessary information but hide all the details of power consumption of each home. The simulation results show that the proposed {DSM} system not only reduce the cost in individual home but also reschedule quickly whenever there is a need, while make a tradeoff between cost and {PAR} with privacy concern in a residential community. © 2016 {IEEE}.},
	pages = {1094--1099},
	publisher = {{IEEE} Computer Society},
	author = {Kuo, H.-H. and Pradhan, S. K. and Wu, C.-L. and Cheng, P.-H. and Xie, Y. and Fu, L.-C.},
	date = {2016},
	keywords = {Multiobjective optimization, Renewable energy resources, Electric power transmission networks, Multi-objective optimization, Demand side management, Costs, Energy conservation, Housing, Electric energy storage, Smart grid, Photovoltaic systems, Energy resources, Smart power grids, Solar energy, Sales, Demand-side management, Cost reduction, Electric utilities, Residential communities, Peak to average ratios, Problem formulation, Power distributions, dynamic algorithm, user privacy},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 10},
}


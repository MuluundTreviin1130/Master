@article{hu_model_2025,
	title = {Model simulation and multi-objective capacity optimization of wind power coupled hybrid energy storage system},
	volume = {319},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217948877&doi=10.1016%2fj.energy.2025.134887&partnerID=40&md5=dfeeba421675b0e2fd4def2b5ee50d42},
	doi = {10.1016/j.energy.2025.134887},
	abstract = {Wind and hydrogen energy storage systems are increasingly recognized as significant contributors to clean energy, driven by the rapid growth of renewable energy sources. To enhance system efficiency and economic feasibility, a model of a wind power-integrated hybrid energy storage system with battery and hydrogen was developed using {TRNSYS}. The system is optimized using the Non-dominated Sequential Genetic Algorithm for multi-objective capacity allocation, emphasizing economy, reliability, and energy consumption rates. Based on the Pareto frontier diagram, optimal solutions are derived under varying objective weights, and representative cases are selected for comparative analysis. The impact of varying equipment capacities on the system is thoroughly investigated. Lastly, the constructed model and operational strategy are validated through quantitative energy flow analysis of each system component. Results indicate that the electrolyzer capacity significantly affects the system's power abandonment rate, while the battery capacity predominantly influences the system's life cycle cost and loss of power supply probability. In this system, the primary role of the battery storage system is to supply electricity to loads as needed, filling over 78 \% of the deficit independently. The hydrogen storage subsystem can absorb over 55 \% of wind power annually and sell hydrogen converted from more than 40.9 \% of wind power promptly and on demand for revenue. This study offers valuable insights into designing the configuration and operational strategy of a renewable energy-coupled hydrogen energy storage system, along with guidance for optimizing its multi-objective capacity allocation. © 2025 Elsevier Ltd},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Hu, S. and Yang, H. and Ding, S. and Tian, Z. and Guo, B. and Chen, H. and Yang, F. and Xu, N.},
	date = {2025},
	keywords = {Multi-objectives optimization, Wind power, Multi-objective optimization, optimization, Hybrid power, Hydrogen storage, alternative energy, Battery, energy storage, Multi objective, Storage systems, Power, Simulation, Hydrogen, Charge storage, Hydrogen energy storages, Hybrid energy storage systems, Capacity allocation, Windmill, Water electrolysis, electrokinesis, Energy flow, Hydrogen demand boundary, Hydrogen production by water electrolyse, Hydrogen production by water electrolysis},
}

@article{hu_economic_2021,
	title = {Economic and environmental analysis of coupling waste-to-power technology to integrated energy system ({IES}) using a two-layer optimization method},
	volume = {325},
	issn = {0959-6526},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85116864675&doi=10.1016%2fj.jclepro.2021.129240&partnerID=40&md5=53a820811b8fa29f8955a5dccc5686e2},
	doi = {10.1016/j.jclepro.2021.129240},
	abstract = {Integrated energy system ({IES}) could improve the energy efficiency and reduce carbon emissions through multi-energy production, storage, transportation, and supply. However, the energy flow in traditional {IES} is usually one-way: from electricity to heat/cold, or from heat to cold. Coupling waste-to-power ({WTP}) may also convert waste heat to electricity, thereby further improving the flexibility and reducing pollutant emissions. Therefore, this work focuses on exploring the value and applicable scenario of {IES}-{WTP}, from the perspective of economics and carbon emissions. A two-layer optimization method is proposed to realize the multi-objective optimization of both the operation strategy and system design. Then this {IES}-{WTP} system is compared with traditional {IES} considering three different load profiles. Results indicate that coupling {WTP} could significantly improve the overall performance of {IES}. Specifically, the annual carbon emissions could be reduced by up to 13\%, and the annual costs could also be reduced with the same emissions. As the {WTP} efficiency improves from 9\% to 18\%, the emission reduction will further increase by 6\%. In addition, this {IES}-{WTP} system is found more applicable for the area where the electric load is higher or close to the heat/cold load, but is not suitable for the area where heat load is much higher than electric/cold load. © 2021},
	journaltitle = {J. Clean. Prod.},
	publisher = {Elsevier Ltd},
	author = {Hu, S. and Yang, Z. and Li, J. and Duan, Y.},
	date = {2021},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Energy efficiency, Carbon, Emission control, Power, Carbon emissions, {ECONOMICS}, Waste heat, Waste heat utilization, Integrated energy systems, Combined cooling, heat and power, Integrated energy system, Environmental technology, Integrated energy system ({IES}), Heat and power ({CCHP}), Load scenario, Load scenarios, Waste-to-power, Waste-to-power ({WTP})},
}

@article{hu_thermo-economic_2021,
	title = {Thermo-economic optimization of the hybrid geothermal-solar power system: A data-driven method based on lifetime off-design operation},
	volume = {229},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097792284&doi=10.1016%2fj.enconman.2020.113738&partnerID=40&md5=0506f8c4893342a1ccac0337eb272a80},
	doi = {10.1016/j.enconman.2020.113738},
	abstract = {The hybridization of the geothermal and solar system provides a potential solution to the problem of geothermal power plants being vulnerable to ambient temperature changes and reservoir degradation. Existing research mainly focuses on its yearly operation or layout improvement, neglecting proactive design based on the off-design performance, due partly to the complexity and elapsed time. Therefore, for the first time, this study proposes a novel data-driven method to realize the fast and accurate prediction of the system off-design performance, thereby making it possible for the lifetime design of the hybrid geothermal-solar power system considering its real-time operation. In this work, an artificial neural network ({ANN}) is firstly trained and validated to predict the hourly performance of the hybrid system based on an organic Rankine cycle ({ORC}) over a 30-year life span. Then the trained {ANN} is combined with a multi-objective optimization procedure to determine the best system design. Results prove the effectiveness of this {ANN}-based approach for the hybrid system proactive design, which could greatly reduce the calculation time while maintaining accuracy within 2\%. Besides, this novel approach has proven to be more efficient in improving the lifetime electricity generation (Etot) and net present value ({NPV}) by up to 17\% and 14\%, respectively. Moreover, compared with the stand-alone geothermal power plants, this hybrid system shows higher turbine/pump efficiency during operation and represents potential thermo-economic advantages as the price of solar collectors declines below 75 \$·m−2. The results provide a valuable reference for hybrid systems, and the {ANN}-based design method can also be directly applied to other power systems, thereby facilitating the in-depth development of optimization design for the renewable energy systems. © 2020 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Hu, S. and Yang, Z. and Li, J. and Duan, Y.},
	date = {2021},
	keywords = {Multiobjective optimization, Multi-objective optimization, Design, Renewable energy systems, Hybrid systems, Solar power generation, electricity generation, Neural networks, Organic Rankine Cycle, Rankine cycle, Accurate prediction, Geothermal energy, Collector efficiency, Solar power plants, Organic Rankine Cycle({ORC}), Geothermal power plants, Thermoeconomic optimization, Ambient temperature change, Data-driven methods, Hybrid geothermal-solar system, Lifetime design, Machine learning method, Off-design analysis, Off-design performance},
}

@article{hu_multiobjective_2021,
	title = {Multiobjective optimal scheduling of integrated energy system in the industry park},
	volume = {36},
	issn = {16739140},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000504817&doi=10.19781%2fj.issn.16739140.2021.01.002&partnerID=40&md5=163b39fb18cd6d97bb56cbb4f66ac936},
	doi = {10.19781/j.issn.16739140.2021.01.002},
	abstract = {The integrated energy system in the industry park is an important material carrier for Chinese comprehensive energy demonstration projects. Its optimal scheduling often takes into account multiple goals with different dimensions and orders of magnitude. Under the background» based on the actual engineering construction of Tongli comprehensive energy service center, a multi-objective optimal scheduling model of integrated energy in the industry park with the goal of considering the overall energy efficiency of integrated energy, integrated energy costs, and collaborative consumption of renewable energy is established. At the same time, the solution set of the Parcto plane is obtained by using the fixed step length of the objective function after unitization. The ideal solution is selected by the near ideal solution sorting method after the Parcto plane is drawn by interpolation fitting. Finally, the Tongli Park is selected as a case to verify the above model. On the Parcto plane, a ideal solution is chosen as the optimal according to the actual engineering requirement. The operation of the various equipment in the industry park is analyzed to provide theoretical and technical support for the future construction and development of the integrated energy system in the industry park. © 2021 Editorial Department of Journal of Electric Power Science and Technology. All rights reserved.},
	pages = {13--20},
	number = {1},
	journaltitle = {J. Electr. Power. Sci. Technol.},
	publisher = {Editorial Department of Journal of Electric Power Science and Technology},
	author = {Hu, W. and Yang, Z. and Wang, J. and Wei, Z. and Jing, J. and Ma, Z.},
	date = {2021},
	keywords = {Multi-objective optimization, day-ahead optimal scheduling, integrated energy system in the industry park, parcto plane},
}

@article{hu_multi-objective_2016,
	title = {Multi-objective optimal operation of microgrid considering the battery loss characteristics},
	volume = {36},
	issn = {02588013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84971529393&doi=10.13334%2fj.0258-8013.pcsee.2016.10.011&partnerID=40&md5=3c6954180ef557dae95b54a0c53e7361},
	doi = {10.13334/j.0258-8013.pcsee.2016.10.011},
	abstract = {In order to obtain global optimization of the microgrid and consider the loss characteristics of the battery, a multi-objective optimization model, using minimum comprehensive cost, maximum environmental benefit, and minimum battery depletion as its objectives, was established. An improved multiple objective particle swarm optimization ({MOPSO}) algorithm was introduced, which obtains better convergence and population diversity by adopting the strategies of adaptively selecting global optimum and maintaining the population diversity with mutation operator. Meanwhile, it uses the Latin hypercube sampling method to generate the original particles with wider distribution, which would decrease the possibility to be trapped in the local optimum. Simulation on a certain microgrid shows effectiveness of the methodology proposed by this paper. © 2016 Chin. Soc. for Elec. Eng.},

	date = {2024},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Genetic algorithms, Multi-objective optimization, Particle swarm optimization ({PSO}), Renewable energy systems, Renewable energies, Energy systems, Algorithmics, Neural networks, Neural-networks, {MATLAB}, Particle swarm, Optimization techniques, Particle swarm optimization, Swarm optimization, Renewable energy system, power electronics, Power-electronics, Reliability theory, Algorithmic Control},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: T. Muthamizhan; Sri Sai Ram Institute of Technology, Department of Electrical And Electronics Engineering, Chennai, Tamil Nadu, West Tambaram, India; email: muthamizhan@gmail.com},

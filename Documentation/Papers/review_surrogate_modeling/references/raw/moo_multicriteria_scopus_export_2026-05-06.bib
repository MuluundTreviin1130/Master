	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: X. Zeng; School of Electronic Information Engineering, Shanghai Dianji University, Shanghai, 201306, China; email: zengxw@sdju.edu.cn; {CODEN}: {PSISD}},
}

@inproceedings{leng_optimal_2021,
	title = {Optimal Scheduling Of Price-Based Demand Response In Microgrid With Classified Load Change Rate},
	isbn = {978-1-6654-3425-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128175442&doi=10.1109%2fEI252483.2021.9712890&partnerID=40&md5=fffbda7473f416e236fd2c74ccdd09b3},
	doi = {10.1109/EI252483.2021.9712890},
	abstract = {Aiming at the problem of low generation utilization caused by distributed renewable energy uncertainty, a multi-objective microgrid optimization method considering multiple load demand responses is proposed. According to the characteristics of load working duration and period, it is classified and transformed into three kinds of controllable load state functions to express the whole day load electricity consumption function, and a price-based demand response model considering classified load is established. In order to test the coordinated operation degree of distributed renewable energy output and controllable load, an evaluation index of load change rate is proposed, which reflects the fluctuation of controllable load following distributed renewable energy output. A multi-objective optimization function is established to minimize the generation cost and consumption cost of users in the microgrid. Taking an area microgrid dominated by wind power as an example, the results show that the proposed optimal scheduling model can appropriately adjust the load working period to adapt to the fluctuation of distributed wind power output and reduce the wind curtailment rate. It can also reduce the user's electricity cost and realize the environmental protection and economic operation of microgrid. © 2021 {IEEE}},

}

@article{gabl_multiobjective_2022,
	title = {A Multiobjective Secondary Control Approach for Optimal Design of {DG} Droop Characteristic and Control Mode for Autonomous Microgrids},
	volume = {16},
	issn = {19328184},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85117103027&doi=10.1109%2fJSYST.2021.3114963&partnerID=40&md5=f32c9f3ff82e6cad1152c8658a5f902f},
	doi = {10.1109/JSYST.2021.3114963},
	abstract = {Theoperating condition of a droop-based microgrid is dependent on the distributed generation ({DG}) droop characteristics. Both primary and secondary controls define the droop characteristic. Previous work dealing with droop-based microgrids overlooked the secondary control region boundary limits while optimizing the droop characteristics as well as the optimal selection of droop type. This article proposes a novel problem formulation that determines the optimal droop type as well as characteristic. Each {DG} is equipped with two operational control modes namely the P-f/Q-V and P-V/Q-f, one of which is optimally selected to achieve the desired operational objectives. The proposed model is formulated as a multiobjective mixed-integer nonlinear programming, which is incorporated into an optimal power flow framework and tested on a 38-bus distribution system modified to form a microgrid and optimally solved using general algebraic modeling system. A secondary control operating region is defined within which the optimal droops are constrained to maintain all possible operating conditions within the acceptable frequency and voltage limits. Furthermore, a comparative analysis is conducted where the {DG} droops are optimized with and without considering the proposed secondary control operating region. The dynamic performance of the proposed optimal secondary control is validated using {PSCAD}/{EMTDC}.  © 2007-2012 {IEEE}.},
	pages = {5445--5454},
	number = {4},
	journaltitle = {{IEEE} Syst. J.},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Gabl, O.M.A. and Shaaban, M. F. and Zeineldin, H. H. and Ammar, M. E.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Microgrid, Optimisations, Distributed power generation, distributed generation, droop control, Integer programming, Optimal power flow, Acoustic generators, Electric load flow, Nonlinear programming, Frequency control, distributed generation ({DG}), Autonomous microgrids, Power control, Autonomous microgrid, Optimal power flows, Droop characteristics, Secondary control},
}

@inproceedings{galisai_multi-objective_2019,
	title = {Multi-Objective and Multi-Criteria Optimization of Microgrids for Nearly Zero-Energy Buildings},
	isbn = {978-1-7281-1156-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073354716&doi=10.1109%2fSEST.2019.8849103&partnerID=40&md5=6071c58c4de6c71f83b91fca6ee3e8af},
	doi = {10.1109/SEST.2019.8849103},
	abstract = {Nearly zero-energy buildings ({NZEBs}) are high energy performance buildings in which part of the amount of energy that these buildings require comes mostly from renewable sources. In order to obtain the target of nearly zero energy consumption, the electrical loads and the energy sources related to the {NZEB} building can be organized as a Microgrid, which needs to be optimally sized in his components. The optimal sizing of a Microgrid for {NZEBs} can be formulated as multi-objective problem. In fact, for the {NZEB} owner exists an economic target aimed at maximizing profits from microgeneration, a different one aimed solely to minimize the energy bought from the market and an environmental target aimed at minimizing the global {CO}2 emissions. These objectives can enter into conflict and create the need for combined optimization. In this paper, this optimization problem is investigated with an integrated framework addressing the multi-objective optimization and multi-criteria evaluation issues simultaneously. Minimize the investment cost, maximize the fraction of energy self-consumed with renewable energy sources and reduce the {CO}2 emissions will be considered as three objectives for multi-objective optimization. The proposed methodology is applied to a microgrid for a {NZEB} public building. The simulation results show the effectiveness of the proposed methodology. © 2019 {IEEE}.},
	eventtitle = {{SEST} 2019 - 2nd International Conference on Smart Energy Systems and Technologies},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	editor = {Galisai, S. and Ghiani, E. and Pilo, F.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Evolutionary algorithms, Energy utilization, Micro grid, Microgrid, Buildings, Carbon dioxide, Costs, Zero energy buildings, Investments, {ECONOMICS}, Real-time pricing, Multi objective evolutionary algorithms, Real time pricing, Renewable sources, Multiobjective Evolutionary Algorithm, {NZEBs}},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 8},
}

@article{galvani_optimal_2019,
	title = {Optimal power flow considering predictability of power systems},
	volume = {171},
	issn = {0378-7796},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061751742&doi=10.1016%2fj.epsr.2019.02.011&partnerID=40&md5=09f2ac33c4f3da2f028b6e1b684890a8},
	doi = {10.1016/j.epsr.2019.02.011},
	abstract = {Ever increasing use of renewable energies as uncertainty resources has caused the power system state to become highly unpredictable. Accurate prediction of the power system state is very important, especially in operational decisions, market contracts and risk management. This paper presents a probabilistic optimal power flow (P-{OPF}) in order to maximize the predictability of the system while minimizing the total cost of power generation. The well-known non-dominated sorting genetic algorithm ({NSGA}) is used to manage multiple objective functions considering operational constraints. In order to show the efficiency of the proposed method, the {IEEE} 30-bus standard test system is selected as a case study and the results are presented. The importance of this study and efficiency of the proposed method are discussed comprehensively. © 2019 Elsevier B.V.},
	pages = {66--73},
	journaltitle = {Electr Power Syst Res},
	publisher = {Elsevier Ltd},
	author = {Galvani, S. and Rezaeian Marjani, S.},
	date = {2019},
	keywords = {Multiobjective optimization, Genetic algorithms, Operational constraints, Non- dominated sorting genetic algorithms, Acoustic generators, Electric load flow, Efficiency, Use of renewable energies, Multi objective optimization, Multiple objective functions, Probabilistic optimal power flow, Probabilistic optimal power flows, risk management, Two-point estimation methods, Electric currents, Non-dominated sorting genetic algorithm, Predictability, Probabilistic optimal power flow (P-{OPF}), Two point estimation method},
}

@article{gamil_optimal_2022,
	title = {Optimal Multi-Objective Power Scheduling of a Residential Microgrid Considering Renewable Sources and Demand Response Technique},
	volume = {14},
	issn = {2071-1050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141887319&doi=10.3390%2fsu142113709&partnerID=40&md5=8e7f8e891f59f5173bdd9b9c5866e672},
	doi = {10.3390/su142113709},
	abstract = {Microgrid optimization is one of the most promising solutions to power system issues and new city electrification. This paper presents a strategy for optimal power scheduling of a residential microgrid depending on renewable generating sources and hydrogen power. Five scenarios of the microgrid are introduced to show the effect of using biomass energy and a seawater electrolyzer on microgrid cost and {CO} (Formula presented.) emissions. Time of use demand response is applied to reshape the electric load demand and decrease the dependence on grid power. The obtained results from the multi-objective optimization verify that biomass has a significant role in minimizing the cost and {CO} (Formula presented.) emissions; the cost is decreased by 37.9\% when comparing scenarios with and without biomass. Besides, the {FC} integration with seawater electrolyzer and tanks reduces the microgrid emissions by around 40\%. © 2022 by the authors.},
	number = {21},
	journaltitle = {Sustainability},
	publisher = {{MDPI}},
	author = {Gamil, M. M. and Ueda, S. and Nakadomari, A. and Konneh, K. V. and Senjyu, T. and Hemeida, A. M. and Lotfy, M. E.},
	date = {2022},

	keywords = {Renewable energy resources, Multi-objective optimization, Particle swarm optimization ({PSO}), Architectural design, Energy efficiency, Hybrid renewable energy systems, optimization, alternative energy, Climate change, algorithm, Hybrid renewable energy system, Hybrid Renewable Energy System ({HRES}), performance assessment, Particle swarm optimization algorithm, Particle size analysis, Techno-economic assessment, design method, Epsilon-constraint method, Building energy performance, electrification, Algeria, Rural electrification, Building energy efficiency, Geographic information systems, Renewable energy potentials, Adrar, Adrar [Algeria], Biskra, Geographical information system, High performance buildings, Tindouf},

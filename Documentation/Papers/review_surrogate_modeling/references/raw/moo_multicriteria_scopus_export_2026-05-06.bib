	date = {2023},
	keywords = {Multiobjective optimization, Electric load dispatching, Carbon, Hydrogen storage, Emission control, Heat storage, Electric vehicles, Electric vehicle, Digital storage, Carbon emissions, Large-scales, Optimal scheduling, Scheduling models, Multi energy, Peak-shaving, Carbon reduction, Energies (power), Multi-energy storage, Peak regulating resource, peak regulating resources},
}

@article{dai_multi-objective_2023,
	title = {Multi-Objective Optimization of Combined Cooling Heating and Power System Considering Photovoltaic-Wind-Gas-Power Collaborative Energy Supply},
	volume = {51},
	issn = {0253374X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164725519&doi=10.11908%2fj.issn.0253-374x.21573&partnerID=40&md5=a80fe8c951c348eaaad323892ecfd40c},
	doi = {10.11908/j.issn.0253-374x.21573},
	abstract = {A kind of combined cooling heating and power （{CCHP}） system considering multi-energy collaborative supply consisting of photovoltaic power， wind power，natural gas， and grid power is developed in this paper. By using the independent {CCHP} system as the measurement benchmark， investment and operation cost， primary energy utilization， as well as carbon dioxide emission are incorporated to formulate multi-objective optimization function. For electrical， heating，and cooling loads on the three kinds of annual typical days such as winter， summer， and transitional seasons， the collaborative optimization study on device capacity sizing and operation strategy including {FEL} （following the electrical loads） and {FTL} （following the thermal loads） is conducted. Due to simultaneous existence of the continuous and combinatorial optimization， a bi-level optimization algorithm of multi-objective particle swarm is proposed. In addition， the orthogonal experimental analysis for the impact of critical system parameters on the optimal result is performed. The results show that compared with the independent {CCHP} system，the proposed {CCHP} system considering photovoltaic-wind-gas-power collaborative energy supply has a significantly better performance in economy， energy saving， and environmental protection. © 2023 Science Press. All rights reserved.},
	pages = {963--972},
	number = {6},
	journaltitle = {Tongji Daxue Xuebao},
	publisher = {Science Press},
	author = {Dai, Y. and Wang, J. and Zeng, Y.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy supplies, Wind power, Particle swarm optimization ({PSO}), Energy utilization, Carbon dioxide, Photovoltaics, Energy conservation, Global warming, Electric loads, Investments, Power, Multi objective particle swarm optimization, {ECONOMICS}, Cooling, Combined cooling heating and power, Multi-objective particle swarm optimization, Multi energy, Photovoltaic power, Combinatorial optimization, combined cooling heating and power({CCHP}), Experimental analysis, Orthogonal experimental analyse, orthogonal experimental analysis},

	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: R. Tang; School of Energy and Environment, Southeast University, Nanjing, 210096, China; email: 220200448@seu.edu.cn; P. Wang; School of Energy and Environment, Southeast University, Nanjing, 210096, China; email: phwang@seu.edu.cn},
}

@article{tang_solving_2024,
	title = {Solving Engineering Optimization Problems Based on Multi-Strategy Particle Swarm Optimization Hybrid Dandelion Optimization Algorithm},
	volume = {9},
	issn = {23137673},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194073697&doi=10.3390%2fbiomimetics9050298&partnerID=40&md5=2ea1429c5255ba8396e67be173b05521},
	doi = {10.3390/biomimetics9050298},
	abstract = {In recent years, swarm intelligence optimization methods have been increasingly applied in many fields such as mechanical design, microgrid scheduling, drone technology, neural network training, and multi-objective optimization. In this paper, a multi-strategy particle swarm optimization hybrid dandelion optimization algorithm ({PSODO}) is proposed, which is based on the problems of slow optimization speed and being easily susceptible to falling into local extremum in the optimization ability of the dandelion optimization algorithm. This hybrid algorithm makes the whole algorithm more diverse by introducing the strong global search ability of particle swarm optimization and the unique individual update rules of the dandelion algorithm (i.e., rising, falling and landing). The ascending and descending stages of dandelion also help to introduce more changes and explorations into the search space, thus better balancing the global and local search. The experimental results show that compared with other algorithms, the proposed {PSODO} algorithm greatly improves the global optimal value search ability, convergence speed and optimization speed. The effectiveness and feasibility of the {PSODO} algorithm are verified by solving 22 benchmark functions and three engineering design problems with different complexities in {CEC} 2005 and comparing it with other optimization algorithms. © 2024 by the authors.},
	number = {5},
	journaltitle = {Biomimetics},
	publisher = {Multidisciplinary Digital Publishing Institute ({MDPI})},
	author = {Tang, W. and Cao, L. and Chen, Y. and Chen, B. and Yue, Y.},
	date = {2024},
	keywords = {Multi-objective optimization, Particle swarm optimization algorithm, dandelion algorithm, function optimization, Levy flight},
}

@inproceedings{tang_analysis_2018,
	title = {Analysis of controlled islanding in multi-infeed {HVDC} systems},
	volume = {2018},
	isbn = {978-1-78561-791-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081691261&doi=10.1049%2fcp.2018.1776&partnerID=40&md5=c11893bb4a919fd09f246803d265b3a6},
	doi = {10.1049/cp.2018.1776},
	abstract = {Determining the optimal islanding solution considering the stability of power systems after splitting is an essential problem of controlled islanding. However, the problem is commonly simplified as a single objective optimization problem in existing literature, which is not able to ensure the stability required by current power systems due to the development of renewable energy and high voltage direct current transmission. Therefore, the multi-objective optimization problem of controlled islanding is analyzed in this paper. First, the problems and higher requirements that current islanding strategy faces are discussed. Second, through analyzing in multi-infeed {HVDC} systems, it is proposed that multi-infeed short circuit ratio must be included in objective functions when determining islanding surface. Finally, stability of power system following different islanding strategies are analyzed and contrasted by simulation. It can be concluded that searching the optimal splitting surface of controlled islanding must be transformed from traditional single-objective optimization to multi-objective optimization problem, in order to ensure the stability required by current complex power grids. © 2018 Institution of Engineering and Technology. All rights reserved.},

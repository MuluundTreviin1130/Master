	volume = {12302},
	isbn = {0277786X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144009608&doi=10.1117%2f12.2645872&partnerID=40&md5=80ef4c010bfa274ef5b94b38972da4c9},
	doi = {10.1117/12.2645872},
	abstract = {The integrated energy system includes a variety of energy production and conversion equipment, which can realize the complementary operation of cold and hot electricity and improve energy utilization efficiency. However, at present, the research on the optimal operation of integrated energy system is relatively limited, there are few types of equipment and models, and the objective function of optimal operation is single. Therefore, this paper constructs a comprehensive energy system model covering energy production, conversion and storage, establishes a multi-objective optimization function of operating cost, carbon emission and primary energy consumption, and takes an industrial park as an example. The results show that the proposed integrated energy system can realize the coordinated operation of electric heating and air conditioning according to the energy price and supply, and the cost can be saved by 15.72\% compared with the cost of sub supply system. © 2022 {SPIE}},

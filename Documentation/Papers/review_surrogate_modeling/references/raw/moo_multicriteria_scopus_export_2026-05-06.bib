	date = {2020},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Renewable energy resources, Renewable energy source, Natural resources, Multi-objective optimization, Environmental impact, Energy policy, Integer programming, Multi objective, Energy, Investments, Supply chains, 'current, Fossil fuels, Design and operations, Automotive industry, Multi-period, Hydrogen supply chain, Hydrogen supply chains, Portugal, World energies},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: T. Pinto-Varela; Centro de Estudos de Gestão-{IST}, Instituto Superior Técnico, Universidade de Lisboa, Lisboa, Av. Rovisco Pais, 1049-001, Portugal; email: tania.pinto.varela@tecnico.ulisboa.pt},

@inproceedings{moradinia_efficiency_2024,
	title = {{EFFICIENCY} {AND} {INNOVATION} {IN} {OFFSHORE} {RENEWABLE} {ENERGY}: A {SURROGATE} {MODELING} {APPROACH} {TO} {MOORING} {SYSTEM} {OPTIMIZATION}},
	volume = {1},
	isbn = {978-0-7918-8778-3},

}

@inproceedings{ivanova_d_mathematical_2023,
	title = {Mathematical model and mobile application to support decision-making in conditions of uncertainty when investing in terrains for construction of renewable energy sources},
	volume = {2939},
	isbn = {0094243X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85180353209&doi=10.1063%2f5.0178686&partnerID=40&md5=100119d3751ec6adbd927355a36be7a8},
	doi = {10.1063/5.0178686},
	abstract = {Renewable energy sources are of great importance for the whole world-environmental, social, political, etc. This is one of the main priorities of the European Union. Investing in terrains for the construction of renewable energy is a risky investment because the conditions under which it must be built and operate are not completely unknown, i.e., there is uncertainty about the environment. The investments made can be both profitable and unprofitable. This research presents a mathematical model and a mobile application for the optimal solution to this problem. A multi-criteria optimization problem under conditions of uncertainty is solved, which, through appropriate scalarization and efficiency coefficients, is reduced to a single-criteria problem-a knapsack problem with Boolean variables, considering the stochastic nature of nature. The solving algorithms are implemented in a mobile application for the Android system in Java programming environments. © 2023 Author(s).},

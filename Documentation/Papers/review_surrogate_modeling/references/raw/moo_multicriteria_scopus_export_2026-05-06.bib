@inproceedings{chen_research_2018,
	title = {Research on layered microgrid operation optimization based on {NSGA}-{II} algorithm},
	isbn = {978-1-5386-6461-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061753323&doi=10.1109%2fPOWERCON.2018.8602169&partnerID=40&md5=0d36902bb39a03c69ccf375df8022bb0},
	doi = {10.1109/POWERCON.2018.8602169},
	abstract = {Poor efficiency and long running time of existent optimization algorithms in dealing with multi-objective multi-variable community microgrid optimization have always been a concern. To address this issue, a novel layered optimization algorithm based on {NSGA}-{II} is proposed. The proposed algorithm integrates the structural feature of community microgrid and the concept of multi-agent system into the optimization process and decomposes the complex microgrid optimization into several household optimizations of smaller scale and one central microgrid optimization. The household operation is optimized first and the central microgrid optimization is solved subsequently based on the Pareto solution set of household operation problems to obtain the optimal operation mode. Simulation results demonstrate that the proposed strategy is effective in improving optimization efficiency. © 2018 {IEEE}.},
	pages = {2149--2156},
	publisher = {Institute of Electrical and Electronics Engineers Inc},

	editor = {Ma, Q. and Yang, Z. and Lei, Z. and Luo, R. and Guo, Q. and Yao, Y.},
	date = {2022},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric load dispatching, Natural resources, Renewable energy sources, Particle swarm optimization ({PSO}), Energy utilization, energy storage, Energy storage system, Storage systems, Railroads, Multi-application, Application requirements, capacity, Electrified railways, fraction power supply system, Regenerative braking, System energy, Traction power supply system},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 2; Correspondence Address: Q. Ma; Xiangtan University, College of Automation and Electronic Information, Xiangtan, China; email: maqianb08@126.com},
}

@article{ma_performance_2022,
	title = {Performance assessment and multi-objective optimization of a geothermal-based tri-generation system in hot Summer Continental Climate: Tianjin case study},
	volume = {269},
	issn = {0196-8904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85135927399&doi=10.1016%2fj.enconman.2022.116083&partnerID=40&md5=0c9e672bf5fe0102d7383e28301dd8b1},
	doi = {10.1016/j.enconman.2022.116083},
	abstract = {Considerable interest in the investigation of energy supply systems that effectively utilize renewable energies is being aroused due to the shortage of fossil energy and serious environmental pollution. Geothermal energy is a considered as a promising alternative to fossil energy due to its advantages of large reserves, good stability, and strong sustainability. This paper developed a geothermal-driven tri-generation system to generate power and supply heating and cooling demand. The tri-generation system is composed of an absorption refrigeration cycle, a heat exchange cycle, and an organic Rankine cycle. The paper begins with an introduction to the thermodynamic, economic, and environment models of the presented system. The effects of the geothermal water parameters on the system performance were originally investigated based on the actual data of a sports center (zero energy building). This building is located in Jiefang South Road, Tianjin, which belong to Hot Summer Continental Climate. In addition, the multi-objective optimization of this system was carried out based on the {TOPISIS} decision-making method considering economic and environmental criteria. The minimum payback period and maximum carbon emission reduction were chosen as the optimization factors. Finally, the optimal temperature of geothermal water is obtained and the exergy analysis was performed under the optimal conditions. The results indicate that the presented system possesses an optimal geothermal water temperature of 83 °C. Under this temperature, the total thermal efficiency in cooling season and heating season were 41.17 \% and 84.93 \%, respectively. The exergy efficiency in cooling season and heating season were 47.28 \% and 62.23 \%, respectively. Our proposed system has equivalent annual operating cost of 12.9 k\$/year, with a payback period ({PBP}) of 2.57 years and carbon emission reduction of 2379 ton/year. The condenser and evaporator need to be improved in terms of large exergy loss rate and low exergy efficiency. © 2022 Elsevier Ltd},
	journaltitle = {Energy Convers. Manage.},
	publisher = {Elsevier Ltd},
	author = {Ma, R. and Hua, Y. and Yu, X. and Zhang, H.},
	date = {2022},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Multi-objective optimization, Decision making, Sustainable development, Carbon, Zero energy buildings, Emission control, Investments, Exergy, Generation systems, performance assessment, Organic Rankine Cycle, Rankine cycle, Organics, water temperature, Geothermal energy, Tri-generation, Refrigeration cycles, Absorption refrigeration, Absorption refrigeration cycle, Geothermal water, Tri-generation system},
}

@inproceedings{ma_cooperative_2019,
	title = {Cooperative scheduling strategy of distributed energy storage system in regional grid with high proportion of renewable energy},
	volume = {2019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081637925&doi=10.1049%2fcp.2019.0521&partnerID=40&md5=5d2cb714686de33e8b782e4bd3c00979},
	doi = {10.1049/cp.2019.0521},
	abstract = {In recent years, the application of large-scale energy storage system({ESS}) in power grid has shown explosive growth. China has successfully built a number of grid-side {ESS} projects. The {ESS} has a variety of application scenarios in grid-side connection, which can give full play to its advantages of quick response and high operating efficiency. In this paper, a collaborative scheduling strategy of distributed {ESSs} are proposed for regional grid with high proportion of renewable energy including photovoltaic({PV}) and wind power. Based on the day-ahead load and the renewable energy power prediction curve, the {ESSs} adopt the multi-point distributed access method, and make the system operating cost and the voltage deviation minimum as the objective function. The large M method is used to linearize the nonlinear variables multiplied by integer variables and continuous variables respectively, and to transform the multiobjective optimization problem of nonlinear multi-decision variables into a mixed-integer linear programming ({MILP}) problem. Finally, the effectiveness is verified by simulation based on {IEEE} 9 node system. The results show that the access of distributed {ESS} in regional grid can effectively promote the consumption of renewable energy and improve the system voltage level. © 2019 Institution of Engineering and Technology. All rights reserved.},

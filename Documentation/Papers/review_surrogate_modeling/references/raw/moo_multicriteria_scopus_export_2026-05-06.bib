	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 21; Correspondence Address: L. Zhang; Department of Electrical, Electronic and Computer Engineering, University of Pretoria, Hatfield, Pretoria, 0002, South Africa; email: lijun.zhang@up.ac.za},
}

@article{giorgi_can_2013,
	title = {Can tidal current energy provide base load?},
	volume = {6},
	issn = {1996-1073},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84880210480&doi=10.3390%2fen6062840&partnerID=40&md5=589aa1fe2cd8fbabf8460988de153f39},
	doi = {10.3390/en6062840},
	abstract = {Tidal energy belongs to the class of intermittent but predictable renewable energy sources. In this paper, we consider a compact set of geographically diverse locations, which have been assessed to have significant tidal stream energy, and attempt to find the degree to which the resource in each location should be exploited so that the aggregate power from all locations has a low variance. An important characteristic of the locations chosen is that there is a good spread in the peak tidal flow times, though the geographical spread is relatively small. We assume that the locations, all on the island of Ireland, can be connected together and also assume a modular set of tidal turbines. We employ multi-objective optimisation to simultaneously minimise variance, maximise mean power and maximise minimum power. A Pareto front of optimal solutions in the form of a set of coefficients determining the degree of tidal energy penetration in each location is generated using a genetic algorithm. While for the example chosen the total mean power generated is not great (circa 100 {MW}), the case study demonstrated a methodology that can be applied to other location sets that exhibit similar delays between peak tidal flow times. © 2013 by the author.},
	pages = {2840--2858},
	number = {6},
	journaltitle = {Energies},
	publisher = {{MDPI} {AG}},
	author = {Giorgi, S. and Ringwood, J. V.},
	date = {2013},
	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Genetic algorithms, electricity generation, Multi-objective optimisation, Location, Optimal solutions, Tidal turbines, Tidal power, Base-loads, Diverse locations, Ocean currents, Power base load, Tidal current energy, Tidal stream energy},
}


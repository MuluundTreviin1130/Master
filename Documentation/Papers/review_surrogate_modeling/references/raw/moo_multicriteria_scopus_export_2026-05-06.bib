@inproceedings{gao_economic_2015,
	title = {Economic Cost and Carbon Emission Reduction of Microgrid via Bi-Objective Optimization},
	isbn = {19341768},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205502947&doi=10.23919%2fCCC63176.2024.10662760&partnerID=40&md5=62883858e68f0c2efdf6e46a9ce10abc},
	doi = {10.23919/CCC63176.2024.10662760},
	abstract = {In the evolving landscape of energy systems, microgrids play a pivotal role in enhancing electricity supply efficiency and integrating renewable energy. This study addresses the critical challenge of balancing operational costs with carbon emissions reduction in microgrid energy management. We formulate this as a bi-objective optimization problem and propose an innovative hybrid methodology that merges the augmented ϵ-constraint method with the {TOPSIS} decision-making technique. Our approach efficiently resolves subproblems defined by specific ϵ values using a {MILP} solver, constructing a Pareto front to illustrate the trade-offs between economic and environmental objectives. Utilizing {TOPSIS}, we successfully identify a balanced compromise solution, significantly reducing the secondary objective by 55.1 \% in economic cost and 16.7 \% in carbon emissions for a preference weight vector of [0.7,0.3]. This study not only addresses the immediate challenge of dual-objective optimization in microgrids but also sets the foundation for future research in more intricate demand response programs and comparative analyses with other multi-objective optimization methods. The code is accessible at https://gitee.com/shuhuagao/mgbo. © 2024 Technical Committee on Control Theory, Chinese Association of Automation.},
	pages = {6307--6314},
	publisher = {{IEEE} Computer Society},
	author = {Gao, S. and Wang, Z. and Yang, Y. and Li, C. and Fan, J. and Kou, J. and Wang, J.},
	editor = {{Zhao Q.} and {Liu S.}},
	date = {2015},
	keywords = {Microgrid, Microgrids, Clean energy, Energy, Energy systems, {TOPSIS}, Pareto front, Zero-carbon, electricity supply, Carbon sequestration, Carbon emissions reductions, Low emission, Bi-objective optimization, Carbon capture and utilization, Kyoto Protocol, Carbon emission reduction, Economic costs, Microgrid energy management},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: J. Wang; School of Control Science and Engineering, Shandong University, Jinan, 250100, China; email: wangjingkz@sdu.edu.cn},
}


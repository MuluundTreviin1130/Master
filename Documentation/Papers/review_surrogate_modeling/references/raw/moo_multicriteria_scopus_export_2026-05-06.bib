	isbn = {18653529},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85085290447&doi=10.1007%2f978-981-15-4246-6_5&partnerID=40&md5=7d51560aaf58e0d7bb3a45e274384f33},
	doi = {10.1007/978-981-15-4246-6_5},
	abstract = {In the pathway of sustainable development, the energy consumption achieves crest and becomes a global issue. Several countries are trying to tackle this problem of increase in demand of energy and limited reserves of fossil fuel-based resources. Also, the energy consumption giving rise to the environmental issues is another big concern. Researchers, all over the globe, are very keen about this problem and suggesting solutions in the form of energy efficiency, conservation and renewable energy technology. Nowadays, larger penetration of renewable energy resources in grid is getting much more lead and importance. This paper reveals a particle swarm optimization ({PSO}) technique in Microsoft {XL} optimizer and is utilized to satisfy the electrical demand for the case study of Kolhapur in Maharashtra state in India. The 40\% of total electrical the demand is tried to satisfy due to lack of supportive grid capability to accommodate the renewable electricity more than this. Solar {PV}, wind energy and small hydropower resources are utilized to satisfy the electrical demand. An optimization problem based on multi-objective is formulated for the integrated combination of resources to satisfy the average single-day electrical demand of first of each month for the whole year. Mainly, cost and {CO}2 emission reduction are the objectives considered to solve the constant optimization problem. © 2020, Springer Nature Singapore Pte Ltd.},
	pages = {103--121},
	booktitle = {Green Energy and Technology},
	publisher = {Springer Science and Business Media Deutschland {GmbH}},
	author = {Wagh, M. and Kulkarni, V.},
	date = {2020},
	keywords = {Multiobjective optimization, Wind power, Multi-objective optimization, Particle swarm optimization ({PSO}), Energy efficiency, Energy utilization, Optimization problems, Sustainable development, Emission control, Solar energy, Renewable energy integrations, Renewable energy technologies, Fossil fuels, {CO}2 emission reduction, Proven reserves, Fossil fuel deposits, Renewable electricity, Constant optimizations, Electrical demand satisfaction, Electrical energy demand, Integrated renewable energy sources, {PSO}-based Multi-Objective Optimization},
	annotation = {Book {chapterExport} Date: 03 April 2025; Cited By: 0; Correspondence Address: M. Wagh; Department of Technology, Shivaji University, Kolhapur, 416004, India; email: waghmahesh2006@gmail.com},
}

@article{waibel_co-simulation_2019,
	title = {Co-simulation and optimization of building geometry and multi-energy systems: Interdependencies in energy supply, energy demand and solar potentials},
	volume = {242},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063457908&doi=10.1016%2fj.apenergy.2019.03.177&partnerID=40&md5=60f568c494bff517b67c84fbcefc2a6f},
	doi = {10.1016/j.apenergy.2019.03.177},
	abstract = {This paper presents a co-simulation framework for the simultaneous optimization of building geometries and multi-energy systems using the energy hub approach. The rationale for such coupling is that building geometry has an impact on energy demands and solar potentials on roofs and façades, thus also altering the corresponding optimal energy system. As a demonstration of this approach, we formulate bi-objective optimization problems for minimizing operational cost and carbon emissions, with decision variables for building geometry and for selection and sizing of energy system technologies. The methodology is applied to a case study in the city of Zurich, Switzerland, involving four office buildings. Different carbon emissions targets are studied to show the impact on cost, densities, sizing of the multi-energy system, and architectural design implications. Results for this case study show a clear relation between emissions targets and densities due to available solar potentials for renewable energy generation, with an optimal density in the strictest emissions target reaching only 10\% of the optimal density without emissions target. This indicates that differentiated environmental targets should be defined depending on the location of a building, where rural sites could have stricter targets than dense urban sites to reflect the respective marginal costs for achieving the targets. Our study shows that coupling multiple simulators into a common optimization and design workflow brings together architectural aspects, such as geometry, with engineering aspects, such as the energy system design, and microclimate conditions, such as local solar potentials. Thus, essential interdependencies between the energy supply and demand side can be captured in the design of energy efficient cities. © 2019 Elsevier Ltd},
	pages = {1661--1682},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Waibel, C. and Evins, R. and Carmeliet, J.},
	date = {2019},
	keywords = {Multiobjective optimization, Renewable energy resources, Multi-objective optimization, Architectural design, Energy efficiency, Energy management, Power generation, Carbon, alternative energy, Energy hub, Energy hubs, algorithm, Solar power, Multi-energy systems, carbon emission, {ECONOMICS}, rural area, Multi-energy system, Simulation, methodology, demand analysis, electricity supply, Office buildings, urban area, Urban growth, Building energy demands, Geometry, Solar potential, climate conditions, Switzerland, Zurich [Switzerland], Co-simulation, Cosimulation, Geometry optimization, Building energy demand, microclimate, Solar potentials},
}

@inproceedings{wakui_operations_2017,
	title = {Operations management of energy supply networks based on two-stage multi-objective schedule planning},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85048613739&partnerID=40&md5=48cc4927cd8ba47ee9f998617803c839},
	abstract = {An operations management system of energy supply networks using multiple energy supply devices is developed to tackle a trade-off between energy savings and operation cost reduction. The developed system consists of energy demand prediction by support vector regression, schedule planning based on mixed-integer linear programming, and rule-based real-time control. In the schedule planning, a two-stage multi-objective optimization approach is newly employed. In the first stage, the primary energy consumption in the prediction horizon is minimized and a reduction rate of primary energy consumption is calculated from the optimal solution. In the second stage, the operation cost is minimized subject to satisfaction of an achievement rate of the calculated reduction rate of primary energy consumption. For a case study, a residential energy supply network, consisting of four fuel cell-based cogeneration units, is investigated. Annual operating simulation, in which the achievement rate is varied as a given parameter, shows that varying the achievement rate is effective to obtain a Pareto front of this multi-objective optimization problem and to make decisions for the trade-off between energy savings and operation cost reduction. © 2017 {IMEKO}},
	eventtitle = {30th International Conference on Efficiency, Cost, Optimization, Simulation and Environmental Impact of Energy Systems, {ECOS} 2017},
	publisher = {International Measurement Confederation ({IMEKO})},
	editor = {Wakui, T. and Sawada, K. and Yokoyama, R. and Aki, H.},
	date = {2017},
	keywords = {Multiobjective optimization, Multi-objective optimization, Economic and social effects, Energy efficiency, Energy utilization, Environmental impact, Micro grid, Microgrid, Multi-objective optimization problem, Energy management, Fuel cells, Energy conservation, Operating costs, Integer programming, Cogeneration plants, Cost reduction, Mixed-integer linear programming, Primary energy consumption, Mixed integer linear programming, Real time control, Energy demand prediction, Energy supply network, Energy supply networks, Operations management, Support vector regression ({SVR})},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 0},
}

@article{wakui_predictive_2018,
	title = {Predictive management of cogeneration-based energy supply networks using two-stage multi-objective optimization},
	volume = {162},
	issn = {0360-5442},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85053460153&doi=10.1016%2fj.energy.2018.08.072&partnerID=40&md5=fe668731d971253f14c6de938778901d},
	doi = {10.1016/j.energy.2018.08.072},
	abstract = {A predictive management system for cogeneration unit-based energy supply networks using two-stage multi-objective optimization was developed to tackle a trade-off between energy savings and operating cost reduction. The developed system integrated support vector regression-based energy demand prediction, {MILP} (mixed-integer linear programming)-based schedule planning, and rule-based operation control. The contribution is to develop two-stage {MILP}-based multi-objective schedule planning, which is extension of an ε-constraint method, and operation control rule of multiple cogeneration units. In the first-stage schedule planning, primary energy consumption in the prediction horizon is minimized, and a reduction rate of primary energy consumption is calculated. In the second-stage schedule planning, an operating cost is minimized additionally subject to satisfaction of partial achievement of the reduction rate of primary energy consumption calculated in the first stage. An energy-saving achievement rate is regarded as a decision-making parameter to control a trade-off between energy savings and cost reduction, of which definition is quantitatively apprehensible for decision makers. Annual operating simulation of an energy supply network using four fuel-cell-based cogeneration units revealed that the developed predictive management system has high controllability to the trade-off between the energy-saving rates (18.9\%–21.6\%) and the operating cost reduction rate (19.0\%–15.6\%), caused by a time-of-use power tariff structure. © 2018 Elsevier Ltd},
	pages = {1269--1286},
	journaltitle = {Energy},
	publisher = {Elsevier Ltd},
	author = {Wakui, T. and Sawada, K. and Yokoyama, R. and Aki, H.},
	date = {2018},
	keywords = {Multiobjective optimization, Energy management systems, Multi-objective optimization, Decision making, Economic and social effects, Energy utilization, Micro grid, Microgrid, optimization, Energy management, Fuel cells, Energy conservation, Cogeneration, Operating costs, Integer programming, Smart grid, cost, Cogeneration plants, model predictive control, energy use, Cost reduction, electricity supply, Mixed-integer linear programming, trade-off, linear programing, Epsilon-constraint method, Primary energy consumption, Mixed integer linear programming, Management, prediction, control system, Decision making parameters, Energy demand prediction, Energy supply networks},
}

@inproceedings{wamalwa_optimal_2014,
	title = {Optimal energy mix of a microhydro-wind-grid system powering a dairy farm in Western Cape, South Africa},
	isbn = {18766102},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85041532682&doi=10.1016%2fj.egypro.2017.12.116&partnerID=40&md5=5f4811786caeb7f46fc0a71f8995490d},
	doi = {10.1016/j.egypro.2017.12.116},
	abstract = {This paper presents an optimal control strategy of a grid-tied microhydro-wind power system for a rural dairy farm in South Africa. The problem is formulated as a multi-objective optimisation programme in discrete time domain to minimise grid imported energy cost under Time of Use Tariff ({TOU}) while at the same time maximising revenue generated from the sale of surplus renewable energy to the grid at a specified renewable energy feed-in tariff. The application of the proposed model to a practical case study shows the potential of the model to save the farmer the grid energy cost up to 75.07\% in summer and 70.69\% in the winter with a discounted repayment period of 3 years and 7 months.},
	pages = {708--715},
	publisher = {Elsevier Ltd},
	author = {Wamalwa, F. and Sichilalu, S. M. and Xia, X.},
	date = {2014},
	keywords = {Multiobjective optimization, Wind power, Renewable energies, feed-in tariff, Electric power system control, dairy farm, Farms, Optimal control, Optimal controls, Optimal control systems, Dairy farms, Distributed renewable energy, Micro hydros, Microhydro system, {TOU} tariff},
	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 7; Correspondence Address: F. Wamalwa; Centre of New Energy Systems, Department of Electrical, Electronic and Computer Engineering, University of Pretoria, Pretoria, 0002, South Africa; email: Fazil.wamalwa@gmail.com},
}

@article{wan_optimal_2025,
	title = {Optimal sizing and operation of community hybrid energy storage systems},
	volume = {119},
	issn = {2352152X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000727584&doi=10.1016%2fj.est.2025.116209&partnerID=40&md5=f866bea60c055ef59a0a64edcb7c1c7b},
	doi = {10.1016/j.est.2025.116209},
	abstract = {Configuring a community energy storage system ({CESS}) helps balance energy supply-demand and increase the self-consumption rate of distributed renewable energy based generation on the user side. However, a {CESS} primarily relies on battery storage, whose high economic cost makes large-scale development and practical application difficult. Given this background, the optimal sizing and operational strategy for a community hybrid energy storage system ({CHESS}) is proposed in this paper, which comprises the slow-response energy storage device ({SRESD}) and the fast-response energy storage device ({FRESD}). Firstly, considering the community's willingness to deploy storage and the impact of storage on smoothing load fluctuations, a multi-objective optimization model aiming to maximize community profits and minimize load fluctuations is proposed, which is transformed into a single objective optimization by incorporating a penalty factor. Then, the Density-Based Spatial Clustering of Applications with Noise ({DBSCAN}) algorithm is employed to derive typical community load and electricity price curves which are used to schedule the monthly charge and discharge periods for the {SRESD}, subsequently developing the optimal sizing and annual 8760-hour operational strategy for a {CHESS} based on this schedule. On this basis, three storage configurations ({CHESS}, {SRESD}, and {FRESD}) are compared, and it is found by simulation results that the {CHESS} combines the advantages of both {SRESD} and {FRESD}, offering larger arbitrage opportunity with the peak-valley price spread and being more effective in managing load fluctuations. Finally, the impacts of declining battery costs on optimization results are examined and experimental verification based on real data from Australia is carried out, with the feasibility and sustainability of the proposed sizing and operational strategy for a {CHESS} demonstrated. © 2025 The Authors},
	journaltitle = {J. Energy Storage},
	publisher = {Elsevier Ltd},
	author = {Wan, L. and Yang, J. and Yang, Y. and Li, T. and Liu, H. and Wen, F.},
	date = {2025},
	keywords = {Multi-objectives optimization, Multi-objective optimization, Hybrid power, Storage systems, Community energy, Load fluctuations, load fluctuation, Community energy storage system, Community profit, Fast response, Fast-response energy storage device, Response energy, Slow-response energy storage device},
}

@article{wang_multi-objective_2024,
	title = {Multi-objective optimization algorithm for economy and flexibility of cogeneration unit with heat storage},
	volume = {43},
	issn = {20963203},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189033074&doi=10.12158%2fj.2096-3203.2024.02.026&partnerID=40&md5=899a37fe03b9c193a67a320227a3f16d},
	doi = {10.12158/j.2096-3203.2024.02.026},
	abstract = {With the sustained growth of renewable energy, the flexibility of the power system has emerged as a critical indicator, influenced by frequent peak regulation. However, a dilemma exists between maximizing flexibility and optimizing economy, and a multi-objective optimization can serve as means of coordinating conflicts. In this study, condensing cogeneration units equipped with a molten salt heat storage system is research object, an optimization model for day-ahead scheduling is established, with flexibility and economy as the primary optimization objectives. To account for various constraint condition such as unit ramp rate, unit output and thermoelectric coupling properties, an enhanced version of the non-dominated sorting genetic algorithm-Ⅱ ({NSGA}-Ⅱ) is proposed to efficiently solve the optimization problem of a molten salt heat storage system. Flexibility and economy are used to compare and analyze the non dominated solution set obtained from the Pareto front. At the same time, the heat storage and release characteristics of a molten salt heat storage system are analyzed. The findings reveal that a focus on flexibility necessitates great motten salt heat storage to manage insufficient heating during low-load operations. Conversely, an emphasis on economy leads to frequent adjustments in heat storage to maintain optimal unit performance. © 2024 Editorial Department of Electric Power Engineering Technology. All rights reserved.},
	pages = {248--259},
	number = {2},
	journaltitle = {Electr. Pow. Eng. Technol.},
	publisher = {Editorial Department of Electric Power Engineering Technology},
	author = {Wang, A. and Yang, Q. and Wang, J. and Lu, J. and Liu, H. and Wang, P.},
	date = {2024},
	keywords = {Multi-objective optimization, Day-ahead scheduling, Molten salt, Economy, Flexibility, non-dominated sorting genetic algorithm-Ⅱ ({NSGA}-Ⅱ)},
}

@article{wang_real-time_2020,
	title = {Real-time Prior Dispatch Method for Renewable Energy with Safety and Economy Coordination of Power Grid and Its Application},
	volume = {44},
	issn = {10001026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090246221&doi=10.7500%2fAEPS20191121001&partnerID=40&md5=edd620caab2dd230a0ea203aeaffa1a9},
	doi = {10.7500/AEPS20191121001},
	abstract = {The real-time dispatch of power system is between the intraday hourly rolling dispatch and the automatic generation control ({AGC}) responding within seconds, which is an important link between the preceding and the following dispatch in the online dispatch process. For the power grid with high proportion of renewable energy, the real-time dispatch is important to improve the real-time regulation of the power grid and cope with strong fluctuations such as steep rise/fall of renewable energy power output. The real-time dispatch is essentially a multi-objective optimization problem with multiple constraints, which needs to take a variety of actual requirements into account. It should give the feasible and reasonable optimization strategy online automatically and reliably under the condition that human intervention is basically not required, with the dispatch cycle of 5 and 15 minutes, respectively. This paper proposes a real-time prior dispatch method for renewable energy with safety and economy coordination, which uses multiple stages to advance decision-making to achieve the coordination of different dispatch objectives in different scenarios. It considers different dispatch requirements, such as the elimination of cross-section congestion, the maximum accommodation of renewable energy, fair distribution of power between traditional units and feasible {AGC} reserve capacity. Based on the proposed method, a real-time dispatch system is developed and put into operation in several provincial power grids. Actual operation results prove the effectiveness of the proposed method. © 2020 Automation of Electric Power Systems Press.},
	pages = {105--113},
	number = {16},
	journaltitle = {Dianli Xitong Zidonghue},
	publisher = {Automation of Electric Power Systems Press},

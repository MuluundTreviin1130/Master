	abstract = {This paper introduces an optimal household demand side management ({DSM}) program with the integration of inhouse renewable energy resources ({RERs}). With the help of a smart battery energy storage system ({BESS}), the utilization of {RER} integration is maximized in this paper. The minimization of peak load demand and the minimization of every consumer's energy bill are chosen as objectives of this {DSM} program. Generally, smart residential users are equipped with different controllable appliances which have complex constraints too. Therefore, an evolutionary method is used to solve the proposed residential {DSM} model. Additionally, the popular economic tool which is the cash payback period ({CPP}) has also been applied in this paper to investigate the initial investment benefits of {RERs} and {BESS}. Six distinct scenarios have been demonstrated in this paper to evaluate the performance of proposed residential {DSM} model. © 2019 {IEEE}.},

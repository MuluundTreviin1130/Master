@inproceedings{na_j_multi-objective_2024,
	title = {Multi-objective optimal scheduling for microgrids based on improved sand cat swarm optimization algorithm},
	volume = {13259},
	isbn = {0277786X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204223482&doi=10.1117%2f12.3039328&partnerID=40&md5=8342795ad776fe5a5e99874c32d2cbf8},
	doi = {10.1117/12.3039328},
	abstract = {The multi-objective optimization scheduling of microgrids is crucial for reducing electricity usage, energy consumption, and environmental pollution. This paper proposes a microgrid optimization management method based on the improved Sand Cat Swarm Optimization ({ISCSO}) algorithm to enhance the economy, stability, and reliability of microgrid operations. By predicting distributed energy output and power load, an optimization objective is set focusing on operating costs and environmental management. The {ISCSO} algorithm optimizes energy output, outperforming the Grey Wolf Optimization ({GWO}) and Whale Optimization Algorithm ({WOA}) in scheduling. It effectively optimizes distributed power sources and power exchange with the distribution network, minimizing the microgrid's overall operating cost. The proposed method, model, and {ISCSO} algorithm are validated as rational and effective. © 2024 {SPIE}.},

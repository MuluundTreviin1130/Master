	publisher = {Power System Protection and Control Press},
	author = {Tan, Y. and Lü, Z. and Li, J.},
	date = {2016},
	keywords = {Multi-objective optimization, Entropy theory, Improved {ELM}, Independent microgrid, Optimal sizing allocation},
}


@article{fang_multiobjective_2019,
	title = {Multiobjective Coordinated Scheduling of Energy and Flight for Hybrid Electric Unmanned Aircraft Microgrids},
	volume = {66},
	issn = {02780046},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050997104&doi=10.1109%2fTIE.2018.2860569&partnerID=40&md5=33e9b5823d0001415b9d046358f287df},
	doi = {10.1109/TIE.2018.2860569},
	abstract = {A hybrid electric unmanned aircraft ({HEUA}) uses the aerial thermal engine and energy storage system ({ESS})-driven electric motor to meet the load demand, thus can be viewed as a "mobile multienergy microgrid." Conventionally, for a given flight mission, only the energy of an {HEUA} is optimized while the flight speed is fixed; thus, the overall energy efficiency may be limited. This paper aims to coordinately schedule the energy consumption and the flight speed of an {HEUA} toward optimal economic and environmental objectives. First, a coordinated optimization model is proposed to coordinately schedule the energy consumption (including the power output of the thermal engine and the {ESS}) and flight speed (i.e., the true air speed) of an {HEUA} for simultaneously minimizing the fuel consumption ({FC}) and polluted gas emission ({PGE}). Second, a decomposition-based solution method is developed to convert the original nonlinear multiobjective optimization model into a bilevel programming model which can be solved iteratively. Simulation results demonstrate that, compared with the conventional single energy scheduling, the proposed coordinated scheduling method can achieve much better performance in terms of {FC} and {PGE}. © 2018 {IEEE}.},
	pages = {5686--5695},
	number = {7},
	journaltitle = {{IEEE} Trans Ind Electron},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Fang, S. and Xu, Y.},
	date = {2019},
	keywords = {Multiobjective optimization, Energy efficiency, Energy utilization, Micro grid, Gas emissions, Multi-objective optimization models, Scheduling, Iterative methods, Environmental objectives, Coordinated optimization, Overall energy efficiency, Antennas, Unmanned aerial vehicles ({UAV}), Bilevel programming models, Coordinated fuel and flight scheduling, Durability, Exhaust systems (engine), Flight scheduling, hybrid electric unmanned aircraft ({HEUA}), mobile multienergy microgrid, polluted gas emission ({PGE}), Unmanned aircrafts},
}

@article{fang_two-step_2019,
	title = {Two-Step Multi-Objective Management of Hybrid Energy Storage System in All-Electric Ship Microgrids},
	volume = {68},
	issn = {00189545},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064607878&doi=10.1109%2fTVT.2019.2898461&partnerID=40&md5=686b3b72e33671f30805a2315537185f},
	doi = {10.1109/TVT.2019.2898461},
	abstract = {The all-electric ship ({AES}) usually employs battery energy storage systems ({ESSs}) in the shipboard microgrid. However, the battery-only storage usually experiences frequent deep discharging or charging to meet the sudden load variations in a voyage, which may lead to significant degradation of battery lifetime. This paper, hybridizes two types of {ESSs} and proposes a two-step multi-objective optimization method for hybrid {ESS} ({HESS}) management. The first step regulates the {HESS} with the onboard diesel generators to simultaneously optimize both the economic and environmental objectives, and the second step is to split the active power of {HESS} into two individual {ESSs} for minimizing the battery cycle degradation. The first step is formulated as a bi-level optimization model through constraint decomposition. Then, a normal boundary intersection method combining with the column-and-constraint generation algorithm is developed to solve the proposed model. Extensive simulations demonstrate that the {HESS} can effectively resolve the power-density shortage of the battery-only system, and its integration into {AES} is able to extend the battery lifetime and improve both the economic and environmental indices. © 1967-2012 {IEEE}.},
	pages = {3361--3373},
	number = {4},
	journaltitle = {{IEEE} Trans. Veh. Technol.},
	publisher = {Institute of Electrical and Electronics Engineers Inc},
	author = {Fang, S. and Xu, Y. and Li, Z. and Zhao, T. and Wang, H.},
	date = {2019},
	keywords = {Multiobjective optimization, Battery storage, Micro grid, Secondary batteries, Bi-level optimization, Hybrid energy storage system, Hybrid energy storage systems, Ships, All electric ships, All-electric ship, battery lifetime, Electric ship equipment, shipboard microgrid, two-step multi-objective bi-level optimization},
}


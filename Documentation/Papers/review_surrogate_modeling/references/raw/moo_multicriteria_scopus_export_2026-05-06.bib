	keywords = {Multiobjective optimization, Renewable energy resources, Renewable energy source, Electric power transmission networks, Natural resources, Power quality, Decision making, optimization, Optimisations, Sensitivity analysis, Integer programming, Power, Integration, Integration of renewable energies, Network security, Nonlinear programming, Large-scales, Constrained optimization, Harmonic analysis, Electric power system planning, Expansion planning, Composite power systems, Global demand, Harmonic emissions, harmonics, Power system expansion planning},
}

@article{gbadega_jaya_2023,
	title = {{JAYA} Algorithm-Based Energy Management for a Grid-Connected Micro-Grid with {PV}-Wind-Microturbine-Storage Energy System},
	volume = {63},
	issn = {16633571},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85154018076&doi=10.4028%2fp-du1983&partnerID=40&md5=f07aeffd6ab2c5cc5b310d12ab30d0db},
	doi = {10.4028/p-du1983},
	abstract = {In this study, the Jaya optimization algorithm is used to address the micro-grid energy management optimization problem using a hybrid {PV}-wind-microturbine-storage energy system. The main goals of this study are to reduce environmental pollution, increase microturbine operating efficiency, and minimize the cost of power generated. The overall objective of the proposed optimization method employed in the {PV}-{WECS} system is to run the {PV}-{WECS} systems at full capacity while running the microturbine when the {PV}-{WECS} systems are unable to produce all of the required power. The amount of emissions and costs of generated energy are reduced when {BESS} is used in the microgrid system. Furthermore, it is observed from the results that there is about 61.39\% cost saving in the micro-grid operational costs and 38\% carbon emissions reductions using the proposed optimization algorithm compared to the other metaheuristic algorithms used in this study. To demonstrate the appropriateness and supremacy of the proposed algorithm over the various optimization techniques for energy management of the proposed micro-grid systems, simulation results from the proposed algorithm are compared with those from other population-based metaheuristic algorithms, such as Particle Swarm Optimization ({PSO}), Differential Evolution ({DE}), Teaching Learning Based Optimization ({TLBO}), and Genetic Algorithms ({GA}). The proposed algorithm outperforms and produces better results than the existing metaheuristic optimization techniques. More importantly, it illustrates the viability and efficacy of the proposed {JAYA} optimization approach in addressing the issue of energy management for large-scale power systems. © 2023 Trans Tech Publications Ltd, Switzerland.},
	pages = {159--184},
	journaltitle = {Int. J. Eng. Res. Afr.},
	publisher = {Trans Tech Publications Ltd},
	author = {Gbadega, P. A. and Sun, Y.},
	date = {2023},
	keywords = {Multi-objectives optimization, Multiobjective optimization, Energy management systems, Genetic algorithms, Multi-objective optimization, Particle swarm optimization ({PSO}), Microgrid, Energy management, energy storage, Energy storage system, Meta-heuristics algorithms, Storage systems, Energy systems, Metaheuristic algorithms, Turbines, {MATLAB}, Jaya algorithm, Cost reduction, Storage management, Energy management system, {MATLAB} simulation, Microturbines, Storage energy},
}

@article{ge_hierarchical_2025,
	title = {A hierarchical multi-objective co-optimization framework for sizing and energy management of coupled hydrogen-electricity energy storage systems at ports},
	volume = {384},
	issn = {0306-2619},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216867250&doi=10.1016%2fj.apenergy.2025.125451&partnerID=40&md5=fc86c1c4678ca260861a2c72c0926460},
	doi = {10.1016/j.apenergy.2025.125451},
	abstract = {Hydrogen-electricity integrated multi-energy systems are promising approaches to reduce carbon emissions in ports. However, the stochastic nature of renewable energy and the imbalance between the renewable generation and load demand in ports necessitate the design of an appropriate coupled hydrogen-electricity energy storage systems ({CHEESS}). This paper proposes a multi-objective optimization model for {CHEESS} configuration in random imbalanced port integrated multi-energy systems ({PIMES}), aiming to minimize its life-cycle cost and carbon emissions through co-optimization of sizing and energy management. A hierarchical two-stage framework is proposed to solve the multi-objective model. The proposed optimization framework is applied to a real {PIMES} at the Ningbo-Zhoushan Port. The results show that the proposed method can save 10.54 \% of the monetary cost and 19.67 \% of carbon emissions over the entire life-cycle of the system. The study demonstrates that the proposed framework has the potential to generate significant economic and environmental benefits and provides a feasible solution for port authorities seeking to implement {CHEESS}, aiming to promote sustainability in port operations. © 2025 Elsevier Ltd},
	journaltitle = {Appl. Energy},
	publisher = {Elsevier Ltd},
	author = {Ge, P. and Tang, D. and Yuan, Y. and Guerrero, J. M. and Zio, E.},
	date = {2025},
	keywords = {Multi-objectives optimization, Multi-objective optimization, optimization, Energy management, Hybrid power, alternative energy, energy storage, Storage systems, Energy, Multi-energy systems, Carbon emissions, Hybrid energy storage system, Zero-carbon, Hydrogen, integrated approach, Charge storage, Optimization framework, Carbon sequestration, Hybrid energy storage systems, Co-optimization, Carbon capture and utilization, China, Carbon capture and storage, Integrated multi-energy system, Ningbo, port operation, Seaport, Seaports, Zhejiang, Zhoushan, Zhoushan Island, Zhoushan Islands},
}


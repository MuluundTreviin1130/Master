	annotation = {Conference {paperExport} Date: 03 April 2025; Cited By: 1; Correspondence Address: Y. Amoura; Research Centre in Digitalization and Intelligent Robotics ({CeDRI}), Instituto Politécnico de Bragança, Bragança, Portugal; email: yahia@ipb.pt},

	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143983024&doi=10.1109%2fICPRE55555.2022.9960331&partnerID=40&md5=66ff6bec8226fee90df616bdebcb3a73},
	doi = {10.1109/ICPRE55555.2022.9960331},
	abstract = {The preparation of "Green hydrogen"from renewable energy is an important way to realize low carbonization of energy. In this paper, the wind-solar renewable energy hydrogen production system, which is located in Chongli, Hebei Province, is used to power the hydrogen buses for the Winter Olympic Venues. Aiming at the shortcomings of Cplex solving multi-objective problems, an optimization strategy using multiobjective Golden Eagle algorithm ({MOGEO}) to solve the solution set of the optimal operation scheme is proposed, in order to achieve to maximize system profit at the same time reduce the environmental cost. Finally, the proposed method was compared with Cplex and {MOPSO} to verify the feasibility and superiority of the proposed method. © 2022 {IEEE}.},

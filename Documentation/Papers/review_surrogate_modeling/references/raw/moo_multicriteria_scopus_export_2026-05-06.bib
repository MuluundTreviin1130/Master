	keywords = {Multiobjective optimization, Energy supplies, Stochastic systems, Hydrogen storage, Environmental energy, Stochastic models, Plug-in Electric Vehicles, Integer programming, Energy resources, Stochastic programming, hydrogen energy storage, Hydrogen energy storages, Robust optimization, Base stations, Mixed integer, Economic-environmental operation, Environmental operations, Mixed-integer second-order cone programming, Mobile base station, Second-order cone programming},
